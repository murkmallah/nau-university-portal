@{ Layout = null; }
<!DOCTYPE html>
<html><head><title>Admin Dashboard</title>
<partial name="_Favicon" />
<link rel="stylesheet" href="~/css/site.css">
<style>
  body { font-family: 'Poppins', sans-serif; background: #f5f7fb; margin: 0; }
  .admin-nav { background: #0b2c4d; padding: 16px 32px; color: #fff; font-family: 'Montserrat', sans-serif; font-weight: 700; }
  .admin-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; padding: 32px; max-width: 1100px; margin: 0 auto; }
  .admin-card { background: #fff; border-radius: 12px; padding: 24px; box-shadow: 0 4px 16px rgba(11,44,77,0.08); text-decoration: none; color: #0b2c4d; }
  .admin-card h3 { font-family: 'Montserrat', sans-serif; margin-bottom: 6px; }
  .admin-card p { color: #888; font-size: 13px; margin: 0; }
</style>
</head>
<body>
    <div class="admin-nav" style="display:flex; justify-content:space-between; align-items:center;">
        <span>NAU Admin Panel</span>
        <div style="font-size:13px; font-weight:400; display:flex; align-items:center; gap:16px;">
            <span>Hi, @User.Identity?.Name</span>
            <a href="/" style="color:#fff; text-decoration:none;">View Site</a>
            <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline; margin:0;">
                <button type="submit" style="background:none; border:1px solid rgba(255,255,255,0.3); color:#fff; padding:6px 14px; border-radius:6px; cursor:pointer; font-family:'Poppins',sans-serif; font-size:13px;">Logout</button>
            </form>
        </div>
    </div>
    <div class="admin-cards">
    <a class="admin-card" href="/?edit=true"><h3>🏠 Homepage</h3><p>Edit homepage text and images directly</p></a>
    <a class="admin-card" href="/Facilities"><h3>🏢 Facilities</h3><p>Manage hostel, library, mess, etc.</p></a>
    <a class="admin-card" href="/Courses/Public?edit=true"><h3>🎯 Short Courses</h3><p>Edit the public Short Courses page directly — add or remove courses inline</p></a>
    <a class="admin-card" href="/NewsPosts/Public?edit=true"><h3>📰 News & Media</h3><p>Edit the public News page directly — add, edit, or remove news posts, photos, and videos inline</p></a>
    <a class="admin-card" href="/Faculties/Public?edit=true"><h3>🎓 Faculties</h3><p>Edit the public Faculties page directly — add or remove faculties and programs inline</p></a>
    <a class="admin-card" href="/SimulationLabs/Public?edit=true"><h3>✈️ Simulation &amp; Labs</h3><p>Edit the Flight Simulators, ATC Simulator and Avionics Lab sections directly — update images and features inline</p></a>
    <a class="admin-card" href="/SimulationLabs/Index"><h3>➕ Simulation &amp; Labs — Sections</h3><p>Add, reorder, hide or delete whole sections (e.g. a 4th section) — saved straight to the database</p></a>
    <a class="admin-card" href="/links.html?edit=1"><h3>🔗 Useful Links</h3><p>Edit the public Useful Links page directly — add, edit, or remove links inline</p></a>
    <a class="admin-card" href="/Pages"><h3>📄 Pages</h3><p>Edit About, Financial, etc.</p></a>
    <a class="admin-card" href="/about.html?edit=true"><h3>🛫 About</h3><p>Edit the "History of CAA", "History of CATI" &amp; "Management" sections directly on the About page</p></a>
  </div>
</body></html>

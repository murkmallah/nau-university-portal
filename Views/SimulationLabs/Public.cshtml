    async function handleAvSectionImageFileChange(input){
      var file = input.files && input.files[0];
      if (!file) return;
      var err = document.getElementById('avImageError');
      err.style.display = 'none';
      var preview = document.getElementById('avImgPreview');
      preview.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

      var formData = new FormData();
      formData.append('file', file);

      try {
        var res = await fetch('@Url.Action("UploadSectionImage", "SimulationLabs")', {
          method: 'POST',
          headers: { 'RequestVerificationToken': slGetToken() },
          body: formData
        });
        var data = await res.json();
        if (!res.ok || !data.success){
          err.textContent = data.message || 'Could not upload the image.';
          err.style.display = 'block';
          updateAvImagePreview('', document.getElementById('avImgIcon').value || 'fas fa-image');
          return;
        }
        document.getElementById('avImgUrl').value = data.url;
        updateAvImagePreview(data.url, '');
      } catch (e){
        err.textContent = 'Network error while uploading, please try again.';
        err.style.display = 'block';
        updateAvImagePreview('', 'fas fa-image');
      }
    }

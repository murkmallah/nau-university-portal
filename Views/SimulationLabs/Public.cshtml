        f('avImgIcon').value = d.iconClass || '';
        f('avImgUrl').value = d.imageUrl || '';
        updateAvImagePreview(d.imageUrl, d.iconClass);
      } else {
        document.getElementById('avImageModalTitle').textContent = avCurrentImageIsLarge ? 'Edit Wide Image' : 'Add Image';
        f('avImgTitle').value = ''; f('avImgBadge').value = ''; f('avImgIcon').value = ''; f('avImgUrl').value = '';
        updateAvImagePreview('', 'fas fa-image');
      }

      document.getElementById('avImageModal').classList.add('open');
      document.body.style.overflow = 'hidden';
      f('avImgTitle').focus();

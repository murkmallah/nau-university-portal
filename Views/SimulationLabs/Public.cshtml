<!-- ════════════════════════════════════════
     ADMIN-ADDED SECTIONS (4th, 5th, ... — fully DB-driven)
     Same inline add/edit/delete experience as Sections 1-3 above, but
     generic so it works for however many extra sections exist. The
     "+ Add New Section" card creates a brand-new row in
     SimulationLabSections right from this page (no separate admin page
     needed), and every section rendered below reuses the exact same
     Quick* endpoints as Sections 1-3 (QuickUpdateSectionInfo,
     QuickSaveImage, QuickDeleteImage, QuickSaveFeature, QuickDeleteFeature,
     UploadSectionImage), just parameterized by sectionId instead of being
     hard-coded to one section.
════════════════════════════════════════ -->
@{
    var extraSections = ViewBag.ExtraSections as List<NAU_Web.Models.SimulationLabSection>;
}
@if (extraSections != null)
{
    foreach (var extra in extraSections)
    {
        var exColorA = string.IsNullOrWhiteSpace(extra.ColorHex) ? "#0b2c4d" : extra.ColorHex;
        var exColorB = string.IsNullOrWhiteSpace(extra.ColorHex2) ? exColorA : extra.ColorHex2;
        var exLarge = extra.SimulationLabImages.FirstOrDefault(i => i.IsLarge);
        var exSmall = extra.SimulationLabImages.Where(i => !i.IsLarge).OrderBy(i => i.DisplayOrder).ToList();
        var exFeatures = extra.SimulationLabFeatures.OrderBy(f => f.DisplayOrder).ToList();
        var exSmallTileCount = exSmall.Count + (editMode ? 1 : 0);
        var exMosaicClass = exSmallTileCount > 4 ? "sl-mosaic sl-grow" : "sl-mosaic";

        <section class="lab-section" id="@extra.SectionKey">
          <div class="lab-inner">

            <div class="sec-header reveal" style="position:relative;">
              <div class="sec-icon-wrap" style="background:linear-gradient(135deg, @exColorA, @exColorB);">
                <i class="@(extra.IconClass ?? "fas fa-flask")"></i>
              </div>
              <div class="sec-header-text">
                <div class="sec-tag" style="color:@exColorA;">@extra.Tag</div>
                <h2>@extra.Title</h2>
                <p>@extra.Description</p>
              </div>
              @if (isAdmin && editMode)
              {
                  <button type="button" class="sl-header-delete-btn" title="Delete Section" onclick="deleteExSection(@extra.SimulationLabSectionId)"><i class="fas fa-trash"></i></button>
                  <button type="button" class="sl-header-edit-btn" title="Edit Section Info" onclick="openExSectionInfoModal(@extra.SimulationLabSectionId)"><i class="fas fa-pen"></i></button>
              }
            </div>

            <!-- Image grid: 1 large + any number of small images (same pattern as Section 1) -->
            <div class="grid-1-2 reveal">
              <div class="span-col">
                <div class="img-placeholder" style="min-height:360px;@(!string.IsNullOrEmpty(exLarge?.ImageUrl) ? $"background-image:url('{exLarge.ImageUrl}');background-size:cover;background-position:center;" : "")">
                  @if (string.IsNullOrEmpty(exLarge?.ImageUrl))
                  {
                    <div class="ph-icon"><i class="@(exLarge?.IconClass ?? extra.IconClass ?? "fas fa-flask")"></i></div>
                  }
                  <div class="ph-title">@(exLarge?.Title ?? extra.Title)</div>
                  @if (!string.IsNullOrEmpty(exLarge?.Badge))
                  {
                    <div class="ph-badge">@exLarge.Badge</div>
                  }
                  @if (isAdmin && editMode)
                  {
                      <div class="sl-card-actions">
                          <button type="button" class="sl-edit-btn" title="Edit" onclick="event.stopPropagation(); openExImageModal(@extra.SimulationLabSectionId, @(exLarge?.SimulationLabImageId ?? 0), true)"><i class="fas fa-pen"></i></button>
                          @if (exLarge != null)
                          {
                              <button type="button" class="sl-delete-btn" title="Delete" onclick="event.stopPropagation(); deleteExImage(@exLarge.SimulationLabImageId)"><i class="fas fa-trash"></i></button>
                          }
                      </div>
                  }
                </div>
              </div>

              <div class="@exMosaicClass">
                @foreach (var img in exSmall)
                {
                  <div class="img-placeholder" style="@(!string.IsNullOrEmpty(img.ImageUrl) ? $"background-image:url('{img.ImageUrl}');background-size:cover;background-position:center;" : "")">
                    @if (string.IsNullOrEmpty(img.ImageUrl))
                    {
                      <div class="ph-icon" style="width:52px;height:52px;font-size:22px;"><i class="@(img.IconClass ?? "fas fa-circle")"></i></div>
                    }
                    <div class="ph-title" style="font-size:14px;">@img.Title</div>
                    @if (isAdmin && editMode)
                    {
                        <div class="sl-card-actions">
                            <button type="button" class="sl-edit-btn" title="Edit" onclick="event.stopPropagation(); openExImageModal(@extra.SimulationLabSectionId, @img.SimulationLabImageId, false)"><i class="fas fa-pen"></i></button>
                            <button type="button" class="sl-delete-btn" title="Delete" onclick="event.stopPropagation(); deleteExImage(@img.SimulationLabImageId)"><i class="fas fa-trash"></i></button>
                        </div>
                    }
                  </div>
                }
                @if (isAdmin && editMode)
                {
                    <button type="button" class="sl-add-tile-btn" onclick="openExImageModal(@extra.SimulationLabSectionId, null, false)"><i class="fas fa-plus"></i> Add Image</button>
                }
              </div>
            </div>

            <div class="feature-strip reveal">
              @foreach (var f in exFeatures)
              {
                <div class="feat-chip@(isAdmin && editMode ? " sl-editable" : "")" style="--feat-color:@exColorA;">
                  <i class="@(f.IconClass ?? "fas fa-check-circle")" style="color:@exColorA;"></i> @f.Label
                  @if (isAdmin && editMode)
                  {
                      <span class="feat-chip-actions">
                          <button type="button" class="sl-edit-mini" title="Edit" onclick="openExFeatureModal(@extra.SimulationLabSectionId, @f.SimulationLabFeatureId)"><i class="fas fa-pen"></i></button>
                          <button type="button" class="sl-del-mini" title="Delete" onclick="deleteExFeature(@f.SimulationLabFeatureId)"><i class="fas fa-trash"></i></button>
                      </span>
                  }
                </div>
              }
              @if (isAdmin && editMode)
              {
                  <button type="button" class="sl-add-feature-btn" onclick="openExFeatureModal(@extra.SimulationLabSectionId, null)"><i class="fas fa-plus"></i> Add Feature</button>
              }
            </div>

            <!-- Optional sidebar-style info card (heading + bullet list + highlight box).
                 Entirely opt-in: if the admin never adds one, nothing renders here at all. -->
            @{
                var exCard  = extra.SimulationLabInfoCard;
                var exItems = exCard?.SimulationLabInfoItems.OrderBy(i => i.DisplayOrder).ToList() ?? new List<NAU_Web.Models.SimulationLabInfoItem>();
            }
            @if (exCard != null)
            {
                <div class="info-card reveal" style="max-width:340px;margin-top:20px;">
                  <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px;">
                    <h3 style="flex:1;">@exCard.Heading</h3>
                    @if (isAdmin && editMode)
                    {
                        <span style="display:flex;gap:6px;flex-shrink:0;">
                            <button type="button" class="sl-edit-btn" style="position:static;" title="Edit Heading" onclick="openExInfoCardModal(@extra.SimulationLabSectionId)"><i class="fas fa-pen"></i></button>
                            <button type="button" class="sl-delete-btn" style="position:static;" title="Delete Card" onclick="deleteExInfoCard(@exCard.SimulationLabInfoCardId)"><i class="fas fa-trash"></i></button>
                        </span>
                    }
                  </div>
                  @if (exItems.Any() || (isAdmin && editMode))
                  {
                      <ul class="info-list">
                        @foreach (var item in exItems)
                        {
                          <li>
                            <span class="li-dot" style="background:@(item.ColorHex ?? exColorA);"></span>
                            @item.Text
                            @if (isAdmin && editMode)
                            {
                                <span style="display:inline-flex;gap:4px;margin-left:8px;">
                                    <button type="button" class="sl-edit-mini" title="Edit" onclick="openExInfoItemModal(@exCard.SimulationLabInfoCardId, @item.SimulationLabInfoItemId)"><i class="fas fa-pen"></i></button>
                                    <button type="button" class="sl-del-mini" title="Delete" onclick="deleteExInfoItem(@item.SimulationLabInfoItemId)"><i class="fas fa-trash"></i></button>
                                </span>
                            }
                          </li>
                        }
                      </ul>
                      @if (isAdmin && editMode)
                      {
                          <button type="button" class="sl-add-feature-btn" style="margin-bottom:12px;" onclick="openExInfoItemModal(@exCard.SimulationLabInfoCardId, null)"><i class="fas fa-plus"></i> Add Item</button>
                      }
                  }
                  @if (!string.IsNullOrEmpty(exCard.HighlightText))
                  {
                      <div class="highlight-box @exCard.HighlightColor"><i class="@(exCard.HighlightIcon ?? "fas fa-star")"></i> @exCard.HighlightText</div>
                  }
                </div>
            }
            else if (isAdmin && editMode)
            {
                <div class="reveal" style="margin-top:20px;">
                  <button type="button" class="sl-add-tile-btn" style="max-width:340px;" onclick="openExInfoCardModal(@extra.SimulationLabSectionId)"><i class="fas fa-plus"></i> Add Info Card</button>
                </div>
            }

            @if (isAdmin && editMode && !extra.IsAvailable)
            {
                <div class="reveal" style="margin-top:12px;">
                  <span class="ph-badge" style="position:static;display:inline-block;background:#c0392b;">Hidden — visible to admins only. Use Sections admin panel to publish.</span>
                </div>
            }

          </div>
        </section>
        <hr class="section-rule">
    }
}


.feat-chip {
  background: #fff;
  border: 1.5px solid var(--border);
  border-radius: 8px;
  padding: 10px 16px;
  display: flex;
  align-items: center;
  gap: 9px;
  font-size: 13px;
  font-weight: 600;
  color: var(--navy);
  font-family: var(--font-head);
  box-shadow: 0 2px 8px rgba(0,0,0,.05);
}

.feat-chip i { font-size: 14px; }

.feat-chip.blue i   { color: var(--flight-a); }

.feat-chip.purple i { color: var(--atc-a); }

.feat-chip.amber i  { color: var(--avionics-a); }

.section-rule {
  border: none;
  border-top: 1px solid var(--border);
  margin: 0 60px;
}

.page-footer, footer {
  background: var(--navy, #0b2c4d);
  color: rgba(255,255,255,.85);
  margin-top: auto;
  margin-bottom: 0;
}

.page-footer a { color: #4ade80; text-decoration: none; font-weight: 600; }

.reveal {
  opacity: 0;
  transform: translateY(28px);
  transition: opacity .65s ease, transform .65s ease;
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

@@media(max-width:900px){
  .grid-3        { grid-template-columns: 1fr 1fr; }
  .grid-2-info   { grid-template-columns: 1fr 1fr; }
  .grid-2-info .info-card { grid-column: 1 / -1; }
  .grid-mosaic-info { grid-template-columns: 1fr; }
  .sl-mosaic.cols-3 { grid-template-columns: 1fr 1fr; }
  .sl-mosaic.cols-3 > *:nth-last-child(2):nth-child(3n+1) { grid-column: auto; }
  .page-hero h1  { font-size: 32px; }
  .lab-section   { padding: 60px 24px; }
  .page-hero     { padding: 60px 24px; }
  .announcement  { padding: 8px 24px; }
  .navbar        { padding: 0 24px; }
  .section-rule  { margin: 0 24px; }
}

@@media(max-width:600px){
  .grid-3        { grid-template-columns: 1fr; }
  .grid-1-2      { grid-template-columns: 1fr; }
  .grid-1-2 .span-col .img-placeholder { height: 260px; min-height: 260px; }
  .sl-mosaic     { --mosaic-h: 260px; --mosaic-grow-row: 140px; }
  .hero-quick-links { flex-direction: column; align-items: center; }
  .sec-header    { flex-direction: column; }
}

/* ===== Section 1 inline admin editing (Flight Simulators only) ===== */
.sl-edit-banner{
  background:#0b2c4d; color:#fff; text-align:center;
  padding:10px 16px; font-size:13px; font-family:"Poppins",sans-serif;
}
.sl-edit-banner a{ color:#4ed47a; font-weight:600; text-decoration:none; margin-left:10px; }
.sl-edit-banner a:hover{ text-decoration:underline; }

/* Small pencil / trash icon buttons overlaid on section header, images and
   feature chips -- same visual language as News & Media's np-edit-btn /
   np-delete-btn / np-card-actions. */
.sl-header-edit-btn{
  position:absolute; top:0; right:0; width:34px; height:34px; border-radius:50%;
  background:rgba(255,255,255,0.92); color:#0b6dbf; border:1.5px solid #d5dce6;
  display:flex; align-items:center; justify-content:center; cursor:pointer;
  font-size:13px; transition:background .2s,color .2s; box-shadow:0 3px 10px rgba(0,0,0,.1);
}
.sl-header-edit-btn:hover{ background:#0b6dbf; color:#fff; }

.sl-header-delete-btn{
  position:absolute; top:0; right:42px; width:34px; height:34px; border-radius:50%;
  background:rgba(255,255,255,0.92); color:#c0392b; border:1.5px solid #d5dce6;
  display:flex; align-items:center; justify-content:center; cursor:pointer;
  font-size:13px; transition:background .2s,color .2s; box-shadow:0 3px 10px rgba(0,0,0,.1);
}
.sl-header-delete-btn:hover{ background:#c0392b; color:#fff; }

.sl-card-actions{ position:absolute; top:10px; right:10px; z-index:2; display:flex; gap:6px; }
.sl-edit-btn, .sl-delete-btn{
  width:32px; height:32px; border-radius:50%; border:none; cursor:pointer;
  display:flex; align-items:center; justify-content:center; font-size:13px;
  box-shadow:0 3px 10px rgba(0,0,0,.18);
}
.sl-edit-btn{ background:rgba(255,255,255,0.92); color:#0b6dbf; }
.sl-edit-btn:hover{ background:#0b6dbf; color:#fff; }
.sl-delete-btn{ background:rgba(255,255,255,0.92); color:#c0392b; }
.sl-delete-btn:hover{ background:#c0392b; color:#fff; }
.sl-delete-btn:disabled{ opacity:.5; cursor:default; }

.sl-add-tile-btn{
  border:2px dashed #b9c4d6; border-radius:12px; background:#fff; min-height:110px;
  width:100%; display:flex; align-items:center; justify-content:center; gap:8px;
  color:var(--flight-a); font-weight:600; font-size:13px; cursor:pointer;
  font-family:"Poppins",sans-serif;
}
.sl-add-tile-btn:hover{ background:#f5f9ff; }

.feat-chip.sl-editable{ position:relative; }
.feat-chip-actions{ display:inline-flex; gap:4px; margin-left:10px; }
.feat-chip-actions button{
  width:20px; height:20px; border:none; border-radius:50%; cursor:pointer;
  font-size:9px; display:inline-flex; align-items:center; justify-content:center;
}
.feat-chip-actions .sl-edit-mini{ background:#e7f1ff; color:#0b6dbf; }
.feat-chip-actions .sl-edit-mini:hover{ background:#0b6dbf; color:#fff; }
.feat-chip-actions .sl-del-mini{ background:#fdeaea; color:#c0392b; }
.feat-chip-actions .sl-del-mini:hover{ background:#c0392b; color:#fff; }

.sl-add-feature-btn{
  background:#fff; border:1.5px dashed var(--flight-a); border-radius:8px;
  padding:10px 16px; display:inline-flex; align-items:center; gap:6px;
  font-size:13px; font-weight:600; color:var(--flight-a); cursor:pointer;
  font-family:"Poppins",sans-serif;
}
.sl-add-feature-btn:hover{ background:#f5f9ff; }

/* Modal (mirrors News & Media's np-modal-backdrop / np-modal pattern) */
.sl-modal-backdrop{
  display:none; position:fixed; inset:0; background:rgba(11,44,77,.55);
  z-index:100000; align-items:center; justify-content:center; padding:20px;
}
.sl-modal-backdrop.open{ display:flex; }
.sl-modal{
  background:#fff; border-radius:12px; width:100%; max-width:480px;
  max-height:90vh; overflow-y:auto; box-shadow:0 20px 60px rgba(0,0,0,.3);
  font-family:"Poppins",sans-serif;
}
.sl-modal-header{
  display:flex; align-items:center; justify-content:space-between;
  padding:18px 22px; border-bottom:1px solid #eef1f6;
}
.sl-modal-header h3{ font-family:"Montserrat",sans-serif; font-size:16px; font-weight:700; color:#0b2c4d; }
.sl-modal-close{ background:none; border:none; font-size:16px; cursor:pointer; color:#667; }
.sl-modal-body{ padding:22px; }
.sl-field{ margin-bottom:14px; }
.sl-field label{ display:block; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.5px; color:#0b2c4d; margin-bottom:5px; }
.sl-field input[type=text], .sl-field textarea{
  width:100%; border:1px solid #d5dce6; border-radius:6px; padding:9px 12px; font-size:13px;
  font-family:"Poppins",sans-serif;
}
.sl-field textarea{ min-height:70px; resize:vertical; }
.sl-error{ color:#c0392b; font-size:11.5px; margin-top:4px; display:none; }
.sl-modal-actions{ display:flex; gap:10px; margin-top:6px; }
.sl-btn-primary, .sl-btn-secondary{
  flex:1; padding:10px; border-radius:6px; border:none; font-weight:700; font-size:13px; cursor:pointer;
}
.sl-btn-primary{ background:var(--flight-a); color:#fff; }
.sl-btn-primary:hover{ background:#0a58ca; }
.sl-btn-secondary{ background:#f0f4f8; color:#0b2c4d; border:1.5px solid #dde2ea; }
.sl-btn-secondary:hover{ background:#e4ecf4; }
.sl-photo-preview{
  width:100%; height:120px; border-radius:8px; margin-top:8px; background:#f0f4f8;
  display:flex; align-items:center; justify-content:center; font-size:28px; color:#aab6c6;
  background-size:cover; background-position:center;
}

/* Toast (mirrors News & Media's showNpToast) */
.sl-toast{
  position:fixed; bottom:26px; left:50%; transform:translateX(-50%) translateY(20px);
  background:#0b2c4d; color:#fff; padding:12px 22px; border-radius:8px; font-size:13.5px;
  font-family:"Poppins",sans-serif; box-shadow:0 10px 30px rgba(0,0,0,.25);
  opacity:0; pointer-events:none; transition:opacity .25s, transform .25s; z-index:100001;
}
.sl-toast.show{ opacity:1; transform:translateX(-50%) translateY(0); }
.sl-toast.error{ background:#c0392b; }
    </style>
</head>
<body>

@if (editMode)
{
    <div class="sl-edit-banner">
        <i class="fas fa-lock"></i> You are viewing this page in <strong>Admin Edit Mode</strong> (Flight Simulators section).
        <a href="/SimulationLabs/Public">Exit to normal view</a>
        <a href="/Admin" style="margin-left:14px;"><i class="fas fa-user-shield"></i> Admin Panel</a>
    </div>
}

<partial name="_SiteHeader" />

<!-- HERO -->
<section class="page-hero">
  <div class="hero-bg-pattern"></div>
  <div class="hero-deco"></div>
  <div class="page-hero-inner">
    <div class="hero-breadcrumb">
      <a href="/">Home</a>
      <i class="fas fa-chevron-right"></i>
      <a href="/">Training</a>
      <i class="fas fa-chevron-right"></i>
      <span style="color:rgba(255,255,255,0.85)">Simulation &amp; Labs</span>
    </div>
    <div class="page-hero-eyebrow">Training</div>
    <h1>Simulation &amp; <em>Labs</em></h1>
    <p>World-class simulation facilities and hands-on laboratories designed to prepare aviation professionals for real-world operations.</p>
    <div class="hero-quick-links">
      <a href="#flight-simulators" class="hero-ql"><i class="fas fa-plane"></i> Flight Simulators</a>
      <a href="#atc-simulator"     class="hero-ql"><i class="fas fa-tower-broadcast"></i> ATC Simulator</a>
      <a href="#avionics-lab"      class="hero-ql"><i class="fas fa-microchip"></i> Avionics Lab</a>
    </div>
  </div>
</section>


<!-- ════════════════════════════════════════
     SECTION 1 — FLIGHT SIMULATORS (DB-driven, editable)
════════════════════════════════════════ -->
<section class="lab-section" id="flight-simulators">
  <div class="lab-inner">

@{
    var largeImg   = Model.SimulationLabImages.FirstOrDefault(i => i.IsLarge);
    var smallImgs  = Model.SimulationLabImages.Where(i => !i.IsLarge).OrderBy(i => i.DisplayOrder).ToList();
    var features   = Model.SimulationLabFeatures.OrderBy(f => f.DisplayOrder).ToList();
    var smallColTileCount = smallImgs.Count + (editMode ? 1 : 0);
    var smallColClass = smallColTileCount > 4 ? "sl-mosaic sl-grow" : "sl-mosaic";
}

    <div class="sec-header reveal" style="position:relative;">
      <div class="sec-icon-wrap flight"><i class="@(Model.IconClass ?? "fas fa-plane")"></i></div>
      <div class="sec-header-text">
        <div class="sec-tag flight">@Model.Tag</div>
        <h2>@Model.Title</h2>
        <p>@Model.Description</p>
      </div>
      @if (editMode)
      {
          <button type="button" class="sl-header-edit-btn" title="Edit Section Info" onclick="openSectionInfoModal()"><i class="fas fa-pen"></i></button>
      }
    </div>

    <!-- Image grid: 1 large + any number of small images -->
    <div class="grid-1-2 reveal">
      <div class="span-col">
        <div class="img-placeholder ph-flight-1" style="min-height:360px;@(!string.IsNullOrEmpty(largeImg?.ImageUrl) ? $"background-image:url('{largeImg.ImageUrl}');background-size:cover;background-position:center;" : "")">
          @if (string.IsNullOrEmpty(largeImg?.ImageUrl))
          {
            <div class="ph-icon"><i class="@(largeImg?.IconClass ?? "fas fa-plane")"></i></div>
          }
          <div class="ph-title">@(largeImg?.Title ?? "Full Flight Simulator (FFS)")</div>
          @if (!string.IsNullOrEmpty(largeImg?.Badge))
          {
            <div class="ph-badge">@largeImg.Badge</div>
          }
          @if (editMode)
          {
              <div class="sl-card-actions">
                  <button type="button" class="sl-edit-btn" title="Edit" onclick="event.stopPropagation(); openImageModal(@(largeImg?.SimulationLabImageId ?? 0), true)"><i class="fas fa-pen"></i></button>
                  @if (largeImg != null)
                  {
                      <button type="button" class="sl-delete-btn" title="Delete" onclick="event.stopPropagation(); deleteImage(@largeImg.SimulationLabImageId)"><i class="fas fa-trash"></i></button>
                  }
              </div>
          }
        </div>
      </div>

      <div class="@smallColClass">
        @foreach (var img in smallImgs)
        {
          <div class="img-placeholder ph-flight-2" style="@(!string.IsNullOrEmpty(img.ImageUrl) ? $"background-image:url('{img.ImageUrl}');background-size:cover;background-position:center;" : "")">
            @if (string.IsNullOrEmpty(img.ImageUrl))
            {
              <div class="ph-icon" style="width:52px;height:52px;font-size:22px;"><i class="@(img.IconClass ?? "fas fa-circle")"></i></div>
            }
            <div class="ph-title" style="font-size:14px;">@img.Title</div>
            @if (editMode)
            {
                <div class="sl-card-actions">
                    <button type="button" class="sl-edit-btn" title="Edit" onclick="event.stopPropagation(); openImageModal(@img.SimulationLabImageId, false)"><i class="fas fa-pen"></i></button>
                    <button type="button" class="sl-delete-btn" title="Delete" onclick="event.stopPropagation(); deleteImage(@img.SimulationLabImageId)"><i class="fas fa-trash"></i></button>
                </div>
            }
          </div>
        }
        @if (editMode)
        {
            <button type="button" class="sl-add-tile-btn" onclick="openImageModal(null, false)"><i class="fas fa-plus"></i> Add Image</button>
        }
      </div>
    </div>

    <div class="feature-strip reveal">
      @foreach (var f in features)
      {
        <div class="feat-chip blue@(editMode ? " sl-editable" : "")">
          <i class="@(f.IconClass ?? "fas fa-check-circle")"></i> @f.Label
          @if (editMode)
          {
              <span class="feat-chip-actions">
                  <button type="button" class="sl-edit-mini" title="Edit" onclick="openFeatureModal(@f.SimulationLabFeatureId)"><i class="fas fa-pen"></i></button>
                  <button type="button" class="sl-del-mini" title="Delete" onclick="deleteFeature(@f.SimulationLabFeatureId)"><i class="fas fa-trash"></i></button>
              </span>
          }
        </div>
      }
      @if (editMode)
      {
          <button type="button" class="sl-add-feature-btn" onclick="openFeatureModal(null)"><i class="fas fa-plus"></i> Add Feature</button>
      }
    </div>

  </div>
</section>

@if (editMode)
{
    <div class="sl-modal-backdrop" id="slSectionModal">
        <div class="sl-modal">
            <div class="sl-modal-header">
                <h3>Edit Section Info</h3>
                <button type="button" class="sl-modal-close" onclick="closeSectionInfoModal()"><i class="fas fa-times"></i></button>
            </div>
            <div class="sl-modal-body">
                <div class="sl-field"><label>Tag</label><input type="text" id="slTag" placeholder="e.g. Simulation &amp; Labs — 01"></div>
                <div class="sl-field"><label>Title</label><input type="text" id="slTitle" placeholder="Title"></div>
                <div class="sl-field"><label>Icon (Font Awesome class)</label><input type="text" id="slIconClass" placeholder="e.g. fas fa-plane"></div>
                <div class="sl-field"><label>Description</label><textarea id="slDescription" placeholder="Description"></textarea></div>
                <div class="sl-error" id="slSectionError"></div>
                <div class="sl-modal-actions">
                    <button type="button" class="sl-btn-primary" id="slSectionSaveBtn" onclick="saveSectionInfo(this)"><i class="fas fa-save"></i> Save</button>
                    <button type="button" class="sl-btn-secondary" onclick="closeSectionInfoModal()">Cancel</button>
                </div>
            </div>
        </div>
    </div>

    <div class="sl-modal-backdrop" id="slImageModal">
        <div class="sl-modal">
            <div class="sl-modal-header">
                <h3 id="slImageModalTitle">Edit Image</h3>
                <button type="button" class="sl-modal-close" onclick="closeImageModal()"><i class="fas fa-times"></i></button>
            </div>
            <div class="sl-modal-body">
                <div class="sl-field"><label>Title</label><input type="text" id="slImgTitle" placeholder="Tile title"></div>
                <div class="sl-field" id="slImgBadgeField"><label>Badge (large tile only)</label><input type="text" id="slImgBadge" placeholder="e.g. Level D Certified"></div>
                <div class="sl-field"><label>Icon (fallback, Font Awesome class)</label><input type="text" id="slImgIcon" placeholder="e.g. fas fa-plane"></div>
                <div class="sl-field">
                    <label>Photo</label>
                    <input type="file" id="slImgFile" accept="image/png,image/jpeg,image/gif,image/webp" onchange="handleSectionImageFileChange(this)">
                    <div class="sl-photo-preview" id="slImgPreview"><i class="fas fa-image"></i></div>
                    <input type="hidden" id="slImgUrl">
                </div>
                <div class="sl-error" id="slImageError"></div>
                <div class="sl-modal-actions">
                    <button type="button" class="sl-btn-primary" id="slImageSaveBtn" onclick="saveSectionImage(this)"><i class="fas fa-save"></i> Save</button>
                    <button type="button" class="sl-btn-secondary" onclick="closeImageModal()">Cancel</button>
                </div>
            </div>
        </div>
    </div>

    <div class="sl-modal-backdrop" id="slFeatureModal">
        <div class="sl-modal">
            <div class="sl-modal-header">
                <h3 id="slFeatureModalTitle">Edit Feature</h3>
                <button type="button" class="sl-modal-close" onclick="closeFeatureModal()"><i class="fas fa-times"></i></button>
            </div>
            <div class="sl-modal-body">
                <div class="sl-field"><label>Label</label><input type="text" id="slFeatureLabel" placeholder="e.g. CAA Certified"></div>
                <div class="sl-field"><label>Icon (Font Awesome class)</label><input type="text" id="slFeatureIcon" placeholder="e.g. fas fa-check-circle"></div>
                <div class="sl-error" id="slFeatureError"></div>
                <div class="sl-modal-actions">
                    <button type="button" class="sl-btn-primary" id="slFeatureSaveBtn" onclick="saveFeature(this)"><i class="fas fa-save"></i> Save</button>
                    <button type="button" class="sl-btn-secondary" onclick="closeFeatureModal()">Cancel</button>
                </div>
            </div>
        </div>
    </div>

    <div class="sl-toast" id="slToast"></div>

    @Html.AntiForgeryToken()
}

<hr class="section-rule">


<!-- ════════════════════════════════════════
     SECTION 2 — ATC SIMULATOR (DB-driven, editable)
════════════════════════════════════════ -->
<section class="lab-section" id="atc-simulator">
  <div class="lab-inner">

@{
    var atcSection  = (NAU_Web.Models.SimulationLabSection)ViewBag.AtcSection;
    var atcSmall    = atcSection.SimulationLabImages.Where(i => !i.IsLarge).OrderBy(i => i.DisplayOrder).ToList();
    var atcWide     = atcSection.SimulationLabImages.FirstOrDefault(i => i.IsLarge);
    var atcFeatures = atcSection.SimulationLabFeatures.OrderBy(f => f.DisplayOrder).ToList();
    var atcMosaicTileCount = atcSmall.Count + (editMode ? 1 : 0);
    var atcMosaicClass = atcMosaicTileCount > 4 ? "sl-mosaic sl-grow" : "sl-mosaic";
    var atcCard  = atcSection.SimulationLabInfoCard;
    var atcItems = atcCard?.SimulationLabInfoItems.OrderBy(i => i.DisplayOrder).ToList() ?? new List<NAU_Web.Models.SimulationLabInfoItem>();
    var atcShowInfoSlot = atcCard != null || editMode;
}

    <div class="sec-header reveal" style="position:relative;">
      <div class="sec-icon-wrap atc"><i class="@(atcSection.IconClass ?? "fas fa-tower-broadcast")"></i></div>
      <div class="sec-header-text">
        <div class="sec-tag atc">@atcSection.Tag</div>
        <h2>@atcSection.Title</h2>
        <p>@atcSection.Description</p>
      </div>
      @if (editMode)
      {
          <button type="button" class="sl-header-edit-btn" title="Edit Section Info" onclick="openAtcSectionInfoModal()"><i class="fas fa-pen"></i></button>
      }
    </div>

    <!-- Image mosaic (any number of tiles) + info sidebar -->
    <div class="grid-mosaic-info reveal">
      <div class="@atcMosaicClass" style="--mosaic-h:360px;--mosaic-grow-row:170px;@(!atcShowInfoSlot ? "grid-column:1/-1;" : "")">
        @foreach (var img in atcSmall)
        {
          <div class="img-placeholder ph-atc-1" style="@(!string.IsNullOrEmpty(img.ImageUrl) ? $"background-image:url('{img.ImageUrl}');background-size:cover;background-position:center;" : "")">
            @if (string.IsNullOrEmpty(img.ImageUrl))
            {
              <div class="ph-icon"><i class="@(img.IconClass ?? "fas fa-circle-dot")" style="font-size:26px;"></i></div>
            }
            <div class="ph-title">@Html.Raw((img.Title ?? "").Replace(" — ", "<br>"))</div>
            @if (!string.IsNullOrEmpty(img.Badge))
            {
              <div class="ph-badge">@img.Badge</div>
            }
            @if (editMode)
            {
                <div class="sl-card-actions">
                    <button type="button" class="sl-edit-btn" title="Edit" onclick="event.stopPropagation(); openAtcImageModal(@img.SimulationLabImageId, false)"><i class="fas fa-pen"></i></button>
                    <button type="button" class="sl-delete-btn" title="Delete" onclick="event.stopPropagation(); deleteAtcImage(@img.SimulationLabImageId)"><i class="fas fa-trash"></i></button>
                </div>
            }
          </div>
        }
        @if (editMode)
        {
            <button type="button" class="sl-add-tile-btn" onclick="openAtcImageModal(null, false)"><i class="fas fa-plus"></i> Add Image</button>
        }
      </div>

      @if (atcCard != null)
      {
        <!-- Info sidebar -->
        <div class="info-card">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px;">
            <h3 style="flex:1;">@atcCard.Heading</h3>
            @if (editMode)
            {
                <span style="display:flex;gap:6px;flex-shrink:0;">
                    <button type="button" class="sl-edit-btn" style="position:static;" title="Edit Heading" onclick="openAtcInfoCardModal()"><i class="fas fa-pen"></i></button>
                    <button type="button" class="sl-delete-btn" style="position:static;" title="Delete Card" onclick="deleteAtcInfoCard()"><i class="fas fa-trash"></i></button>
                </span>
            }
          </div>
          @if (atcItems.Any() || editMode)
          {
              <ul class="info-list">
                @foreach (var item in atcItems)
                {
                  <li>
                    <span class="li-dot" style="background:@(item.ColorHex ?? "var(--atc-a)");"></span>
                    @item.Text
                    @if (editMode)
                    {
                        <span style="display:inline-flex;gap:4px;margin-left:8px;">

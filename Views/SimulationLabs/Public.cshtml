    function updateAvImagePreview(url, icon){
      var p = document.getElementById('avImgPreview');
      if (url){ p.style.backgroundImage = "url('" + url + "')"; p.innerHTML = ''; }
      else { p.style.backgroundImage = ''; p.innerHTML = '<i class="' + (icon || 'fas fa-image') + '"></i>'; }
    }

    function openAvImageModal(imageId, isLarge){
      avCurrentImageId = imageId || null;
      avCurrentImageIsLarge = !!isLarge;
      var f = function(id){ return document.getElementById(id); };
      f('avImageError').style.display = 'none';

    <style>
:root {
  --primary: #0b2c4d;
  --green: #1e8e3e;
  --bg: #f5f7fb;
  --white: #fff;
  --shadow: 0 6px 20px rgba(0,0,0,0.08);
  --navy: #0d2c54;
  --gold: #f5a623;
  --text: #333;
  --text-light: #666;
  --border: #e0e0e0;
  --bg-light: #f7f9fc;
  --font-head: "Montserrat", sans-serif;

  
  --flight-a:  #0d6efd;
  --flight-b:  #4ea8ff;
  --atc-a:     #7c3aed;
  --atc-b:     #c084fc;
  --avionics-a:#d97706;
  --avionics-b:#fcd34d;

  --text-lt:   #64748b;
  --font-body: "Open Sans", sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box;font-family:"Poppins",sans-serif;}
html {
  background: var(--navy, #0b2c4d);
  scroll-behavior: smooth;
  margin: 0;
  padding: 0;
}
body {
  background: var(--bg, #f5f7fb);
  margin: 0;
  padding: 0;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* .announcement / .scroll / .account-dropdown / .apply-btn now come from
   the single shared file wwwroot/css/public-site.css (linked above), so
   this page always matches the rest of the site automatically. */
.navbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:0 48px;
  background:white;
  box-shadow:0 2px 12px rgba(0,0,0,0.07);
  position:sticky;
  top:0;
  z-index:1000;
  height:68px;
}

.logo{display:flex;align-items:center;gap:10px;text-decoration:none;}

.logo img{width:60px;height:auto;}

.logo span{font-size:30px;font-weight:700;color:var(--primary);white-space:nowrap;}

.logo-tagline{font-size:10px;font-weight:600;color:#0073ff;letter-spacing:3px;text-transform:uppercase;margin-top:1px;white-space:nowrap;}

.menu{
  display:flex;
  align-items:stretch;
  height:100%;
  gap:0;
}

.menu-item{
  position:static;
  display:flex;
  align-items:center;
}

.menu-item > .nav-link{
  display:flex;
  align-items:center;
  gap:5px;
  padding:0 14px;
  height:100%;
  text-decoration:none;
  color:#333;
  font-size:13.5px;
  font-weight:500;
  white-space:nowrap;
  position:relative;
  transition:color .2s;
  cursor:pointer;
  border:none;
  background:none;
  font-family:"Poppins",sans-serif;
}

.menu-item > .nav-link::after{
  content:"";
  position:absolute;
  bottom:0;
  left:14px;
  right:14px;
  height:3px;
  background:var(--green);
  transform:scaleX(0);
  transition:transform .25s;
  border-radius:2px 2px 0 0;
}

.menu-item:hover > .nav-link,
.menu-item > .nav-link:hover{
  color:var(--primary);
}

.menu-item:hover > .nav-link::after{
  transform:scaleX(1);
}

.nav-link .chevron{
  font-size:10px;
  opacity:.6;
  transition:transform .25s;
}

.menu-item:hover > .nav-link .chevron{

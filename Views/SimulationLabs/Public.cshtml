<!-- ════════════════════════════════════════
    SECTION 3 — AVIONICS LAB (DB-driven, editable)
════════════════════════════════════════ -->
<section class="lab-section" id="avionics-lab">
  <div class="lab-inner">

@{
    var avSection  = (NAU_Web.Models.SimulationLabSection)ViewBag.AvionicsSection;
    var avSmall    = avSection.SimulationLabImages.Where(i => !i.IsLarge).OrderBy(i => i.DisplayOrder).ToList();
    var avWide     = avSection.SimulationLabImages.FirstOrDefault(i => i.IsLarge);
    var avFeatures = avSection.SimulationLabFeatures.OrderBy(f => f.DisplayOrder).ToList();
    var avMosaicTileCount = avSmall.Count + (editMode ? 1 : 0);
    var avMosaicClass = avMosaicTileCount > 3 ? "sl-mosaic sl-grow cols-3" : "sl-mosaic cols-3";
    var avCard  = avSection.SimulationLabInfoCard;
    var avItems = avCard?.SimulationLabInfoItems.OrderBy(i => i.DisplayOrder).ToList() ?? new List<NAU_Web.Models.SimulationLabInfoItem>();
    var avShowInfoSlot = avCard != null || editMode;
}

    <div class="sec-header reveal" style="position:relative;">
      <div class="sec-icon-wrap avionics"><i class="@(avSection.IconClass ?? "fas fa-microchip")"></i></div>
      <div class="sec-header-text">
        <div class="sec-tag avionics">@avSection.Tag</div>
        <h2>@avSection.Title</h2>
        <p>@avSection.Description</p>
      </div>
      @if (editMode)
      {
          <button type="button" class="sl-header-edit-btn" title="Edit Section Info" onclick="openAvSectionInfoModal()"><i class="fas fa-pen"></i></button>
      }
    </div>

    <!-- Image mosaic (any number of tiles) -->
    <div class="@avMosaicClass reveal" style="--mosaic-h:260px;--mosaic-grow-row:150px;">
      @foreach (var img in avSmall)
      {
        <div class="img-placeholder ph-av-1" style="@(!string.IsNullOrEmpty(img.ImageUrl) ? $"background-image:url('{img.ImageUrl}');background-size:cover;background-position:center;" : "")">
          @if (string.IsNullOrEmpty(img.ImageUrl))
          {
            <div class="ph-icon"><i class="@(img.IconClass ?? "fas fa-circle")"></i></div>
          }
          <div class="ph-title">@Html.Raw((img.Title ?? "").Replace(" — ", "<br>"))</div>
          @if (!string.IsNullOrEmpty(img.Badge))
          {
            <div class="ph-badge">@img.Badge</div>
          }
          @if (editMode)
          {
              <div class="sl-card-actions">
                  <button type="button" class="sl-edit-btn" title="Edit" onclick="event.stopPropagation(); openAvImageModal(@img.SimulationLabImageId, false)"><i class="fas fa-pen"></i></button>
                  <button type="button" class="sl-delete-btn" title="Delete" onclick="event.stopPropagation(); deleteAvImage(@img.SimulationLabImageId)"><i class="fas fa-trash"></i></button>
              </div>
          }
        </div>
      }
      @if (editMode)
      {
          <button type="button" class="sl-add-tile-btn" onclick="openAvImageModal(null, false)"><i class="fas fa-plus"></i> Add Image</button>
      }
    </div>

    <div style="display:grid;grid-template-columns:1fr 300px;gap:20px;margin-top:20px;@(!avShowInfoSlot ? "grid-template-columns:1fr;" : "")" class="reveal">
      <div>
        <div class="img-placeholder ph-av-1" style="min-height:180px;background:linear-gradient(135deg,#006064,#00838f,#4dd0e1);position:relative;@(!string.IsNullOrEmpty(avWide?.ImageUrl) ? $"background-image:url('{avWide.ImageUrl}');background-size:cover;background-position:center;" : "")">
          @if (string.IsNullOrEmpty(avWide?.ImageUrl))
          {
            <div class="ph-icon"><i class="@(avWide?.IconClass ?? "fas fa-tools")"></i></div>
          }
          <div class="ph-title">@(avWide?.Title ?? "Avionics Maintenance Workstation")</div>
          @if (!string.IsNullOrEmpty(avWide?.Badge))
          {
            <div class="ph-badge">@avWide.Badge</div>
          }
          @if (editMode)
          {
              <div class="sl-card-actions">
                  <button type="button" class="sl-edit-btn" title="Edit" onclick="event.stopPropagation(); openAvImageModal(@(avWide?.SimulationLabImageId ?? 0), true)"><i class="fas fa-pen"></i></button>
                  @if (avWide != null)
                  {
                      <button type="button" class="sl-delete-btn" title="Delete" onclick="event.stopPropagation(); deleteAvImage(@avWide.SimulationLabImageId)"><i class="fas fa-trash"></i></button>
                  }
              </div>
          }
        </div>
      </div>
      @if (avCard != null)
      {
        <div class="info-card" style="align-self:stretch;">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px;">
            <h3 style="flex:1;">@avCard.Heading</h3>
            @if (editMode)
            {
                <span style="display:flex;gap:6px;flex-shrink:0;">
                    <button type="button" class="sl-edit-btn" style="position:static;" title="Edit Heading" onclick="openAvInfoCardModal()"><i class="fas fa-pen"></i></button>
                    <button type="button" class="sl-delete-btn" style="position:static;" title="Delete Card" onclick="deleteAvInfoCard()"><i class="fas fa-trash"></i></button>
                </span>
            }
          </div>
          @if (avItems.Any() || editMode)
          {
              <ul class="info-list">
                @foreach (var item in avItems)
                {
                  <li>
                    <span class="li-dot" style="background:@(item.ColorHex ?? "var(--avionics-a)");"></span>
                    @item.Text
                    @if (editMode)
                    {
                        <span style="display:inline-flex;gap:4px;margin-left:8px;">
                            <button type="button" class="sl-edit-mini" title="Edit" onclick="openAvInfoItemModal(@item.SimulationLabInfoItemId)"><i class="fas fa-pen"></i></button>
                            <button type="button" class="sl-del-mini" title="Delete" onclick="deleteAvInfoItem(@item.SimulationLabInfoItemId)"><i class="fas fa-trash"></i></button>
                        </span>
                    }
                  </li>
                }
              </ul>
              @if (editMode)
              {
                  <button type="button" class="sl-add-feature-btn" style="margin-bottom:12px;" onclick="openAvInfoItemModal(null)"><i class="fas fa-plus"></i> Add Item</button>
              }
          }
          @if (!string.IsNullOrEmpty(avCard.HighlightText))
          {
              <div class="highlight-box @(avCard.HighlightColor ?? "amber")"><i class="@(avCard.HighlightIcon ?? "fas fa-tools")"></i> @avCard.HighlightText</div>
          }
        </div>
      }
      else if (editMode)
      {
        <div class="info-card" style="align-self:stretch;display:flex;align-items:center;justify-content:center;min-height:200px;">
          <button type="button" class="sl-add-tile-btn" onclick="openAvInfoCardModal()"><i class="fas fa-plus"></i> Add Info Card</button>
        </div>
      }
    </div>

    <div class="feature-strip reveal">
      @foreach (var f in avFeatures)
      {
        <div class="feat-chip amber@(editMode ? " sl-editable" : "")">
          <i class="@(f.IconClass ?? "fas fa-check-circle")"></i> @f.Label
          @if (editMode)
          {
              <span class="feat-chip-actions">
                  <button type="button" class="sl-edit-mini" title="Edit" onclick="openAvFeatureModal(@f.SimulationLabFeatureId)"><i class="fas fa-pen"></i></button>
                  <button type="button" class="sl-del-mini" title="Delete" onclick="deleteAvFeature(@f.SimulationLabFeatureId)"><i class="fas fa-trash"></i></button>
              </span>
          }
        </div>
      }
      @if (editMode)
      {
          <button type="button" class="sl-add-feature-btn" onclick="openAvFeatureModal(null)"><i class="fas fa-plus"></i> Add Feature</button>
      }
    </div>

  </div>
</section>


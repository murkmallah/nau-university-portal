@model NAU_Web.Models.SimulationLabSection
@{
    Layout = null;
    bool isSuperAdmin = User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin");
    bool isAdmin = User.Identity != null && User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Staff"));
    bool canEdit = ViewBag.IsAdmin == true;
    bool editMode = ViewBag.EditMode == true;
    // Section 1 (Flight Simulators) is DB-driven and editable inline by
    // admins via ?edit=true. Sections 2 & 3 (ATC Simulator, Avionics Lab)
    // stay static for now.
}

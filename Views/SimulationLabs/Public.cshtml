<!-- FOOTER -->
<partial name="_SiteFooter" />


<script>
// ── Scroll-reveal ──────────────────────────────────────────────
const revealEls = document.querySelectorAll('.reveal');
const observer = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      e.target.classList.add('visible');
      observer.unobserve(e.target);
    }
  });
}, { threshold: 0.1 });
revealEls.forEach(el => observer.observe(el));

// ── Active jump-nav highlight on scroll ───────────────────────
const sections = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    new[] { "flight-simulators", "atc-simulator", "avionics-lab" }
    .Concat((ViewBag.ExtraSections as List<NAU_Web.Models.SimulationLabSection>)?.Select(s => s.SectionKey) ?? Enumerable.Empty<string>())
    .ToArray()));
const jumpBtns = document.querySelectorAll('.jump-btn');

function setActive() {
  let current = '';
  sections.forEach(id => {
    const el = document.getElementById(id);
    if (el && window.scrollY >= el.offsetTop - 120) current = id;
  });
  jumpBtns.forEach(btn => {
    btn.classList.toggle('active', btn.dataset.section === current);
  });
}
window.addEventListener('scroll', setActive, { passive: true });
setActive();
</script>

@if (editMode)
{
    <script>
    /* ===== Section 1 (Flight Simulators): Admin inline add/edit/delete =====
       Same convention as News & Media's Quick* JS: fetch() with a JSON body
       and the anti-forgery token header, a toast for feedback, then one
       page reload to show the fresh data -- no full-page form posts. */
    var slSectionId = @Model.SimulationLabSectionId;

    var slImagesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.SimulationLabImages.ToDictionary(i => i.SimulationLabImageId.ToString(), i => new
        {
            id = i.SimulationLabImageId,
            title = i.Title ?? "",
            badge = i.Badge ?? "",
            iconClass = i.IconClass ?? "",
            imageUrl = i.ImageUrl ?? ""
        })
    ).Replace("</", "<\\/"));

    var slFeaturesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.SimulationLabFeatures.ToDictionary(f => f.SimulationLabFeatureId.ToString(), f => new
        {
            id = f.SimulationLabFeatureId,
            label = f.Label,
            iconClass = f.IconClass ?? ""
        })
    ).Replace("</", "<\\/"));

    function slGetToken(){
      var el = document.querySelector('input[name="__RequestVerificationToken"]');
      return el ? el.value : '';
    }

    function showSlToast(message, isError){
      var t = document.getElementById('slToast');
      t.textContent = message;
      t.classList.toggle('error', !!isError);
      t.classList.add('show');
      setTimeout(function(){ t.classList.remove('show'); }, 2600);
    }

    /* ---- Section Info ---- */
    function openSectionInfoModal(){
      document.getElementById('slTag').value = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Tag ?? ""));
      document.getElementById('slTitle').value = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Title ?? ""));
      var ic = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.IconClass ?? ""));
      document.getElementById('slIconClass').value = ic;
      var icPrev = document.getElementById('slIconClassPreview');
      if (icPrev) icPrev.innerHTML = '<i class="' + (ic || 'fas fa-plane') + '"></i>';
      document.getElementById('slDescription').value = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Description ?? ""));
      document.getElementById('slSectionError').style.display = 'none';
      document.getElementById('slSectionModal').classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeSectionInfoModal(){
      document.getElementById('slSectionModal').classList.remove('open');
      document.body.style.overflow = '';
    }
    async function saveSectionInfo(btn){
      var f = function(id){ return document.getElementById(id); };
      var title = f('slTitle').value.trim();
      var err = f('slSectionError');
      err.style.display = 'none';
      if (!title){ err.textContent = 'Title is required.'; err.style.display = 'block'; return; }

      var payload = {
        SectionId: slSectionId,
        Tag: f('slTag').value.trim(),
        Title: title,
        IconClass: f('slIconClass').value.trim(),
        Description: f('slDescription').value.trim()
      };

      btn.disabled = true;
      var originalText = btn.innerHTML;
      btn.innerHTML = 'Saving...';

      try {
        var res = await fetch('@Url.Action("QuickUpdateSectionInfo", "SimulationLabs")', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': slGetToken() },
          body: JSON.stringify(payload)
        });
        var data = await res.json();
        if (!res.ok || !data.success){
          err.textContent = data.message || 'Could not save.';
          err.style.display = 'block';
          btn.disabled = false; btn.innerHTML = originalText;
          return;
        }
        showSlToast('\u2705 Section info saved.');
        setTimeout(function(){ window.location.reload(); }, 700);
      } catch (e){
        err.textContent = 'Network error, please try again.';
        err.style.display = 'block';
        btn.disabled = false; btn.innerHTML = originalText;
      }
    }

    /* ---- Images (large tile + small tiles) ---- */
    var slCurrentImageId = null;
    var slCurrentImageIsLarge = false;

    function updateSlImagePreview(url, icon){
      var p = document.getElementById('slImgPreview');
      if (url){ p.style.backgroundImage = "url('" + url + "')"; p.innerHTML = ''; }
      else { p.style.backgroundImage = ''; p.innerHTML = '<i class="' + (icon || 'fas fa-image') + '"></i>'; }
    }

    function openImageModal(imageId, isLarge){
      slCurrentImageId = imageId || null;
      slCurrentImageIsLarge = !!isLarge;
      var f = function(id){ return document.getElementById(id); };
      f('slImageError').style.display = 'none';
      f('slImgFile').value = '';
      f('slImgBadgeField').style.display = slCurrentImageIsLarge ? 'block' : 'none';

      var imgIconPrev = document.getElementById('slImgIconPreview');

      if (slCurrentImageId && slImagesData[slCurrentImageId]){
        var d = slImagesData[slCurrentImageId];
        document.getElementById('slImageModalTitle').textContent = 'Edit Image';
        f('slImgTitle').value = d.title || '';
        f('slImgBadge').value = d.badge || '';
        f('slImgIcon').value = d.iconClass || '';
        f('slImgUrl').value = d.imageUrl || '';
        if (imgIconPrev) imgIconPrev.innerHTML = '<i class="' + (d.iconClass || 'fas fa-plane') + '"></i>';
        updateSlImagePreview(d.imageUrl, d.iconClass);
      } else {
        document.getElementById('slImageModalTitle').textContent = slCurrentImageIsLarge ? 'Edit Large Image' : 'Add Image';
        f('slImgTitle').value = ''; f('slImgBadge').value = ''; f('slImgIcon').value = ''; f('slImgUrl').value = '';
        if (imgIconPrev) imgIconPrev.innerHTML = '<i class="fas fa-plane"></i>';
        updateSlImagePreview('', 'fas fa-image');
      }

      document.getElementById('slImageModal').classList.add('open');
      document.body.style.overflow = 'hidden';
      f('slImgTitle').focus();
    }
    function closeImageModal(){
      document.getElementById('slImageModal').classList.remove('open');
      document.body.style.overflow = '';
      slCurrentImageId = null;
    }
    async function handleSectionImageFileChange(input){
      var file = input.files && input.files[0];
      if (!file) return;
      var err = document.getElementById('slImageError');
      err.style.display = 'none';
      var preview = document.getElementById('slImgPreview');
      preview.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

      var formData = new FormData();
      formData.append('file', file);

      try {
        var res = await fetch('@Url.Action("UploadSectionImage", "SimulationLabs")', {
          method: 'POST',
          headers: { 'RequestVerificationToken': slGetToken() },
          body: formData
        });
        var data = await res.json();
        if (!res.ok || !data.success){
          err.textContent = data.message || 'Could not upload the image.';

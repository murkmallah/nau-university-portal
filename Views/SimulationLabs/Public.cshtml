.grid-3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.grid-1-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: start;
  gap: 20px;
}

/* Fixed-size hero tile -- no longer stretches to match the right
   column's height, so adding more small images never makes this one
   grow. */
.grid-1-2 .span-col .img-placeholder { height: 380px; min-height: 380px; }

/* Reusable dynamic mosaic grid for "1 fixed tile + any number of small
   tiles" layouts (Section 1's hero+small-images, Section 2 & 3's
   top-image lists). By default it fills exactly a reference height
   (set per-usage via the --mosaic-h custom property) and divides that
   space evenly between however many tiles exist -- adding one shrinks
   all of them to fit, deleting one grows the rest to fill the gap, so
   nothing is ever left empty. */
.sl-mosaic {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  height: var(--mosaic-h, 380px);
  grid-auto-rows: 1fr;
  align-content: stretch;
}

/* Once there are more tiles than comfortably fit a 2x2 grid (5+ tiles,
   counting "Add Image"), stop shrinking every tile to squeeze into the
   reference height and instead grow downward with a fixed, readable
   row height (set via --mosaic-grow-row) -- same idea as the hero
   tile: never shrink content into unreadable slivers just because more
   photos were added. */
.sl-mosaic.sl-grow {
  height: auto;
  grid-auto-rows: var(--mosaic-grow-row, 170px);
  align-content: start;
}

.sl-mosaic .img-placeholder {
  height: 100%;
  min-height: 0;
}

/* If the tile count (photos + the "Add Image" tile) is odd, the very
   last tile spans both columns instead of sitting alone next to an
   empty cell -- so 1 photo, 3 photos, 5 photos, etc. always fill the
   row completely, whether adding or deleting. (Only for the default
   2-column mosaic -- the 3-column variant below has its own rules.) */
.sl-mosaic:not(.cols-3) > *:last-child:nth-child(odd) {
  grid-column: 1 / -1;
}

/* 3-column variant (Section 3's top-image mosaic, which was always a
   3-across design) -- same idea, but filling an incomplete last row of
   1 or 2 tiles instead of always 2 columns. */
.sl-mosaic.cols-3 {
  grid-template-columns: repeat(3, 1fr);
}
/* Exactly 1 tile left over in the last row -> it spans all 3 columns. */
.sl-mosaic.cols-3 > *:last-child:nth-child(3n+1) {
  grid-column: 1 / -1;
}
/* Exactly 2 tiles left over -> the first of the two spans 2 columns,
   the last stays 1 column, so together they fill the row. */
.sl-mosaic.cols-3 > *:nth-last-child(2):nth-child(3n+1) {
  grid-column: span 2;
}

.sl-mosaic .sl-add-tile-btn {
  min-height: 60px;
}

/* Section 2 & 3: mosaic sits beside a fixed-width sidebar or above a
   wide tile -- align-items:start keeps the mosaic's own height (driven
   by --mosaic-h / --mosaic-grow-row above) from being stretched to
   match its neighbour. */
.grid-mosaic-info {
  display: grid;
  grid-template-columns: 1fr 320px;
  align-items: start;
  gap: 20px;
}

.grid-2-info {

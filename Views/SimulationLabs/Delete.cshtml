@model NAU_Web.Models.SimulationLabSection

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete Section</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Simulation Lab Section</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Model.Title</dd>

        <dt class="col-sm-2">Section Key</dt>
        <dd class="col-sm-10">@Model.SectionKey</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="SimulationLabSectionId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>

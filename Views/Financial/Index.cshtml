@model NAU_Web.Models.FinancialPageContent
@{
    Layout = null;
    bool isAdmin  = User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin");
    bool editMode = ViewBag.EditMode == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Financial Information &mdash; National Aviation University</title>
<partial name="_Favicon" />

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Open+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<link rel="stylesheet" href="~/css/public-site.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/courses-page.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/financial-page.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/mobile-nav.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/public-modals.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/cms-icon-picker.css" asp-append-version="true">

<script>
    window.NAU_AUTH = {
        isAuthenticated: @Html.Raw(User.Identity != null && User.Identity.IsAuthenticated ? "true" : "false"),
        isAdmin: @Html.Raw(isAdmin ? "true" : "false"),
        userName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)ViewBag.CurrentUserName ?? ""))
    };
</script>

<style>
  /* .announcement / .scroll / .account-dropdown / .apply-btn now come from
     the single shared file wwwroot/css/public-site.css (linked above), so
     this page always matches the rest of the site automatically. */

  /* Inline Admin Controls (Schools & SimLabs Pattern) */
  .fin-admin-btn {
    border: none; border-radius: 6px; padding: 6px 12px; font-size: 12px; font-weight: 600;
    cursor: pointer; display: inline-flex; align-items: center; gap: 6px; transition: all .2s;
  }
  .fin-admin-add { background: var(--green); color: #fff; }
  .fin-admin-add:hover { background: #166f30; }
  .fin-admin-edit { background: #eef4f9; color: #1a5fa6; }
  .fin-admin-edit:hover { background: #1a5fa6; color: #fff; }
  .fin-admin-delete { background: #fde8e8; color: #c0392b; }
  .fin-admin-delete:hover { background: #c0392b; color: #fff; }

  /* Modal Backdrop */
  .fin-modal-backdrop {
    display: none; position: fixed; inset: 0; z-index: 10000;
    background: rgba(8,20,40,.75); align-items: center; justify-content: center;
  }
  .fin-modal-backdrop.open { display: flex; }
  .fin-modal {
    background: #fff; border-radius: 14px; width: 90%; max-width: 520px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.3); overflow: hidden; animation: popIn .2s ease;
  }
  @@keyframes popIn { from { transform: scale(0.9); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  .fin-modal-head {
    background: var(--primary); color: #fff; padding: 16px 20px;
    display: flex; justify-content: space-between; align-items: center;
    font-family: "Montserrat", sans-serif; font-weight: 700; font-size: 16px;
  }
  .fin-modal-close { background: none; border: none; color: #fff; font-size: 18px; cursor: pointer; }
  .fin-modal-body { padding: 20px; }
  .fin-field { margin-bottom: 14px; }
  .fin-field label { display: block; font-size: 12.5px; font-weight: 600; color: #444; margin-bottom: 5px; }
  .fin-field input, .fin-field select, .fin-field textarea {
    width: 100%; padding: 9px 12px; border: 1.5px solid #dde2ec; border-radius: 8px;
    font-family: "Poppins", sans-serif; font-size: 13px; outline: none; transition: border-color .2s;
  }
  .fin-field input:focus, .fin-field select:focus, .fin-field textarea:focus { border-color: var(--green); }
  .fin-modal-foot { padding: 14px 20px; background: #f8fafc; border-top: 1px solid #eef2f6; display: flex; justify-content: flex-end; gap: 10px; }
</style>
</head>
<body>

@if (editMode)
{
    <div style="background:#0b2c4d;color:#fff;text-align:center;padding:10px 20px;font-family:'Poppins',sans-serif;font-size:13.5px;font-weight:600;">
        <i class="fas fa-lock"></i> You are viewing this page in <strong>Admin Edit Mode</strong>.
        <a href="/Financial" style="color:#7ec8ff;margin-left:8px;text-decoration:none;">Exit to normal view</a>
        <a href="/Admin" style="color:#7ec8ff;margin-left:14px;text-decoration:none;"><i class="fas fa-user-shield"></i> Admin Panel</a>
    </div>
}

<partial name="_SiteHeader" />

<!-- PAGE HERO -->
<div class="page-hero">
  <div class="page-hero-inner">
    <div class="page-hero-eyebrow">Admissions &mdash; Financial</div>
    <h1>Financial Information</h1>
    <p>Everything you need to know about tuition fees, scholarship opportunities, and accepted payment methods at National Aviation University.</p>
  </div>
</div>

<!-- SECTION NAV -->
<nav class="sec-nav" id="secNav">
  <div class="sec-nav-inner">
    <a href="#fee-structure" class="sec-nav-link active" onclick="setActive(this)"><i class="fas fa-coins"></i> Fee Structure</a>
    <a href="#scholarships" class="sec-nav-link" onclick="setActive(this)"><i class="fas fa-hand-holding-usd"></i> Scholarships</a>
    <a href="#payment-methods" class="sec-nav-link" onclick="setActive(this)"><i class="fas fa-receipt"></i> Payment Methods</a>
  </div>
</nav>

<!-- MAIN CONTENT -->
<main class="fin-main">

  <!-- ========== FEE STRUCTURE ========== -->
  <section class="fin-section" id="fee-structure">
    <div class="fin-section-header">
      <div class="fin-section-label"><i class="fas fa-coins"></i> @(string.IsNullOrWhiteSpace(Model.FeeSectionLabel) ? "FEE STRUCTURE" : Model.FeeSectionLabel)</div>
      <h2>@(string.IsNullOrWhiteSpace(Model.FeeSectionTitle) ? "Tuition & Other Fees" : Model.FeeSectionTitle)</h2>
      <div class="fin-divider"></div>
      <p>@(string.IsNullOrWhiteSpace(Model.FeeSectionDesc) ? "Fees are charged per semester. Amounts shown are for the 2026 academic year and subject to revision annually. All amounts are in Pakistani Rupees (PKR)." : Model.FeeSectionDesc)</p>
    </div>

    <div class="fin-notice">
      <i class="fas fa-info-circle"></i>
      <div>@Model.FeeNoticeText</div>
    </div>

    @if (editMode)
    {
        <div style="margin-bottom:14px; text-align:right; display:flex; justify-content:flex-end; gap:8px;">
            <button type="button" class="fin-admin-btn fin-admin-edit" onclick="openFeeHeaderModal()">
                <i class="fas fa-pen"></i> Edit Section Headings &amp; Notice
            </button>
            <button type="button" class="fin-admin-btn fin-admin-edit" onclick="openProgramTabsModal()">
                <i class="fas fa-tags"></i> Edit Program Tabs
            </button>
        </div>
    }

    <!-- Program Tabs -->
    <div class="fee-tabs">
      <button class="fee-tab active" onclick="switchFeeTab(this,'be')">@Model.GetTabLabel("be")</button>
      <button class="fee-tab" onclick="switchFeeTab(this,'bs')">@Model.GetTabLabel("bs")</button>
      <button class="fee-tab" onclick="switchFeeTab(this,'mba')">@Model.GetTabLabel("mba")</button>
      <button class="fee-tab" onclick="switchFeeTab(this,'short')">@Model.GetTabLabel("short")</button>
    </div>

    @foreach (var cat in new[] { "be", "bs", "mba", "short" })
    {
        var items = Model.FeeItems.Where(i => i.Category == cat).OrderBy(i => i.DisplayOrder).ToList();
        var cards = Model.FeeCards.Where(c => c.Category == cat).ToList();

        var regItem = items.FirstOrDefault(i => i.Component.Contains("Registration", StringComparison.OrdinalIgnoreCase) || i.Frequency.Contains("One-Time", StringComparison.OrdinalIgnoreCase));
        var subItem = items.FirstOrDefault(i => i.IsSubtotal || i.Component.Contains("Semester Total", StringComparison.OrdinalIgnoreCase));

        <div id="feeTab-@cat" class="fee-tab-content @(cat == "be" ? "active" : "")">
          @if (editMode)
          {
              <div style="margin-bottom:14px; text-align:right;">
                  <button type="button" class="fin-admin-btn fin-admin-add" onclick="openFeeItemModal('', '@cat')">
                      <i class="fas fa-plus"></i> Add Fee Component (@Model.GetTabLabel(cat))
                  </button>
              </div>
          }
          <div class="fee-table-wrap">
            <table class="fee-table">
              <thead>
                <tr>
                  <th>Fee Component</th>
                  <th>Amount (PKR)</th>
                  <th>Frequency</th>
                  <th>Note</th>
                  @if (editMode) { <th width="80">Actions</th> }
                </tr>
              </thead>
              <tbody>
                @foreach (var item in items)
                {
                    <tr class="@(item.IsTotal ? "fee-total" : item.IsSubtotal ? "fee-subtotal" : "")">
                      <td class="fee-label">@item.Component</td>
                      <td class="fee-amount">@item.Amount</td>
                      <td>@item.Frequency</td>
                      <td class="fee-note">@item.Note</td>
                      @if (editMode)
                      {
                          <td>
                              <button type="button" class="fin-admin-btn fin-admin-edit" title="Edit" onclick="openFeeItemModal('@item.Id', '@item.Category', '@item.Component', '@item.Amount', '@item.Frequency', '@item.Note', @(item.IsSubtotal ? "true":"false"), @(item.IsTotal ? "true":"false"))">
                                  <i class="fas fa-pen"></i>
                              </button>
                              <button type="button" class="fin-admin-btn fin-admin-delete" title="Delete" onclick="deleteFeeItem('@item.Id')">
                                  <i class="fas fa-trash"></i>
                              </button>
                          </td>
                      }
                    </tr>
                }
              </tbody>
            </table>
          </div>

          @if (cards.Any())
          {
              <div class="fee-cards">
                @foreach (var card in cards)
                {
                    string cardAmt = card.Amount;
                    if (card.Title.Contains("Registration", StringComparison.OrdinalIgnoreCase) && regItem != null)
                    {
                        cardAmt = regItem.Amount.StartsWith("PKR", StringComparison.OrdinalIgnoreCase) ? regItem.Amount : "PKR " + regItem.Amount;
                    }
                    else if (card.Title.Equals("Per Semester", StringComparison.OrdinalIgnoreCase) && subItem != null)
                    {
                        cardAmt = subItem.Amount.StartsWith("PKR", StringComparison.OrdinalIgnoreCase) ? subItem.Amount : "PKR " + subItem.Amount;
                    }
                    else if (card.Title.Equals("Annual Cost", StringComparison.OrdinalIgnoreCase) && subItem != null)
                    {
                        var digits = new string(subItem.Amount.Where(char.IsDigit).ToArray());
                        if (long.TryParse(digits, out long val))
                        {
                            cardAmt = $"PKR {val * 2:N0}";
                        }
                    }

                    <div class="fee-card" style="position:relative;">
                      @if (editMode)
                      {
                          <div style="position:absolute; top:8px; right:8px; z-index:5;">
                              <button type="button" class="fin-admin-btn fin-admin-edit" style="padding:3px 7px; font-size:11px;" title="Edit Card" onclick="openFeeCardModal('@card.Id', '@card.Category', '@card.Title', '@cardAmt', '@card.Period', '@card.Note')">
                                  <i class="fas fa-pen"></i> Edit
                              </button>
                          </div>
                      }
                      <div class="fee-card-icon" style="background:@card.BgColor; color:@card.TextColor;"><i class="@card.IconClass"></i></div>
                      <div class="fee-card-title">@card.Title</div>
                      <div class="fee-card-amount">@cardAmt</div>
                      <div class="fee-card-period">@card.Period</div>
                      <div class="fee-card-note">@card.Note</div>
                    </div>
                }
              </div>
          }
        </div>
    }
  </section>

  <!-- ========== SCHOLARSHIPS ========== -->
  <section class="fin-section" id="scholarships">
    <div class="fin-section-header">
      <div class="fin-section-label"><i class="fas fa-hand-holding-usd"></i> @(string.IsNullOrWhiteSpace(Model.ScholarshipSectionLabel) ? "SCHOLARSHIPS" : Model.ScholarshipSectionLabel)</div>
      <h2>@(string.IsNullOrWhiteSpace(Model.ScholarshipSectionTitle) ? "Financial Aid & Scholarships" : Model.ScholarshipSectionTitle)</h2>
      <div class="fin-divider"></div>
      <p>@(string.IsNullOrWhiteSpace(Model.ScholarshipSectionDesc) ? "NAU offers merit and need-based scholarship programs to ensure that financial constraints do not prevent talented students from pursuing an aviation career." : Model.ScholarshipSectionDesc)</p>
    </div>

    <div class="fin-notice">
      <i class="fas fa-exclamation-triangle"></i>
      <div>@Model.ScholarshipNoticeText</div>
    </div>

    @if (editMode)
    {
        <div style="margin-bottom:20px; text-align:right; display:flex; justify-content:flex-end; gap:8px;">
            <button type="button" class="fin-admin-btn fin-admin-edit" onclick="openScholarshipHeaderModal()">
                <i class="fas fa-pen"></i> Edit Section Headings &amp; Notice
            </button>
            <button type="button" class="fin-admin-btn fin-admin-add" onclick="openScholarshipModal('')">
                <i class="fas fa-plus"></i> Add Scholarship Program
            </button>
        </div>
    }

    <div class="scholar-grid">
      @foreach (var sch in Model.Scholarships)
      {
          <div class="scholar-card" style="position:relative;">
            @if (editMode)
            {
                <div style="position:absolute; top:12px; right:12px; z-index:10; display:flex; gap:6px;">
                    <button type="button" class="fin-admin-btn fin-admin-edit" title="Edit" onclick="editScholarshipModal('@sch.Id', '@sch.Title', '@sch.Subtitle', '@sch.Percentage', '@sch.PercentageLabel', '@sch.BadgeText', '@sch.BadgeBg', '@sch.BadgeColor', '@sch.HeaderGradient', '@(string.Join("|", sch.Criteria ?? new List<string>()))')">
                        <i class="fas fa-pen"></i> Edit
                    </button>
                    <button type="button" class="fin-admin-btn fin-admin-delete" title="Delete" onclick="deleteScholarship('@sch.Id')">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            }
            <div class="scholar-card-header" style="background:@sch.HeaderGradient;">
              <div class="scholar-icon" style="background:rgba(255,255,255,0.15);color:#fff;"><i class="fas fa-award"></i></div>
              <div>
                <div class="scholar-title">@sch.Title</div>
                <div class="scholar-subtitle">@sch.Subtitle</div>
              </div>
            </div>
            <div class="scholar-body">
              <div class="scholar-pct" style="color:@sch.BadgeColor;">@sch.Percentage</div>
              <div class="scholar-pct-label">@sch.PercentageLabel</div>
              <ul class="scholar-criteria-list">
                @if (sch.Criteria != null)
                {
                    foreach (var cr in sch.Criteria)
                    {
                        <li><i class="fas fa-check-circle"></i><span>@cr</span></li>
                    }
                }
              </ul>
              @if (!string.IsNullOrEmpty(sch.BadgeText))
              {
                  <div class="scholar-badge" style="background:@sch.BadgeBg; color:@sch.BadgeColor; border-color:@sch.BadgeBg;">
                    <i class="fas fa-star"></i> @sch.BadgeText
                  </div>
              }
            </div>
          </div>
      }
    </div>
  </section>

  <!-- ========== PAYMENT METHODS ========== -->
  <section class="fin-section" id="payment-methods">
    <div class="fin-section-header">
      <div class="fin-section-label"><i class="fas fa-receipt"></i> @(string.IsNullOrWhiteSpace(Model.PaymentSectionLabel) ? "PAYMENT METHODS" : Model.PaymentSectionLabel)</div>
      <h2>@(string.IsNullOrWhiteSpace(Model.PaymentSectionTitle) ? "How to Pay Your Fees" : Model.PaymentSectionTitle)</h2>
      <div class="fin-divider"></div>
      <p>@(string.IsNullOrWhiteSpace(Model.PaymentSectionDesc) ? "NAU accepts fee payments through multiple channels for your convenience. Always keep your payment receipt safe — it is your official proof of payment." : Model.PaymentSectionDesc)</p>
    </div>

    <!-- Accepted Banks -->
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
        <h3 style="font-family:'Montserrat',sans-serif;font-size:16px;font-weight:700;color:var(--primary);margin:0;">
          <i class="fas fa-university" style="color:var(--green);margin-right:8px;"></i>@(string.IsNullOrWhiteSpace(Model.PaymentSubTitle) ? "Accepted Banks & Payment Options" : Model.PaymentSubTitle)
        </h3>
        @if (editMode)
        {
            <div style="display:flex; gap:8px;">
                <button type="button" class="fin-admin-btn fin-admin-edit" onclick="openPaymentHeaderModal()">
                    <i class="fas fa-pen"></i> Edit Section Headings
                </button>
                <button type="button" class="fin-admin-btn fin-admin-add" onclick="openBankModal('')">
                    <i class="fas fa-plus"></i> Add Bank
                </button>
            </div>
        }
    </div>

    <div class="bank-list">
      @foreach (var bank in Model.Banks)
      {
          <div class="bank-item">
            <div class="bank-logo" style="background:@(string.IsNullOrEmpty(bank.LogoUrl) ? bank.LogoBgHex : "transparent");">
              @if (!string.IsNullOrWhiteSpace(bank.LogoUrl))
              {
                  <img src="@bank.LogoUrl" alt="@bank.Name" class="bank-logo-img" onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                  <span class="bank-logo-fallback" style="display:none;background:@bank.LogoBgHex;color:#fff;">@bank.LogoText</span>
              }
              else
              {
                  <span style="color:#fff;">@bank.LogoText</span>
              }
            </div>
            <div class="bank-info">
              <div class="bank-name">@bank.Name</div>
              <div class="bank-detail">@bank.Details</div>
            </div>
            <span class="bank-tag" style="background:@bank.TagBg; color:@bank.TagColor;">@bank.TagText</span>
            @if (editMode)
            {
                <div style="margin-left:14px; display:flex; gap:6px;">
                    <button type="button" class="fin-admin-btn fin-admin-edit" title="Edit" onclick="editBankModal('@bank.Id', '@bank.Name', '@bank.Details', '@bank.TagText', '@bank.TagBg', '@bank.TagColor', '@bank.LogoText', '@bank.LogoBgHex', '@bank.LogoUrl')">
                        <i class="fas fa-pen"></i>
                    </button>
                    <button type="button" class="fin-admin-btn fin-admin-delete" title="Delete" onclick="deleteBank('@bank.Id')">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            }
          </div>
      }
    </div>
  </section>

</main>

<partial name="_SiteFooter" />



<!-- ADMIN EDIT MODALS (Schools & SimLabs Pattern) -->
@if (editMode)
{
    <!-- FEE ITEM MODAL -->
    <div id="feeItemModal" class="fin-modal-backdrop">
      <div class="fin-modal">
        <div class="fin-modal-head">
          <span id="fimTitle">Add Fee Component</span>
          <button type="button" class="fin-modal-close" onclick="closeFeeItemModal()">&times;</button>
        </div>
        <div class="fin-modal-body">
          <input type="hidden" id="fimId" />
          <input type="hidden" id="fimIsSubtotal" value="false" />
          <input type="hidden" id="fimIsTotal" value="false" />
          <div class="fin-field">
            <label>Program Category</label>
            <select id="fimCategory">
              <option value="be">BE Programs</option>
              <option value="bs">BS Programs</option>
              <option value="mba">MBA</option>
              <option value="short">Short Courses</option>
            </select>
          </div>
          <div class="fin-field">
            <label>Component Name</label>
            <input type="text" id="fimComponent" placeholder="e.g. Tuition Fee" />
          </div>
          <div class="fin-field">
            <label>Amount (PKR)</label>
            <input type="text" id="fimAmount" placeholder="e.g. 45,000" />
            <small id="fimAmountHelp" style="color:#1e8e3e;font-size:11px;margin-top:3px;display:block;"></small>
          </div>
          <div class="fin-field">
            <label>Frequency</label>
            <input type="text" id="fimFrequency" placeholder="e.g. Per Semester / One-Time" />
          </div>
          <div class="fin-field">
            <label>Note / Eligibility</label>
            <input type="text" id="fimNote" placeholder="e.g. At time of admission" />
          </div>
        </div>
        <div class="fin-modal-foot">
          <button type="button" class="fin-admin-btn" style="background:#eee;color:#333;" onclick="closeFeeItemModal()">Cancel</button>
          <button type="button" class="fin-admin-btn fin-admin-add" onclick="saveFeeItem()">Save Component</button>
        </div>
      </div>
    </div>

    <!-- SCHOLARSHIP MODAL -->
    <div id="scholarshipModal" class="fin-modal-backdrop">
      <div class="fin-modal">
        <div class="fin-modal-head">
          <span id="smTitle">Add Scholarship Program</span>
          <button type="button" class="fin-modal-close" onclick="closeScholarshipModal()">&times;</button>
        </div>
        <div class="fin-modal-body">
          <input type="hidden" id="smId" />
          <div class="fin-field">
            <label>Scholarship Name</label>
            <input type="text" id="smName" placeholder="e.g. Merit Scholarship" />
          </div>
          <div class="fin-field">
            <label>Subtitle</label>
            <input type="text" id="smSubtitle" placeholder="e.g. Top academic performers" />
          </div>
          <div class="fin-field">
            <label>Percentage / Waiver</label>
            <input type="text" id="smPct" placeholder="e.g. 50% – 100%" />
          </div>
          <div class="fin-field">
            <label>Waiver Label</label>
            <input type="text" id="smPctLabel" placeholder="e.g. Fee waiver on tuition" />
          </div>
          <div class="fin-field">
            <label>Award Badge Text</label>
            <input type="text" id="smBadge" placeholder="e.g. Academic Excellence Award" />
          </div>
          <div class="fin-field">
            <label>Criteria (Separate each point with a pipe '|' character)</label>
            <textarea id="smCriteria" rows="3" placeholder="Minimum 85% marks | Top 3 positions in Entry Test"></textarea>
          </div>
        </div>
        <div class="fin-modal-foot">
          <button type="button" class="fin-admin-btn" style="background:#eee;color:#333;" onclick="closeScholarshipModal()">Cancel</button>
          <button type="button" class="fin-admin-btn fin-admin-add" onclick="saveScholarship()">Save Scholarship</button>
        </div>
      </div>
    </div>

    <!-- BANK MODAL -->
    <div id="bankModal" class="fin-modal-backdrop">
      <div class="fin-modal">
        <div class="fin-modal-head">
          <span id="bmTitle">Add / Edit Accepted Bank</span>
          <button type="button" class="fin-modal-close" onclick="closeBankModal()">&times;</button>
        </div>
        <div class="fin-modal-body">
          <input type="hidden" id="bmId" />
          <div class="fin-field">
            <label>Bank Name</label>
            <input type="text" id="bmName" placeholder="e.g. Habib Bank Limited (HBL)" />
          </div>
          <div class="fin-field">
            <label>Payment Details</label>
            <input type="text" id="bmDetails" placeholder="e.g. Over-the-counter &amp; HBL Mobile app" />
          </div>
          <div class="fin-field">
            <label>Tag Text</label>
            <input type="text" id="bmTag" placeholder="e.g. Primary / Accepted / Mobile" />
          </div>
          <div class="fin-field">
            <label>Real Bank Logo</label>
            <select id="bmLogoPreset" onchange="onBankLogoPresetChange(this.value)">
              <option value="/images/banks/hbl.png">HBL (Habib Bank Limited)</option>
              <option value="/images/banks/nbp.png">NBP (National Bank of Pakistan)</option>
              <option value="/images/banks/mcb.png">MCB Bank Limited</option>
              <option value="/images/banks/ubl.png">UBL (United Bank Limited)</option>

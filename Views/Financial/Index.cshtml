      document.getElementById('fimIsSubtotal').value = isSub ? 'true' : 'false';
      document.getElementById('fimIsTotal').value = isTot ? 'true' : 'false';
      document.getElementById('fimTitle').textContent = id ? 'Edit Fee Component' : 'Add Fee Component';

      const amtHelp = document.getElementById('fimAmountHelp');
      if (amtHelp) {
        if (isSub || isTot) {
          amtHelp.textContent = 'Totals and program estimates are auto-calculated from components upon save.';

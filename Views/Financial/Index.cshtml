    // Section Sub-Nav & ScrollSpy Controller
    function updateActiveSecNav(targetId) {
      if (!targetId) return;
      if (!targetId.startsWith('#')) targetId = '#' + targetId;
      const links = document.querySelectorAll('.sec-nav-link');
      links.forEach(link => {
        const href = link.getAttribute('href');
        if (href === targetId) {
          link.classList.add('active');
        } else {
          link.classList.remove('active');
        }
      });
    }

    function setActive(el) {
      if (!el) return;
      const targetId = el.getAttribute('href');
      if (targetId) updateActiveSecNav(targetId);
    }

    function handleSectionHash() {
      const hash = window.location.hash;
      if (hash && (hash === '#fee-structure' || hash === '#scholarships' || hash === '#payment-methods')) {
        updateActiveSecNav(hash);
      }
    }

    window.addEventListener('DOMContentLoaded', handleSectionHash);
    window.addEventListener('hashchange', handleSectionHash);
    handleSectionHash();

    // ScrollSpy to dynamically highlight the current section in viewport
    (function initFinancialScrollSpy() {
      let scrollTimeout = null;
      window.addEventListener('scroll', function () {
        if (scrollTimeout) return;
        scrollTimeout = setTimeout(function () {
          scrollTimeout = null;
          const sections = [
            document.getElementById('fee-structure'),
            document.getElementById('scholarships'),
            document.getElementById('payment-methods')
          ].filter(Boolean);

          const scrollY = window.pageYOffset || document.documentElement.scrollTop;
          const triggerPos = scrollY + 180;

          let currentId = '';
          for (let i = 0; i < sections.length; i++) {
            const sec = sections[i];
            const top = sec.offsetTop;
            const height = sec.offsetHeight;
            if (triggerPos >= top && triggerPos < top + height) {
              currentId = '#' + sec.id;
              break;
            } else if (triggerPos >= top) {
              currentId = '#' + sec.id;
            }
          }

          if (currentId) {
            updateActiveSecNav(currentId);
          }
        }, 40);
      }, { passive: true });
    })();


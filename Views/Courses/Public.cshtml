      "Facilitated by senior aviation management professionals",
      "Interactive workshops and group activities",
      "Applicable across all aviation departments",
      "Focus on real-world aviation organizational challenges"
    ]
  }
};

function getSchoolDefaults(schoolName) {
  var s = (schoolName || '').toLowerCase();
  if (s.includes('navigation') || s.includes('ans') || s.includes('traffic')) return defaultSchoolInfo.navigation;
  if (s.includes('regulatory') || s.includes('safety') || s.includes('compliance')) return defaultSchoolInfo.regulatory;
  if (s.includes('airport') || s.includes('fire') || s.includes('rescue')) return defaultSchoolInfo.airport;
  if (s.includes('management') || s.includes('business')) return defaultSchoolInfo.management;
  return defaultSchoolInfo.navigation;
}

function splitList(text){
  return (text || '').split(';').map(function(s){ return s.trim(); }).filter(Boolean);
}

function renderCourseModal(data){
  var defaults = getSchoolDefaults(data.schoolName);
  var heroColor = data.schoolColor || '#0b3a5c';

  document.getElementById('cmHero').style.background =
    'linear-gradient(135deg, ' + heroColor + ', ' + heroColor + ')';
  document.getElementById('cmSchool').textContent = data.schoolName || 'School Course';
  document.getElementById('cmTitle').textContent = data.title || 'Course Details';

  var dur = data.duration || '-';
  var start = data.startDate || 'TBD';
  var end = data.endDate || 'TBD';
  var cert = data.certificate || 'NAU Certified';

  document.getElementById('cmMeta').innerHTML =
    '<span class="cm-badge"><i class="fas fa-clock"></i> ' + dur + '</span>' +
    '<span class="cm-badge"><i class="fas fa-calendar"></i> ' + start + ' &ndash; ' + end + '</span>' +
    '<span class="cm-badge"><i class="fas fa-certificate"></i> ' + cert + '</span>';

  document.getElementById('cmDesc').textContent = data.description || defaults.desc;

  document.getElementById('cmInfoGrid').innerHTML =
    '<div class="cm-info-item"><label>Duration</label><span>' + dur + '</span></div>' +
    '<div class="cm-info-item"><label>Start Date</label><span>' + start + '</span></div>' +
    '<div class="cm-info-item"><label>End Date</label><span>' + end + '</span></div>' +
    '<div class="cm-info-item"><label>Certificate</label><span>' + cert + '</span></div>';

  var topicsList = splitList(data.topics);
  if (topicsList.length === 0) topicsList = defaults.topics;
  document.getElementById('cmTopics').innerHTML = topicsList.map(function(t){
    return '<span class="cm-topic-tag">' + t + '</span>';
  }).join('');

  var pointsList = splitList(data.highlights);
  if (pointsList.length === 0) pointsList = defaults.highlights;
  document.getElementById('cmPoints').innerHTML = pointsList.map(function(h){
    return '<li><i class="fas fa-check-circle"></i> ' + h + '</li>';
  }).join('');
}

var currentModalSchoolId = null;
var currentModalAccIdx = null;

function openCourseModal(courseId, startInEditMode){
  var data = courseData[courseId];
  if (!data) return;
  currentModalCourseId = courseId;
  currentModalSchoolId = data.schoolId || null;

  // Highlight the row on the page
  var row = document.querySelector('tr.course-row[data-course-id="' + courseId + '"]');
  if (row) {
    document.querySelectorAll('tr.course-row').forEach(function(r){ r.classList.remove('highlighted-course'); });
    row.classList.add('highlighted-course');
  }

  renderCourseModal(data);

  var viewBody = document.getElementById('cmBodyView');
  var editBody = document.getElementById('cmBodyEdit');
  var saveBtn = document.getElementById('cmBtnSaveCourse');
  if (saveBtn) saveBtn.innerHTML = '<i class="fas fa-save"></i> Save Course';

  if (startInEditMode && editBody){
    if (typeof fillCourseEditForm === 'function') fillCourseEditForm(data);
    if (viewBody) viewBody.style.display = 'none';
    editBody.style.display = 'block';
  } else {
    if (viewBody) viewBody.style.display = 'block';
    if (editBody) editBody.style.display = 'none';
  }
  var err = document.getElementById('cmEditError');
  if (err){ err.style.display = 'none'; }

  document.getElementById('courseModal').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function switchToCourseEditMode(){
  if (currentModalCourseId && currentModalCourseId !== 0) {
    var data = courseData[currentModalCourseId];
    if (data && typeof fillCourseEditForm === 'function') fillCourseEditForm(data);
  }
  var viewBody = document.getElementById('cmBodyView');
  var editBody = document.getElementById('cmBodyEdit');
  if (viewBody) viewBody.style.display = 'none';
  if (editBody) editBody.style.display = 'block';
  var saveBtn = document.getElementById('cmBtnSaveCourse');
  if (saveBtn) {
    saveBtn.innerHTML = (currentModalCourseId === 0) ? '<i class="fas fa-plus"></i> Create & Save Course' : '<i class="fas fa-save"></i> Save Course';
  }
}

function switchToCourseViewMode(){
  if (currentModalCourseId === 0) {
    closeCourseModal();
    return;
  }
  var viewBody = document.getElementById('cmBodyView');
  var editBody = document.getElementById('cmBodyEdit');
  if (viewBody) viewBody.style.display = 'block';
  if (editBody) editBody.style.display = 'none';
}

function openAddCourseModal(accIdx, schoolId, schoolName){
  currentModalCourseId = 0;
  currentModalSchoolId = schoolId;
  currentModalAccIdx = accIdx;

  var defaults = getSchoolDefaults(schoolName);
  var schoolBlock = document.querySelector('.accordion-block[data-school-id="' + schoolId + '"]');
  var schoolColor = schoolBlock ? (schoolBlock.getAttribute('data-school-color') || '#0b3a5c') : '#0b3a5c';

  var draftData = {
    id: 0,
    schoolId: schoolId,
    schoolName: schoolName || 'School',
    schoolColor: schoolColor,
    title: '',
    duration: '01 Week',
    startDate: 'TBD',
    endDate: 'TBD',
    description: defaults.desc,
    topics: defaults.topics.join('; '),
    highlights: defaults.highlights.join('; '),
    certificate: 'NAU Certified'
  };

  renderCourseModal(draftData);
  fillCourseEditForm(draftData);

  var viewBody = document.getElementById('cmBodyView');
  var editBody = document.getElementById('cmBodyEdit');
  if (viewBody) viewBody.style.display = 'none';
  if (editBody) editBody.style.display = 'block';

  var saveBtn = document.getElementById('cmBtnSaveCourse');
  if (saveBtn) saveBtn.innerHTML = '<i class="fas fa-plus"></i> Create & Save Course';

  var err = document.getElementById('cmEditError');
  if (err){ err.style.display = 'none'; }

  document.getElementById('courseModal').classList.add('open');
  document.body.style.overflow = 'hidden';

  var titleInput = document.getElementById('cmEditTitle');
  if (titleInput) {
    titleInput.focus();
  }
}

function closeCourseModal(){
  document.getElementById('courseModal').classList.remove('open');
  document.body.style.overflow = '';
  currentModalCourseId = null;
}

document.addEventListener('keydown', function(e){
  if (e.key === 'Escape') closeCourseModal();
});

/* ===== Clickable Course Rows ===== */
document.addEventListener('DOMContentLoaded', function(){
  document.querySelectorAll('tr.course-row').forEach(function(row){
    row.addEventListener('click', function(e){
      if (e.target.closest('.row-edit-btn, .row-delete-btn, input, button')) return;
      var cid = row.getAttribute('data-course-id');
      if (cid) {
        openCourseModal(cid);
      }
    });
  });
});

/* ===== Deep-linking from Academics nav menu (?school=...&course=...) ===== */
(function(){
  var params = new URLSearchParams(window.location.search);
  var wantedSchool = (params.get('school') || '').trim().toLowerCase();
  var wantedCourse = (params.get('course') || params.get('courseId') || params.get('courseTitle') || '').trim().toLowerCase();

  var hash = window.location.hash ? window.location.hash.replace('#', '').trim() : '';
  if (!wantedCourse && hash.startsWith('course-')) {
    wantedCourse = hash.replace('course-', '');
  }

  var targetSchoolBlock = null;
  if (wantedSchool) {
    var blocks = document.querySelectorAll('.accordion-block');
    blocks.forEach(function(block){
      if (targetSchoolBlock) return;
      var name = (block.getAttribute('data-school-name') || '').toLowerCase();
      if (name.indexOf(wantedSchool) !== -1) {
        targetSchoolBlock = block;
      }
    });
  }

  var targetRow = null;
  if (wantedCourse) {
    document.querySelectorAll('tr.course-row').forEach(function(r){
      if (targetRow) return;
      var cid = (r.getAttribute('data-course-id') || '').toLowerCase();
      var name = (r.querySelector('.row-name') ? r.querySelector('.row-name').textContent : '').toLowerCase();
      if (cid === wantedCourse || name.indexOf(wantedCourse) !== -1 || wantedCourse.indexOf(name) !== -1) {
        targetRow = r;
      }
    });
  }

  if (targetRow) {
    var parentBlock = targetRow.closest('.accordion-block');
    if (parentBlock) {
      parentBlock.classList.add('open');
    }
    document.querySelectorAll('tr.course-row').forEach(function(r){ r.classList.remove('highlighted-course'); });
    targetRow.classList.add('highlighted-course');

    setTimeout(function(){
      targetRow.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }, 150);
  } else if (targetSchoolBlock) {
    targetSchoolBlock.classList.add('open');
    targetSchoolBlock.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
})();

@if (editMode)
{
    <text>
    function getAntiForgeryToken(){
      var el = document.querySelector('input[name="__RequestVerificationToken"]');
      return el ? el.value : '';
    }

    function addCourseRow(accIdx, schoolId){
      var tbody = document.getElementById('acc-tbody-' + accIdx);
      if (!tbody) return;
      if (tbody.querySelector('tr.course-row-new')) return;

      var tr = document.createElement('tr');
      tr.className = 'course-row-new';
      tr.innerHTML =
        '<td class="row-num">+</td>' +
        '<td><input type="text" placeholder="Course title" class="qa-title"></td>' +
        '<td><input type="text" placeholder="e.g. 04 Weeks" class="qa-duration"></td>' +
        '<td><input type="text" placeholder="e.g. 05 Jan 2027 or TBD" class="qa-start"></td>' +
        '<td>' +
          '<input type="text" placeholder="e.g. 10 Feb 2027 or TBD" class="qa-end" style="margin-bottom:6px;">' +
          '<div class="qa-actions">' +
            '<button type="button" class="qa-save" onclick="saveCourseRow(this, ' + accIdx + ', ' + schoolId + ')">Save</button>' +
            '<button type="button" class="qa-cancel" onclick="this.closest(\'tr\').remove()">Cancel</button>' +
          '</div>' +
          '<div class="qa-error" style="display:none;"></div>' +
        '</td>' +
        '<td></td>';
      tbody.appendChild(tr);
      tr.scrollIntoView({ behavior: 'smooth', block: 'center' });
      tr.querySelector('.qa-title').focus();
    }

    async function saveCourseRow(btn, accIdx, schoolId){
      var tr = btn.closest('tr');
      var tbody = tr.closest('tbody');
      var title = tr.querySelector('.qa-title').value.trim();
      var duration = tr.querySelector('.qa-duration').value.trim();
      var start = tr.querySelector('.qa-start').value.trim();
      var end = tr.querySelector('.qa-end').value.trim();
      var errorBox = tr.querySelector('.qa-error');
      errorBox.style.display = 'none';

      if (!title){
        errorBox.textContent = 'Course title is required.';
        errorBox.style.display = 'block';
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Saving...';

      try {
        var res = await fetch('@Url.Action("QuickAdd", "Courses")', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': getAntiForgeryToken()
          },
          body: JSON.stringify({ SchoolId: schoolId, Title: title, Duration: duration, StartDate: start, EndDate: end })
        });
        var data = await res.json();
        if (!res.ok || !data.success){
          errorBox.textContent = data.message || 'Could not save the course.';
          errorBox.style.display = 'block';
          btn.disabled = false;
          btn.textContent = 'Save';
          return;
        }

        var serialNum = tbody.querySelectorAll('tr.course-row').length + 1;

        var schoolEditBtn = document.querySelector('.school-edit-btn[data-school-id="' + schoolId + '"]');
        courseData[data.courseId] = {
          id: data.courseId,
          schoolId: schoolId,
          schoolName: data.schoolName,
          schoolColor: schoolEditBtn ? schoolEditBtn.getAttribute('data-school-color') : '#0b3a5c',
          title: data.title,
          duration: data.duration || '-',
          startDate: data.startDate,
          endDate: data.endDate,
          description: data.description,
          topics: data.topics,
          highlights: data.highlights,
          certificate: data.certificate
        };

        var newTr = document.createElement('tr');
        newTr.className = 'course-row';
        newTr.setAttribute('data-course-id', data.courseId);
        newTr.innerHTML =
          '<td class="row-num">' + serialNum + '</td>' +
          '<td class="row-name"><span class="row-name-inner" onclick="openCourseModal(' + data.courseId + ')">' + data.title + ' <i class="fas fa-chevron-right row-arrow"></i></span></td>' +
          '<td><span class="dur-pill">' + (data.duration || '-') + '</span></td>' +
          '<td class="row-date">' + data.startDate + '</td>' +
          '<td class="row-date">' + data.endDate + '</td>' +
          '<td>' +
            '<button type="button" class="row-edit-btn" title="Edit this course" onclick="openCourseModal(' + data.courseId + ', true)"><i class="fas fa-pen"></i></button>' +
            '<button type="button" class="row-delete-btn" title="Delete this course" onclick="deleteCourseRow(this, ' + data.courseId + ', ' + accIdx + ')"><i class="fas fa-trash"></i></button>' +
          '</td>';
        tr.replaceWith(newTr);

        newTr.addEventListener('click', function(e){
          if (e.target.closest('.row-edit-btn, .row-delete-btn, input, button')) return;
          openCourseModal(data.courseId);
        });

        var countEl = document.getElementById('acc-count-' + accIdx);
        if (countEl){
          var n = parseInt(countEl.textContent, 10) || 0;
          countEl.textContent = (n + 1) + ' Courses';
        }
        var totalEl = document.getElementById('totalCount');
        if (totalEl){
          var t = parseInt(totalEl.textContent, 10) || 0;
          totalEl.textContent = (t + 1) + ' courses';
        }

        showQaToast('✅ "' + data.title + '" saved to the database (course #' + serialNum + ').');
      } catch (err){
        errorBox.textContent = 'Network error, please try again.';
        errorBox.style.display = 'block';
        btn.disabled = false;
        btn.textContent = 'Save';
      }
    }

    async function deleteCourseRow(btn, courseId, accIdx){
      if (!confirm('Delete this course permanently from the database?')) return;

      btn.disabled = true;
      var tr = btn.closest('tr');

      try {
        var res = await fetch('@Url.Action("QuickDelete", "Courses")', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': getAntiForgeryToken()
          },
          body: JSON.stringify({ CourseId: courseId })
        });
        var data = await res.json();
        if (!res.ok || !data.success){
          showQaToast(data.message || 'Could not delete the course.', true);
          btn.disabled = false;
          return;
        }

        var title = tr.querySelector('.row-name') ? tr.querySelector('.row-name').textContent : 'Course';
        tr.remove();

        var countEl = document.getElementById('acc-count-' + accIdx);
        if (countEl){
          var n = parseInt(countEl.textContent, 10) || 0;
          countEl.textContent = Math.max(0, n - 1) + ' Courses';
        }
        var totalEl = document.getElementById('totalCount');
        if (totalEl){
          var t = parseInt(totalEl.textContent, 10) || 0;
          totalEl.textContent = Math.max(0, t - 1) + ' courses';
        }

        var tbody = document.getElementById('acc-tbody-' + accIdx);
        if (tbody){
          var rows = tbody.querySelectorAll('tr.course-row .row-num');
          rows.forEach(function(cell, i){ cell.textContent = (i + 1); });
        }

        showQaToast('🗑️ "' + title + '" removed from the database.');
      } catch (err){
        showQaToast('Network error, please try again.', true);
        btn.disabled = false;
      }
    }

    var qaToastTimer;
    function showQaToast(message, isError){
      var toast = document.getElementById('qaToast');
      if (!toast) return;
      toast.textContent = message;
      toast.className = isError ? 'show error' : 'show';
      clearTimeout(qaToastTimer);
      qaToastTimer = setTimeout(function(){ toast.className = ''; }, 3500);

      if (!isError && typeof window.refreshCalendarData === 'function'){
        window.refreshCalendarData();
      }
    }

    function fillCourseEditForm(data){
      var f = function(id){ return document.getElementById(id); };
      if (!f('cmEditTitle')) return;
      f('cmEditTitle').value = data.title || '';
      f('cmEditDuration').value = (data.duration === '-' ? '' : data.duration) || '';
      f('cmEditStart').value = data.startDate || '';
      f('cmEditEnd').value = data.endDate || '';
      f('cmEditDesc').value = data.description || '';
      f('cmEditTopics').value = data.topics || '';
      f('cmEditHighlights').value = data.highlights || '';
      f('cmEditCertificate').value = data.certificate || '';
    }

    async function saveCourseModal(btn){
      if (currentModalCourseId === null || currentModalCourseId === undefined) return;
      var f = function(id){ return document.getElementById(id) ? document.getElementById(id).value.trim() : ''; };
      var errorBox = document.getElementById('cmEditError');
      var title = f('cmEditTitle');

      if (!title){
        if (errorBox){
          errorBox.textContent = 'Course title is required.';
          errorBox.style.display = 'block';
        }
        return;
      }
      if (errorBox) errorBox.style.display = 'none';
      btn.disabled = true;
      var originalText = btn.innerHTML;
      btn.innerHTML = 'Saving...';

      var isNew = (currentModalCourseId === 0);
      var url = isNew ? '@Url.Action("QuickAdd", "Courses")' : '@Url.Action("QuickUpdateCourse", "Courses")';
      var payload = {
        SchoolId: isNew ? currentModalSchoolId : undefined,
        CourseId: isNew ? undefined : currentModalCourseId,
        Title: title,
        Duration: f('cmEditDuration'),
        StartDate: f('cmEditStart'),
        EndDate: f('cmEditEnd'),
        Description: f('cmEditDesc'),
        Topics: f('cmEditTopics'),
        Highlights: f('cmEditHighlights'),
        Certificate: f('cmEditCertificate')
      };

      try {
        var res = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
          body: JSON.stringify(payload)
        });
        var data = await res.json();
        if (!res.ok || !data.success){
          if (errorBox){
            errorBox.textContent = data.message || 'Could not save the course.';
            errorBox.style.display = 'block';
          }
          btn.disabled = false;
          btn.innerHTML = originalText;
          return;
        }

        if (isNew) {
          currentModalCourseId = data.courseId;
          data.schoolColor = courseData[data.courseId] ? courseData[data.courseId].schoolColor : '#0b3a5c';
          courseData[data.courseId] = data;

          // Add row to table
          var accIdx = currentModalAccIdx !== null ? currentModalAccIdx : 0;
          var tbody = document.getElementById('acc-tbody-' + accIdx);
          if (tbody) {
            var serialNum = tbody.querySelectorAll('tr.course-row').length + 1;
            var tr = document.createElement('tr');
            tr.className = 'course-row';
            tr.setAttribute('data-course-id', data.courseId);
            tr.innerHTML =
              '<td class="row-num">' + serialNum + '</td>' +
              '<td class="row-name">' +
                '<span class="row-name-inner" onclick="openCourseModal(' + data.courseId + ')">' + data.title + ' <i class="fas fa-chevron-right row-arrow"></i></span>' +
              '</td>' +
              '<td><span class="dur-pill">' + (data.duration || '-') + '</span></td>' +
              '<td class="row-date">' + data.startDate + '</td>' +
              '<td class="row-date">' + data.endDate + '</td>' +
              '<td>' +
                '<button type="button" class="row-edit-btn" title="Edit this course" onclick="openCourseModal(' + data.courseId + ', true)"><i class="fas fa-pen"></i></button>' +
                '<button type="button" class="row-delete-btn" title="Delete this course" onclick="deleteCourseRow(this, ' + data.courseId + ', ' + accIdx + ')"><i class="fas fa-trash"></i></button>' +
              '</td>';
            tbody.appendChild(tr);

            // Click handler for newly created row
            tr.addEventListener('click', function(e){
              if (e.target.closest('.row-edit-btn, .row-delete-btn, input, button')) return;
              openCourseModal(data.courseId);
            });
          }

          // Update counters
          var countEl = document.getElementById('acc-count-' + accIdx);
          if (countEl) {
            var n = parseInt(countEl.textContent, 10) || 0;
            countEl.textContent = (n + 1) + ' Courses';
          }
          var totalEl = document.getElementById('totalCount');
          if (totalEl) {
            var t = parseInt(totalEl.textContent, 10) || 0;
            totalEl.textContent = (t + 1) + ' courses';
          }
        } else {
          data.schoolColor = courseData[currentModalCourseId] ? courseData[currentModalCourseId].schoolColor : '#0b3a5c';
          courseData[currentModalCourseId] = data;

          var tr = document.querySelector('tr.course-row[data-course-id="' + currentModalCourseId + '"]');
          if (tr){
            var nameSpan = tr.querySelector('.row-name-inner');
            if (nameSpan) nameSpan.innerHTML = data.title + ' <i class="fas fa-chevron-right row-arrow"></i>';
            var durPill = tr.querySelector('.dur-pill');
            if (durPill) durPill.textContent = data.duration || '-';
            var dateCells = tr.querySelectorAll('.row-date');
            if (dateCells[0]) dateCells[0].textContent = data.startDate;
            if (dateCells[1]) dateCells[1].textContent = data.endDate;
          }
        }

        renderCourseModal(data);
        var viewBody = document.getElementById('cmBodyView');
        var editBody = document.getElementById('cmBodyEdit');
        if (viewBody) viewBody.style.display = 'block';
        if (editBody) editBody.style.display = 'none';
        btn.disabled = false;
        btn.innerHTML = originalText;
        showQaToast('✅ "' + data.title + '" ' + (isNew ? 'created' : 'updated') + ' and saved to the database.');
      } catch (err){
        if (errorBox){
          errorBox.textContent = 'Network error, please try again.';
          errorBox.style.display = 'block';
        }
        btn.disabled = false;
        btn.innerHTML = originalText;
      }
    }

    /* ===== Edit School ===== */
    function editSchoolBlock(btn){
      var wrap = document.getElementById('addSchoolWrap');
      if (wrap) return;

      var schoolId = btn.getAttribute('data-school-id');
      var name = btn.getAttribute('data-school-name');
      var icon = btn.getAttribute('data-school-icon');
      var color = btn.getAttribute('data-school-color');

      var addBtn = document.getElementById('addSchoolBtn');
      wrap = document.createElement('div');
      wrap.id = 'addSchoolWrap';
      wrap.style.cssText = 'max-width:560px;margin:0 auto;background:#eaf2fb;border:1px dashed #cfe0f4;border-radius:12px;padding:20px 22px;text-align:left;';
      wrap.innerHTML =
        '<label style="display:block;font-size:11.5px;font-weight:700;color:#0b2c4d;margin-bottom:4px;">SCHOOL NAME</label>' +
        '<input type="text" id="editSchoolName" style="width:100%;padding:8px 10px;border-radius:6px;border:1px solid #cfe0f4;font-family:\'Poppins\',sans-serif;font-size:13.5px;margin-bottom:10px;">' +
        '<label style="display:block;font-size:11.5px;font-weight:700;color:#0b2c4d;margin-bottom:4px;">ICON (Font Awesome class, optional)</label>' +
        '<input type="text" id="editSchoolIcon" placeholder="e.g. fas fa-plane" style="width:100%;padding:8px 10px;border-radius:6px;border:1px solid #cfe0f4;font-family:\'Poppins\',sans-serif;font-size:13.5px;margin-bottom:10px;">' +
        '<label style="display:block;font-size:11.5px;font-weight:700;color:#0b2c4d;margin-bottom:4px;">COLOR (hex, optional)</label>' +
        '<input type="text" id="editSchoolColor" placeholder="e.g. #0b3a5c" style="width:100%;padding:8px 10px;border-radius:6px;border:1px solid #cfe0f4;font-family:\'Poppins\',sans-serif;font-size:13.5px;margin-bottom:12px;">' +
        '<div class="qa-actions">' +
          '<button type="button" class="qa-save" onclick="saveSchoolEdit(this, ' + schoolId + ')">Save</button>' +
          '<button type="button" class="qa-cancel" onclick="cancelSchoolBlock()">Cancel</button>' +
        '</div>' +
        '<div class="qa-error" id="editSchoolError" style="display:none;"></div>';

      addBtn.parentNode.insertBefore(wrap, addBtn);
      addBtn.style.display = 'none';
      document.getElementById('editSchoolName').value = name || '';
      document.getElementById('editSchoolIcon').value = icon || '';
      document.getElementById('editSchoolColor').value = color || '';
      document.getElementById('editSchoolName').focus();
      wrap.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    async function saveSchoolEdit(btn, schoolId){
      var name = document.getElementById('editSchoolName').value.trim();
      var icon = document.getElementById('editSchoolIcon').value.trim();
      var color = document.getElementById('editSchoolColor').value.trim();
      var errorBox = document.getElementById('editSchoolError');
      errorBox.style.display = 'none';

      if (!name){
        errorBox.textContent = 'School name is required.';
        errorBox.style.display = 'block';
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Saving...';

      try {
        var res = await fetch('@Url.Action("QuickUpdateSchool", "Courses")', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
          body: JSON.stringify({ SchoolId: schoolId, Name: name, Icon: icon, ColorHex: color })
        });
        var data = await res.json();
        if (!res.ok || !data.success){
          errorBox.textContent = data.message || 'Could not save the school.';
          errorBox.style.display = 'block';
          btn.disabled = false;
          btn.textContent = 'Save';
          return;
        }

        var editBtn = document.querySelector('.school-edit-btn[data-school-id="' + schoolId + '"]');
        var delBtn = document.querySelector('.school-delete-btn[data-school-id="' + schoolId + '"]');
        var headerBtn = delBtn ? delBtn.closest('.accordion-block').querySelector('.acc-header') : null;
        if (headerBtn){
          headerBtn.style.background = 'linear-gradient(135deg, ' + data.colorHex + ', ' + data.colorHex + ')';
          headerBtn.querySelector('.acc-school').textContent = data.name;
          headerBtn.querySelector('.acc-icon-wrap i').className = data.icon;
        }
        if (editBtn){
          editBtn.setAttribute('data-school-name', data.name);
          editBtn.setAttribute('data-school-icon', data.icon);
          editBtn.setAttribute('data-school-color', data.colorHex);
        }
        if (delBtn) delBtn.setAttribute('data-school-name', data.name);

        Object.keys(courseData).forEach(function(id){
          if (courseData[id].schoolId == schoolId){
            courseData[id].schoolName = data.name;
            courseData[id].schoolColor = data.colorHex;
          }
        });

        cancelSchoolBlock();
        showQaToast('✅ School updated and saved to the database.');
      } catch (err){
        errorBox.textContent = 'Network error, please try again.';
        errorBox.style.display = 'block';
        btn.disabled = false;
        btn.textContent = 'Save';
      }
    }

    async function deleteSchoolBlock(btn){
      var schoolId = btn.getAttribute('data-school-id');
      var schoolName = btn.getAttribute('data-school-name') || 'this school';
      if (!confirm('Delete "' + schoolName + '" permanently from the database?')) return;

      btn.disabled = true;
      var block = btn.closest('.accordion-block');

      try {
        var res = await fetch('@Url.Action("QuickDeleteSchool", "Courses")', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
          body: JSON.stringify({ SchoolId: schoolId })
        });
        var data = await res.json();
        if (!res.ok || !data.success){
          showQaToast(data.message || 'Could not delete the school.', true);
          btn.disabled = false;
          return;
        }

        if (block) block.remove();
        showQaToast('🗑️ "' + schoolName + '" removed from the database.');
      } catch (err){
        showQaToast('Network error, please try again.', true);
        btn.disabled = false;
      }
    }

    /* ===== Add School (new accordion block) ===== */
    function addSchoolBlock(){
      var wrap = document.getElementById('addSchoolWrap');
      if (wrap) return;

      var addBtn = document.getElementById('addSchoolBtn');
      wrap = document.createElement('div');
      wrap.id = 'addSchoolWrap';
      wrap.style.cssText = 'max-width:560px;margin:0 auto;background:#f0faf4;border:1px dashed #cfe8d8;border-radius:12px;padding:20px 22px;text-align:left;';
      wrap.innerHTML =
        '<label style="display:block;font-size:11.5px;font-weight:700;color:#0b2c4d;margin-bottom:4px;">SCHOOL NAME</label>' +
        '<input type="text" id="newSchoolName" placeholder="e.g. School of Cabin Crew Training" style="width:100%;padding:8px 10px;border-radius:6px;border:1px solid #cfe8d8;font-family:\'Poppins\',sans-serif;font-size:13.5px;margin-bottom:10px;">' +
        '<label style="display:block;font-size:11.5px;font-weight:700;color:#0b2c4d;margin-bottom:4px;">ICON (Font Awesome class, optional)</label>' +
        '<input type="text" id="newSchoolIcon" placeholder="e.g. fas fa-plane" style="width:100%;padding:8px 10px;border-radius:6px;border:1px solid #cfe8d8;font-family:\'Poppins\',sans-serif;font-size:13.5px;margin-bottom:10px;">' +
        '<label style="display:block;font-size:11.5px;font-weight:700;color:#0b2c4d;margin-bottom:4px;">COLOR (hex, optional)</label>' +
        '<input type="text" id="newSchoolColor" placeholder="e.g. #0b3a5c" style="width:100%;padding:8px 10px;border-radius:6px;border:1px solid #cfe8d8;font-family:\'Poppins\',sans-serif;font-size:13.5px;margin-bottom:12px;">' +
        '<div class="qa-actions">' +
          '<button type="button" class="qa-save" onclick="saveSchoolBlock(this)">Save</button>' +
          '<button type="button" class="qa-cancel" onclick="cancelSchoolBlock()">Cancel</button>' +
        '</div>' +
        '<div class="qa-error" id="newSchoolError" style="display:none;"></div>';

      addBtn.parentNode.insertBefore(wrap, addBtn);
      addBtn.style.display = 'none';
      document.getElementById('newSchoolName').focus();
    }

    function cancelSchoolBlock(){
      var wrap = document.getElementById('addSchoolWrap');
      if (wrap) wrap.remove();
      var addBtn = document.getElementById('addSchoolBtn');
      if (addBtn) addBtn.style.display = '';
    }

    async function saveSchoolBlock(btn){
      var name = document.getElementById('newSchoolName').value.trim();
      var icon = document.getElementById('newSchoolIcon').value.trim();
      var color = document.getElementById('newSchoolColor').value.trim();
      var errorBox = document.getElementById('newSchoolError');
      errorBox.style.display = 'none';

      if (!name){
        errorBox.textContent = 'School name is required.';
        errorBox.style.display = 'block';
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Saving...';

      try {
        var res = await fetch('@Url.Action("QuickAddSchool", "Courses")', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
          body: JSON.stringify({ Name: name, Icon: icon, ColorHex: color })
        });
        var data = await res.json();
        if (!res.ok || !data.success){
          errorBox.textContent = data.message || 'Could not save the school.';
          errorBox.style.display = 'block';
          btn.disabled = false;
          btn.textContent = 'Save';
          return;
        }

        var container = document.getElementById('accordionContainer');
        var newIdx = container.querySelectorAll('.accordion-block').length;

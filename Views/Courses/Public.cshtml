<script>
function toggleAcc(i){
  var block = document.getElementById('acc-' + i);
  if (!block) return;
  block.classList.toggle('open');
}

function searchCourses(q){
  q = q.trim().toLowerCase();
  document.querySelectorAll('.accordion-block').forEach(function(block){
    var anyMatch = false;
    block.querySelectorAll('tr.course-row').forEach(function(row){
      var text = row.querySelector('.row-name') ? row.querySelector('.row-name').textContent.toLowerCase() : '';
      var isMatch = (q === '' || text.includes(q));
      row.style.display = isMatch ? '' : 'none';
      if (isMatch) anyMatch = true;
    });

    if (q === ''){
      block.style.display = '';
    } else {
      block.classList.toggle('open', anyMatch);
      block.style.display = anyMatch ? '' : 'none';
    }
  });
}

/* ===== Course detail modal (Accessible by ALL users) ===== */
var currentModalCourseId = null;

var defaultSchoolInfo = {

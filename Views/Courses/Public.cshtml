@model IEnumerable<NAU_Web.Models.School>
@{
    Layout = null;
    bool canEdit = ViewBag.CanEdit == true;
    bool editMode = ViewBag.EditMode == true;   // true only when reached via Admin Panel "Short Courses" link
    var userPerms = (ViewBag.UserPermissions as List<string>) ?? new List<string>();
    bool isSuperAdmin = ViewBag.IsSuperAdmin == true || (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"));
    bool isAdmin = User.Identity != null && User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Staff"));
    int totalCourses = Model.Sum(s => s.Courses.Count);
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Schools - National Aviation University</title>
<partial name="_Favicon" />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Open+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link rel="stylesheet" href="~/css/public-site.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/courses-page.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/mobile-nav.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/public-modals.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/cms-icon-picker.css" asp-append-version="true">
<style>
  /* Admin-only quick-add controls (not part of the original static design) */
  .acc-add-btn{ background:rgba(255,255,255,0.18); border:1px solid rgba(255,255,255,0.35); color:#fff; padding:7px 14px; border-radius:20px; font-size:12.5px; font-weight:600; cursor:pointer; display:inline-flex; align-items:center; gap:6px; margin-right:14px; }
  .acc-add-btn:hover{ background:rgba(255,255,255,0.3); }
  tr.course-row-new td{ background:#f0faf4; }
  tr.course-row-new input{ width:100%; border:1px solid #cfe8d8; border-radius:6px; padding:6px 8px; font-size:12.5px; font-family:"Poppins",sans-serif; }
  .qa-actions{ display:flex; gap:6px; }
  .qa-save,.qa-cancel{ border:none; border-radius:6px; padding:6px 10px; font-size:12px; font-weight:600; cursor:pointer; }
  .qa-save{ background:var(--green); color:#fff; }
  .qa-cancel{ background:#eee; color:#555; }
  .qa-error{ color:#c0392b; font-size:11.5px; margin-top:4px; }
  .row-delete-btn{ background:#fdeceb; color:#c0392b; border:1px solid #f4c7c3; border-radius:6px; padding:5px 9px; font-size:12px; cursor:pointer; }
  .row-delete-btn:hover{ background:#c0392b; color:#fff; }
  .row-delete-btn:disabled{ opacity:.5; cursor:default; }

  /* ===== Account dropdown (Sign Up / Log In) ===== */
  .account-dropdown{ position:relative; display:inline-block; }
  .account-dropdown > .apply-btn::after{
    content:"\f078";
    font-family:"Font Awesome 6 Free"; font-weight:900;
    font-size:10px; margin-left:8px; opacity:.85; display:inline-block;
    transition:transform .2s;
  }
  .account-dropdown.open > .apply-btn::after,
  .account-dropdown:hover > .apply-btn::after{ transform:rotate(180deg); }
  .account-dropdown-menu{
    display:none;
    position:absolute;
    top:calc(100% + 8px);
    right:0;
    background:#fff;
    min-width:150px;
    border-radius:8px;
    box-shadow:0 10px 28px rgba(0,0,0,0.2);
    overflow:hidden;
    z-index:2000;
  }
  .account-dropdown.open .account-dropdown-menu,
  .account-dropdown:hover .account-dropdown-menu{ display:block; }
  .account-dropdown-menu a{
    display:block;
    padding:11px 16px;
    color:#0b2c4d;
    text-decoration:none;
    font-size:13.5px;
    font-weight:600;
    border-bottom:1px solid #f0f2f5;
  }
  .account-dropdown-menu a:last-child{ border-bottom:none; }
  .account-dropdown-menu a:hover{ background:#f5f7fb; color:#1e8e3e; }

  /* ===== Save/Delete confirmation toast ===== */
  #qaToast{
    position:fixed; top:20px; right:20px; z-index:3000;
    background:#1e8e3e; color:#fff; padding:14px 20px; border-radius:10px;
    box-shadow:0 10px 28px rgba(0,0,0,0.25); font-size:13.5px; font-weight:600;
    display:flex; align-items:center; gap:10px; opacity:0; transform:translateY(-12px);
    transition:opacity .25s, transform .25s; pointer-events:none; max-width:320px;
  }
  #qaToast.show{ opacity:1; transform:translateY(0); }
  #qaToast.error{ background:#c0392b; }

  /* ===== Course detail modal (ported from the static reference page) ===== */
  .course-modal-backdrop {
    display:none; position:fixed; inset:0;
    background:rgba(8,20,40,.78); z-index:10000;
    align-items:center; justify-content:center;
    backdrop-filter:blur(6px); padding:20px;
  }
  .course-modal-backdrop.open { display:flex; animation:cmFadeIn .22s ease; }
  @@keyframes cmFadeIn { from{opacity:0;} to{opacity:1;} }
  .course-modal {
    background:#fff; border-radius:22px; width:100%; max-width:580px;
    max-height:92vh; overflow-y:auto;
    box-shadow:0 28px 90px rgba(0,0,0,.28);
    animation:cmSlide .25s ease;
  }
  @@keyframes cmSlide { from{transform:scale(.93) translateY(12px);opacity:0;} to{transform:scale(1) translateY(0);opacity:1;} }
  .cm-hero { padding:34px 36px 30px; border-radius:22px 22px 0 0; position:relative; }
  .cm-close {
    position:absolute; top:16px; right:16px;
    background:rgba(255,255,255,.18); border:none; border-radius:50%;
    width:36px; height:36px; font-size:15px; cursor:pointer; color:#fff;
    display:flex; align-items:center; justify-content:center;
    transition:background .2s;
  }
  .cm-close:hover { background:rgba(255,255,255,.35); }
  .cm-school-label { font-size:10px; font-weight:700; letter-spacing:2.5px; text-transform:uppercase; color:rgba(255,255,255,.65); margin-bottom:6px; }
  .cm-title { font-family:'Poppins',sans-serif; font-size:22px; font-weight:800; color:#fff; line-height:1.3; margin-bottom:0; }
  .cm-meta-row { display:flex; align-items:center; gap:10px; margin-top:14px; flex-wrap:wrap; }
  .cm-badge {
    display:inline-flex; align-items:center; gap:5px;
    background:rgba(255,255,255,.18); border:1px solid rgba(255,255,255,.3);
    color:#fff; font-size:11px; font-weight:600;
    padding:5px 12px; border-radius:20px; backdrop-filter:blur(4px);
  }
  .cm-body { padding:28px 36px 36px; }
  .cm-desc { font-size:14px; color:#555; line-height:1.8; margin-bottom:24px; }
  .cm-info-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:24px; }
  .cm-info-item { background:#f5f7fb; border-radius:10px; padding:14px 16px; }
  .cm-info-item label { display:block; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:#aaa; margin-bottom:5px; }
  .cm-info-item span { font-size:14px; font-weight:700; color:#0b2c4d; }
  .cm-section-title { font-size:11px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:#1e8e3e; margin:0 0 10px; }
  .cm-topics { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:22px; }
  .cm-topic-tag { background:#f0f4f8; color:#333; border-radius:20px; padding:5px 14px; font-size:12px; font-weight:500; }
  .cm-points { list-style:none; display:flex; flex-direction:column; gap:8px; margin-bottom:24px; padding:0; }
  .cm-points li { display:flex; align-items:flex-start; gap:10px; font-size:13px; color:#444; line-height:1.55; }
  .cm-points li i { color:#1e8e3e; font-size:12px; margin-top:3px; flex-shrink:0; }
  .cm-actions { display:flex; gap:10px; flex-wrap:wrap; margin-top:4px; }
  .cm-btn {
    flex:1; padding:12px 18px; border-radius:9px;
    font-family:"Poppins",sans-serif; font-size:13px; font-weight:600;
    cursor:pointer; border:none; text-decoration:none;
    display:inline-flex; align-items:center; justify-content:center; gap:7px;
    transition:all .2s; min-width:130px;
  }
  .cm-btn.primary { background:#1e8e3e; color:#fff; }
  .cm-btn.primary:hover { background:#166f30; }
  .cm-btn.secondary { background:#f0f4f8; color:#0b2c4d; border:1.5px solid #dde2ea; }
  .cm-btn.secondary:hover { background:#e4ecf4; }
  @@media(max-width:600px){
    .cm-hero { padding:24px 22px 22px; }
    .cm-body { padding:20px 22px 28px; }
    .cm-title { font-size:18px; }
    .cm-info-grid { grid-template-columns:1fr; }
  }

  /* Edit-mode fields inside the modal */
  .cm-edit-fields { margin-top:16px; border-top:1px solid #eef0f4; padding-top:16px; }
  .cm-edit-field { margin-bottom:12px; }
  .cm-edit-field label { display:block; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.5px; color:#667; margin-bottom:4px; }
  .cm-edit-field input, .cm-edit-field textarea, .cm-edit-field select {
    width:100%; border:1px solid #cfe0f4; border-radius:7px; padding:7px 10px;
    font-size:13px; font-family:"Poppins",sans-serif;
  }
  .cm-row2 { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .cm-dates-wrap { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .cm-checkbox-label { display:inline-flex; align-items:center; gap:6px; font-size:12.5px; font-weight:600; color:#0b2c4d; cursor:pointer; margin-bottom:8px; }
  .cm-checkbox-label input { width:auto; }
  .row-edit-btn{ background:#eaf2fb; color:#0b6dbf; border:1px solid #cfe0f4; border-radius:6px; padding:5px 9px; font-size:12px; cursor:pointer; margin-right:6px; }
  .row-edit-btn:hover{ background:#0b6dbf; color:#fff; }
</style>
</head>
<body>

<div id="qaToast"></div>

<!-- ===== COURSE DETAIL MODAL ===== -->
<div id="courseModal" class="course-modal-backdrop" onclick="if(event.target===this)closeCourseModal()">
  <div class="course-modal">
    <div class="cm-hero" id="cmHero">
      <button class="cm-close" onclick="closeCourseModal()" type="button"><i class="fas fa-times"></i></button>
      <div class="cm-school-label" id="cmSchool"></div>
      <div class="cm-title" id="cmTitle"></div>
      <div class="cm-meta-row" id="cmMeta"></div>
    </div>
    <div class="cm-body" id="cmBodyView">
      <p class="cm-desc" id="cmDesc"></p>
      <div class="cm-info-grid" id="cmInfoGrid"></div>
      <p class="cm-section-title" id="cmTopicsLabel" style="margin-bottom:10px;">Key Topics</p>
      <div class="cm-topics" id="cmTopics"></div>
      <p class="cm-section-title" style="margin-bottom:10px;">Course Highlights</p>
      <ul class="cm-points" id="cmPoints"></ul>
      <div class="cm-actions" id="cmActionsView">
        <a href="/Account/Register" class="cm-btn primary"><i class="fas fa-user-plus"></i> Enroll Now</a>
        @if (canEdit || isAdmin || editMode)
        {
            <button class="cm-btn secondary" id="cmBtnEdit" type="button" onclick="switchToCourseEditMode()" style="background:#0284c7;color:#fff;border-color:#0284c7;"><i class="fas fa-pen"></i> Edit Course</button>
        }
        <button class="cm-btn secondary" type="button" onclick="closeCourseModal()"><i class="fas fa-times"></i> Close</button>
      </div>
    </div>
    @if (canEdit || isAdmin || editMode)
    {
        <div class="cm-body" id="cmBodyEdit" style="display:none;">
            <div class="cm-edit-field"><label>Course Title</label><input type="text" id="cmEditTitle" placeholder="e.g. Advanced Radar Navigation Course"></div>
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;">
                <div class="cm-edit-field"><label>Duration</label><input type="text" id="cmEditDuration" placeholder="e.g. 04 Weeks"></div>
                <div class="cm-edit-field"><label>Start Date</label><input type="text" id="cmEditStart" placeholder="e.g. 05 Jan 2027 or TBD"></div>
                <div class="cm-edit-field"><label>End Date</label><input type="text" id="cmEditEnd" placeholder="e.g. 10 Feb 2027 or TBD"></div>
            </div>
            <div class="cm-edit-field"><label>Description</label><textarea id="cmEditDesc" rows="3" placeholder="Enter detailed course overview description..."></textarea></div>
            <div class="cm-edit-field"><label>Key Topics (separate multiple topics with ;)</label><textarea id="cmEditTopics" rows="2" placeholder="Topic 1; Topic 2; Topic 3"></textarea></div>
            <div class="cm-edit-field"><label>Course Highlights (separate multiple highlights with ;)</label><textarea id="cmEditHighlights" rows="3" placeholder="Highlight 1; Highlight 2; Highlight 3"></textarea></div>
            <div class="cm-edit-field"><label>Certificate Label</label><input type="text" id="cmEditCertificate" placeholder="e.g. NAU Certified"></div>
            <div class="qa-error" id="cmEditError" style="display:none;margin-bottom:12px;"></div>
            <div class="cm-actions">
                <button class="cm-btn primary" id="cmBtnSaveCourse" type="button" onclick="saveCourseModal(this)" style="background:var(--green);border-color:var(--green);"><i class="fas fa-save"></i> Save Course</button>
                <button class="cm-btn secondary" id="cmBtnBackView" type="button" onclick="switchToCourseViewMode()"><i class="fas fa-arrow-left"></i> Back to View</button>
                <button class="cm-btn secondary" type="button" onclick="closeCourseModal()"><i class="fas fa-times"></i> Cancel</button>
            </div>
        </div>
    }
  </div>
</div>

@if (editMode)
{
    <div style="background:#0b2c4d;color:#fff;text-align:center;padding:12px 20px;font-family:'Poppins',sans-serif;font-size:13.5px;font-weight:600;display:flex;align-items:center;justify-content:center;gap:14px;position:sticky;top:0;z-index:9999;box-shadow:0 4px 15px rgba(0,0,0,0.25);">
        <span><i class="fas fa-shield-halved" style="color:#38bdf8;"></i> You are viewing schools &amp; courses in <strong>Admin Edit Mode</strong>.</span>
        <a href="/Courses/Public" style="background:rgba(255,255,255,0.15);color:#fff;text-decoration:none;padding:5px 12px;border-radius:6px;font-size:12px;"><i class="fas fa-eye"></i> View Live</a>
        <a href="/Admin" style="background:#0284c7;color:#fff;text-decoration:none;padding:5px 12px;border-radius:6px;font-size:12px;"><i class="fas fa-arrow-left"></i> Staff Control Panel</a>
    </div>
}

<partial name="_SiteHeader" />

<section class="hero">
  <div class="hero-bg-pattern"></div>
  <div class="hero-deco"></div>
  <div class="hero-content">
    <div class="hero-breadcrumb">
      <a href="/">Home</a>
      <i class="fas fa-chevron-right"></i>
      <span style="color:rgba(255,255,255,0.85)">Schools</span>
    </div>
    <div class="hero-eyebrow">Professional Development</div>
    <h1>Our <em>Schools</em></h1>
    <p>Explore our specialized schools offering industry-focused, certification-based training designed for aviation professionals &mdash; sharpen your skills, stay current, and advance your career.</p>
  </div>
</section>

<div class="filter-bar" style="background:#fff;padding:16px 48px;border-bottom:1px solid #eef0f4;display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
  <span style="font-size:13px;font-weight:700;color:var(--navy);display:flex;align-items:center;gap:6px;"><i class="fas fa-search" style="color:var(--green)"></i> Search:</span>
  <div class="course-search-wrap">
    <i class="fas fa-search"></i>
    <input type="text" id="courseSearch" class="course-search-input" placeholder="Search courses..." oninput="searchCourses(this.value)">
  </div>
  <span style="font-size:13px;color:var(--text-light);margin-left:auto;">Total: <strong id="totalCount" style="color:var(--navy);">@totalCourses courses</strong></span>
</div>

<section class="accordion-section">
  <div class="accordion-inner">
    <div class="accordion-top">
      <div>
        <span class="eyebrow" style="color:var(--green);font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;">Training Catalog</span>
        <h2 style="font-family:'Montserrat',sans-serif;font-weight:800;color:var(--navy);font-size:24px;margin-top:4px;">Specialized Training Schools</h2>
      </div>
      @if (editMode && isSuperAdmin)
      {
          <button type="button" class="btn-primary" onclick="openAddSchoolModal()" style="padding:10px 18px;font-size:13px;">
              <i class="fas fa-plus"></i> Add New School
          </button>
      }
    </div>

    <div id="accordionContainer">
    @{ int idx = 0; }
    @foreach (var school in Model)
    {
        var courses = school.Courses.OrderBy(c => c.CourseId).ToList();
        var sName = (school.Name ?? "").ToLowerInvariant();
        bool canEditThisSchool = editMode && (isSuperAdmin || userPerms.Contains("School.All") ||
            (sName.Contains("navigation") || sName.Contains("ans") ? userPerms.Contains("School.ANS") : false) ||
            (sName.Contains("airport") ? userPerms.Contains("School.Airport") : false) ||
            (sName.Contains("regulatory") || sName.Contains("safety") ? userPerms.Contains("School.Regulatory") : false) ||
            (sName.Contains("management") ? userPerms.Contains("School.Management") : false));

        <div class="accordion-block" id="acc-@idx" data-school-id="@school.SchoolId" data-school-name="@school.Name">
            <div class="acc-header-shell" style="position:relative;">
                @if (canEditThisSchool)
                {
                    <button type="button" class="row-edit-btn school-edit-btn" data-school-id="@school.SchoolId" data-school-name="@school.Name" data-school-icon="@school.Icon" data-school-color="@school.ColorHex" style="position:absolute; top:50%; right:112px; transform:translateY(-50%); z-index:5;" title="Edit this school" onclick="event.stopPropagation(); editSchoolBlock(this)">
                        <i class="fas fa-pen"></i>
                    </button>
                    <button type="button" class="row-delete-btn school-delete-btn" data-school-id="@school.SchoolId" data-school-name="@school.Name" style="position:absolute; top:50%; right:72px; transform:translateY(-50%); z-index:5;" title="Delete this school" onclick="event.stopPropagation(); deleteSchoolBlock(this)">
                        <i class="fas fa-trash"></i>
                    </button>
                }
                <button class="acc-header" onclick="toggleAcc(@idx)" style="background:linear-gradient(135deg, @(string.IsNullOrEmpty(school.ColorHex) ? "#0b3a5c" : school.ColorHex), @(string.IsNullOrEmpty(school.ColorHex) ? "#0f7490" : school.ColorHex)); @(canEditThisSchool ? "padding-right:170px;" : "")">
                    <div class="acc-left">
                        @{
                            string rawIcon = string.IsNullOrWhiteSpace(school.Icon) ? "fas fa-graduation-cap" : school.Icon.Trim();
                            string iconClass = rawIcon;
                            if (!iconClass.StartsWith("fa", StringComparison.OrdinalIgnoreCase))
                            {
                                iconClass = "fas fa-" + iconClass;
                            }
                            else if (!iconClass.StartsWith("fas ", StringComparison.OrdinalIgnoreCase) && 
                                     !iconClass.StartsWith("far ", StringComparison.OrdinalIgnoreCase) && 
                                     !iconClass.StartsWith("fab ", StringComparison.OrdinalIgnoreCase) && 
                                     !iconClass.StartsWith("fa-solid ", StringComparison.OrdinalIgnoreCase))
                            {
                                iconClass = "fas " + iconClass;
                            }
                        }
                        <div class="acc-icon-wrap"><i class="@iconClass"></i></div>
                        <div class="acc-title-wrap">
                            <span class="acc-school">@school.Name</span>
                            <span class="acc-sub">National Aviation University &mdash; Hyderabad</span>
                        </div>
                    </div>
                    <div class="acc-right">
                        <span class="acc-count" id="acc-count-@idx">@courses.Count Courses</span>
                        <i class="fas fa-chevron-down acc-chevron"></i>
                </div>
            </button>
            </div>
            <div class="acc-body">
                <div class="acc-table-wrap">
                    @if (canEditThisSchool)
                    {
                        <div style="padding:14px 18px 0; text-align:right; display:flex; justify-content:flex-end; gap:8px;">
                            <button type="button" class="acc-add-btn" style="background:var(--green);border-color:var(--green);color:#fff;" onclick="openAddCourseModal(@idx, @school.SchoolId, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(school.Name ?? ""))')">
                                <i class="fas fa-plus"></i> Add New Course
                            </button>
                        </div>
                    }
                    <table class="acc-table">
                        <thead>
                            <tr>
                                <th width="40">#</th>
                                <th>Course Title</th>
                                <th width="110">Duration</th>
                                <th width="100">Start Date</th>
                                <th width="100">End Date</th>
                                @if (canEditThisSchool)
                                {
                                    <th width="50"></th>
                                }
                            </tr>
                        </thead>
                        <tbody id="acc-tbody-@idx">
                        @{ int rowNum = 1; }
                        @foreach (var c in courses)
                        {
                            <tr class="course-row" data-course-id="@c.CourseId">
                                <td class="row-num">@rowNum</td>
                                <td class="row-name">
                                    <span class="row-name-inner" onclick="openCourseModal(@c.CourseId)">@c.Title <i class="fas fa-chevron-right row-arrow"></i></span>
                                </td>
                                <td><span class="dur-pill">@(c.Duration ?? "-")</span></td>
                                <td class="row-date">@(c.IsTbd || c.StartDate == null ? "TBD" : c.StartDate.Value.ToString("dd MMM yyyy"))</td>
                                <td class="row-date">@(c.IsTbd || c.EndDate == null ? "TBD" : c.EndDate.Value.ToString("dd MMM yyyy"))</td>
                                @if (canEditThisSchool)
                                {
                                    <td>
                                        <button type="button" class="row-edit-btn" title="Edit this course" onclick="openCourseModal(@c.CourseId, true)">
                                            <i class="fas fa-pen"></i>
                                        </button>
                                        <button type="button" class="row-delete-btn" title="Delete this course" onclick="deleteCourseRow(this, @c.CourseId, @idx)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                }
                            </tr>
                            rowNum++;
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        idx++;
    }
    </div>

    @if (editMode)
    {
        <div style="text-align:center; padding:22px 0 6px;">
            <button type="button" id="addSchoolBtn" class="acc-add-btn" style="background:var(--green);border-color:var(--green);color:#fff;display:inline-flex;" onclick="addSchoolBlock()">
                <i class="fas fa-plus"></i> Add School
            </button>
        </div>
    }
  </div>
</section>

<script>
  /* ===== Mega-menu nav search icon/box ===== */
  function toggleSearch() {
    const box = document.getElementById("searchBox");
    box.classList.toggle("open");
    if (box.classList.contains("open")) box.focus();
  }
  function closeSearch() {
    setTimeout(() => { document.getElementById("searchBox").classList.remove("open"); }, 150);
  }

  // Full detail data for every course, keyed by CourseId, so the modal can
  // show real info without extra network round-trips.
  var courseData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
      Model.SelectMany(s => s.Courses.Select(c => new
      {
          id = c.CourseId,
          schoolId = s.SchoolId,
          schoolName = s.Name,
          schoolColor = string.IsNullOrEmpty(s.ColorHex) ? "#0b3a5c" : s.ColorHex,
          title = c.Title,
          duration = c.Duration ?? "-",
          startDate = c.IsTbd || c.StartDate == null ? "TBD" : c.StartDate.Value.ToString("dd MMM yyyy"),
          endDate = c.IsTbd || c.EndDate == null ? "TBD" : c.EndDate.Value.ToString("dd MMM yyyy"),
          description = c.Description ?? "",
          topics = c.Topics ?? "",
          highlights = c.Highlights ?? "",
          certificate = string.IsNullOrEmpty(c.Certificate) ? "NAU Certified" : c.Certificate
      })).ToDictionary(x => x.id.ToString(), x => x)
  ).Replace("</", "<\\/"));
</script>


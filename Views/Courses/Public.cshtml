        var block = document.createElement('div');
        block.className = 'accordion-block';
        block.id = 'acc-' + newIdx;
        block.innerHTML =
          '<div class="acc-header-shell" style="position:relative;">' +
          '<button type="button" class="row-edit-btn school-edit-btn" data-school-id="' + data.schoolId + '" data-school-name="' + data.name + '" data-school-icon="' + (data.icon || 'fas fa-graduation-cap') + '" data-school-color="' + c1 + '" style="position:absolute; top:50%; right:112px; transform:translateY(-50%); z-index:5;" title="Edit this school" onclick="event.stopPropagation(); editSchoolBlock(this)"><i class="fas fa-pen"></i></button>' +
          '<button type="button" class="row-delete-btn school-delete-btn" data-school-id="' + data.schoolId + '" data-school-name="' + data.name + '" style="position:absolute; top:50%; right:72px; transform:translateY(-50%); z-index:5;" title="Delete this school" onclick="event.stopPropagation(); deleteSchoolBlock(this)"><i class="fas fa-trash"></i></button>' +
          '<button class="acc-header" onclick="toggleAcc(' + newIdx + ')" style="background:linear-gradient(135deg, ' + c1 + ', ' + c2 + '); padding-right:170px;">' +
            '<div class="acc-left">' +
              '<div class="acc-icon-wrap"><i class="' + (data.icon || 'fas fa-graduation-cap') + '"></i></div>' +
              '<div class="acc-title-wrap">' +
                '<span class="acc-school">' + data.name + '</span>' +
                '<span class="acc-sub">National Aviation University &mdash; Hyderabad</span>' +
              '</div>' +
            '</div>' +
            '<div class="acc-right">' +
              '<span class="acc-count" id="acc-count-' + newIdx + '">0 Courses</span>' +
              '<i class="fas fa-chevron-down acc-chevron"></i>' +
            '</div>' +
          '</button>' +
          '</div>' +
          '<div class="acc-body">' +
            '<div class="acc-table-wrap">' +
              '<div style="padding:14px 18px 0; text-align:right;">' +
                '<button type="button" class="acc-add-btn" style="background:var(--green);border-color:var(--green);color:#fff;" onclick="addCourseRow(' + newIdx + ', ' + data.schoolId + ')"><i class="fas fa-plus"></i> Add Course</button>' +
              '</div>' +
              '<table class="acc-table">' +
                '<thead><tr><th width="40">#</th><th>Course Title</th><th width="110">Duration</th><th width="100">Start Date</th><th width="100">End Date</th><th width="50"></th></tr></thead>' +

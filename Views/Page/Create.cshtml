            </div>

            <div class="form-group">
                <label asp-for="UpdatedByUser" class="control-label"></label>
                <input asp-for="UpdatedByUser" class="form-control" />
                <span asp-validation-for="UpdatedByUser" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@using Microsoft.AspNetCore.Identity
@using NAU_Web.Models
@inject UserManager<ApplicationUser> UserManager
@{
    bool isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
    if (!isAuthenticated) return;

    bool isSuperAdmin = User.IsInRole("Admin");
    bool canEdit = ViewBag.CanEdit == true || isSuperAdmin;
    bool editMode = ViewBag.EditMode == true;

    string editUrl = ViewBag.EditUrl as string ?? "?edit=true";
    string exitUrl = ViewBag.ExitUrl as string ?? "?";
}

<div class="nau-admin-floating-bar">
    <a href="/Admin" class="nau-floating-btn nau-floating-btn-admin" title="Go to Admin Control Panel">
        <i class="fas fa-shield-halved" style="color: #38bdf8;"></i> Admin Panel
    </a>

    @if (editMode)
    {
        <a href="@exitUrl" class="nau-floating-btn nau-floating-btn-exit" title="Exit Admin Edit Mode">
            <i class="fas fa-xmark" style="color: #f87171;"></i> Exit Edit Mode
        </a>
    }
    else if (canEdit)
    {
        <a href="@editUrl" class="nau-floating-btn nau-floating-btn-edit" title="Enable Inline Page Edit Mode">
            <i class="fas fa-pen-to-square" style="color: #38bdf8;"></i> Enable Edit Mode
        </a>
    }
</div>

<script>
(function() {
    var bars = document.querySelectorAll('.nau-admin-floating-bar');
    if (bars.length > 1) {
        for (var i = 0; i < bars.length - 1; i++) {
            bars[i].remove();
        }
    }
})();
</script>

<style>
.nau-admin-floating-bar {
    position: fixed !important;
    bottom: 28px !important;
    left: 28px !important;
    right: auto !important;
    top: auto !important;
    z-index: 999999 !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 10px !important;
    width: auto !important;
    max-width: max-content !important;
    background: transparent !important;
    padding: 0 !important;
    margin: 0 !important;
    border: none !important;
    box-shadow: none !important;
}

.nau-floating-btn {
    display: inline-flex !important;
    align-items: center !important;
    gap: 8px !important;
    background: #0b2c4d !important;
    color: #ffffff !important;
    font-family: 'Poppins', 'Montserrat', sans-serif !important;
    font-weight: 700 !important;
    font-size: 13px !important;
    letter-spacing: 0.2px !important;
    text-decoration: none !important;
    padding: 10px 18px !important;
    border-radius: 30px !important;
    box-shadow: 0 8px 24px rgba(11, 44, 77, 0.35) !important;
    border: 1.5px solid rgba(255, 255, 255, 0.25) !important;
    white-space: nowrap !important;
    width: auto !important;
    height: auto !important;
    transition: all 0.2s ease-in-out !important;
}

.nau-floating-btn:hover {
    background: #1e8e3e !important;
    color: #ffffff !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 12px 28px rgba(30, 142, 62, 0.4) !important;
    border-color: rgba(255, 255, 255, 0.4) !important;
}

.nau-floating-btn-exit:hover {
    background: #dc2626 !important;
    box-shadow: 0 12px 28px rgba(220, 38, 38, 0.4) !important;
}

@@media (max-width: 768px) {
    .nau-admin-floating-bar {
        bottom: 18px !important;
        left: 16px !important;
        flex-direction: column !important;
        align-items: flex-start !important;
        gap: 8px !important;
    }
    .nau-floating-btn {
        padding: 8px 14px !important;
        font-size: 12px !important;
    }
}
</style>

<!-- ===== NAU SPLASH SCREEN ANNOUNCEMENT MODAL ===== -->
<div class="nau-splash-backdrop" id="nauSplashModal" onclick="if(event.target===this)closeNauSplash()">
  <div class="nau-splash-dialog" onclick="event.stopPropagation()">
    <button type="button" class="nau-splash-close" onclick="closeNauSplash()" aria-label="Close Announcement">
      <i class="fas fa-times"></i>
    </button>
    
    <div class="nau-splash-banner-wrap" id="nauSplashBannerWrap">
      <img id="nauSplashImage" class="nau-splash-img" alt="Announcement Banner" style="display:none;" />
      <div class="nau-splash-fallback-hero" id="nauSplashFallbackHero">
        <div class="nau-splash-hero-icon" id="nauSplashHeroIcon"><i class="fas fa-bullhorn"></i></div>
        <div class="nau-splash-pattern"></div>
      </div>
      <div class="nau-splash-badge-bar">
        <span class="nau-splash-badge" id="nauSplashCategory"><i class="fas fa-bullhorn"></i> Announcement</span>
        <span class="nau-splash-pill"><i class="fas fa-bolt"></i> Notice</span>
      </div>
    </div>

    <div class="nau-splash-body">
      <div class="nau-splash-meta">
        <span class="nau-splash-date" id="nauSplashDate"><i class="far fa-calendar-alt"></i> Date</span>
        <span class="nau-splash-org"><i class="fas fa-university"></i> National Aviation University</span>
      </div>

      <h2 class="nau-splash-title" id="nauSplashTitle">Announcement Headline</h2>

      <div class="nau-splash-text" id="nauSplashBody">
        Announcement details will appear here.
      </div>

      <div class="nau-splash-footer">
        <label class="nau-splash-remember">
          <input type="checkbox" id="nauSplashDontShowToday" onchange="toggleSplashRemember(this.checked)">
          <span>Don't show again today</span>
        </label>
        <div class="nau-splash-actions">
          <button type="button" class="nau-splash-btn secondary" onclick="closeNauSplash()">Dismiss</button>
          <a href="/NewsPosts/Public" id="nauSplashReadMoreBtn" class="nau-splash-btn primary">
            <span>Read Full Story</span> <i class="fas fa-arrow-right"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>


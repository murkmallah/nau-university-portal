<!-- ===== ELIGIBILITY CRITERIA MODAL ===== -->
<div class="util-modal-backdrop" id="eligibilityModal" onclick="closeUtilModal('eligibilityModal')">
  <div class="util-modal util-modal--wide" onclick="event.stopPropagation()">
    <div class="util-modal-header" style="background:linear-gradient(135deg,#0b2c4d,#1a5fa6);">
      <div class="util-modal-icon"><i class="fas fa-list-check"></i></div>
      <div>
        <div class="util-modal-title">Eligibility Criteria</div>
        <div class="util-modal-sub">Entry Requirements per Program — 2026</div>
      </div>
      <button class="util-close-btn" onclick="closeUtilModal('eligibilityModal')" aria-label="Close"><i class="fas fa-times"></i></button>
    </div>
    <div class="util-modal-body">
      <div class="util-notice">
        <i class="fas fa-info-circle"></i>
        All candidates must meet the minimum academic qualifications listed below. Foreign nationals and CAA employees may be subject to additional requirements.
      </div>
      <div class="elig-prog-tabs">
        <button class="elig-tab active" onclick="switchEligTab(this,'undergrad')"><i class="fas fa-graduation-cap"></i> Undergraduate</button>
        <button class="elig-tab" onclick="switchEligTab(this,'mba')"><i class="fas fa-briefcase"></i> MBA</button>
        <button class="elig-tab" onclick="switchEligTab(this,'short')"><i class="fas fa-bolt"></i> Short Courses</button>
      </div>
      <!-- Undergraduate Tab -->
      <div id="eligTab-undergrad" class="elig-tab-content active">
        <div class="elig-program-card">
          <div class="elig-prog-header" style="border-left:4px solid #1a5fa6;">
            <div class="elig-prog-icon" style="background:#e8f0fe;color:#1a5fa6;"><i class="fas fa-cogs"></i></div>
            <div>
              <div class="elig-prog-name">BE ANS Engineering / BE Airport Engineering</div>
              <div class="elig-prog-duration">4 Years · 8 Semesters</div>
            </div>
          </div>
          <div class="elig-criteria-list">
            <div class="elig-criteria-item"><i class="fas fa-check-circle" style="color:#1e8e3e;"></i><span>FSc (Pre-Engineering) or A-Levels (Physics, Math, Chemistry/CS) with minimum <strong>50% marks</strong></span></div>
            <div class="elig-criteria-item"><i class="fas fa-check-circle" style="color:#1e8e3e;"></i><span>NTS/AU Entry Test with qualifying score</span></div>
            <div class="elig-criteria-item"><i class="fas fa-check-circle" style="color:#1e8e3e;"></i><span>Age limit: Not more than <strong>22 years</strong> at time of admission</span></div>
            <div class="elig-criteria-item"><i class="fas fa-check-circle" style="color:#1e8e3e;"></i><span>Pakistani National or approved foreign national</span></div>
          </div>
        </div>
        <div class="elig-program-card">
          <div class="elig-prog-header" style="border-left:4px solid #1e8e3e;">
            <div class="elig-prog-icon" style="background:#e6f4ea;color:#1e8e3e;"><i class="fas fa-plane-departure"></i></div>
            <div>
              <div class="elig-prog-name">BS Aviation Management / BS Aviation Operations</div>
              <div class="elig-prog-duration">4 Years · 8 Semesters</div>
            </div>
          </div>
          <div class="elig-criteria-list">
            <div class="elig-criteria-item"><i class="fas fa-check-circle" style="color:#1e8e3e;"></i><span>FA/FSc/ICS or equivalent with minimum <strong>45% marks</strong></span></div>
            <div class="elig-criteria-item"><i class="fas fa-check-circle" style="color:#1e8e3e;"></i><span>NTS/AU Entry Test with qualifying score</span></div>
            <div class="elig-criteria-item"><i class="fas fa-check-circle" style="color:#1e8e3e;"></i><span>Age limit: Not more than <strong>23 years</strong> at time of admission</span></div>
          </div>
        </div>
        <div class="elig-program-card">
          <div class="elig-prog-header" style="border-left:4px solid #8b5cf6;">
            <div class="elig-prog-icon" style="background:#f3e8ff;color:#8b5cf6;"><i class="fas fa-laptop-code"></i></div>
            <div>
              <div class="elig-prog-name">BS Aviation Cyber Security</div>
              <div class="elig-prog-duration">4 Years · 8 Semesters</div>
            </div>
          </div>
          <div class="elig-criteria-list">
            <div class="elig-criteria-item"><i class="fas fa-check-circle" style="color:#1e8e3e;"></i><span>FSc (Pre-Engineering/ICS) or A-Levels with Math/CS with minimum <strong>50% marks</strong></span></div>
            <div class="elig-criteria-item"><i class="fas fa-check-circle" style="color:#1e8e3e;"></i><span>NTS/AU Entry Test with qualifying score</span></div>
            <div class="elig-criteria-item"><i class="fas fa-check-circle" style="color:#1e8e3e;"></i><span>Age limit: Not more than <strong>22 years</strong> at time of admission</span></div>
          </div>
        </div>
      </div>
      <!-- MBA Tab -->
      <div id="eligTab-mba" class="elig-tab-content">
        <div class="elig-program-card">
          <div class="elig-prog-header" style="border-left:4px solid #f5a623;">
            <div class="elig-prog-icon" style="background:#fff7e6;color:#f5a623;"><i class="fas fa-chart-line"></i></div>
            <div>
              <div class="elig-prog-name">MBA Aviation Management</div>
              <div class="elig-prog-duration">2 Years · 4 Semesters</div>
            </div>
          </div>
          <div class="elig-criteria-list">
            <div class="elig-criteria-item"><i class="fas fa-check-circle" style="color:#1e8e3e;"></i><span>Bachelor's degree (16 years of education) in any discipline with minimum <strong>2nd Division (45%)</strong></span></div>
            <div class="elig-criteria-item"><i class="fas fa-check-circle" style="color:#1e8e3e;"></i><span>GAT General / NTS MBA Test with minimum qualifying score</span></div>
            <div class="elig-criteria-item"><i class="fas fa-check-circle" style="color:#1e8e3e;"></i><span>Working professionals with aviation background preferred</span></div>
            <div class="elig-criteria-item"><i class="fas fa-check-circle" style="color:#1e8e3e;"></i><span>Minimum <strong>2 years</strong> post-graduation work experience (preferred)</span></div>
          </div>
        </div>
      </div>
      <!-- Short Courses Tab -->
      <div id="eligTab-short" class="elig-tab-content">
        <div class="util-notice" style="background:#fff7e6;border-left-color:#f5a623;">
          <i class="fas fa-bolt" style="color:#f5a623;"></i>
          Short courses are primarily designed for CAA/PAA employees, aviation industry professionals, and government nominees. Some courses are open to sponsored candidates from other organizations.
        </div>
        <div class="elig-program-card">
          <div class="elig-prog-header" style="border-left:4px solid #c0392b;">
            <div class="elig-prog-icon" style="background:#fde8e8;color:#c0392b;"><i class="fas fa-fire-extinguisher"></i></div>
            <div>
              <div class="elig-prog-name">Aerodrome Fire Fighting Courses</div>
              <div class="elig-prog-duration">1–5 Weeks</div>
            </div>

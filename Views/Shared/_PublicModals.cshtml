@* ===== SITE-WIDE PUBLIC MODALS =====
   Contains the HTML markup for Academic Calendar, Results, Examination Schedule,
   Downloads, Eligibility Criteria, Required Documents, Professional Courses,
   and Events & Activities modals accessible from the header dropdowns on all pages. *@

<!-- ===== RESULTS MODAL ===== -->
<div class="util-modal-backdrop" id="resultsModal" onclick="closeUtilModal('resultsModal')">
  <div class="util-modal" onclick="event.stopPropagation()">
    <div class="util-modal-header" style="background:linear-gradient(135deg,#0b2c4d,#1a5fa6);">
      <div class="util-modal-icon"><i class="fas fa-poll"></i></div>
      <div>
        <div class="util-modal-title">Examination Results</div>
        <div class="util-modal-sub">National Aviation University</div>
      </div>
      <button class="util-close-btn" onclick="closeUtilModal('resultsModal')" aria-label="Close"><i class="fas fa-times"></i></button>
    </div>
    <div class="util-modal-body">
      <div class="util-notice">
        <i class="fas fa-info-circle"></i>
        Results are published through the Student Online Portal. Log in with your student credentials to view your semester results, grade reports, and transcripts.
      </div>
      <div class="util-options-grid">
        <a href="/Account/Login" class="util-option-card">
          <div class="util-option-icon" style="background:#e8f0fe;color:#1a5fa6;"><i class="fas fa-user-circle"></i></div>
          <div class="util-option-label">Student Portal</div>
          <div class="util-option-desc">Login to view your results</div>
          <span class="util-option-arrow"><i class="fas fa-arrow-right"></i></span>
        </a>
        <div class="util-option-card" onclick="closeUtilModal('resultsModal');openCalendar(event,'results')">
          <div class="util-option-icon" style="background:#e6f4ea;color:#1e8e3e;"><i class="fas fa-calendar-alt"></i></div>
          <div class="util-option-label">Result Dates</div>
          <div class="util-option-desc">View result announcement schedule</div>
          <span class="util-option-arrow"><i class="fas fa-arrow-right"></i></span>
        </div>
      </div>
      <div class="util-info-box">
        <div class="util-info-row"><i class="fas fa-envelope" style="color:#1e8e3e;"></i><span>For result queries: <strong>AdID.Academics@paa.gov.pk</strong></span></div>
        <div class="util-info-row"><i class="fas fa-phone" style="color:#1e8e3e;"></i><span>Call Academics Office: <strong>+92 22 9260310-19</strong></span></div>
        <div class="util-info-row"><i class="fas fa-clock" style="color:#1e8e3e;"></i><span>Office Hours: <strong>Mon–Fri, 08:00 AM – 04:00 PM</strong></span></div>
      </div>
    </div>
  </div>
</div>

<!-- ===== ACADEMIC CALENDAR MODAL ===== -->
<div id="calendarModal" class="cal-modal-backdrop" onclick="if(event.target===this)closeCalendar()">
  <div class="cal-modal">
    <!-- Sidebar -->
    <div class="cal-sidebar">
      <div class="cal-sidebar-brand">
        <div class="cal-sidebar-icon"><i class="fas fa-calendar-days"></i></div>
        <div class="cal-sidebar-title">Academic<br>Calendar</div>
        <div class="cal-sidebar-year">2026</div>
      </div>
      <div class="cal-sidebar-filters">
        <div class="cal-sf-label">Status</div>
        <button class="cal-sf-btn active" onclick="setCalFilter('all',this)" data-filter="all">
          <span class="cal-sf-dot all"></span> All Courses
        </button>
        <button class="cal-sf-btn" onclick="setCalFilter('upcoming',this)" data-filter="upcoming">
          <span class="cal-sf-dot up"></span> Upcoming
        </button>
        <button class="cal-sf-btn" onclick="setCalFilter('completed',this)" data-filter="completed">
          <span class="cal-sf-dot done"></span> Completed
        </button>
        <button class="cal-sf-btn" onclick="setCalFilter('tbd',this)" data-filter="tbd">
          <span class="cal-sf-dot tbd"></span> TBD
        </button>
      </div>
      <div class="cal-sidebar-schools" id="calSidebarSchools"></div>
      <div class="cal-sidebar-footer">
        <div style="font-size:10px;color:rgba(255,255,255,0.35);line-height:1.5;">NAU Hyderabad<br>ATP-2026 Schedule</div>
      </div>
    </div>
    <!-- Main Content -->
    <div class="cal-main">
      <div class="cal-main-topbar">
        <div class="cal-main-school-title" id="calMainSchoolTitle">All Schools</div>
        <div class="cal-view-tabs">
          <button class="cal-view-tab active" id="calTabCourses" onclick="switchCalView('courses',this)"><i class="fas fa-calendar-days"></i> Courses</button>
          <button class="cal-view-tab" id="calTabResults" onclick="switchCalView('results',this)"><i class="fas fa-poll"></i> Result Dates</button>
        </div>
        <div class="cal-search-wrap">
          <i class="fas fa-search"></i>
          <input type="text" placeholder="Search courses…" oninput="calSearch(this.value)" class="cal-search-input" id="calSearchInput">
        </div>
        <button class="cal-close-btn" onclick="closeCalendar()" aria-label="Close"><i class="fas fa-times"></i></button>
      </div>
      <div class="cal-legend-strip" id="calLegendStrip">
        <span class="cal-legend-item"><span class="cal-legend-dot" style="background:#1e8e3e"></span> Course start</span>
        <span class="cal-legend-item"><span class="cal-legend-dot" style="background:#1e8e3e44;border-radius:2px;width:14px;height:5px"></span> In progress</span>
        <span class="cal-legend-item"><span class="cal-legend-dot" style="background:#0b2c4d"></span> Today</span>
        <span style="margin-left:auto;font-size:10px;color:#b0b8c4;">Click a date to see courses</span>
      </div>
      <div class="cal-timeline-list" id="calCourseList"></div>
    </div>
  </div>
</div>

<!-- ===== EXAMINATION SCHEDULE MODAL ===== -->

<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.body.addEventListener("click", function (e) {
      var vmvBtn = e.target.closest("#openVmvEditModalBtn, .vmv-section-edit-btn");
      if (vmvBtn) {
        e.preventDefault();
        e.stopPropagation();
        openVmvCRUDModal();
        return;
      }

      var editBtn = e.target.closest(".facility-card-edit-btn");
      if (!editBtn) return;

      e.preventDefault();
      e.stopPropagation();

      var card = editBtn.closest(".hv-hover-card");
      if (!card) return;

      var imgEl = card.querySelector(".hv-hover-img");
      var badgeEls = card.querySelectorAll(".hv-hover-badge");
      var titleEls = card.querySelectorAll("h3");
      var descEl = card.querySelector("p");
      var linkTextEl = card.querySelector(".hv-card-link-text") || card.querySelector(".hv-hover-link");

      var currentImg = imgEl ? imgEl.src : "";
      var currentBadge = badgeEls.length > 0 ? badgeEls[0].textContent.trim() : "";
      var currentTitle = titleEls.length > 0 ? titleEls[0].textContent.trim() : "";
      var currentDesc = descEl ? descEl.textContent.trim() : "";
      var currentLinkText = linkTextEl ? linkTextEl.textContent.replace("→", "").trim() : "Explore";
      var currentHref = card.getAttribute("href") || "#";

      var backdrop = document.createElement("div");
      backdrop.className = "cms-image-modal-backdrop";
      backdrop.style.zIndex = "9999999";

      function escapeAttr(str) {
        if (!str) return "";
        return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
      }

      backdrop.innerHTML =
        '<div class="cms-image-modal" style="max-width: 580px; border-radius: 20px; box-shadow: 0 25px 60px rgba(0,0,0,0.5);">' +
          '<div class="cms-image-modal-head" style="background: #0b2c4d; padding: 18px 24px; border-top-left-radius: 20px; border-top-right-radius: 20px; display:flex; justify-content:space-between; align-items:center;">' +
            '<h3 style="color:#fff; font-size:17px; font-weight:700; margin:0; display:flex; align-items:center; gap:8px;">' +
              '<i class="fas fa-pen-to-square" style="color:#4ed47a;"></i> Edit Facility Card' +
            '</h3>' +
            '<button type="button" class="cms-image-modal-close" id="closeFacModal" style="color:#fff; font-size:22px; cursor:pointer; background:none; border:none;">&times;</button>' +
          '</div>' +

          '<div class="cms-image-modal-body" style="padding: 24px; max-height: 75vh; overflow-y: auto;">' +
            
            '<div style="margin-bottom: 16px;">' +
              '<label style="display:block; font-weight:700; font-size:13px; color:#0b2c4d; margin-bottom:6px;">Facility Title</label>' +
              '<input type="text" id="facModalTitleInput" class="cms-url-input" value="' + escapeAttr(currentTitle) + '" style="width:100%; box-sizing:border-box; padding:10px 14px; border:1px solid #cbd5e1; border-radius:8px; font-size:14px; font-weight:600;">' +
            '</div>' +

            '<div style="margin-bottom: 16px;">' +
              '<label style="display:block; font-weight:700; font-size:13px; color:#0b2c4d; margin-bottom:6px;">Category Badge / Tag</label>' +
              '<input type="text" id="facModalBadgeInput" class="cms-url-input" value="' + escapeAttr(currentBadge) + '" placeholder="e.g. ACADEMIC & RESEARCH" style="width:100%; box-sizing:border-box; padding:10px 14px; border:1px solid #cbd5e1; border-radius:8px; font-size:14px;">' +
            '</div>' +

            '<div style="margin-bottom: 16px;">' +
              '<label style="display:block; font-weight:700; font-size:13px; color:#0b2c4d; margin-bottom:6px;">Facility Description</label>' +
              '<textarea id="facModalDescInput" class="cms-url-input" rows="3" style="width:100%; box-sizing:border-box; padding:10px 14px; border:1px solid #cbd5e1; border-radius:8px; font-size:13.5px; font-family:inherit; line-height:1.5;">' + escapeAttr(currentDesc) + '</textarea>' +
            '</div>' +

            '<div style="margin-bottom: 18px; background: #f8fafc; padding: 16px; border-radius: 12px; border: 1px solid #e2e8f0;">' +
              '<label style="display:block; font-weight:700; font-size:13px; color:#0b2c4d; margin-bottom:10px;"><i class="fas fa-image" style="color:#1e8e3e;"></i> Card Background Image</label>' +
              
              '<div style="display:flex; gap:10px; margin-bottom:12px;">' +
                '<input type="text" id="facModalImgUrlInput" class="cms-url-input" value="' + escapeAttr(currentImg) + '" placeholder="Paste Image Web URL..." style="flex:1; padding:9px 12px; border:1px solid #cbd5e1; border-radius:8px; font-size:13px;">' +
                '<label for="facModalFileInput" style="background:#0b2c4d; color:#fff; padding:9px 16px; border-radius:8px; font-size:12.5px; font-weight:600; cursor:pointer; display:inline-flex; align-items:center; gap:6px;">' +
                  '<i class="fas fa-upload"></i> Upload' +
                '</label>' +
                '<input type="file" id="facModalFileInput" accept="image/*" style="display:none;">' +
              '</div>' +

              '<div style="height: 140px; border-radius: 10px; overflow: hidden; position: relative; background: #000; border:1px solid #cbd5e1;">' +
                '<img id="facModalImgPreview" src="' + escapeAttr(currentImg) + '" style="width:100%; height:100%; object-fit:cover;">' +
              '</div>' +
            '</div>' +

            '<div style="display:flex; gap:12px; margin-bottom:10px;">' +
              '<div style="flex:1;">' +
                '<label style="display:block; font-weight:700; font-size:13px; color:#0b2c4d; margin-bottom:6px;">Button / Action Text</label>' +
                '<input type="text" id="facModalBtnTextInput" class="cms-url-input" value="' + escapeAttr(currentLinkText) + '" style="width:100%; box-sizing:border-box; padding:10px 14px; border:1px solid #cbd5e1; border-radius:8px; font-size:13.5px;">' +
              '</div>' +

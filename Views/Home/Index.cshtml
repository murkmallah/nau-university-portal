          '<div style="padding: 16px 24px; background: #f8fafc; border-top: 1px solid #eef0f4; border-bottom-left-radius: 20px; border-bottom-right-radius: 20px; display: flex; justify-content: flex-end; gap: 10px;">' +
            '<button type="button" class="cms-modal-btn" id="cancelFacModal" style="background:#e2e8f0; color:#334155; border:none; padding:10px 20px; border-radius:8px; font-weight:600; cursor:pointer;">Cancel</button>' +
            '<button type="button" class="cms-modal-btn cms-modal-btn-primary" id="saveFacModal" style="background:#1e8e3e; color:#fff; border:none; padding:10px 24px; border-radius:8px; font-weight:700; cursor:pointer; display:inline-flex; align-items:center; gap:6px;"><i class="fas fa-check"></i> Apply &amp; Update Card</button>' +
          '</div>' +
        '</div>';

      document.body.appendChild(backdrop);

      var closeModal = function () {
        if (backdrop && backdrop.parentNode) {
          backdrop.parentNode.removeChild(backdrop);
        }
      };

      backdrop.querySelector("#closeFacModal").addEventListener("click", closeModal);
      backdrop.querySelector("#cancelFacModal").addEventListener("click", closeModal);

      var urlInput = backdrop.querySelector("#facModalImgUrlInput");
      var imgPreview = backdrop.querySelector("#facModalImgPreview");
      urlInput.addEventListener("input", function () {
        imgPreview.src = urlInput.value;
      });

      var fileInput = backdrop.querySelector("#facModalFileInput");
      fileInput.addEventListener("change", function () {
        if (fileInput.files && fileInput.files[0]) {
          var file = fileInput.files[0];
          var fd = new FormData();
          fd.append("file", file);
          urlInput.value = "Uploading file...";
          fetch("/Cms/UploadImage", { method: "POST", body: fd })
            .then(function (res) { return res.json(); })
            .then(function (data) {
              if (data && data.url) {
                urlInput.value = data.url;
                imgPreview.src = data.url;
              } else if (data && data.error) {
                alert(data.error);
                urlInput.value = currentImg;
              }
            })
            .catch(function (err) {
              alert("Error uploading image");
              urlInput.value = currentImg;
            });
        }
      });

      backdrop.querySelector("#saveFacModal").addEventListener("click", function () {
        var newTitle = backdrop.querySelector("#facModalTitleInput").value.trim();
        var newBadge = backdrop.querySelector("#facModalBadgeInput").value.trim();
        var newDesc = backdrop.querySelector("#facModalDescInput").value.trim();
        var newImg = backdrop.querySelector("#facModalImgUrlInput").value.trim();
        var newBtnText = backdrop.querySelector("#facModalBtnTextInput").value.trim();
        var newLink = backdrop.querySelector("#facModalLinkInput").value.trim();

        if (imgEl && newImg) imgEl.src = newImg;
        if (newLink) card.setAttribute("href", newLink);

        badgeEls.forEach(function (b) { b.textContent = newBadge; });
        titleEls.forEach(function (t) { t.textContent = newTitle; });
        if (descEl) descEl.textContent = newDesc;

        var linkTextNode = card.querySelector(".hv-card-link-text");
        if (linkTextNode) {
          linkTextNode.textContent = newBtnText;
        } else if (linkTextEl) {
          linkTextEl.innerHTML = escapeAttr(newBtnText) + ' <i class="fas fa-arrow-right"></i>';
        }

        closeModal();

        var statusEl = document.getElementById("cmsStatusText") || document.querySelector(".cms-status");
        if (statusEl) {
          statusEl.textContent = "Facility card updated! Click Save Changes at bottom to publish.";
        }
      });
    });

    function openVmvCRUDModal() {
      var vmvSec = document.querySelector(".vmv-section");
      if (!vmvSec) return;

      var visionCard = vmvSec.querySelector(".vmv-vision-card");
      var visionTag = visionCard ? (visionCard.querySelector(".vmv-pill-tag") ? visionCard.querySelector(".vmv-pill-tag").textContent.trim() : "PURPOSE & FUTURE") : "PURPOSE & FUTURE";
      var visionQuote = visionCard ? (visionCard.querySelector(".vmv-quote-dark") ? visionCard.querySelector(".vmv-quote-dark").textContent.replace(/^["“\s]+|["”\s]+$/g, "").trim() : "") : "";
      var visionFooter = visionCard ? (visionCard.querySelector(".vmv-card-footer-accent span") ? visionCard.querySelector(".vmv-card-footer-accent span").textContent.trim() : "Global Aviation Benchmark") : "";

      var missionCard = vmvSec.querySelector(".vmv-mission-card");
      var missionTag = missionCard ? (missionCard.querySelector(".vmv-pill-tag") ? missionCard.querySelector(".vmv-pill-tag").textContent.trim() : "COMMITMENT & OBJECTIVE") : "COMMITMENT & OBJECTIVE";
      var missionQuote = missionCard ? (missionCard.querySelector(".vmv-quote-light") ? missionCard.querySelector(".vmv-quote-light").textContent.replace(/^["“\s]+|["”\s]+$/g, "").trim() : "") : "";

      var pillarList = [];
      if (missionCard) {
        missionCard.querySelectorAll(".vmv-pillar").forEach(function (p) {
          var t = p.textContent.trim();
          if (t) pillarList.push(t);
        });
      }
      var missionPillarsStr = pillarList.join(", ");

      var valuesList = [];
      vmvSec.querySelectorAll(".vmv-value-item").forEach(function (item) {
        var name = item.querySelector(".vmv-val-name") ? item.querySelector(".vmv-val-name").textContent.trim() : "";
        var desc = item.querySelector(".vmv-val-desc") ? item.querySelector(".vmv-val-desc").textContent.trim() : "";
        var iconEl = item.querySelector(".vmv-val-icon i");
        var icon = iconEl ? iconEl.className : "fas fa-star";
        if (name) {
          valuesList.push({ name: name, desc: desc, icon: icon });
        }
      });

      var existingBackdrop = document.querySelector(".vmv-edit-modal-backdrop");
      if (existingBackdrop) existingBackdrop.remove();

      var backdrop = document.createElement("div");
      backdrop.className = "cms-image-modal-backdrop vmv-edit-modal-backdrop";
      backdrop.style.zIndex = "9999999";

      function esc(str) {
        if (!str) return "";
        return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
      }

      var modalHtml = [
        '<div class="cms-image-modal vmv-crud-modal" style="max-width: 780px; width:92%; border-radius: 20px; box-shadow: 0 25px 60px rgba(0,0,0,0.5); background:#fff; overflow:hidden;">',
          '<div style="background: #0b2c4d; padding: 20px 26px; display:flex; justify-content:space-between; align-items:center;">',
            '<h3 style="color:#fff; font-size:18px; font-weight:700; margin:0; display:flex; align-items:center; gap:10px;">',
              '<i class="fas fa-sliders" style="color:#4ed47a;"></i> Manage Vision, Mission &amp; Core Values',
            '</h3>',
            '<button type="button" class="vmv-close-btn" style="color:#fff; font-size:24px; cursor:pointer; background:none; border:none;">&times;</button>',
          '</div>',

          '<div style="padding: 24px; max-height: 72vh; overflow-y: auto;">',
            
            '<div class="vmv-modal-card-box" style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:16px; padding:20px; margin-bottom:20px;">',
              '<h4 style="margin:0 0 14px 0; color:#0b2c4d; font-size:15px; font-weight:800; display:flex; align-items:center; gap:8px;">',
                '<i class="fas fa-eye" style="color:#1e8e3e;"></i> 1. Vision Card Settings',
              '</h4>',
              '<div style="display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:14px;">',
                '<div>',
                  '<label style="display:block; font-size:12px; font-weight:700; color:#475569; margin-bottom:4px;">Category Tag</label>',
                  '<input type="text" id="vmvInpVisionTag" class="cms-url-input" value="' + esc(visionTag) + '" style="width:100%; box-sizing:border-box; padding:9px 12px; border:1px solid #cbd5e1; border-radius:8px; font-size:13px;">',
                '</div>',
                '<div>',
                  '<label style="display:block; font-size:12px; font-weight:700; color:#475569; margin-bottom:4px;">Footer Accent Text</label>',
                  '<input type="text" id="vmvInpVisionFooter" class="cms-url-input" value="' + esc(visionFooter) + '" style="width:100%; box-sizing:border-box; padding:9px 12px; border:1px solid #cbd5e1; border-radius:8px; font-size:13px;">',
                '</div>',
              '</div>',
              '<div>',
                '<label style="display:block; font-size:12px; font-weight:700; color:#475569; margin-bottom:4px;">Vision Statement / Quote</label>',
                '<textarea id="vmvInpVisionQuote" rows="2" style="width:100%; box-sizing:border-box; padding:9px 12px; border:1px solid #cbd5e1; border-radius:8px; font-size:13.5px; font-family:inherit; line-height:1.5;">' + esc(visionQuote) + '</textarea>',
              '</div>',
            '</div>',

            '<div class="vmv-modal-card-box" style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:16px; padding:20px; margin-bottom:20px;">',
              '<h4 style="margin:0 0 14px 0; color:#0b2c4d; font-size:15px; font-weight:800; display:flex; align-items:center; gap:8px;">',
                '<i class="fas fa-bullseye" style="color:#1e8e3e;"></i> 2. Mission Card Settings',
              '</h4>',
              '<div style="margin-bottom:14px;">',
                '<label style="display:block; font-size:12px; font-weight:700; color:#475569; margin-bottom:4px;">Category Tag</label>',
                '<input type="text" id="vmvInpMissionTag" class="cms-url-input" value="' + esc(missionTag) + '" style="width:100%; box-sizing:border-box; padding:9px 12px; border:1px solid #cbd5e1; border-radius:8px; font-size:13px;">',
              '</div>',
              '<div style="margin-bottom:14px;">',
                '<label style="display:block; font-size:12px; font-weight:700; color:#475569; margin-bottom:4px;">Mission Statement / Quote</label>',
                '<textarea id="vmvInpMissionQuote" rows="2" style="width:100%; box-sizing:border-box; padding:9px 12px; border:1px solid #cbd5e1; border-radius:8px; font-size:13.5px; font-family:inherit; line-height:1.5;">' + esc(missionQuote) + '</textarea>',
              '</div>',
              '<div>',
                '<label style="display:block; font-size:12px; font-weight:700; color:#475569; margin-bottom:4px;">Mission Pillars (Comma-separated tags)</label>',
                '<input type="text" id="vmvInpMissionPillars" class="cms-url-input" value="' + esc(missionPillarsStr) + '" placeholder="Safe, Secure, Efficient, Best-in-Class" style="width:100%; box-sizing:border-box; padding:9px 12px; border:1px solid #cbd5e1; border-radius:8px; font-size:13px;">',
              '</div>',
            '</div>',

            '<div class="vmv-modal-card-box" style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:16px; padding:20px;">',
              '<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">',
                '<h4 style="margin:0; color:#0b2c4d; font-size:15px; font-weight:800; display:flex; align-items:center; gap:8px;">',
                  '<i class="fas fa-layer-group" style="color:#1e8e3e;"></i> 3. Manage Core Values (CRUD)',
                '</h4>',
                '<button type="button" id="vmvAddNewValBtn" style="background:#1e8e3e; color:#fff; border:none; padding:7px 14px; border-radius:8px; font-size:12px; font-weight:700; cursor:pointer; display:flex; align-items:center; gap:6px;">',
                  '<i class="fas fa-plus"></i> Add New Value',
                '</button>',
              '</div>',
              '<div id="vmvCoreValuesContainer" style="display:flex; flex-direction:column; gap:12px;"></div>',
            '</div>',

          '</div>',

          '<div style="background:#f1f5f9; padding:16px 24px; display:flex; justify-content:flex-end; gap:12px; border-top:1px solid #e2e8f0;">',
            '<button type="button" class="vmv-close-btn" style="background:#94a3b8; color:#fff; border:none; padding:10px 20px; border-radius:8px; font-weight:600; cursor:pointer;">Cancel</button>',
            '<button type="button" id="vmvApplyChangesBtn" style="background:linear-gradient(135deg,#0b2c4d 0%,#1e8e3e 100%); color:#fff; border:none; padding:10px 24px; border-radius:8px; font-weight:700; cursor:pointer; display:flex; align-items:center; gap:8px;">',
              '<i class="fas fa-check"></i> Apply &amp; Save VMV Section',
            '</button>',
          '</div>',
        '</div>'
      ].join('');

      backdrop.innerHTML = modalHtml;
      document.body.appendChild(backdrop);

      var container = backdrop.querySelector("#vmvCoreValuesContainer");

      function renderValueRow(val) {
        var row = document.createElement("div");
        row.className = "vmv-val-edit-row";
        row.style.cssText = "background:#ffffff; border:1px solid #cbd5e1; border-radius:12px; padding:14px; position:relative;";
        row.innerHTML = [
          '<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">',
            '<span style="font-size:12px; font-weight:800; color:#1e8e3e; text-transform:uppercase;">Core Value Item</span>',
            '<button type="button" class="vmv-del-row-btn" style="background:rgba(220,38,38,0.1); color:#dc2626; border:none; padding:4px 10px; border-radius:6px; font-size:11px; font-weight:700; cursor:pointer; display:flex; align-items:center; gap:4px;">',
              '<i class="fas fa-trash-can"></i> Delete',
            '</button>',
          '</div>',
          '<div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:8px;">',
            '<div>',
              '<label style="display:block; font-size:11px; font-weight:700; color:#475569; margin-bottom:3px;">Value Title</label>',
              '<input type="text" class="vmv-row-name" value="' + esc(val.name) + '" style="width:100%; box-sizing:border-box; padding:7px 10px; border:1px solid #cbd5e1; border-radius:6px; font-size:13px; font-weight:700;">',
            '</div>',
            '<div>',
              '<label style="display:block; font-size:11px; font-weight:700; color:#475569; margin-bottom:3px;">FontAwesome Icon Class</label>',
              '<input type="text" class="vmv-row-icon" value="' + esc(val.icon) + '" placeholder="fas fa-star" style="width:100%; box-sizing:border-box; padding:7px 10px; border:1px solid #cbd5e1; border-radius:6px; font-size:12px;">',
            '</div>',
          '</div>',
          '<div>',
            '<label style="display:block; font-size:11px; font-weight:700; color:#475569; margin-bottom:3px;">Description / Subtext</label>',
            '<input type="text" class="vmv-row-desc" value="' + esc(val.desc) + '" style="width:100%; box-sizing:border-box; padding:7px 10px; border:1px solid #cbd5e1; border-radius:6px; font-size:12px;">',
          '</div>'
        ].join('');

        row.querySelector(".vmv-del-row-btn").addEventListener("click", function () {
          row.remove();
        });

        container.appendChild(row);
      }

      valuesList.forEach(function (v) { renderValueRow(v); });

      backdrop.querySelector("#vmvAddNewValBtn").addEventListener("click", function () {
        renderValueRow({ name: "New Core Value", desc: "Short description here", icon: "fas fa-star" });
      });

      backdrop.querySelectorAll(".vmv-close-btn").forEach(function (btn) {
        btn.addEventListener("click", function () { backdrop.remove(); });
      });

      backdrop.querySelector("#vmvApplyChangesBtn").addEventListener("click", function () {
        var newVisionTag = backdrop.querySelector("#vmvInpVisionTag").value.trim();
        var newVisionFooter = backdrop.querySelector("#vmvInpVisionFooter").value.trim();
        var newVisionQuote = backdrop.querySelector("#vmvInpVisionQuote").value.trim();

        var newMissionTag = backdrop.querySelector("#vmvInpMissionTag").value.trim();
        var newMissionQuote = backdrop.querySelector("#vmvInpMissionQuote").value.trim();
        var newMissionPillarsStr = backdrop.querySelector("#vmvInpMissionPillars").value.trim();

        if (visionCard) {
          var tagEl = visionCard.querySelector(".vmv-pill-tag");
          if (tagEl) tagEl.textContent = newVisionTag;

          var quoteEl = visionCard.querySelector(".vmv-quote-dark");
          if (quoteEl) quoteEl.innerHTML = "&ldquo;" + esc(newVisionQuote) + "&rdquo;";

          var footSpan = visionCard.querySelector(".vmv-card-footer-accent span");
          if (footSpan) footSpan.innerHTML = '<i class="fas fa-globe-asia"></i> ' + esc(newVisionFooter);
        }

        if (missionCard) {
          var mTagEl = missionCard.querySelector(".vmv-pill-tag");
          if (mTagEl) mTagEl.textContent = newMissionTag;

          var mQuoteEl = missionCard.querySelector(".vmv-quote-light");
          if (mQuoteEl) mQuoteEl.innerHTML = "&ldquo;" + esc(newMissionQuote) + "&rdquo;";

          var pillarsRow = missionCard.querySelector(".vmv-pillars-row");
          if (pillarsRow) {
            var parts = newMissionPillarsStr.split(",").map(function (s) { return s.trim(); }).filter(Boolean);
            var pillarsHtml = parts.map(function (p) {
              return '<span class="vmv-pillar"><i class="fas fa-check"></i> ' + esc(p) + '</span>';
            }).join('');
            pillarsRow.innerHTML = pillarsHtml;
          }
        }

        var valuesGrid = vmvSec.querySelector(".vmv-values-grid");
        if (valuesGrid) {
          var newRows = container.querySelectorAll(".vmv-val-edit-row");
          var gridHtml = "";
          newRows.forEach(function (r) {
            var name = r.querySelector(".vmv-row-name").value.trim();
            var icon = r.querySelector(".vmv-row-icon").value.trim() || "fas fa-star";
            var desc = r.querySelector(".vmv-row-desc").value.trim();

            gridHtml += [
              '<div class="vmv-value-item">',
                '<div class="vmv-val-icon"><i class="' + esc(icon) + '"></i></div>',
                '<div class="vmv-val-info">',
                  '<span class="vmv-val-name">' + esc(name) + '</span>',
                  '<span class="vmv-val-desc">' + esc(desc) + '</span>',
                '</div>',
              '</div>'
            ].join('');
          });
          valuesGrid.innerHTML = gridHtml;
        }

        backdrop.remove();

        var cmsStatus = document.getElementById("cmsStatus") || document.getElementById("cmsStatusText");
        if (cmsStatus) {
          cmsStatus.textContent = "VMV Section updated! Click Save Changes to publish.";
          cmsStatus.style.color = "#4ed47a";
        }
      });
    }
  });
</script>

<partial name="_PublicModals" />
<script src="~/js/public-modals.js" asp-append-version="true"></script>
<script src="~/js/cms-icon-picker.js" asp-append-version="true"></script>
<partial name="_AdminFloatingBar" />
</body>
</html>

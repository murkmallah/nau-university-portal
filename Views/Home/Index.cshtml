                '<label style="display:block; font-weight:700; font-size:13px; color:#0b2c4d; margin-bottom:6px;">Target Page Link</label>' +
                '<input type="text" id="facModalLinkInput" class="cms-url-input" value="' + escapeAttr(currentHref) + '" style="width:100%; box-sizing:border-box; padding:10px 14px; border:1px solid #cbd5e1; border-radius:8px; font-size:13.5px;">' +
              '</div>' +
            '</div>' +


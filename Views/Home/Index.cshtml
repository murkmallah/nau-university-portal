<script>
    // Tells the shared navbar script (home-scripts.js) whether someone is
    // logged in, so the Account button can show the right state.
    window.NAU_AUTH = {
        isAuthenticated: @Html.Raw(User.Identity != null && User.Identity.IsAuthenticated ? "true" : "false"),
        isAdmin: @Html.Raw(isAdmin ? "true" : "false"),
        userName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)ViewBag.CurrentUserName ?? ""))
    };

    function initTickerAutoScroll() {
      document.querySelectorAll('.ticker-container').forEach(function(container) {
        var wrapper = container.querySelector('.ticker-scroll-wrapper');
        if (!wrapper) return;
        var isManual = false;
        var timer;
        container.addEventListener('scroll', function() {
          isManual = true;
          wrapper.style.animationPlayState = 'paused';
          clearTimeout(timer);
          timer = setTimeout(function() {
            isManual = false;
            if (!container.matches(':hover')) {
              wrapper.style.animationPlayState = 'running';
            }
          }, 2000);
        });
        container.addEventListener('mouseenter', function() {
          wrapper.style.animationPlayState = 'paused';
        });
        container.addEventListener('mouseleave', function() {
          if (!isManual) {
            wrapper.style.animationPlayState = 'running';
          }
        });
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTickerAutoScroll);
    } else {
      initTickerAutoScroll();
    }
</script>

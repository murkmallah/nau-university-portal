@model NAU_Web.Models.Page
@{
    Layout = null;
    var isSuperAdmin = User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin");
    var isAdmin = User.Identity != null && User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Staff"));
    var canEdit = ViewBag.CanEdit == true;
    var editMode = ViewBag.EditMode == true;   // true only when reached via Admin Panel "Edit Homepage" link
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>@Model.Title</title>
<partial name="_Favicon" />

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Open+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link rel="stylesheet" href="~/css/public-site.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/home.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/mobile-nav.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/public-modals.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/cms-icon-picker.css" asp-append-version="true">

@if (editMode)
{
    <link rel="stylesheet" href="~/css/cms-editor.css" asp-append-version="true">
}
</head>
<body>

@if (editMode)
{
    <div class="cms-mode-banner">
        <i class="fas fa-lock"></i> You are viewing this page in <strong>Admin Edit Mode</strong>.
        <a href="/">Exit to normal view</a>
        <a href="/Admin" style="margin-left:14px;"><i class="fas fa-user-shield"></i> Admin Panel</a>
    </div>
}

@{
    string homeContent = Model?.ContentHtml ?? "";
    var heroIdx = homeContent.IndexOf("<div class=\"hero\"", StringComparison.OrdinalIgnoreCase);
    if (heroIdx < 0) heroIdx = homeContent.IndexOf("<section class=\"hero\"", StringComparison.OrdinalIgnoreCase);
    if (heroIdx < 0) heroIdx = homeContent.IndexOf("<div class=\"hero-slides\"", StringComparison.OrdinalIgnoreCase);

    if (heroIdx >= 0)
    {
        // Everything before <div class="hero"> is the legacy announcement + navbar block
        homeContent = homeContent.Substring(heroIdx);
    }
    else
    {
        var annIdx = homeContent.IndexOf("<div class=\"announcement\"", StringComparison.OrdinalIgnoreCase);
        if (annIdx >= 0)
        {
            var navIdx = homeContent.IndexOf("<div class=\"navbar\"", annIdx, StringComparison.OrdinalIgnoreCase);
            if (navIdx < 0) navIdx = homeContent.IndexOf("<nav", annIdx, StringComparison.OrdinalIgnoreCase);
            if (navIdx >= 0)
            {
                var navEndIdx = homeContent.IndexOf("</nav>", navIdx, StringComparison.OrdinalIgnoreCase);
                if (navEndIdx >= 0)
                {
                    navEndIdx += "</nav>".Length;
                }
                else
                {
                    // If navbar was a div, find closing </div> of .menu / .navbar
                    var searchWrapIdx = homeContent.IndexOf("class=\"search-wrap\"", navIdx, StringComparison.OrdinalIgnoreCase);
                    if (searchWrapIdx >= 0)
                    {
                        var divEnd = homeContent.IndexOf("</div>", searchWrapIdx, StringComparison.OrdinalIgnoreCase);
                        if (divEnd >= 0)
                        {
                            divEnd = homeContent.IndexOf("</div>", divEnd + 6, StringComparison.OrdinalIgnoreCase);
                            if (divEnd >= 0) navEndIdx = divEnd + 6;
                        }
                    }
                }
                var afterNavIdx = navEndIdx >= 0 ? navEndIdx : navIdx;
                homeContent = homeContent.Substring(0, annIdx) + homeContent.Substring(afterNavIdx);
            }
        }
    }

    var footerIdx = homeContent.IndexOf("<footer", StringComparison.OrdinalIgnoreCase);
    if (footerIdx >= 0)
    {
        homeContent = homeContent.Substring(0, footerIdx);
    }

    // Clean up quick bar from homeContent
    homeContent = System.Text.RegularExpressions.Regex.Replace(homeContent, @"<div\s+class=""hero-quick-bar-wrap""[\s\S]*?</div>\s*</div>", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    var latestNewsList = ViewBag.LatestNews as List<NAU_Web.Models.NewsPost> ?? new List<NAU_Web.Models.NewsPost>();
    var upcomingEventsList = ViewBag.UpcomingEvents as List<NAU_Web.Models.Event> ?? new List<NAU_Web.Models.Event>();

    // Build dynamic Latest News HTML
    var newsItemsHtml = new System.Text.StringBuilder();
    foreach (var n in latestNewsList)
    {
        var iconClass = !string.IsNullOrWhiteSpace(n.Icon) ? n.Icon : "fas fa-newspaper";
        var imgOrIcon = !string.IsNullOrWhiteSpace(n.ImageUrl)
            ? "<div class=\"news-img-placeholder\" style=\"background-image:url('" + n.ImageUrl + "');background-size:cover;background-position:center;\"></div>"
            : "<div class=\"news-img-placeholder\"><i class=\"" + iconClass + "\"></i></div>";

        var bodySnippet = !string.IsNullOrWhiteSpace(n.Body)
            ? (n.Body.Length > 90 ? n.Body.Substring(0, 90) + "..." : n.Body)
            : "";

        newsItemsHtml.Append("<div class=\"news-item\" style=\"cursor:pointer;\" onclick=\"window.location.href='/NewsPosts/Public?id=" + n.NewsPostId + "';\">");
        newsItemsHtml.Append(imgOrIcon);
        newsItemsHtml.Append("<div class=\"news-body\">");
        newsItemsHtml.Append("<h4>" + System.Net.WebUtility.HtmlEncode(n.Title) + "</h4>");
        newsItemsHtml.Append("<div class=\"news-meta\"><i class=\"far fa-calendar\"></i> " + n.PublishDate.ToString("MMMM d, yyyy") + "</div>");
        newsItemsHtml.Append("<p>" + System.Net.WebUtility.HtmlEncode(bodySnippet) + "</p>");
        newsItemsHtml.Append("</div></div>");
    }

    var newsTickerHtml = new System.Text.StringBuilder();
    newsTickerHtml.Append("<div class=\"ticker-container\" style=\"height:300px;overflow:hidden;position:relative;\">");
    if (latestNewsList.Any())
    {
        var animDuration = Math.Max(12, latestNewsList.Count * 6);
        newsTickerHtml.Append("<div class=\"ticker-scroll-wrapper\" style=\"animation: verticalTickerScroll " + animDuration + "s linear infinite;\">");
        newsTickerHtml.Append(newsItemsHtml.ToString());
        newsTickerHtml.Append(newsItemsHtml.ToString());
        newsTickerHtml.Append("</div>");
    }
    else
    {
        newsTickerHtml.Append("<p style=\"padding:20px;color:#64748b;font-size:14px;\">No recent news announcements available.</p>");
    }
    newsTickerHtml.Append("</div>");

    // Build dynamic Upcoming Events HTML
    var eventsItemsHtml = new System.Text.StringBuilder();
    foreach (var ev in upcomingEventsList)
    {
        var monthStr = ev.EventDate.ToString("MMM").ToUpper();
        var dayStr = ev.EventDate.ToString("dd");
        var timeStr = ev.StartTime.HasValue
            ? (ev.EndTime.HasValue ? ev.StartTime.Value.ToString("hh:mm tt") + " – " + ev.EndTime.Value.ToString("hh:mm tt") : ev.StartTime.Value.ToString("hh:mm tt"))
            : "TBA";
        var locStr = !string.IsNullOrWhiteSpace(ev.Location) ? ev.Location : "NAU Main Campus";

        eventsItemsHtml.Append("<div class=\"event-item\" style=\"cursor:pointer;\" onclick=\"openEvents(event);\">");
        eventsItemsHtml.Append("<div class=\"event-date\"><div class=\"month\">" + monthStr + "</div><div class=\"day\">" + dayStr + "</div></div>");
        eventsItemsHtml.Append("<div class=\"event-body\">");
        eventsItemsHtml.Append("<h4>" + System.Net.WebUtility.HtmlEncode(ev.Title) + "</h4>");
        eventsItemsHtml.Append("<div class=\"event-detail\"><i class=\"fas fa-map-marker-alt\"></i> " + System.Net.WebUtility.HtmlEncode(locStr) + "</div>");
        eventsItemsHtml.Append("<div class=\"event-detail\"><i class=\"far fa-clock\"></i> " + System.Net.WebUtility.HtmlEncode(timeStr) + "</div>");
        eventsItemsHtml.Append("</div></div>");
    }

    var eventsTickerHtml = new System.Text.StringBuilder();
    eventsTickerHtml.Append("<div class=\"ticker-container\" style=\"height:300px;overflow:hidden;position:relative;\">");
    if (upcomingEventsList.Any())
    {
        var animDurationEv = Math.Max(12, upcomingEventsList.Count * 6);
        eventsTickerHtml.Append("<div class=\"ticker-scroll-wrapper\" style=\"animation: verticalTickerScroll " + animDurationEv + "s linear infinite;\">");
        eventsTickerHtml.Append(eventsItemsHtml.ToString());
        eventsTickerHtml.Append(eventsItemsHtml.ToString());
        eventsTickerHtml.Append("</div>");
    }
    else
    {
        eventsTickerHtml.Append("<p style=\"padding:20px;color:#64748b;font-size:14px;\">No upcoming events scheduled.</p>");
    }
    eventsTickerHtml.Append("</div>");

    // Construct full section.news-events replacement block
    var sectionSb = new System.Text.StringBuilder();
    sectionSb.Append("<section class=\"news-events\">");
    sectionSb.Append("<div class=\"news-events-inner\">");
    sectionSb.Append("<div class=\"news-col\">");
    sectionSb.Append("<div class=\"section-head\">");
    sectionSb.Append("<h3>LATEST NEWS</h3>");
    sectionSb.Append("<a href=\"/NewsPosts/Public\" class=\"view-all\">View All News</a>");
    sectionSb.Append("</div>");
    sectionSb.Append(newsTickerHtml.ToString());
    sectionSb.Append("</div>");
    sectionSb.Append("<div class=\"news-col\">");
    sectionSb.Append("<div class=\"section-head\">");
    sectionSb.Append("<h3>UPCOMING EVENTS</h3>");
    sectionSb.Append("<a href=\"#\" onclick=\"openEvents(event); return false;\" class=\"view-all\">View All Events</a>");
    sectionSb.Append("</div>");
    sectionSb.Append(eventsTickerHtml.ToString());
    sectionSb.Append("</div>");
    sectionSb.Append("</div>");
    sectionSb.Append("</section>");

    homeContent = System.Text.RegularExpressions.Regex.Replace(
        homeContent,
        @"<section\s+class=""news-events"">[\s\S]*?</section>",
        sectionSb.ToString(),
        System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    // Thorough multi-pass cleanup of ALL faculty sections, grids, cards, and residual fragments from homeContent
    homeContent = System.Text.RegularExpressions.Regex.Replace(homeContent, @"<section\s+class=""(faculties|programs|schools-section)""[\s\S]*?</section>", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
    homeContent = System.Text.RegularExpressions.Regex.Replace(homeContent, @"<div\s+class=""(faculty-grid|faculties-grid)""[\s\S]*?</div>", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
    homeContent = System.Text.RegularExpressions.Regex.Replace(homeContent, @"<a\s+[^>]*?(faculty-card|/Faculties/Detail)[^>]*>[\s\S]*?</a>", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
    homeContent = System.Text.RegularExpressions.Regex.Replace(homeContent, @"<a\s+[^>]*?>[\s\S]*?Faculty of (Engineering|IT|Aviation|Management)[\s\S]*?</a>", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
    homeContent = System.Text.RegularExpressions.Regex.Replace(homeContent, @"<div\s+class=""faculty-card""[^>]*?>[\s\S]*?</div>", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
    homeContent = System.Text.RegularExpressions.Regex.Replace(homeContent, @"max-width:\s*1[13]80px", "max-width:1480px", System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    // Ensure Facts & Figures section is present after section.news-events if missing in homeContent
    if (!System.Text.RegularExpressions.Regex.IsMatch(homeContent, @"<section\s+class=""facts2""", System.Text.RegularExpressions.RegexOptions.IgnoreCase))
    {
        var factsTemplate = @"<section class=""facts2"">
  <div class=""facts-inner"">
    <div class=""section-head"" style=""max-width:1480px;margin:0 auto 0;border-bottom:2px solid var(--green);padding-bottom:14px;margin-bottom:30px;justify-content:center;"">
      <h3 style=""font-family:var(--font-head);font-size:18px;font-weight:700;color:var(--navy);text-transform:uppercase;letter-spacing:0.5px;"">FACTS &amp; FIGURES</h3>
    </div>
    <div class=""facts-grid"">
      <div class=""fact-item"">
        <div class=""fact-icon""><i class=""fas fa-university""></i></div>
        <div class=""fact-number"">2026</div>
        <div class=""fact-label"">Year of Establishment</div>
      </div>
      <div class=""fact-item"">
        <div class=""fact-icon""><i class=""fas fa-user-graduate""></i></div>
        <div class=""fact-number"">19935</div>
        <div class=""fact-label"">Students Enrolled</div>
      </div>
      <div class=""fact-item"">
        <div class=""fact-icon""><i class=""fas fa-book-open""></i></div>
        <div class=""fact-number"">2474</div>
        <div class=""fact-label"">Total Courses</div>
      </div>
      <div class=""fact-item"">
        <div class=""fact-icon""><i class=""fas fa-chart-line""></i></div>
        <div class=""fact-number"">23313</div>
        <div class=""fact-label"">G. Total</div>
      </div>
      <div class=""fact-item"">
        <div class=""fact-icon""><i class=""fas fa-briefcase""></i></div>
        <div class=""fact-number"">2126</div>
        <div class=""fact-label"">Govt/Corporate</div>
      </div>
      <div class=""fact-item"">
        <div class=""fact-icon""><i class=""fas fa-globe""></i></div>
        <div class=""fact-number"">49</div>
        <div class=""fact-label"">Number of States which have sent trainees to CATI</div>
      </div>
    </div>
  </div>
</section>";

        if (System.Text.RegularExpressions.Regex.IsMatch(homeContent, @"<section\s+class=""news-events""[\s\S]*?</section>", System.Text.RegularExpressions.RegexOptions.IgnoreCase))
        {
            homeContent = System.Text.RegularExpressions.Regex.Replace(
                homeContent,
                @"<section\s+class=""news-events""[\s\S]*?</section>",
                "$0" + factsTemplate,
                System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        }
        else
        {
            homeContent += factsTemplate;
        }
    }

    // Build dynamic Our Faculties & Specialized Schools HTML
    var facultiesList = ViewBag.Faculties as List<NAU_Web.Models.Faculty> ?? new List<NAU_Web.Models.Faculty>();
    var schoolsList = ViewBag.Schools as List<NAU_Web.Models.School> ?? new List<NAU_Web.Models.School>();

    var facultiesSb = new System.Text.StringBuilder();
    var schoolsSb = new System.Text.StringBuilder();

    if (facultiesList.Any())
    {
        facultiesSb.Append("<section class=\"programs\">");
        facultiesSb.Append("<div class=\"programs-inner\">");
        facultiesSb.Append("<div class=\"section-head\" style=\"max-width:1480px;margin:0 auto 0;border-bottom:2px solid var(--green);padding-bottom:14px;margin-bottom:30px;justify-content:center;\">");
        facultiesSb.Append("<h3 style=\"font-family:var(--font-head);font-size:18px;font-weight:700;color:var(--navy);text-transform:uppercase;letter-spacing:0.5px;\">OUR FACULTIES</h3>");
        facultiesSb.Append("</div>");
        facultiesSb.Append("<div class=\"faculty-grid\">");

        foreach (var f in facultiesList)
        {
            var iconClass = !string.IsNullOrWhiteSpace(f.Icon) ? f.Icon : "fas fa-graduation-cap";
            var introText = !string.IsNullOrWhiteSpace(f.Description) ? f.Description : "";
            var name = !string.IsNullOrWhiteSpace(f.Name) ? f.Name : "Faculty";

            facultiesSb.Append("<a href=\"/Faculties/Detail/" + f.Slug + "\" class=\"faculty-card\">");
            facultiesSb.Append("<div class=\"faculty-header\">");
            facultiesSb.Append("<div class=\"faculty-header-icon\"><i class=\"" + iconClass + "\"></i></div>");
            facultiesSb.Append("<div class=\"faculty-header-text\">");
            facultiesSb.Append("<div class=\"faculty-name\">" + System.Net.WebUtility.HtmlEncode(name) + "</div>");
            facultiesSb.Append("<div class=\"faculty-caption\">" + System.Net.WebUtility.HtmlEncode(introText) + "</div>");
            facultiesSb.Append("</div></div>");
            facultiesSb.Append("<div class=\"faculty-footer\">");
            facultiesSb.Append("<span class=\"faculty-explore\">Explore Faculty <i class=\"fas fa-arrow-right\"></i></span>");
            facultiesSb.Append("</div></a>");
        }

        facultiesSb.Append("</div></div></section>");
    }

    if (schoolsList.Any())
    {
        schoolsSb.Append("<section class=\"schools-section\">");
        schoolsSb.Append("<div class=\"schools-inner\">");
        schoolsSb.Append("<div class=\"section-head\" style=\"max-width:1480px;margin:0 auto 0;border-bottom:2px solid var(--green);padding-bottom:14px;margin-bottom:30px;justify-content:center;\">");
        schoolsSb.Append("<h3 style=\"font-family:var(--font-head);font-size:18px;font-weight:700;color:var(--navy);text-transform:uppercase;letter-spacing:0.5px;\"><i class=\"fas fa-school\" style=\"color:var(--green);margin-right:8px;\"></i> OUR SPECIALIZED SCHOOLS</h3>");
        schoolsSb.Append("</div>");
        schoolsSb.Append("<div class=\"schools-grid\">");

        foreach (var s in schoolsList)
        {
            var iconClass = !string.IsNullOrWhiteSpace(s.Icon) ? s.Icon : "fas fa-school";
            var descText = !string.IsNullOrWhiteSpace(s.Description) ? s.Description : "";
            var sName = !string.IsNullOrWhiteSpace(s.Name) ? s.Name : "School";
            var imgUrl = !string.IsNullOrWhiteSpace(s.ImageUrl) ? s.ImageUrl : "/images/schools/school_ans.jpg";
            var targetSlug = !string.IsNullOrWhiteSpace(s.Slug) ? s.Slug : "navigation";
            var colorHex = !string.IsNullOrWhiteSpace(s.ColorHex) ? s.ColorHex : "#0b2c4d";

            schoolsSb.Append("<a href=\"/Courses/Public?school=" + targetSlug + "\" class=\"school-card\">");
            schoolsSb.Append("<div class=\"school-img-wrapper\">");
            schoolsSb.Append("<img src=\"" + System.Net.WebUtility.HtmlEncode(imgUrl) + "\" alt=\"" + System.Net.WebUtility.HtmlEncode(sName) + "\" class=\"school-card-img\" onerror=\"this.src='/images/schools/school_ans.jpg'\">");
            schoolsSb.Append("<div class=\"school-icon-badge\" style=\"background:" + colorHex + ";\"><i class=\"" + iconClass + "\"></i></div>");
            schoolsSb.Append("</div>");
            schoolsSb.Append("<div class=\"school-card-body\">");
            schoolsSb.Append("<h4 class=\"school-card-title\">" + System.Net.WebUtility.HtmlEncode(sName) + "</h4>");
            schoolsSb.Append("<p class=\"school-card-desc\">" + System.Net.WebUtility.HtmlEncode(descText) + "</p>");
            schoolsSb.Append("</div>");
            schoolsSb.Append("<div class=\"school-card-footer\">");
            schoolsSb.Append("<span class=\"school-explore\">Explore Courses <i class=\"fas fa-arrow-right\"></i></span>");
            schoolsSb.Append("</div></a>");
        }

        schoolsSb.Append("</div></div></section>");
    }

    // 1.5) Build dynamic Vision, Mission, Core Values HTML
    var vmvSb = new System.Text.StringBuilder();
    vmvSb.Append("<section class=\"vmv-section\">");
    vmvSb.Append("<div class=\"vmv-container\">");
    
    // Header
    vmvSb.Append("<div class=\"section-head vmv-header\">");
    vmvSb.Append("<div class=\"vmv-header-title-box\">");
    vmvSb.Append("<span class=\"vmv-eyebrow\"><i class=\"fas fa-compass\"></i> PAA STANDARDS &amp; PRINCIPLES</span>");
    vmvSb.Append("<h3 class=\"vmv-main-heading\">VISION, MISSION &amp; CORE VALUES</h3>");
    vmvSb.Append("</div>");
    if (editMode)
    {
        vmvSb.Append("<button type=\"button\" class=\"vmv-section-edit-btn\" id=\"openVmvEditModalBtn\"><i class=\"fas fa-pen-to-square\"></i> Edit Section</button>");
    }
    vmvSb.Append("</div>");

    // Top Duo: Vision & Mission Hero Cards
    vmvSb.Append("<div class=\"vmv-hero-grid\">");
    
    // Vision Card (Dark Navy Aviation Hero)
    vmvSb.Append("<div class=\"vmv-hero-card vmv-vision-card\">");
    vmvSb.Append("<div class=\"vmv-watermark-icon\"><i class=\"fas fa-compass\"></i></div>");
    vmvSb.Append("<div class=\"vmv-card-top\">");
    vmvSb.Append("<div class=\"vmv-icon-box vmv-icon-navy\"><i class=\"fas fa-eye\"></i></div>");
    vmvSb.Append("<span class=\"vmv-pill-tag tag-gold\">PURPOSE &amp; FUTURE</span>");
    vmvSb.Append("</div>");
    vmvSb.Append("<h3 class=\"vmv-title-white\">Our Vision</h3>");
    vmvSb.Append("<blockquote class=\"vmv-quote-dark\">&ldquo;To be a world-class service provider in the aviation industry&rdquo;</blockquote>");
    vmvSb.Append("<div class=\"vmv-card-footer-accent\">");
    vmvSb.Append("<span><i class=\"fas fa-globe-asia\"></i> Global Aviation Benchmark</span>");
    vmvSb.Append("</div>");
    vmvSb.Append("</div>");

    // Mission Card (Emerald Accent White Hero Card)
    vmvSb.Append("<div class=\"vmv-hero-card vmv-mission-card\">");
    vmvSb.Append("<div class=\"vmv-watermark-icon\"><i class=\"fas fa-bullseye\"></i></div>");
    vmvSb.Append("<div class=\"vmv-card-top\">");
    vmvSb.Append("<div class=\"vmv-icon-box vmv-icon-emerald\"><i class=\"fas fa-crosshairs\"></i></div>");
    vmvSb.Append("<span class=\"vmv-pill-tag tag-emerald\">COMMITMENT &amp; OBJECTIVE</span>");
    vmvSb.Append("</div>");
    vmvSb.Append("<h3 class=\"vmv-title-navy\">Our Mission</h3>");
    vmvSb.Append("<blockquote class=\"vmv-quote-light\">&ldquo;Provide safe, secure and efficient best-in-class aviation services to the stakeholders&rdquo;</blockquote>");
    vmvSb.Append("<div class=\"vmv-pillars-row\">");
    vmvSb.Append("<span class=\"vmv-pillar\"><i class=\"fas fa-shield-check\"></i> Safe</span>");
    vmvSb.Append("<span class=\"vmv-pillar\"><i class=\"fas fa-lock\"></i> Secure</span>");
    vmvSb.Append("<span class=\"vmv-pillar\"><i class=\"fas fa-bolt\"></i> Efficient</span>");
    vmvSb.Append("<span class=\"vmv-pillar\"><i class=\"fas fa-star\"></i> Best-in-Class</span>");
    vmvSb.Append("</div>");
    vmvSb.Append("</div>");

    vmvSb.Append("</div>"); // end vmv-hero-grid

    // Bottom Banner: Core Values Deck
    vmvSb.Append("<div class=\"vmv-values-banner\">");
    vmvSb.Append("<div class=\"vmv-values-banner-head\">");
    vmvSb.Append("<div class=\"vmv-values-badge\"><i class=\"fas fa-layer-group\"></i> GUIDING PRINCIPLES</div>");
    vmvSb.Append("<h4 class=\"vmv-values-title\">Core Values of NAU</h4>");
    vmvSb.Append("</div>");
    
    vmvSb.Append("<div class=\"vmv-values-grid\">");
    
    // 1 Integrity
    vmvSb.Append("<div class=\"vmv-value-item\">");
    vmvSb.Append("<div class=\"vmv-val-icon\"><i class=\"fas fa-shield-halved\"></i></div>");
    vmvSb.Append("<div class=\"vmv-val-info\">");
    vmvSb.Append("<span class=\"vmv-val-name\">Integrity</span>");
    vmvSb.Append("<span class=\"vmv-val-desc\">Uncompromising honesty &amp; standards</span>");
    vmvSb.Append("</div></div>");

    // 2 Professional Excellence
    vmvSb.Append("<div class=\"vmv-value-item\">");
    vmvSb.Append("<div class=\"vmv-val-icon\"><i class=\"fas fa-award\"></i></div>");
    vmvSb.Append("<div class=\"vmv-val-info\">");
    vmvSb.Append("<span class=\"vmv-val-name\">Professional Excellence</span>");
    vmvSb.Append("<span class=\"vmv-val-desc\">Mastery, quality &amp; growth</span>");
    vmvSb.Append("</div></div>");

    // 3 Commitment
    vmvSb.Append("<div class=\"vmv-value-item\">");
    vmvSb.Append("<div class=\"vmv-val-icon\"><i class=\"fas fa-handshake\"></i></div>");
    vmvSb.Append("<div class=\"vmv-val-info\">");
    vmvSb.Append("<span class=\"vmv-val-name\">Commitment</span>");
    vmvSb.Append("<span class=\"vmv-val-desc\">Dedicated to stakeholder success</span>");
    vmvSb.Append("</div></div>");

    // 4 Safety and Security
    vmvSb.Append("<div class=\"vmv-value-item\">");
    vmvSb.Append("<div class=\"vmv-val-icon\"><i class=\"fas fa-user-shield\"></i></div>");

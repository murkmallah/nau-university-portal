<partial name="_SiteFooter" />

<script>
/* ===== Mega-menu nav search icon/box ===== */
function toggleSearch() {
  const box = document.getElementById("searchBox");
  box.classList.toggle("open");
  if (box.classList.contains("open")) box.focus();
}
function closeSearch() {
  setTimeout(() => { document.getElementById("searchBox").classList.remove("open"); }, 150);
}

/* ===== Filter + Search (client-side, no page reload) ===== */
function filterNews(cat, btn){
  document.querySelectorAll('.news-filter-btn').forEach(b=>b.classList.remove('active'));
  if (btn) btn.classList.add('active');

  var feat = document.getElementById('newsFeatured');

  if (cat === 'expired') {
    if (feat) feat.style.display = 'none';
    document.querySelectorAll('#newsGrid .news-card').forEach(function(c){
      var isExpired = c.getAttribute('data-expired') === 'true';
      var isActive = c.getAttribute('data-active') === 'true';
      var match = (isExpired || !isActive);
      c.classList.toggle('hidden', !match);
      if (match) c.classList.remove('more-batch');
    });
  } else {
    document.querySelectorAll('#newsGrid .news-card').forEach(function(c){
      var isExpired = c.getAttribute('data-expired') === 'true';
      var isActive = c.getAttribute('data-active') === 'true';
      var matchesCat = (cat === 'all' || c.getAttribute('data-cat') === cat);
      var match = matchesCat && (!isExpired && isActive);
      c.classList.toggle('hidden', !match);
      if (match) c.classList.remove('more-batch');
    });
    if (feat){
      feat.style.display = (cat === 'all') ? '' : 'none';
    }
  }
}

function searchNews(q){
  q = q.trim().toLowerCase();
  document.querySelectorAll('#newsGrid .news-card').forEach(function(c){
    var isExpired = c.getAttribute('data-expired') === 'true';
    var isActive = c.getAttribute('data-active') === 'true';
    var title = c.querySelector('.nc-title') ? c.querySelector('.nc-title').textContent.toLowerCase() : '';
    var isMatch = (!isExpired && isActive) && (q === '' || title.includes(q));
    c.classList.toggle('hidden', !isMatch);
  });
  var feat = document.getElementById('newsFeatured');
  if (feat){ feat.style.display = (q === '') ? '' : 'none'; }
}

function loadMoreNews(){
  var hidden = document.querySelectorAll('#newsGrid .news-card.more-batch');
  var count = 0;
  hidden.forEach(function(c){
    if (count < 6){ c.classList.remove('hidden'); c.classList.remove('more-batch'); count++; }
  });
  if (document.querySelectorAll('#newsGrid .news-card.more-batch').length === 0){
    var btn = document.getElementById('loadMoreBtn');
    if (btn){ btn.innerHTML = '<i class="fas fa-check"></i> All news loaded'; btn.disabled = true; }
  }
}

/* ===== Photo Gallery: filter + lightbox (public, no login required) ===== */
var galleryPhotoData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    galleryPhotos.Select((g, i) => new
    {
        index = i,
        caption = g.Caption,
        album = g.Album,
        imageUrl = g.ImageUrl ?? "",
        icon = string.IsNullOrWhiteSpace(g.Icon) ? "fas fa-image" : g.Icon,
        gradient = new { c1 = PhotoGradient(g.PhotoId).C1, c2 = PhotoGradient(g.PhotoId).C2 }
    })
).Replace("</", "<\\/"));

function filterGallery(album, btn){
  document.querySelectorAll('.gallery-filter-btn').forEach(b=>b.classList.remove('active'));
  if (btn) btn.classList.add('active');

  document.querySelectorAll('#photoGrid .photo-item').forEach(function(tile){
    var match = (album === 'all' || tile.getAttribute('data-album') === album);
    tile.classList.toggle('hidden', !match);
  });
}

var currentLightboxIndex = 0;
function renderLightbox(idx){
  var data = galleryPhotoData[idx];
  if (!data) return;
  var imgEl = document.getElementById('lightboxImg');
  if (data.imageUrl){
    imgEl.style.backgroundImage = "url('" + data.imageUrl + "')";
    imgEl.innerHTML =
      '<button class="lightbox-nav prev" onclick="lightboxNav(-1)" type="button"><i class="fas fa-chevron-left"></i></button>' +
      '<button class="lightbox-nav next" onclick="lightboxNav(1)" type="button"><i class="fas fa-chevron-right"></i></button>' +
      '<button class="lightbox-close" onclick="closeLightbox()" type="button"><i class="fas fa-times"></i></button>';
  } else {
    imgEl.style.backgroundImage = 'linear-gradient(135deg,' + data.gradient.c1 + ',' + data.gradient.c2 + ')';
    imgEl.innerHTML =
      '<i class="' + data.icon + ' photo-thumb-icon"></i>' +
      '<button class="lightbox-nav prev" onclick="lightboxNav(-1)" type="button"><i class="fas fa-chevron-left"></i></button>' +
      '<button class="lightbox-nav next" onclick="lightboxNav(1)" type="button"><i class="fas fa-chevron-right"></i></button>' +
      '<button class="lightbox-close" onclick="closeLightbox()" type="button"><i class="fas fa-times"></i></button>';
  }
  document.getElementById('lightboxCaption').textContent = data.caption;
  document.getElementById('lightboxAlbum').textContent = data.album;
}

function openLightbox(idx){
  if (!galleryPhotoData.length) return;
  currentLightboxIndex = idx;
  renderLightbox(currentLightboxIndex);
  document.getElementById('lightbox').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function closeLightbox(){
  document.getElementById('lightbox').classList.remove('open');
  document.body.style.overflow = '';
}

function lightboxNav(dir){
  if (!galleryPhotoData.length) return;
  currentLightboxIndex = (currentLightboxIndex + dir + galleryPhotoData.length) % galleryPhotoData.length;
  renderLightbox(currentLightboxIndex);
}

document.addEventListener('keydown', function(e){
  if (e.key === 'Escape') closeLightbox();
  if (document.getElementById('lightbox').classList.contains('open')){
    if (e.key === 'ArrowLeft') lightboxNav(-1);
    if (e.key === 'ArrowRight') lightboxNav(1);
  }
});

/* ===== Video Gallery: playback modal (public, no login required) ===== */
function buildPlayerHtml(url){
  if (!url) {
    return '<div class="video-placeholder"><div class="video-placeholder-icon"><i class="fas fa-film"></i></div><p>No video source set for this entry yet.</p></div>';
  }
  var ytId = null;
  var watchMatch = url.match(/[?&]v=([^&]+)/);
  var shortMatch = url.match(/youtu\.be\/([^?&]+)/);
  var embedMatch = url.match(/youtube\.com\/embed\/([^?&]+)/);
  if (watchMatch) ytId = watchMatch[1];
  else if (shortMatch) ytId = shortMatch[1];
  else if (embedMatch) ytId = embedMatch[1];

  if (ytId) {
    return '<iframe src="https://www.youtube.com/embed/' + ytId + '?autoplay=1" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>';
  }
  if (/\.(mp4|webm|ogg)($|\?)/i.test(url)) {
    return '<video controls autoplay src="' + url + '"></video>';
  }
  // Fallback: try to embed whatever link was given (e.g. Vimeo, an already-embeddable URL)
  return '<iframe src="' + url + '" allowfullscreen></iframe>';
}

function openVideo(title, url){
  document.getElementById('vmTitle').textContent = title || 'Video';
  document.getElementById('videoPlayerArea').innerHTML = buildPlayerHtml(url);
  document.getElementById('videoPlayerModal').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function closeVideo(){
  document.getElementById('videoPlayerModal').classList.remove('open');
  document.getElementById('videoPlayerArea').innerHTML = '';
  document.body.style.overflow = '';
}
document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closeVideo(); });

/* ===== Section nav (Latest News / Photo Gallery / Video Gallery): keep the active tab in sync while scrolling ===== */
(function setupSecNav(){
  var links = document.querySelectorAll('.sec-nav-link');
  if (!links.length) return;
  var sections = Array.prototype.map.call(links, function(l){ return document.getElementById(l.dataset.section); }).filter(Boolean);

  links.forEach(function(link){
    link.addEventListener('click', function(){
      links.forEach(function(l){ l.classList.remove('active'); });
      link.classList.add('active');
    });
  });

  window.addEventListener('scroll', function(){
    var pos = window.scrollY + 120;
    var current = sections[0];
    sections.forEach(function(sec){ if (sec.offsetTop <= pos) current = sec; });
    if (!current) return;
    links.forEach(function(l){ l.classList.toggle('active', l.dataset.section === current.id); });
  }, { passive: true });
})();

var npToastTimer;
function showNpToast(message, isError){
  var toast = document.getElementById('npToast');
  if (!toast) return;
  toast.textContent = message;
  toast.className = isError ? 'show error' : 'show';
  clearTimeout(npToastTimer);
  npToastTimer = setTimeout(function(){ toast.className = ''; }, 3200);
}

/* ===== News Data Dictionary (client-side for instant modal opening) ===== */
var newsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    posts.ToDictionary(p => p.NewsPostId.ToString(), p => new
    {
        id = p.NewsPostId,
        title = p.Title,
        body = p.Body ?? "",
        category = string.IsNullOrWhiteSpace(p.Category) ? "News" : p.Category,
        icon = p.Icon ?? "",
        imageUrl = p.ImageUrl ?? "",
        publishDate = p.PublishDate.ToString("yyyy-MM-dd"),
        publishDateFormatted = p.PublishDate.ToString("MMMM d, yyyy"),
        expiresAt = p.ExpiresAt.HasValue ? p.ExpiresAt.Value.ToString("yyyy-MM-dd") : "",
        expiresAtFormatted = p.ExpiresAt.HasValue ? p.ExpiresAt.Value.ToString("MMMM d, yyyy") : "",
        isExpired = p.ExpiresAt.HasValue && p.ExpiresAt.Value < DateOnly.FromDateTime(DateTime.Now),
        isFeatured = p.IsFeatured,
        isActive = p.IsActive,
        isSplashScreen = p.IsSplashScreen,
        color = CatStyle(p.Category).Color,
        catIcon = string.IsNullOrWhiteSpace(p.Icon) ? CatStyle(p.Category).Icon : p.Icon
    })
).Replace("</", "<\\/"));

var isUserAdmin = @Html.Raw(editMode ? "true" : "false");
var activeNewsId = null;

function getAntiForgeryToken(){
  var el = document.querySelector('input[name="__RequestVerificationToken"]');
  return el ? el.value : '';
}

function openNewsDetailModal(id){
  var item = newsData[id];
  if (!item) return;
  activeNewsId = id;

  var viewMode = document.getElementById('ndViewMode');
  var editModeEl = document.getElementById('ndEditMode');
  if (viewMode) viewMode.style.display = 'block';
  if (editModeEl) editModeEl.style.display = 'none';

  document.getElementById('ndModalTitle').textContent = item.title;
  document.getElementById('ndCategoryText').textContent = item.category || 'News';
  document.getElementById('ndCategoryIcon').className = item.catIcon || 'fas fa-newspaper';
  document.getElementById('ndModalDate').textContent = item.publishDateFormatted;

  var featTag = document.getElementById('ndFeaturedTag');
  if (featTag) featTag.style.display = item.isFeatured ? 'inline-flex' : 'none';

  var splashTag = document.getElementById('ndSplashTag');
  if (splashTag) splashTag.style.display = 'none';

  var activeTag = document.getElementById('ndActiveTag');
  var inactiveTag = document.getElementById('ndInactiveTag');
  if (isUserAdmin) {
    if (activeTag) activeTag.style.display = (item.isActive !== false) ? 'inline-flex' : 'none';
    if (inactiveTag) inactiveTag.style.display = (item.isActive === false) ? 'inline-flex' : 'none';
  } else {
    if (activeTag) activeTag.style.display = 'none';
    if (inactiveTag) inactiveTag.style.display = 'none';
  }

  var hero = document.getElementById('ndHero');
  if (hero) {
    var c1 = item.color || '#0b2c4d';
    hero.style.background = 'linear-gradient(135deg,' + c1 + ', #1a5fa6)';
  }

  var imgWrap = document.getElementById('ndImageWrap');
  var imgEl = document.getElementById('ndImage');
  if (item.imageUrl && item.imageUrl.trim()){
    imgEl.src = item.imageUrl;
    imgWrap.style.display = 'flex';
  } else {
    imgWrap.style.display = 'none';
  }

  document.getElementById('ndContentBody').textContent = item.body || item.title;

  document.getElementById('newsDetailModal').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function closeNewsDetailModal(){
  var m = document.getElementById('newsDetailModal');
  if (m) m.classList.remove('open');
  document.body.style.overflow = '';
}

window.addEventListener('DOMContentLoaded', function(){
  var params = new URLSearchParams(window.location.search);
  var newsId = params.get('id');
  if (newsId && typeof newsData !== 'undefined' && newsData[newsId]){
    openNewsDetailModal(newsId);
  }
});

/* ===== Searchable Icon Picker & Banner Image Upload Helpers ===== */
var currentNewsIconCategory = 'all';

function filterIconCategory(cat, btn){
  currentNewsIconCategory = cat || 'all';
  var buttons = document.querySelectorAll('#ndIconCatTabs .nd-cat-tab-btn');
  buttons.forEach(function(b){ b.classList.remove('active'); });
  if (btn) btn.classList.add('active');
  var q = document.getElementById('ndIconSearchInput') ? document.getElementById('ndIconSearchInput').value : '';
  filterIconPicker(q);
}

function filterIconPicker(query){
  var q = (query || '').toLowerCase().trim();
  var cat = currentNewsIconCategory || 'all';
  var chips = document.querySelectorAll('#ndIconGrid .nd-icon-chip');
  chips.forEach(function(chip){
    var itemCat = chip.dataset.category || '';
    var search = (chip.dataset.search || '') + ' ' + (chip.dataset.name || '') + ' ' + (chip.dataset.icon || '');
    var matchesCat = (cat === 'all' || itemCat === cat);
    var matchesSearch = (!q || search.toLowerCase().indexOf(q) !== -1);

    if (matchesCat && matchesSearch){
      chip.style.display = 'flex';
    } else {
      chip.style.display = 'none';
    }
  });
}

function selectNewsIcon(iconClass, iconName, element){
  document.getElementById('ndFormIcon').value = iconClass || 'fas fa-newspaper';
  document.getElementById('ndSelectedIconPreview').className = iconClass || 'fas fa-newspaper';
  document.getElementById('ndSelectedIconName').textContent = iconName || iconClass || 'Icon';
  document.getElementById('ndSelectedIconClass').textContent = iconClass || 'fas fa-newspaper';

  var chips = document.querySelectorAll('#ndIconGrid .nd-icon-chip');
  chips.forEach(function(c){ c.classList.remove('active'); });
  if (element) element.classList.add('active');
}

function setNewsIconState(iconClass){
  var ic = iconClass || 'fas fa-newspaper';
  document.getElementById('ndFormIcon').value = ic;
  document.getElementById('ndSelectedIconPreview').className = ic;
  document.getElementById('ndSelectedIconClass').textContent = ic;

  var matchChip = document.querySelector('#ndIconGrid .nd-icon-chip[data-icon="' + ic + '"]');
  var chips = document.querySelectorAll('#ndIconGrid .nd-icon-chip');
  chips.forEach(function(c){ c.classList.remove('active'); });
  if (matchChip){
    matchChip.classList.add('active');
    document.getElementById('ndSelectedIconName').textContent = matchChip.dataset.name || 'Icon';
  } else {
    document.getElementById('ndSelectedIconName').textContent = 'Custom Icon';
  }
}

function syncNewsImageUrlPreview(url){
  var img = document.getElementById('ndBannerPreviewImg');
  var empty = document.getElementById('ndBannerPreviewEmpty');
  var removeBtn = document.getElementById('ndRemoveImgBtn');
  var u = (url || '').trim();

  if (u){
    img.src = u;
    img.style.display = 'block';
    empty.style.display = 'none';
    if (removeBtn) removeBtn.style.display = 'inline-flex';
  } else {
    img.src = '';
    img.style.display = 'none';
    empty.style.display = 'flex';
    if (removeBtn) removeBtn.style.display = 'none';
  }
}

function removeNewsBannerImage(){
  document.getElementById('ndFormImageUrl').value = '';
  document.getElementById('ndBannerFile').value = '';
  syncNewsImageUrlPreview('');
}

function toggleNewsUrlField(){
  var w = document.getElementById('ndUrlFieldWrap');
  if (w) w.style.display = (w.style.display === 'none' ? 'block' : 'none');
}

async function handleNewsImageFileChange(fileInput){
  var file = fileInput.files && fileInput.files[0];
  if (!file) return;

  var err = document.getElementById('ndFormError');
  if (err) err.style.display = 'none';

  if (file.size > 5 * 1024 * 1024){
    if (err){
      err.textContent = 'Banner image must be smaller than 5 MB.';
      err.style.display = 'block';
    }
    fileInput.value = '';
    return;
  }

  var formData = new FormData();
  formData.append('file', file);

  var uploadBtn = document.querySelector('.nd-upload-btn');
  var origHtml = uploadBtn ? uploadBtn.innerHTML : '';
  if (uploadBtn){
    uploadBtn.disabled = true;
    uploadBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Uploading...';
  }

  try {
    var res = await fetch('@Url.Action("UploadNewsImage", "NewsPosts")', {
      method: 'POST',
      headers: { 'RequestVerificationToken': getAntiForgeryToken() },
      body: formData
    });
    var data = await res.json();
    if (!res.ok || !data.success){
      if (err){
        err.textContent = data.message || 'Image upload failed. Please try again.';
        err.style.display = 'block';
      }
      return;
    }

    document.getElementById('ndFormImageUrl').value = data.url;
    syncNewsImageUrlPreview(data.url);
    showNpToast('\u2705 Banner image uploaded successfully.');
  } catch(ex){
    if (err){
      err.textContent = 'Network error while uploading image.';
      err.style.display = 'block';
    }
  } finally {
    if (uploadBtn){
      uploadBtn.disabled = false;
      uploadBtn.innerHTML = origHtml;
    }
  }
}

function openAddNewsDraftModal(){
  activeNewsId = null;
  var viewMode = document.getElementById('ndViewMode');
  var editModeEl = document.getElementById('ndEditMode');
  if (viewMode) viewMode.style.display = 'none';
  if (!editModeEl) return;
  editModeEl.style.display = 'block';

  document.getElementById('ndEditHeaderTitle').innerHTML = 'Create News Announcement <span class="nd-draft-badge">Draft</span>';
  document.getElementById('ndEditSubtitle').textContent = 'Fill in the announcement details below to save and publish';

  document.getElementById('ndFormTitle').value = '';
  document.getElementById('ndFormCategory').value = 'Academic';
  document.getElementById('ndFormDate').value = new Date().toISOString().slice(0, 10);
  var expDefault = new Date();
  expDefault.setFullYear(expDefault.getFullYear() + 1);
  var expEl = document.getElementById('ndFormExpiryDate');
  if (expEl) expEl.value = expDefault.toISOString().slice(0, 10);
  document.getElementById('ndFormBody').value = '';
  document.getElementById('ndFormIsActive').checked = true;
  document.getElementById('ndFormSplashScreen').checked = false;
  document.getElementById('ndFormFeatured').checked = false;

  currentNewsIconCategory = 'all';
  var catTabs1 = document.querySelectorAll('#ndIconCatTabs .nd-cat-tab-btn');
  catTabs1.forEach(function(b){ b.classList.remove('active'); });
  var allTabBtn1 = document.querySelector('#ndIconCatTabs .nd-cat-tab-btn[data-cat="all"]');
  if (allTabBtn1) allTabBtn1.classList.add('active');

  setNewsIconState('fas fa-newspaper');
  document.getElementById('ndIconSearchInput').value = '';
  filterIconPicker('');

  document.getElementById('ndFormImageUrl').value = '';
  document.getElementById('ndBannerFile').value = '';
  syncNewsImageUrlPreview('');

  var err = document.getElementById('ndFormError');
  if (err){ err.style.display = 'none'; err.textContent = ''; }

  document.getElementById('newsDetailModal').classList.add('open');
  document.body.style.overflow = 'hidden';
  document.getElementById('ndFormTitle').focus();
}

function openEditNewsModal(id){
  openNewsDetailModal(id);
  switchToEditNews();
}

function switchToEditNews(){
  var item = activeNewsId ? newsData[activeNewsId] : null;
  if (!item) return;

  var viewMode = document.getElementById('ndViewMode');
  var editModeEl = document.getElementById('ndEditMode');
  if (viewMode) viewMode.style.display = 'none';
  if (!editModeEl) return;
  editModeEl.style.display = 'block';

  document.getElementById('ndEditHeaderTitle').textContent = 'Edit News Announcement';
  document.getElementById('ndEditSubtitle').textContent = 'Modify announcement details and click Save';

  document.getElementById('ndFormTitle').value = item.title || '';
  document.getElementById('ndFormCategory').value = item.category || '';
  document.getElementById('ndFormDate').value = item.publishDate || '';
  var expEl = document.getElementById('ndFormExpiryDate');
  if (expEl) expEl.value = item.expiresAt || '';
  document.getElementById('ndFormBody').value = item.body || '';
  document.getElementById('ndFormIsActive').checked = (item.isActive !== false);
  document.getElementById('ndFormSplashScreen').checked = !!item.isSplashScreen;
  document.getElementById('ndFormFeatured').checked = !!item.isFeatured;

  currentNewsIconCategory = 'all';
  var catTabs2 = document.querySelectorAll('#ndIconCatTabs .nd-cat-tab-btn');
  catTabs2.forEach(function(b){ b.classList.remove('active'); });
  var allTabBtn2 = document.querySelector('#ndIconCatTabs .nd-cat-tab-btn[data-cat="all"]');
  if (allTabBtn2) allTabBtn2.classList.add('active');

  setNewsIconState(item.icon || item.catIcon || 'fas fa-newspaper');
  document.getElementById('ndIconSearchInput').value = '';
  filterIconPicker('');

  document.getElementById('ndFormImageUrl').value = item.imageUrl || '';
  document.getElementById('ndBannerFile').value = '';
  syncNewsImageUrlPreview(item.imageUrl || '');

  var err = document.getElementById('ndFormError');
  if (err){ err.style.display = 'none'; err.textContent = ''; }
  document.getElementById('ndFormTitle').focus();
}

function cancelNewsEdit(){
  if (activeNewsId && newsData[activeNewsId]){
    openNewsDetailModal(activeNewsId);
  } else {
    closeNewsDetailModal();
  }
}

async function saveNewsModalData(btn){
  var title = document.getElementById('ndFormTitle').value.trim();
  var body = document.getElementById('ndFormBody').value.trim();
  var category = document.getElementById('ndFormCategory').value.trim();
  var date = document.getElementById('ndFormDate').value;
  var expiryDate = document.getElementById('ndFormExpiryDate') ? document.getElementById('ndFormExpiryDate').value : '';
  var icon = document.getElementById('ndFormIcon').value.trim();
  var imageUrl = document.getElementById('ndFormImageUrl').value.trim();
  var isActive = document.getElementById('ndFormIsActive').checked;
  var isSplashScreen = document.getElementById('ndFormSplashScreen').checked;
  var isFeatured = document.getElementById('ndFormFeatured').checked;

  var err = document.getElementById('ndFormError');
  err.style.display = 'none';

  if (!title){
    err.textContent = 'Please provide a news headline / title.';
    err.style.display = 'block';
    return;
  }

  var payload = {
    Title: title,
    Body: body,
    Category: category,
    Icon: icon,
    ImageUrl: imageUrl,
    PublishDate: date,
    ExpiresAt: expiryDate,
    IsFeatured: isFeatured,
    IsActive: isActive,
    IsSplashScreen: isSplashScreen
  };

  var url = activeNewsId ? '@Url.Action("QuickUpdate", "NewsPosts")' : '@Url.Action("QuickAdd", "NewsPosts")';
  if (activeNewsId) payload.NewsPostId = activeNewsId;

  btn.disabled = true;
  var orig = btn.innerHTML;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';

  try {
    var res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
      body: JSON.stringify(payload)
    });
    var data = await res.json();
    if (!res.ok || !data.success){
      err.textContent = data.message || 'Could not save news post.';
      err.style.display = 'block';
      btn.disabled = false;
      btn.innerHTML = orig;
      return;
    }

    showNpToast('✅ "' + data.title + '" saved successfully.');
    setTimeout(function(){ window.location.reload(); }, 600);
  } catch(e){
    err.textContent = 'Network error while saving. Please try again.';
    err.style.display = 'block';
    btn.disabled = false;
    btn.innerHTML = orig;
  }
}

async function toggleNewsActive(btn, newsPostId){
  if (btn) btn.disabled = true;
  try {
    var res = await fetch('@Url.Action("ToggleActive", "NewsPosts")', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
      body: JSON.stringify({ NewsPostId: newsPostId })
    });
    var data = await res.json();
    if (!res.ok || !data.success){
      showNpToast(data.message || 'Could not toggle active status.', true);
      if (btn) btn.disabled = false;
      return;
    }
    showNpToast(data.isActive ? '✅ Post is now ACTIVE & visible to public' : '👁️‍🗨️ Post is now INACTIVE (Draft)', false);
    setTimeout(function(){ window.location.reload(); }, 600);
  } catch(e){
    showNpToast('Network error, please try again.', true);
    if (btn) btn.disabled = false;
  }
}



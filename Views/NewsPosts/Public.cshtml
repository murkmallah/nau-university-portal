@model IEnumerable<NAU_Web.Models.NewsPost>
@{
    Layout = null;
    bool isSuperAdmin = User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin");
    bool isAdmin = User.Identity != null && User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Staff"));
    bool canEdit = ViewBag.IsAdmin == true;
    bool editMode = ViewBag.EditMode == true;   // true only when reached via Admin Panel "News & Media" link (?edit=1)

    var posts = Model.ToList();
    var today = DateOnly.FromDateTime(DateTime.Now);

    var activePosts = posts.Where(p => p.IsActive && (p.ExpiresAt == null || p.ExpiresAt >= today)).ToList();
    var expiredPosts = posts.Where(p => !p.IsActive || (p.ExpiresAt.HasValue && p.ExpiresAt.Value < today)).ToList();

    // Pick the featured "main" story from activePosts (prefer IsFeatured, else most recent active post).
    var featuredMain = activePosts.FirstOrDefault(p => p.IsFeatured) ?? activePosts.FirstOrDefault();
    var sideStack = activePosts.Where(p => p.NewsPostId != featuredMain?.NewsPostId)
                          .Where(p => p.IsFeatured)
                          .Take(3)
                          .ToList();
    if (sideStack.Count < 3)
    {
        var extra = activePosts.Where(p => p.NewsPostId != featuredMain?.NewsPostId && !sideStack.Select(s => s.NewsPostId).Contains(p.NewsPostId))
                          .Take(3 - sideStack.Count);
        sideStack.AddRange(extra);
    }
    var excludedIds = new HashSet<int>(sideStack.Select(s => s.NewsPostId));
    if (featuredMain != null) excludedIds.Add(featuredMain.NewsPostId);
    var gridPosts = activePosts.Where(p => !excludedIds.Contains(p.NewsPostId)).ToList();

    var categories = posts.Select(p => string.IsNullOrWhiteSpace(p.Category) ? "News" : p.Category!.Trim())
                           .Distinct(StringComparer.OrdinalIgnoreCase)
                           .OrderBy(c => c)
                           .ToList();

    (string Color, string Icon) CatStyle(string? category)
    {
        var c = category ?? string.Empty;
        if (c.Contains("cpd", StringComparison.OrdinalIgnoreCase) || c.Contains("seminar", StringComparison.OrdinalIgnoreCase))
            return ("#1a5fa6", "fas fa-chalkboard-teacher");
        if (c.Contains("admission", StringComparison.OrdinalIgnoreCase))
            return ("#c87800", "fas fa-graduation-cap");
        if (c.Contains("academic", StringComparison.OrdinalIgnoreCase))
            return ("#7c3aed", "fas fa-award");
        if (c.Contains("event", StringComparison.OrdinalIgnoreCase) || c.Contains("training", StringComparison.OrdinalIgnoreCase))
            return ("#1e8e3e", "fas fa-calendar-check");
        return ("#0b2c4d", "fas fa-newspaper");
    }

    string CatSlug(string? category) => (string.IsNullOrWhiteSpace(category) ? "news" : category!.Trim().ToLowerInvariant().Replace(" ", "-"));

    // ---- Photo Gallery (separate table, own admin controls) ----
    var galleryPhotos = ((IEnumerable<NAU_Web.Models.GalleryPhoto>?)ViewBag.GalleryPhotos ?? Enumerable.Empty<NAU_Web.Models.GalleryPhoto>()).ToList();
    var galleryAlbums = galleryPhotos.Select(g => string.IsNullOrWhiteSpace(g.Album) ? "Campus Life" : g.Album!.Trim())
                                      .Distinct(StringComparer.OrdinalIgnoreCase)
                                      .OrderBy(a => a)
                                      .ToList();
    string AlbumSlug(string? album) => (string.IsNullOrWhiteSpace(album) ? "campus-life" : album!.Trim().ToLowerInvariant().Replace(" ", "-").Replace("&", "and"));

    (string C1, string C2) PhotoGradient(int seed)
    {
        var pairs = new (string, string)[]
        {
            ("#0b2c4d", "#1a5fa6"), ("#1e3a5f", "#2c6fad"), ("#1e5c2e", "#2ea04e"),
            ("#c87800", "#e8a020"), ("#4a1b6b", "#7c3aed"), ("#0b3d6b", "#1565c0"),
            ("#c0392b", "#e74c3c"), ("#16a085", "#1abc9c")
        };
        return pairs[Math.Abs(seed) % pairs.Length];
    }

    // ---- Video Gallery (separate table, own admin controls) -- 3rd section
    // of this same page, right after Photo Gallery. Not a standalone page. ----
    var galleryVideos = ((IEnumerable<NAU_Web.Models.GalleryVideo>?)ViewBag.GalleryVideos ?? Enumerable.Empty<NAU_Web.Models.GalleryVideo>()).ToList();

    string VideoCatColor(string? category)
    {
        var c = category ?? string.Empty;
        if (c.Contains("training", StringComparison.OrdinalIgnoreCase)) return "#1e8e3e";
        if (c.Contains("cpd", StringComparison.OrdinalIgnoreCase)) return "#1e8e3e";
        if (c.Contains("ceremony", StringComparison.OrdinalIgnoreCase) || c.Contains("convocation", StringComparison.OrdinalIgnoreCase)) return "#7c3aed";
        if (c.Contains("campus life", StringComparison.OrdinalIgnoreCase) || c.Contains("sport", StringComparison.OrdinalIgnoreCase)) return "#c87800";
        if (c.Contains("tour", StringComparison.OrdinalIgnoreCase)) return "#1a5fa6";
        return "#0b2c4d";
    }

    string FormatViews(int v)
    {
        if (v >= 1000)
        {
            var k = v / 1000.0;
            return k.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "k views";
        }
        return v + (v == 1 ? " view" : " views");
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>News &amp; Media - National Aviation University</title>
<partial name="_Favicon" />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Open+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link rel="stylesheet" href="~/css/public-site.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/news-page.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/mobile-nav.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/public-modals.css" asp-append-version="true">
</head>
<body>

<div id="npToast"></div>

@if (editMode)
{
    <div class="np-editbar">
        <i class="fas fa-lock"></i> You are viewing this page in <strong>Admin Edit Mode</strong>.
        <a href="/NewsPosts/Public">Exit to normal view</a>
        <a href="/Admin"><i class="fas fa-user-shield"></i> Admin Panel</a>
    </div>
}

<partial name="_SiteHeader" />

<div class="page-hero">
  <div class="page-hero-inner">
    <div class="page-hero-eyebrow">Campus Life &mdash; News &amp; Media</div>
    <h1>News &amp; Media</h1>
    <p>Stay up to date with the latest announcements, events, and news from National Aviation University.</p>
  </div>
</div>

<nav class="sec-nav" id="secNav">
  <a href="#latest-news" class="sec-nav-link active" data-section="latest-news"><i class="fas fa-newspaper"></i> Latest News</a>
  <a href="#photo-gallery" class="sec-nav-link" data-section="photo-gallery"><i class="fas fa-images"></i> Photo Gallery</a>
  <a href="#video-gallery" class="sec-nav-link" data-section="video-gallery"><i class="fas fa-video"></i> Video Gallery</a>
</nav>

<main class="nm-main">
  <section class="nm-section" id="latest-news">
    <div class="nm-section-label"><i class="fas fa-newspaper"></i> News</div>
    <h2>Latest News &amp; Announcements</h2>
    <div class="nm-divider"></div>

    <div class="news-filter-bar">
      <button class="news-filter-btn active" onclick="filterNews('all',this)">All</button>
      @foreach (var cat in categories)
      {
          <button class="news-filter-btn" onclick="filterNews('@CatSlug(cat)',this)">@cat</button>
      }
      @if (ViewBag.IsAdminUser == true || editMode)
      {
          <button class="news-filter-btn expired-tab-btn" onclick="filterNews('expired',this)" style="background:#fee2e2;color:#dc2626;border:1.5px solid #fca5a5;font-weight:700;"><i class="fas fa-clock"></i> Expired &amp; Drafts</button>
      }
      <div class="news-search">
        <i class="fas fa-search"></i>
        <input type="text" id="newsSearchInput" placeholder="Search news..." oninput="searchNews(this.value)">
      </div>
      @if (editMode)
      {
          <button type="button" class="np-add-btn" onclick="openAddNewsDraftModal()"><i class="fas fa-plus"></i> Add News</button>
      }
    </div>

    @if (!posts.Any())
    {
        <p style="color:var(--text-light);font-size:14px;padding:20px 0;">No news posts yet.@(editMode ? " Click \"Add News\" to publish the first one." : "")</p>
    }
    else
    {
        <div class="news-featured" id="newsFeatured">
            @if (featuredMain != null)
            {
                var style = CatStyle(featuredMain.Category);
                var icon = string.IsNullOrWhiteSpace(featuredMain.Icon) ? style.Icon : featuredMain.Icon;
                var bgStyle = string.IsNullOrWhiteSpace(featuredMain.ImageUrl)
                    ? $"background:linear-gradient(135deg,{style.Color},#1a5fa6);"
                    : $"background-image:url('{featuredMain.ImageUrl}');";
                <div class="news-featured-main" data-cat="@CatSlug(featuredMain.Category)" data-id="@featuredMain.NewsPostId" onclick="openNewsDetailModal(@featuredMain.NewsPostId)">
                    <div class="nf-thumb" style="@bgStyle">
                        @if (string.IsNullOrWhiteSpace(featuredMain.ImageUrl))
                        {
                            <i class="@icon" style="color:rgba(255,255,255,0.85);"></i>
                        }
                        <div class="nf-thumb-overlay"></div>
                        <span class="nf-category" style="background:@(style.Color)e6;color:#fff;"><i class="@icon"></i> @featuredMain.Category</span>
                        @if (editMode)
                        {
                            var isExpiredF = featuredMain.ExpiresAt.HasValue && featuredMain.ExpiresAt.Value < DateOnly.FromDateTime(DateTime.Now);
                            <div class="np-card-admin-bar">
                                <div class="np-admin-status-pills">
                                    @if (!featuredMain.IsActive)
                                    {
                                        <span class="np-status-pill inactive" style="background:#64748b;color:#fff;"><i class="fas fa-eye-slash"></i> Inactive</span>
                                    }
                                    else if (isExpiredF)
                                    {
                                        <span class="np-status-pill expired" style="background:#dc2626;color:#fff;"><i class="fas fa-triangle-exclamation"></i> Expired</span>
                                    }
                                    else
                                    {
                                        <span class="np-status-pill active" style="background:#16a34a;color:#fff;"><i class="fas fa-circle-check"></i> Active</span>
                                    }
                                    @if (featuredMain.IsSplashScreen)
                                    {
                                        <span class="np-status-pill splash"><i class="fas fa-bullhorn"></i> Splash</span>
                                    }
                                    @if (featuredMain.IsFeatured)
                                    {
                                        <span class="np-status-pill featured"><i class="fas fa-star"></i> Featured</span>
                                    }
                                </div>
                                <div class="np-card-actions">
                                    <button type="button" class="np-toggle-btn @(featuredMain.IsActive ? "active" : "inactive")" title="@(featuredMain.IsActive ? "Set to Inactive (Hide from Public)" : "Set to Active (Publish Live)")" onclick="event.stopPropagation(); toggleNewsActive(this, @featuredMain.NewsPostId)" style="background:@(featuredMain.IsActive ? "#16a34a" : "#64748b");color:#fff;border:none;padding:5px 9px;border-radius:6px;font-size:12px;cursor:pointer;"><i class="fas @(featuredMain.IsActive ? "fa-eye" : "fa-eye-slash")"></i></button>
                                    <button type="button" class="np-edit-btn" title="Edit" onclick="event.stopPropagation(); openEditNewsModal(@featuredMain.NewsPostId)"><i class="fas fa-pen"></i></button>
                                    <button type="button" class="np-delete-btn" title="Delete" onclick="event.stopPropagation(); deleteNewsPost(this, @featuredMain.NewsPostId)"><i class="fas fa-trash"></i></button>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="nf-body">
                        <div class="nf-meta"><i class="far fa-calendar"></i> @featuredMain.PublishDate.ToString("MMMM d, yyyy")</div>
                        <div class="nf-title">@featuredMain.Title</div>
                        <div class="nf-desc">@featuredMain.Body</div>
                    </div>
                </div>
            }
            <div class="news-side-stack">
                @foreach (var p in sideStack)
                {
                    var s = CatStyle(p.Category);
                    var i = string.IsNullOrWhiteSpace(p.Icon) ? s.Icon : p.Icon;
                    var sideThumbStyle = string.IsNullOrWhiteSpace(p.ImageUrl)
                        ? $"background:{s.Color}1a;"
                        : $"background-image:url('{p.ImageUrl}');background-size:cover;background-position:center;";
                    <div class="news-side-card" data-cat="@CatSlug(p.Category)" data-id="@p.NewsPostId" onclick="openNewsDetailModal(@p.NewsPostId)">
                        <div class="ns-thumb" style="@sideThumbStyle">
                            @if (string.IsNullOrWhiteSpace(p.ImageUrl))
                            {
                                <i class="@i" style="color:@s.Color;"></i>
                            }
                        </div>
                        <div class="ns-body" style="flex:1;">
                            <div class="ns-category" style="color:@s.Color;">
                                <span>@p.Category</span>
                                @if (editMode)
                                {
                                    var isExpiredP = p.ExpiresAt.HasValue && p.ExpiresAt.Value < DateOnly.FromDateTime(DateTime.Now);
                                    if (!p.IsActive)
                                    {
                                        <span class="np-status-pill-mini inactive"><i class="fas fa-eye-slash"></i> Inactive</span>
                                    }
                                    else if (isExpiredP)
                                    {
                                        <span class="np-status-pill-mini expired" style="background:#dc2626;color:#fff;"><i class="fas fa-triangle-exclamation"></i> Expired</span>
                                    }
                                    else
                                    {
                                        <span class="np-status-pill-mini active" style="background:#16a34a;color:#fff;"><i class="fas fa-circle-check"></i> Active</span>
                                    }
                                    @if (p.IsSplashScreen)
                                    {
                                        <span class="np-status-pill-mini splash"><i class="fas fa-bullhorn"></i> Splash</span>
                                    }
                                }
                            </div>
                            <div class="ns-title">@p.Title</div>
                            <div class="ns-meta">
                                <i class="far fa-calendar" style="margin-right:4px;color:var(--green);"></i> @p.PublishDate.ToString("MMMM d, yyyy")
                                @if (p.ExpiresAt.HasValue)
                                {
                                    <span style="margin-left:8px;font-size:11px;color:@(p.ExpiresAt.Value < DateOnly.FromDateTime(DateTime.Now) ? "#dc2626" : "#0284c7");">
                                        <i class="fas fa-clock"></i> Expires: @p.ExpiresAt.Value.ToString("yyyy-MM-dd")
                                    </span>
                                }
                            </div>
                        </div>
                        @if (editMode)
                        {
                            <div class="np-card-actions" style="position:static;display:flex;align-items:flex-start;gap:4px;">
                                <button type="button" class="np-toggle-btn @(p.IsActive ? "active" : "inactive")" title="@(p.IsActive ? "Set to Inactive (Hide from Public)" : "Set to Active (Publish Live)")" onclick="event.stopPropagation(); toggleNewsActive(this, @p.NewsPostId)" style="background:@(p.IsActive ? "#16a34a" : "#64748b");color:#fff;border:none;padding:5px 9px;border-radius:6px;font-size:12px;cursor:pointer;"><i class="fas @(p.IsActive ? "fa-eye" : "fa-eye-slash")"></i></button>
                                <button type="button" class="np-edit-btn" title="Edit" onclick="event.stopPropagation(); openEditNewsModal(@p.NewsPostId)"><i class="fas fa-pen"></i></button>
                                <button type="button" class="np-delete-btn" title="Delete" onclick="event.stopPropagation(); deleteNewsPost(this, @p.NewsPostId)"><i class="fas fa-trash"></i></button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="news-grid" id="newsGrid">
            @{ int shown = 0; }
            @foreach (var p in gridPosts)
            {
                var s = CatStyle(p.Category);
                var i = string.IsNullOrWhiteSpace(p.Icon) ? s.Icon : p.Icon;
                var bgStyle = string.IsNullOrWhiteSpace(p.ImageUrl)
                    ? $"background:linear-gradient(135deg,{s.Color},#0b2c4d);"
                    : $"background-image:url('{p.ImageUrl}');";
                shown++;
                <div class="news-card @(shown > 6 ? "hidden more-batch" : "")" data-cat="@CatSlug(p.Category)" data-id="@p.NewsPostId" data-active="@(p.IsActive ? "true" : "false")" data-expired="@(p.ExpiresAt.HasValue && p.ExpiresAt.Value < DateOnly.FromDateTime(DateTime.Now) ? "true" : "false")" onclick="openNewsDetailModal(@p.NewsPostId)">
                    <div class="nc-thumb" style="@bgStyle">
                        @if (string.IsNullOrWhiteSpace(p.ImageUrl))
                        {
                            <i class="@i" style="color:rgba(255,255,255,0.5);font-size:40px;"></i>
                        }
                        <span class="nc-category" style="background:@(s.Color)d9;color:#fff;"><i class="@i"></i> @p.Category</span>
                        @if (editMode)
                        {
                            var isExpiredG = p.ExpiresAt.HasValue && p.ExpiresAt.Value < DateOnly.FromDateTime(DateTime.Now);
                            <div class="np-card-admin-bar">
                                <div class="np-admin-status-pills">
                                    @if (!p.IsActive)
                                    {
                                        <span class="np-status-pill inactive" style="background:#64748b;color:#fff;"><i class="fas fa-eye-slash"></i> Inactive</span>
                                    }
                                    else if (isExpiredG)
                                    {
                                        <span class="np-status-pill expired" style="background:#dc2626;color:#fff;"><i class="fas fa-triangle-exclamation"></i> Expired</span>
                                    }
                                    else
                                    {
                                        <span class="np-status-pill active" style="background:#16a34a;color:#fff;"><i class="fas fa-circle-check"></i> Active</span>
                                    }
                                    @if (p.IsSplashScreen)
                                    {
                                        <span class="np-status-pill splash"><i class="fas fa-bullhorn"></i> Splash</span>
                                    }
                                    @if (p.IsFeatured)
                                    {
                                        <span class="np-status-pill featured"><i class="fas fa-star"></i> Featured</span>
                                    }
                                </div>
                                <div class="np-card-actions">
                                    <button type="button" class="np-toggle-btn @(p.IsActive ? "active" : "inactive")" title="@(p.IsActive ? "Set to Inactive (Hide from Public)" : "Set to Active (Publish Live)")" onclick="event.stopPropagation(); toggleNewsActive(this, @p.NewsPostId)" style="background:@(p.IsActive ? "#16a34a" : "#64748b");color:#fff;border:none;padding:5px 9px;border-radius:6px;font-size:12px;cursor:pointer;"><i class="fas @(p.IsActive ? "fa-eye" : "fa-eye-slash")"></i></button>
                                    <button type="button" class="np-edit-btn" title="Edit" onclick="event.stopPropagation(); openEditNewsModal(@p.NewsPostId)"><i class="fas fa-pen"></i></button>
                                    <button type="button" class="np-delete-btn" title="Delete" onclick="event.stopPropagation(); deleteNewsPost(this, @p.NewsPostId)"><i class="fas fa-trash"></i></button>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="nc-body">
                        <div class="nc-meta"><i class="far fa-calendar"></i> @p.PublishDate.ToString("MMMM d, yyyy")</div>
                        <div class="nc-title">@p.Title</div>
                        <div class="nc-desc">@p.Body</div>
                    </div>
                </div>
            }
            @if (ViewBag.IsAdminUser == true || editMode)
            {
                @foreach (var p in expiredPosts)
                {
                    var s = CatStyle(p.Category);
                    var i = string.IsNullOrWhiteSpace(p.Icon) ? s.Icon : p.Icon;
                    var bgStyle = string.IsNullOrWhiteSpace(p.ImageUrl)
                        ? $"background:linear-gradient(135deg,{s.Color},#0b2c4d);"
                        : $"background-image:url('{p.ImageUrl}');";
                    var isExpiredItem = p.ExpiresAt.HasValue && p.ExpiresAt.Value < today;
                    <div class="news-card hidden expired-card" data-cat="@CatSlug(p.Category)" data-id="@p.NewsPostId" data-active="@(p.IsActive ? "true" : "false")" data-expired="@(isExpiredItem ? "true" : "false")" onclick="openNewsDetailModal(@p.NewsPostId)">
                        <div class="nc-thumb" style="@bgStyle">
                            @if (string.IsNullOrWhiteSpace(p.ImageUrl))
                            {
                                <i class="@i" style="color:rgba(255,255,255,0.5);font-size:40px;"></i>
                            }
                            <span class="nc-category" style="background:@(s.Color)d9;color:#fff;"><i class="@i"></i> @p.Category</span>
                            <div class="np-card-admin-bar">
                                <div class="np-admin-status-pills">
                                    @if (!p.IsActive)
                                    {
                                        <span class="np-status-pill inactive" style="background:#64748b;color:#fff;"><i class="fas fa-eye-slash"></i> Inactive</span>
                                    }
                                    @if (isExpiredItem)
                                    {
                                        <span class="np-status-pill expired" style="background:#dc2626;color:#fff;"><i class="fas fa-triangle-exclamation"></i> Expired</span>
                                    }
                                </div>
                                <div class="np-card-actions">
                                    <button type="button" class="np-toggle-btn @(p.IsActive ? "active" : "inactive")" title="@(p.IsActive ? "Set to Inactive (Hide from Public)" : "Set to Active (Publish Live)")" onclick="event.stopPropagation(); toggleNewsActive(this, @p.NewsPostId)" style="background:@(p.IsActive ? "#16a34a" : "#64748b");color:#fff;border:none;padding:5px 9px;border-radius:6px;font-size:12px;cursor:pointer;"><i class="fas @(p.IsActive ? "fa-eye" : "fa-eye-slash")"></i></button>
                                    <button type="button" class="np-edit-btn" title="Edit" onclick="event.stopPropagation(); openEditNewsModal(@p.NewsPostId)"><i class="fas fa-pen"></i></button>
                                    <button type="button" class="np-delete-btn" title="Delete" onclick="event.stopPropagation(); deleteNewsPost(this, @p.NewsPostId)"><i class="fas fa-trash"></i></button>
                                </div>
                            </div>
                        </div>
                        <div class="nc-body">
                            <div class="nc-meta">
                                <i class="far fa-calendar"></i> @p.PublishDate.ToString("MMMM d, yyyy")
                                @if (p.ExpiresAt.HasValue)
                                {
                                    <span style="margin-left:8px;font-size:11px;color:#dc2626;"><i class="fas fa-clock"></i> Expired: @p.ExpiresAt.Value.ToString("yyyy-MM-dd")</span>
                                }
                            </div>
                            <div class="nc-title">@p.Title</div>
                            <div class="nc-desc">@p.Body</div>
                        </div>
                    </div>
                }
            }
        </div>

        @if (gridPosts.Count > 6)
        {
            <div class="load-more-wrap">
                <button class="load-more-btn" id="loadMoreBtn" onclick="loadMoreNews()"><i class="fas fa-plus"></i> Load More News</button>
            </div>
        }
    }
  </section>

  <!-- ════════ PHOTO GALLERY (DB-backed, admin-only edit controls) ════════ -->
  <section class="nm-section" id="photo-gallery">
    <div class="nm-section-label"><i class="fas fa-images"></i> Photos</div>
    <h2>Photo Gallery</h2>
    <div class="nm-divider"></div>

    <div class="gallery-filter">
      <button class="gallery-filter-btn active" onclick="filterGallery('all',this)">All Albums</button>
      @foreach (var album in galleryAlbums)
      {
          <button class="gallery-filter-btn" onclick="filterGallery('@AlbumSlug(album)',this)">@album</button>
      }
      @if (editMode)
      {
          <button type="button" class="gallery-add-btn" onclick="openPhotoModal()"><i class="fas fa-plus"></i> Add Photo</button>
      }
    </div>

    @if (!galleryPhotos.Any())
    {
        <p class="gallery-empty">No photos yet.@(editMode ? " Click \"Add Photo\" to publish the first one." : "")</p>
    }
    else
    {
        <div class="photo-grid" id="photoGrid">
            @{ int photoIdx = 0; }
            @foreach (var g in galleryPhotos)
            {
                var grad = PhotoGradient(g.PhotoId);
                var bgStyle = string.IsNullOrWhiteSpace(g.ImageUrl)
                    ? $"background:linear-gradient(135deg,{grad.C1},{grad.C2});"
                    : $"background-image:url('{g.ImageUrl}');";
                <div class="photo-item" data-album="@AlbumSlug(g.Album)" data-index="@photoIdx" style="@bgStyle" onclick="openLightbox(@photoIdx)">
                    @if (string.IsNullOrWhiteSpace(g.ImageUrl))
                    {
                        <i class="@(string.IsNullOrWhiteSpace(g.Icon) ? "fas fa-image" : g.Icon) photo-thumb-icon"></i>
                    }
                    <div class="photo-overlay">
                        <div class="photo-caption">@g.Caption</div>
                        <div class="photo-album">@g.Album</div>
                    </div>
                    <div class="photo-zoom"><i class="fas fa-expand"></i></div>
                    @if (editMode)
                    {
                        <div class="np-card-actions">
                            <button type="button" class="np-edit-btn" title="Edit" onclick="event.stopPropagation(); openPhotoModal(@g.PhotoId)"><i class="fas fa-pen"></i></button>
                            <button type="button" class="np-delete-btn" title="Delete" onclick="event.stopPropagation(); deletePhoto(this, @g.PhotoId)"><i class="fas fa-trash"></i></button>
                        </div>
                    }
                </div>
                photoIdx++;
            }
        </div>
    }
  </section>

  <!-- Lightbox (view-only, no login required) -->
  <div class="lightbox" id="lightbox" onclick="if(event.target===this)closeLightbox()">
    <div class="lightbox-inner">
      <div class="lightbox-img" id="lightboxImg">
        <button class="lightbox-nav prev" onclick="lightboxNav(-1)" type="button"><i class="fas fa-chevron-left"></i></button>
        <button class="lightbox-nav next" onclick="lightboxNav(1)" type="button"><i class="fas fa-chevron-right"></i></button>
        <button class="lightbox-close" onclick="closeLightbox()" type="button"><i class="fas fa-times"></i></button>
      </div>
      <div class="lightbox-info">
        <div class="lightbox-caption" id="lightboxCaption"></div>
        <div class="lightbox-album" id="lightboxAlbum"></div>
      </div>
    </div>
  </div>

  <!-- ════════ VIDEO GALLERY (DB-backed, admin-only edit controls) ════════ -->
  <section class="nm-section" id="video-gallery">
    <div class="nm-section-label"><i class="fas fa-video"></i> Videos</div>
    <h2>Video Gallery</h2>
    <div class="nm-divider"></div>

    @if (editMode)
    {
        <div class="video-toolbar">
            <button type="button" class="np-add-btn" onclick="openVideoModal()"><i class="fas fa-plus"></i> Add Video</button>
        </div>
    }

    @if (!galleryVideos.Any())
    {
        <p class="video-empty">No videos yet.@(editMode ? " Click \"Add Video\" to publish the first one." : "")</p>
    }
    else
    {
        <div class="video-grid" id="videoGrid">
            @foreach (var v in galleryVideos)
            {
                var vColor = VideoCatColor(v.Category);
                var vIcon = string.IsNullOrWhiteSpace(v.Icon) ? "fas fa-film" : v.Icon;
                var vBgStyle = string.IsNullOrWhiteSpace(v.ThumbnailUrl)
                    ? $"background:linear-gradient(135deg,{vColor},#0b2c4d);"
                    : $"background-image:url('{v.ThumbnailUrl}');";
                <div class="video-card" data-id="@v.VideoId" data-title="@v.Title" data-video-url="@v.VideoUrl" onclick="if(!event.target.closest('.np-card-actions')) openVideo(this.dataset.title, this.dataset.videoUrl)">
                    <div class="vc-thumb" style="@vBgStyle">
                        <i class="@vIcon" style="font-size:42px;color:rgba(255,255,255,0.35);"></i>
                        <div class="vc-play"><i class="fas fa-play" style="margin-left:3px;"></i></div>
                        @if (!string.IsNullOrWhiteSpace(v.Duration))
                        {
                            <div class="vc-duration">@v.Duration</div>
                        }
                        @if (editMode)
                        {
                            <div class="np-card-actions">
                                <button type="button" class="np-edit-btn" title="Edit" onclick="event.stopPropagation(); openVideoModal(@v.VideoId)"><i class="fas fa-pen"></i></button>
                                <button type="button" class="np-delete-btn" title="Delete" onclick="event.stopPropagation(); deleteVideo(this, @v.VideoId)"><i class="fas fa-trash"></i></button>
                            </div>
                        }
                    </div>
                    <div class="vc-body">
                        <div class="vc-category" style="color:@vColor;">@v.Category</div>
                        <div class="vc-title">@v.Title</div>
                        <div class="vc-meta"><i class="far fa-calendar"></i> @v.PublishDate.ToString("MMM yyyy") &nbsp;&middot;&nbsp; <i class="fas fa-eye"></i> @FormatViews(v.Views)</div>
                    </div>
                </div>
            }
        </div>
    }
  </section>

  <!-- Video playback modal (works for everyone, not just admins) -->
  <div class="video-player-modal-backdrop" id="videoPlayerModal" onclick="if(event.target===this)closeVideo()">
    <div class="video-player-modal" onclick="event.stopPropagation()">
      <div class="video-player-modal-header">
        <i class="fas fa-play-circle" style="color:var(--green);font-size:18px;"></i>
        <div class="vm-title" id="vmTitle">Video Title</div>
        <button class="vm-close" onclick="closeVideo()"><i class="fas fa-times"></i></button>
      </div>
      <div class="video-player-area" id="videoPlayerArea">
        <div class="video-placeholder">
          <div class="video-placeholder-icon"><i class="fas fa-film"></i></div>
          <p>No video source set for this entry yet.</p>
        </div>
      </div>
    </div>
  </div>
</main>

<!-- ===== NEWS DETAILS & DRAFT MODAL (Interactive for public & editable for admin) ===== -->
<div class="nd-modal-backdrop" id="newsDetailModal" onclick="if(event.target===this)closeNewsDetailModal()">

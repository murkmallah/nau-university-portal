          </div>
          <h2 class="nd-hero-title" id="ndEditHeaderTitle">Edit News Announcement</h2>
          <div class="nd-hero-meta">
            <span id="ndEditSubtitle">Fill in the announcement details below</span>
          </div>
        </div>

        <div class="nd-form-section">
          <div class="nd-field">
            <label>News Headline / Title <span class="req">*</span></label>
            <input type="text" id="ndFormTitle" placeholder="e.g. Fall 2026 Admissions Open — Limited Seats">
          </div>

          <div class="nd-field-grid" style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;">
            <div class="nd-field">
              <label>Category</label>
              <input type="text" id="ndFormCategory" list="ndCategoryDatalist" placeholder="e.g. Admissions, Academic, CPD, Event">
              <datalist id="ndCategoryDatalist">
                <option value="Academic"></option>
                <option value="Admissions"></option>
                <option value="CPD"></option>
                <option value="Event"></option>
                <option value="Training"></option>
                <option value="Campus Life"></option>
                <option value="General News"></option>
              </datalist>
            </div>
            <div class="nd-field">
              <label>Publish Date</label>
              <input type="date" id="ndFormDate">
            </div>
            <div class="nd-field">
              <label>Expiry Date (ExpiresAt)</label>
              <input type="date" id="ndFormExpiryDate">

      <div class="nd-hero" id="ndHero">
        <button class="nd-close" onclick="closeNewsDetailModal()" type="button" aria-label="Close"><i class="fas fa-times"></i></button>
        <div class="nd-hero-top">
          <span class="nd-category-badge" id="ndCategoryBadge"><i class="fas fa-newspaper" id="ndCategoryIcon"></i> <span id="ndCategoryText">Category</span></span>
          @if (editMode)
          {
            <div class="nd-admin-toolbar">
              <button type="button" class="nd-admin-chip" onclick="switchToEditNews()" title="Edit this announcement"><i class="fas fa-pen"></i> Edit</button>
              <button type="button" class="nd-admin-chip danger" onclick="deleteCurrentNews()" title="Delete this announcement"><i class="fas fa-trash"></i> Delete</button>
            </div>
          }
        </div>
        <h2 class="nd-hero-title" id="ndModalTitle">News Headline</h2>
        <div class="nd-hero-meta">
          <span><i class="far fa-calendar-alt"></i> <span id="ndModalDate">Publish Date</span></span>
          <span class="nd-featured-tag" id="ndFeaturedTag" style="display:none;"><i class="fas fa-star"></i> Featured</span>
          <span class="nd-status-tag-active" id="ndActiveTag" style="display:none;"><i class="fas fa-check-circle"></i> Active</span>
          <span class="nd-status-tag-inactive" id="ndInactiveTag" style="display:none;"><i class="fas fa-eye-slash"></i> Inactive Draft</span>
        </div>
      </div>
      
      <div class="nd-body">
        <div class="nd-image-wrap" id="ndImageWrap" style="display:none;">
          <img id="ndImage" src="" alt="Announcement banner">
        </div>
        <div class="nd-content-text" id="ndContentBody"></div>
        <div class="nd-actions-bar">
          @if (editMode)
          {
            <button type="button" class="nd-btn edit" onclick="switchToEditNews()"><i class="fas fa-pen"></i> Edit Announcement</button>
            <button type="button" class="nd-btn danger" onclick="deleteCurrentNews()"><i class="fas fa-trash"></i> Delete</button>
          }
          <button type="button" class="nd-btn secondary" onclick="closeNewsDetailModal()"><i class="fas fa-times"></i> Close</button>
        </div>
      </div>
    </div>

    <!-- EDIT / DRAFT FORM MODE (Admin only in edit mode) -->

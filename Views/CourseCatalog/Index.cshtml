<script src="~/js/schools-submenu.js" asp-append-version="true"></script>
<script>
var catalogData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
var editMode = @Html.Raw(editMode ? "true" : "false");
var currentSchool = -1; // -1 means All Schools, 0..N means specific school
var currentStatus = 'all';

function parseDateRobust(str) {
  if (!str || str === 'TBD' || str === 'tbd') return null;
  // Format DD.MM.YYYY
  if (typeof str === 'string' && str.includes('.')) {
    var p = str.split('.');
    if (p.length === 3) {
      var d = new Date(parseInt(p[2], 10), parseInt(p[1], 10) - 1, parseInt(p[0], 10));
      return isNaN(d) ? null : d;
    }
  }
  // Format YYYY-MM-DD
  if (typeof str === 'string' && str.includes('-')) {
    var p = str.split('-');
    if (p.length === 3) {
      var d = new Date(parseInt(p[0], 10), parseInt(p[1], 10) - 1, parseInt(p[2], 10));
      return isNaN(d) ? null : d;
    }
  }
  var parsed = new Date(str);
  return isNaN(parsed) ? null : parsed;
}

function escapeHtmlText(str) {
  if (!str) return '';
  return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function getStatus(c) {
  if (!c) return 'completed';
  if (c.StatusOverride || c.statusOverride) return c.StatusOverride || c.statusOverride;
  var start = c.StartDate || c.startDate;
  var end = c.EndDate || c.endDate;
  if (!start || start === 'TBD' || start === 'tbd') return 'tbd';
  var endDate = parseDateRobust(end) || parseDateRobust(start);
  if (!endDate) return 'completed';
  var today = new Date();
  today.setHours(0, 0, 0, 0);
  return endDate >= today ? 'upcoming' : 'completed';
}

function onSearchInputChanged() {
  var input = document.getElementById('searchInput');
  var clearBtn = document.getElementById('searchClearBtn');
  if (clearBtn) {
    clearBtn.style.display = (input && input.value.trim().length > 0) ? 'flex' : 'none';
  }
  renderCatalog();
}

function clearCourseSearch() {
  var input = document.getElementById('searchInput');
  var clearBtn = document.getElementById('searchClearBtn');
  if (input) input.value = '';
  if (clearBtn) clearBtn.style.display = 'none';
  renderCatalog();
}

window.switchCourseCatalogSchool = function(i, btn) {
  var schools = (catalogData && (catalogData.Schools || catalogData.schools)) || [];
  var idx = typeof i === 'number' ? i : parseInt(i, 10);
  if (isNaN(idx) || idx < -1 || idx >= schools.length) idx = -1;
  currentSchool = idx;

  var tabs = document.querySelectorAll('.school-tab');
  for (var k = 0; k < tabs.length; k++) {
    tabs[k].classList.remove('active');
    tabs[k].removeAttribute('style');
  }

  var targetBtn = (idx === -1)
    ? (document.getElementById('tab-all') || document.querySelector('.school-tab[data-school-index="-1"]'))
    : (document.getElementById('tab-' + idx) || document.querySelector('.school-tab[data-school-index="' + idx + '"]'));
  if (!targetBtn && btn) targetBtn = btn;

  var themeColor = '#0b2c4d';
  if (idx >= 0 && schools[idx]) {
    var s = schools[idx];
    themeColor = s.Color || s.color || '#0b2c4d';
  }

  if (targetBtn) {
    targetBtn.classList.add('active');
    targetBtn.style.setProperty('background', themeColor, 'important');
    targetBtn.style.setProperty('border-color', themeColor, 'important');
    targetBtn.style.setProperty('color', '#ffffff', 'important');
  }

  renderCatalog();
};
window.switchSchool = window.switchCourseCatalogSchool;

function setStatus(s, btn) {
  currentStatus = s;
  document.querySelectorAll('.status-filter').forEach(function (b) { b.classList.remove('active'); });
  if (btn) btn.classList.add('active');
  renderCatalog();
}

function renderCatalog() {
  var schools = (catalogData && (catalogData.Schools || catalogData.schools)) || [];
  var grid = document.getElementById('coursesGrid');
  if (!grid) return;

  if (!schools || !schools.length) {
    grid.innerHTML = '<div class="no-results"><p>No schools or courses found.</p></div>';
    return;
  }

  var searchInput = document.getElementById('searchInput');
  var rawSearch = searchInput ? searchInput.value : '';
  var search = rawSearch.trim().toLowerCase();

  // Determine active scope of schools
  var activeSchools = [];
  if (currentSchool === -1) {
    activeSchools = schools.map(function(s, idx) { return { school: s, sIdx: idx }; });
  } else {
    var sIdx = currentSchool;
    if (sIdx < 0 || sIdx >= schools.length) sIdx = 0;
    activeSchools = [{ school: schools[sIdx], sIdx: sIdx }];
  }

  // Update header
  var iconEl = document.getElementById('schoolIcon');
  var nameEl = document.getElementById('schoolName');
  var countEl = document.getElementById('schoolCount');

  if (currentSchool === -1) {
    if (iconEl) {
      iconEl.style.background = '#0b2c4d';
      iconEl.innerHTML = '<i class="fas fa-layer-group"></i>';
    }
    if (nameEl) {
      nameEl.textContent = 'All Schools Course Catalog';
    }
  } else {
    var s = schools[currentSchool] || {};
    var sColor = s.Color || s.color || '#0b2c4d';
    var sIcon = s.Icon || s.icon || 'fa-tower-cell';
    var sName = s.Name || s.name || '';
    if (iconEl) {
      iconEl.style.background = sColor;
      iconEl.innerHTML = '<i class="fas ' + sIcon + '"></i>';
    }
    if (nameEl) {
      nameEl.textContent = sName;
    }
  }

  // Collect items
  var allItems = [];
  var totalCoursesInScope = 0;
  var totalUpcoming = 0;
  var totalCompleted = 0;
  var totalTbd = 0;

  activeSchools.forEach(function (item) {
    var s = item.school;
    var sIdx = item.sIdx;
    var sColor = s.Color || s.color || '#0b2c4d';
    var sIcon = s.Icon || s.icon || 'fa-graduation-cap';
    var sName = s.Name || s.name || '';
    var courses = s.Courses || s.courses || [];

    courses.forEach(function (c, cIdx) {
      totalCoursesInScope++;
      var st = getStatus(c);
      if (st === 'upcoming') totalUpcoming++;
      else if (st === 'completed') totalCompleted++;
      else if (st === 'tbd') totalTbd++;

      var title = (c.Title || c.title || '').toLowerCase();
      var duration = (c.Duration || c.duration || '').toLowerCase();
      var note = (c.Note || c.note || '').toLowerCase();
      var startDate = (c.StartDate || c.startDate || '').toLowerCase();
      var schoolNameLower = sName.toLowerCase();

      var matchSearch = !search ||
        title.includes(search) ||
        duration.includes(search) ||
        note.includes(search) ||
        startDate.includes(search) ||
        schoolNameLower.includes(search);

      var matchStatus = currentStatus === 'all' || currentStatus === st;

      if (matchSearch && matchStatus) {
        allItems.push({
          course: c,
          cIdx: cIdx,
          sIdx: sIdx,
          schoolName: sName,
          schoolColor: sColor,
          schoolIcon: sIcon,
          status: st
        });
      }
    });
  });

  if (countEl) {
    if (currentSchool === -1) {
      countEl.textContent = allItems.length + ' course' + (allItems.length !== 1 ? 's' : '') + ' shown across 4 schools (' + totalCoursesInScope + ' total)';
    } else {
      countEl.textContent = allItems.length + ' course' + (allItems.length !== 1 ? 's' : '') + ' shown (' + totalCoursesInScope + ' total)';
    }
  }

  var statChips = document.getElementById('statChips');
  if (statChips) {
    statChips.innerHTML =
      '<div class="stat-chip"><span class="stat-dot all"></span><strong>' + totalCoursesInScope + '</strong> Total</div>' +
      '<div class="stat-chip"><span class="stat-dot up"></span><strong>' + totalUpcoming + '</strong> Upcoming</div>' +
      '<div class="stat-chip"><span class="stat-dot done"></span><strong>' + totalCompleted + '</strong> Completed</div>' +
      '<div class="stat-chip"><span class="stat-dot tbd"></span><strong>' + totalTbd + '</strong> TBD</div>';
  }

  if (!allItems.length) {
    var otherMatches = [];
    if (search.length > 0 && currentSchool !== -1) {
      schools.forEach(function (s, sIdx) {
        if (sIdx !== currentSchool) {
          var sCourses = s.Courses || s.courses || [];
          var count = sCourses.filter(function (c) {
            var t = (c.Title || c.title || '').toLowerCase();
            var d = (c.Duration || c.duration || '').toLowerCase();
            return t.includes(search) || d.includes(search);
          }).length;
          if (count > 0) {
            otherMatches.push({ idx: sIdx, name: s.Name || s.name || '', count: count, color: s.Color || s.color || '#0b2c4d', icon: s.Icon || s.icon || 'fa-building' });
          }
        }
      });
    }

    var otherHtml = '';
    if (otherMatches.length > 0) {
      otherHtml = '<div style="margin-top:18px;display:flex;flex-direction:column;align-items:center;gap:10px;">' +
        '<span style="font-size:13px;font-weight:600;color:#64748b;">Found matches in other schools:</span>' +
        '<div style="display:flex;gap:10px;flex-wrap:wrap;justify-content:center;">' +
        otherMatches.map(function (m) {
          return '<button type="button" class="school-tab" style="background:#ffffff;border:1.5px solid ' + m.color + ';color:' + m.color + ';padding:8px 16px;font-size:12.5px;font-weight:600;cursor:pointer;" onclick="switchSchool(' + m.idx + ')"><i class="fas ' + m.icon + '"></i> Switch to ' + escapeHtmlText(m.name) + ' (' + m.count + ' match' + (m.count > 1 ? 'es' : '') + ')</button>';
        }).join('') +
        '<button type="button" class="school-tab" style="background:#0b2c4d;color:#fff;border:none;padding:8px 16px;font-size:12.5px;font-weight:600;cursor:pointer;" onclick="switchSchool(-1)"><i class="fas fa-layer-group"></i> View All Schools</button>' +
        '</div></div>';
    }

    grid.innerHTML = '<div class="no-results" style="padding:48px 24px;text-align:center;"><i class="fas fa-search" style="font-size:36px;color:#94a3b8;margin-bottom:14px;display:block;"></i><p style="font-size:15px;color:#334155;font-weight:600;">No courses match "' + escapeHtmlText(rawSearch) + '".</p>' + otherHtml + '</div>';
    return;
  }

  grid.innerHTML = allItems.map(function (item) {
    var c = item.course;
    var st = item.status;
    var label = st === 'upcoming' ? 'Upcoming' : st === 'tbd' ? 'TBD' : 'Completed';
    var title = c.Title || c.title || '';
    var duration = c.Duration || c.duration || '-';
    var startDate = c.StartDate || c.startDate || 'TBD';
    var id = c.Id || c.id || 0;

    var adminBtns = '';
    if (editMode) {
      adminBtns =
        '<div class="card-actions" onclick="event.stopPropagation();">' +
          '<button type="button" class="card-act-btn" title="Edit course" onclick="openEditCourseModal(' + item.sIdx + ',' + item.cIdx + ')"><i class="fas fa-pen"></i></button>' +
          '<button type="button" class="card-act-btn danger" title="Delete course" onclick="deleteCourse(' + id + ')"><i class="fas fa-trash"></i></button>' +
        '</div>';
    }

    var schoolBadge = '';
    if (currentSchool === -1) {
      schoolBadge = '<div style="margin-bottom:6px;"><span style="display:inline-flex;align-items:center;gap:5px;background:' + item.schoolColor + '15;color:' + item.schoolColor + ';border:1px solid ' + item.schoolColor + '35;padding:2px 10px;border-radius:12px;font-size:11px;font-weight:700;"><i class="fas ' + item.schoolIcon + '"></i> ' + escapeHtmlText(item.schoolName) + '</span></div>';
    }

    return '<div class="course-card" style="border-left: 4px solid ' + item.schoolColor + '" onclick="openDetail(' + item.sIdx + ',' + item.cIdx + ')">' +
      '<div class="card-top">' +
        '<div style="flex:1;">' + schoolBadge + '<div class="card-title">' + escapeHtmlText(title) + '</div></div>' +
        '<span class="card-badge ' + st + '">' + label + '</span>' +
      '</div>' +
      '<div class="card-meta">' +
        '<span><i class="fas fa-hourglass-half"></i> ' + escapeHtmlText(duration) + '</span>' +
        '<span><i class="fas fa-calendar-check"></i> ' + escapeHtmlText(startDate) + '</span>' +
        adminBtns +
      '</div>' +
    '</div>';
  }).join('');
}

function openDetail(si, ci) {
  var schools = (catalogData && (catalogData.Schools || catalogData.schools)) || [];
  var school = schools[si] || {};
  var courses = school.Courses || school.courses || [];
  var c = courses[ci] || {};
  var st = getStatus(c);
  var label = st === 'upcoming' ? 'Upcoming' : st === 'tbd' ? 'TBD' : 'Completed';
  var schoolColor = school.Color || school.color || '#0b2c4d';
  var schoolIcon = school.Icon || school.icon || 'fa-tower-cell';
  var schoolName = school.Name || school.name || '';
  var title = c.Title || c.title || '';
  var duration = c.Duration || c.duration || '-';
  var startDate = c.StartDate || c.startDate || 'TBD';
  var endDate = c.EndDate || c.endDate || 'TBD';
  var note = c.Note || c.note || 'Part of NAU – ATP 2026 Academic Training Plan, Hyderabad';

  document.getElementById('detailContent').innerHTML =
    '<div class="detail-school-tag" style="background:' + schoolColor + '1a;color:' + schoolColor + '"><i class="fas ' + schoolIcon + '"></i> ' + schoolName + '</div>' +
    '<div class="detail-title">' + title + '</div>' +
    '<div class="detail-grid">' +
      '<div class="detail-item"><label>Duration</label><span>' + duration + '</span></div>' +
      '<div class="detail-item"><label>Status</label><span><span class="card-badge ' + st + '" style="margin:0">' + label + '</span></span></div>' +
      '<div class="detail-item"><label>Start Date</label><span>' + startDate + '</span></div>' +
      '<div class="detail-item"><label>End Date</label><span>' + endDate + '</span></div>' +
    '</div>' +
    '<div class="detail-note"><i class="fas fa-info-circle"></i> ' + note + '</div>' +
    '<div class="detail-action">' +
      '<a href="/Account/Register" class="detail-btn primary"><i class="fas fa-pen"></i> Enroll Now</a>' +
      '<button class="detail-btn secondary" onclick="closeDetail()"><i class="fas fa-arrow-left"></i> Back to Catalog</button>' +
    '</div>';
  document.getElementById('detailModal').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function closeDetail() {
  document.getElementById('detailModal').classList.remove('open');
  document.body.style.overflow = '';
}

function initTabs() {
  var schools = (catalogData && (catalogData.Schools || catalogData.schools)) || [];
  if (!schools || !schools.length) return;

  var urlParams = new URLSearchParams(window.location.search);
  var schoolParam = urlParams.get('school');
  var selectedIdx = -1; // Default to All Schools

  if (schoolParam) {
    if (schoolParam.toLowerCase() === 'all') {
      selectedIdx = -1;
    } else {
      var numIdx = parseInt(schoolParam, 10);
      if (!isNaN(numIdx) && numIdx >= 0 && numIdx < schools.length) {
        selectedIdx = numIdx;
      } else {
        var matchIdx = schools.findIndex(function (s) {
          var slug = (s.Slug || s.slug || '').toLowerCase();
          var name = (s.Name || s.name || '').toLowerCase();
          return slug === schoolParam.toLowerCase() || name === schoolParam.toLowerCase();
        });
        if (matchIdx >= 0) selectedIdx = matchIdx;
      }
    }
  }

  switchCourseCatalogSchool(selectedIdx);
}

document.addEventListener('DOMContentLoaded', function () {
  var container = document.getElementById('schoolTabsContainer');
  if (container) {
    container.addEventListener('click', function (e) {
      var btn = e.target.closest('.school-tab');
      if (btn) {
        var rawIdx = btn.getAttribute('data-school-index');
        var idx = parseInt(rawIdx, 10);
        if (isNaN(idx)) idx = -1;
        switchCourseCatalogSchool(idx, btn);
      }
    });
  }
});

// ===== AJAX Helper =====
function getCsrfToken() {
  var el = document.querySelector('input[name="__RequestVerificationToken"]');
  return el ? el.value : '';
}

async function postAjax(url, data) {
  var res = await fetch(url, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'RequestVerificationToken': getCsrfToken()
    },
    body: JSON.stringify(data)
  });
  return res.json();
}

// ===== Admin Operations =====
function openEditHeroModal() {
  document.getElementById('heroModal').classList.add('open');
}
function closeHeroModal() {
  document.getElementById('heroModal').classList.remove('open');
}
async function saveHeroSection() {
  var eyebrow = document.getElementById('editHeroEyebrow').value.trim();
  var title = document.getElementById('editHeroTitle').value.trim();
  var desc = document.getElementById('editHeroDesc').value.trim();
  var res = await postAjax('/CourseCatalog/QuickSaveHero', { Eyebrow: eyebrow, Title: title, Description: desc });
  if (res.success) {
    location.reload();
  } else {
    alert(res.message || 'Error saving hero section');
  }
}

function openAddCourseModal() {
  document.getElementById('courseModalTitle').textContent = 'Add Course';
  document.getElementById('courseFormId').value = '0';
  document.getElementById('courseFormSchoolId').value = catalogData.Schools[currentSchool].Id;
  document.getElementById('courseFormTitle').value = '';
  document.getElementById('courseFormDuration').value = '01 Week';
  document.getElementById('courseFormStartDate').value = 'TBD';
  document.getElementById('courseFormEndDate').value = 'TBD';
  document.getElementById('courseFormNote').value = 'Part of NAU – ATP 2026 Academic Training Plan, Hyderabad';
  document.getElementById('courseModal').classList.add('open');
}

function openEditCourseModal(si, ci) {
  var school = catalogData.Schools[si];
  var c = school.Courses[ci];
  document.getElementById('courseModalTitle').textContent = 'Edit Course';
  document.getElementById('courseFormId').value = c.Id;
  document.getElementById('courseFormSchoolId').value = school.Id;
  document.getElementById('courseFormTitle').value = c.Title;
  document.getElementById('courseFormDuration').value = c.Duration || '';
  document.getElementById('courseFormStartDate').value = c.StartDate || '';
  document.getElementById('courseFormEndDate').value = c.EndDate || '';
  document.getElementById('courseFormNote').value = c.Note || '';
  document.getElementById('courseModal').classList.add('open');
}

function closeCourseModal() {
  document.getElementById('courseModal').classList.remove('open');
}

async function saveCourseForm() {
  var id = parseInt(document.getElementById('courseFormId').value, 10);
  var schoolId = parseInt(document.getElementById('courseFormSchoolId').value, 10);
  var title = document.getElementById('courseFormTitle').value.trim();
  var duration = document.getElementById('courseFormDuration').value.trim();
  var start = document.getElementById('courseFormStartDate').value.trim();
  var end = document.getElementById('courseFormEndDate').value.trim();
  var note = document.getElementById('courseFormNote').value.trim();

  if (!title) {
    alert('Course title is required.');
    return;
  }

  var btn = document.getElementById('saveCourseBtn');
  btn.disabled = true;
  btn.textContent = 'Saving...';

  var url = id > 0 ? '/CourseCatalog/QuickUpdateCourse' : '/CourseCatalog/QuickAddCourse';
  var body = { CourseId: id, SchoolId: schoolId, Title: title, Duration: duration, StartDate: start, EndDate: end, Note: note };

  var res = await postAjax(url, body);
  if (res.success) {
    location.reload();
  } else {
    alert(res.message || 'Error saving course');
    btn.disabled = false;
    btn.textContent = 'Save Course';
  }
}

async function deleteCourse(courseId) {
  if (!confirm('Are you sure you want to delete this course from the database?')) return;
  var res = await postAjax('/CourseCatalog/QuickDeleteCourse', { CourseId: courseId });
  if (res.success) {
    location.reload();
  } else {
    alert(res.message || 'Error deleting course');
  }
}

function openAddSchoolModal() {
  document.getElementById('schoolFormName').value = '';
  document.getElementById('schoolFormIcon').value = 'fa-graduation-cap';
  document.getElementById('schoolFormColor').value = '#0b2c4d';
  document.getElementById('schoolModal').classList.add('open');
}
function closeSchoolModal() {
  document.getElementById('schoolModal').classList.remove('open');
}
async function saveSchoolForm() {
  var name = document.getElementById('schoolFormName').value.trim();
  var icon = document.getElementById('schoolFormIcon').value.trim();
  var color = document.getElementById('schoolFormColor').value.trim();
  if (!name) { alert('School name is required'); return; }
  var res = await postAjax('/CourseCatalog/QuickAddSchool', { Name: name, Icon: icon, Color: color });
  if (res.success) {
    location.reload();
  } else {
    alert(res.message || 'Error adding school');
  }
}

async function deleteCurrentSchool() {
  var school = catalogData.Schools[currentSchool];
  if (!confirm(`Are you sure you want to delete "${school.Name}" and all of its courses?`)) return;
  var res = await postAjax('/CourseCatalog/QuickDeleteSchool', { SchoolId: school.Id });
  if (res.success) {
    location.reload();
  } else {
    alert(res.message || 'Error deleting school');
  }
}

document.addEventListener('keydown', e => {
  if (e.key === 'Escape') {
    closeDetail();
    if (typeof closeHeroModal === 'function') closeHeroModal();
    if (typeof closeCourseModal === 'function') closeCourseModal();
    if (typeof closeSchoolModal === 'function') closeSchoolModal();
  }
});

initTabs();
renderCatalog();
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', function () {
    initTabs();
    renderCatalog();
  });
}
</script>

<!-- ===== ACCOUNT DROPDOWN (Log In / Sign Up, or user name + Log Out) ===== -->
<script>
window.NAU_AUTH = {
    isAuthenticated: @Html.Raw(User.Identity != null && User.Identity.IsAuthenticated ? "true" : "false"),
    isAdmin: @Html.Raw(isAdmin ? "true" : "false"),
    userName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)(ViewBag.CurrentUserName ?? "")))
};

(function setupAccountDropdown() {
    var enhancedButtons = new WeakSet();
    var auth = window.NAU_AUTH || { isAuthenticated: false, isAdmin: false, userName: '' };

    function enhance(btn) {
        if (enhancedButtons.has(btn)) return;
        var alreadyWrapped = !!btn.closest('.account-dropdown');
        var isPristineAccountBtn = btn.textContent.trim().toLowerCase() === 'account';
        if (!alreadyWrapped && !isPristineAccountBtn) return;
        enhancedButtons.add(btn);

        var wrap = btn.closest('.account-dropdown');
        if (!wrap) {
            wrap = document.createElement('div');
            wrap.className = 'account-dropdown';
            btn.parentNode.insertBefore(wrap, btn);
            wrap.appendChild(btn);
        }

        btn.removeAttribute('href');
        btn.setAttribute('role', 'button');

        if (auth.isAuthenticated) {
            btn.innerHTML = '<i class="fas fa-circle-user" style="margin-right:6px;"></i>' + (auth.userName || 'My Account');
        } else {
            btn.innerHTML = 'Account';
        }

        var menu = document.createElement('div');
        menu.className = 'account-dropdown-menu';
        if (auth.isAuthenticated) {
            menu.innerHTML =
                '<a href="#" id="navLogoutLink"><i class="fas fa-right-from-bracket" style="margin-right:8px;"></i>Log Out</a>';
        } else {
            menu.innerHTML =
                '<a href="/Account/Login"><i class="fas fa-right-to-bracket" style="margin-right:8px;"></i>Log In</a>';
        }
        menu.style.position = 'fixed';
        menu.style.display = 'none';
        menu.style.zIndex = '2147483647';
        menu.style.background = '#fff';
        menu.style.minWidth = '150px';
        menu.style.borderRadius = '8px';
        menu.style.boxShadow = '0 10px 28px rgba(0,0,0,0.2)';
        menu.style.overflow = 'hidden';
        document.body.appendChild(menu);

        if (auth.isAuthenticated) {
            var logoutLink = menu.querySelector('#navLogoutLink');
            logoutLink.addEventListener('click', function (e) {
                e.preventDefault();
                var form = document.createElement('form');
                form.method = 'post';
                form.action = '/Account/Logout';
                document.body.appendChild(form);
                form.submit();
            });
        }

        function positionMenu() {
            var r = btn.getBoundingClientRect();
            menu.style.top = (r.bottom + 8) + 'px';
            menu.style.left = 'auto';
            menu.style.right = (window.innerWidth - r.right) + 'px';
        }

        var closeTimer;
        function openMenu() {
            clearTimeout(closeTimer);
            positionMenu();
            menu.style.display = 'block';
            wrap.classList.add('open');
        }
        function closeMenu() {
            closeTimer = setTimeout(function () {
                menu.style.display = 'none';
                wrap.classList.remove('open');
            }, 150);
        }

        wrap.addEventListener('mouseenter', openMenu);
        wrap.addEventListener('mouseleave', closeMenu);
        menu.addEventListener('mouseenter', function () { clearTimeout(closeTimer); });
        menu.addEventListener('mouseleave', closeMenu);

        btn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            if (menu.style.display === 'block') {
                menu.style.display = 'none';
                wrap.classList.remove('open');
            } else {
                openMenu();
            }
        });

        document.addEventListener('click', function (e) {
            if (!wrap.contains(e.target) && !menu.contains(e.target)) {
                menu.style.display = 'none';
                wrap.classList.remove('open');
            }
        });

        window.addEventListener('scroll', function () {
            if (menu.style.display === 'block') positionMenu();
        }, true);
        window.addEventListener('resize', function () {
            if (menu.style.display === 'block') positionMenu();
        });
    }

    function run() {
        document.querySelectorAll('.apply-btn').forEach(enhance);
    }

    run();
    var observer = new MutationObserver(run);
    observer.observe(document.body, { childList: true, subtree: true });
})();
</script>


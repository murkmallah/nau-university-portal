@model List<NAU_Web.Models.LinkItem>
@{
    Layout = null;
    bool isAdmin = User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin");
    bool editMode = ViewBag.EditMode == true;   // true only when reached via Admin Panel "Useful Links" link (?edit=1)
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Useful Links &ndash; National Aviation University</title>
<partial name="_Favicon" />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Open+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link rel="stylesheet" href="~/css/public-site.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/cms-icon-picker.css" asp-append-version="true">
<style>
:root {
  --primary: #0b2c4d;
  --green: #1e8e3e;
  --bg: #f5f7fb;
  --white: #fff;
  --shadow: 0 6px 20px rgba(0,0,0,0.08);
  --navy: #0d2c54;
  --gold: #f5a623;
  --text: #333;
  --text-light: #666;
  --border: #e0e0e0;
  --bg-light: #f7f9fc;
  --font-head: "Montserrat", sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box;font-family:"Poppins",sans-serif;}
body{background:var(--bg);}

/* .announcement / .scroll / .account-dropdown / .apply-btn now come from
   the single shared file wwwroot/css/public-site.css (linked above), so
   this page always matches the rest of the site automatically. */
.navbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:0 48px;
  background:white;
  box-shadow:0 2px 12px rgba(0,0,0,0.07);
  position:sticky;
  top:0;
  z-index:1000;
  height:68px;
}

.logo{display:flex;align-items:center;gap:10px;text-decoration:none;}

.logo img{width:60px;height:auto;}

.logo span{font-size:30px;font-weight:700;color:var(--primary);white-space:nowrap;}

.logo-tagline{font-size:10px;font-weight:600;color:#0073ff;letter-spacing:3px;text-transform:uppercase;margin-top:1px;white-space:nowrap;}

.menu{
  display:flex;
  align-items:stretch;
  height:100%;
  gap:0;
}

.menu-item{
  position:static;
  display:flex;
  align-items:center;
}

.menu-item > .nav-link{
  display:flex;
  align-items:center;
  gap:5px;
  padding:0 14px;
  height:100%;
  text-decoration:none;
  color:#333;
  font-size:13.5px;
  font-weight:500;
  white-space:nowrap;
  position:relative;
  transition:color .2s;
  cursor:pointer;
  border:none;
  background:none;
  font-family:"Poppins",sans-serif;
}

.menu-item > .nav-link::after{
  content:"";
  position:absolute;
  bottom:0;
  left:14px;
  right:14px;
  height:3px;
  background:var(--green);
  transform:scaleX(0);
  transition:transform .25s;
  border-radius:2px 2px 0 0;
}

.menu-item:hover > .nav-link,
.menu-item > .nav-link:hover{
  color:var(--primary);
}

.menu-item:hover > .nav-link::after{
  transform:scaleX(1);
}

.nav-link .chevron{
  font-size:10px;
  opacity:.6;
  transition:transform .25s;
}

.menu-item:hover > .nav-link .chevron{
  transform:rotate(180deg);
}

.dropdown{
  position:absolute;
  top:68px;
  left:0;
  right:0;
  background:#fff;
  box-shadow:0 8px 32px rgba(0,0,0,0.12);
  display:none;
  border-top:3px solid var(--green);
  z-index:999;
  animation:fadeSlide .2s ease;
}

@@keyframes fadeSlide{
  from{opacity:0;transform:translateY(-8px);}
  to{opacity:1;transform:translateY(0);}
}

.menu-item:hover .dropdown{display:block;}

.dd-inner{
  max-width:1480px;
  margin:0 auto;
  padding:28px 24px 32px;
  display:flex;
  gap:0;
}

.dd-col{
  flex:1;
  padding:0 24px;
  border-right:1px solid #f0f2f5;
}

.dd-col:first-child{padding-left:0;}

.dd-col:last-child{border-right:none;padding-right:0;}

.dd-col-title{
  font-size:12px;
  font-weight:700;
  letter-spacing:2px;
  text-transform:uppercase;
  color:var(--green);
  margin-bottom:14px;
  padding-bottom:8px;
  border-bottom:1px solid #eef0f3;
}

.dd-link{
  display:flex;
  align-items:flex-start;
  gap:10px;
  padding:9px 10px;
  border-radius:7px;
  text-decoration:none;
  color:#444;
  font-size:13px;
  line-height:1.35;
  transition:background .15s, color .15s;
  margin-bottom:2px;
}

.dd-link:hover{
  background:#f5f7fb;
  color:var(--primary);
}

.dd-link:hover .dd-icon{
  background:var(--primary);
  color:#fff;
}

.dd-link .dd-icon{
  width:32px;
  height:32px;
  background:#eef2f8;
  border-radius:7px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:13px;
  color:var(--primary);
  flex-shrink:0;
  transition:background .15s, color .15s;
  margin-top:1px;
}

.dd-link .dd-text strong{
  display:block;
  font-weight:600;
  font-size:13px;
  color:inherit;
}

.dd-link .dd-text span{
  font-size:11px;
  color:#999;
  line-height:1.4;
}

.dd-link:hover .dd-text span{color:#aaa;}

.dd-view-all{
  display:inline-flex;
  align-items:center;
  gap:6px;
  margin-top:10px;
  padding:7px 14px;
  background:var(--green);
  color:#fff;
  border-radius:5px;
  font-size:12px;
  font-weight:600;
  text-decoration:none;
  font-family:"Poppins",sans-serif;
  transition:background .2s, transform .15s;
}

.dd-view-all:hover{
  background:#166f30;
  transform:translateY(-1px);
}

.dd-view-all i{font-size:10px;}
/* ===== Academics dropdown: school course-preview submenu (hover flyout) ===== */
.dd-school-item{ position:relative; }
.dd-school-link{ padding-right:34px; position:relative; }
.dd-school-arrow{
  position:absolute; right:12px; top:50%; transform:translateY(-50%) rotate(0deg);
  font-size:11px; color:#9aa4b2; padding:8px; cursor:pointer; transition:transform .2s, color .2s;
}
.dd-school-item:hover .dd-school-arrow,
.dd-school-item.open .dd-school-arrow{ transform:translateY(-50%) rotate(90deg); color:#166f30; }
.dd-submenu{
  display:none;
  position:absolute;
  top:-8px;
  left:100%;
  margin-left:8px;
  min-width:240px;
  max-width:290px;
  background:#fff;
  border:1px solid #e2e8f0;
  border-radius:10px;
  box-shadow:0 14px 36px rgba(15,30,60,.18);
  padding:10px;
  z-index:9999;
}
.dd-submenu::before{
  content:'';
  position:absolute;
  top:-15px;
  bottom:-15px;
  left:-25px;
  width:30px;
  background:transparent;
  pointer-events:auto;
}
.dd-school-item:hover .dd-submenu,
.dd-school-item.open .dd-submenu{ display:block; }
.dd-submenu .dd-sub-link{ display:block; padding:7px 10px; border-radius:6px; font-size:12px; color:#475569; text-decoration:none; line-height:1.4; transition:background .15s, color .15s; }
.dd-submenu .dd-sub-link:hover{ background:#f1f5f9; color:#166f30; }
.dd-submenu .dd-sub-loading, .dd-submenu .dd-sub-error{ font-size:12px; color:#9aa4b2; padding:8px 10px; }
.dd-submenu .dd-sub-viewall{ display:flex; align-items:center; justify-content:center; gap:6px; margin-top:8px; padding:8px 14px; border-radius:20px; background:var(--green); color:#fff !important; font-size:12px; font-weight:600; text-decoration:none; transition:background .2s; }
.dd-submenu .dd-sub-viewall:hover{ background:#166f30; }


.dd-featured{
  background:linear-gradient(135deg,var(--primary) 0%,#1a5fa6 100%);
  border-radius:10px;
  padding:20px 18px;
  color:#fff;
  text-decoration:none;
  display:block;
  transition:opacity .2s;
}

.dd-featured:hover{opacity:.9;}

.dd-featured .feat-label{font-size:10px;letter-spacing:2px;text-transform:uppercase;opacity:.7;margin-bottom:6px;}

.dd-featured .feat-title{font-size:15px;font-weight:700;margin-bottom:6px;line-height:1.3;}

.dd-featured .feat-desc{font-size:12px;opacity:.75;line-height:1.5;margin-bottom:12px;}

.dd-featured .feat-btn{
  display:inline-block;
  background:var(--green);
  color:#fff;
  padding:6px 14px;
  border-radius:5px;
  font-size:12px;
  font-weight:600;
}

.search-wrap{
  display:flex;
  align-items:center;
  gap:8px;
  padding:0 0 0 14px;
  border-left:1px solid #eee;
  margin-left:6px;
}

.search-icon{
  cursor:pointer;
  color:#555;
  font-size:15px;
  transition:color .2s;
  padding:6px;
  border-radius:50%;
}

.search-icon:hover{color:var(--primary);}

.search-box{
  display:none;
  padding:6px 12px;
  border:1.5px solid #ddd;
  border-radius:20px;
  font-size:13px;
  font-family:"Poppins",sans-serif;
  outline:none;
  width:180px;
  transition:border-color .2s;
}

.search-box:focus{border-color:var(--green);}

.search-box.open{display:block;}

.hero { position:relative; padding:80px 48px; background:linear-gradient(135deg, #0b2c4d 0%, #0d3a6e 50%, #1a5fa6 100%); text-align:center; overflow:hidden; }
.hero-bg-pattern { position:absolute; inset:0; opacity:0.05; background-image: radial-gradient(circle at 20% 30%, #fff 1px, transparent 1px), radial-gradient(circle at 80% 70%, #fff 1px, transparent 1px); background-size:60px 60px, 80px 80px; }
.hero-deco { position:absolute; left:50%; top:-120px; transform:translateX(-50%); width:600px; height:600px; border-radius:50%; border:1px solid rgba(255,255,255,0.05); }
.hero-content { position:relative; z-index:2; max-width:680px; margin:0 auto; }
.hero-breadcrumb { display:flex; align-items:center; justify-content:center; gap:8px; font-size:12px; color:rgba(255,255,255,0.55); margin-bottom:20px; flex-wrap:wrap; }
.hero-breadcrumb a{ color:rgba(255,255,255,0.55); text-decoration:none; }
.hero-eyebrow { font-size:11px; font-weight:700; letter-spacing:4px; text-transform:uppercase; color:var(--gold); margin-bottom:16px; display:flex; align-items:center; justify-content:center; gap:10px; }
.hero-eyebrow::before, .hero-eyebrow::after { content:""; display:inline-block; width:28px; height:2px; background:var(--gold); }
.hero h1 { font-family:var(--font-head); font-size:44px; font-weight:800; color:#fff; line-height:1.15; margin-bottom:16px; }
.hero h1 em { font-style:normal; color:#4ed47a; }
.hero p { font-size:16px; color:rgba(255,255,255,0.75); line-height:1.75; max-width:560px; margin:0 auto; }

.filter-bar { background:#fff; padding:20px 48px; border-bottom:1px solid #eef0f4; display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
.filter-label { font-size:13px; font-weight:600; color:var(--navy); margin-right:4px; }
.filter-btn { padding:8px 18px; border-radius:25px; border:1.5px solid #dde2ea; background:#fff; cursor:pointer; font-size:13px; font-weight:500; color:var(--text-light); transition:all .2s; font-family:"Poppins",sans-serif; }
.filter-btn.active { background:var(--primary); border-color:var(--primary); color:#fff; font-weight:600; }
.filter-btn:hover:not(.active) { background:#f0f4f9; border-color:#b0bdd0; color:var(--primary); }

.facilities-section { padding:60px 24px; }
.facilities-inner { max-width:1480px; margin:0 auto; }
.section-head { margin-bottom:36px; }
.results-count { font-size:14px; color:var(--text-light); margin-top:6px; }
.results-count strong { color:var(--navy); }
.facilities-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(340px, 1fr)); gap:28px; }

.facility-card { background:#fff; border-radius:18px; overflow:hidden; border:1px solid #eef0f4; transition:transform .3s, box-shadow .3s; display:flex; flex-direction:column; position:relative; cursor:pointer; text-decoration:none; color:inherit; }
.facility-card:hover { transform:translateY(-8px); box-shadow:0 20px 50px rgba(11,44,77,0.13); }
.facility-card-visual { height:200px; position:relative; overflow:hidden; display:flex; align-items:center; justify-content:center; }
.facility-card-icon-large { font-size:80px; opacity:0.18; color:#fff; position:absolute; transition:opacity .3s, transform .3s; }
.facility-card-icon-center { font-size:52px; position:relative; z-index:2; width:88px; height:88px; border-radius:50%; background:rgba(255,255,255,0.2); border:2px solid rgba(255,255,255,0.35); display:flex; align-items:center; justify-content:center; backdrop-filter:blur(4px); transition:transform .3s, background .3s; }
.facility-card:hover .facility-card-icon-center { transform:scale(1.1); background:rgba(255,255,255,0.3); }
.facility-status { position:absolute; top:14px; right:14px; padding:5px 12px; border-radius:20px; font-size:11px; font-weight:700; background:rgba(255,255,255,0.2); color:#fff; border:1px solid rgba(255,255,255,0.35); backdrop-filter:blur(4px); }
.facility-status.available { background:rgba(30,142,62,0.25); border-color:rgba(78,212,122,0.5); color:#4ed47a; }
.facility-status.coming { background:rgba(245,166,35,0.2); border-color:rgba(245,166,35,0.4); color:#fcd34d; }

.facility-card-body { padding:24px; flex:1; display:flex; flex-direction:column; }
.facility-category { font-size:10px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--green); margin-bottom:8px; display:block; }
.facility-name { font-family:var(--font-head); font-size:19px; font-weight:800; color:var(--navy); margin-bottom:10px; line-height:1.25; }
.facility-desc { font-size:13.5px; color:var(--text-light); line-height:1.7; flex:1; margin-bottom:20px; }
.facility-tags { display:flex; flex-wrap:wrap; gap:6px; margin-bottom:20px; }
.facility-tag { display:inline-flex; align-items:center; gap:5px; background:var(--bg-light); color:var(--text-light); padding:4px 10px; border-radius:20px; font-size:11px; font-weight:500; border:1px solid #e4e9f0; }
.facility-tag i { font-size:10px; color:var(--primary); }
.facility-card-footer { padding:16px 24px; border-top:1px solid #f0f2f6; display:flex; align-items:center; justify-content:space-between; }
.facility-hrs { font-size:12px; color:var(--text-light); display:flex; align-items:center; gap:6px; }
.facility-hrs i { color:var(--green); }
.read-more-btn { display:inline-flex; align-items:center; gap:7px; background:var(--primary); color:#fff; padding:9px 20px; border-radius:8px; font-size:13px; font-weight:600; text-decoration:none; transition:background .2s, transform .15s; }
.read-more-btn:hover { background:#0d3a6e; transform:translateX(2px); }

.empty-state{ text-align:center; padding:60px 20px; color:var(--text-light); }

@@media(max-width:900px){ .facilities-section { padding:40px 20px; } .filter-bar { padding:16px 20px; } }
@@media(max-width:768px){ .announcement { padding:8px 20px; } .navbar { padding:14px 20px; } .hero { padding:60px 20px; } .hero h1 { font-size:30px; } .facilities-grid { grid-template-columns:1fr; } }

@@keyframes fadeInUp { from{opacity:0;transform:translateY(30px);} to{opacity:1;transform:translateY(0);} }
.animate-up { animation:fadeInUp .55s ease both; }

/* ===== USEFUL LINKS PAGE ===== */
.links-section { padding:60px 24px; }
.links-inner { max-width:1480px; margin:0 auto; }
.links-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(300px, 1fr)); gap:28px; }

.link-card { background:#fff; border-radius:18px; border:1px solid #eef0f4; padding:32px 28px; display:flex; flex-direction:column; transition:transform .3s, box-shadow .3s; }
.link-card:hover { transform:translateY(-8px); box-shadow:0 20px 50px rgba(11,44,77,0.13); }

.link-card-icon { width:60px; height:60px; border-radius:14px; background:linear-gradient(135deg, var(--primary), #1a5fa6); display:flex; align-items:center; justify-content:center; margin-bottom:20px; flex-shrink:0; }
.link-card-icon i { font-size:24px; color:#fff; }

.link-card-title { font-family:var(--font-head); font-size:19px; font-weight:700; color:var(--navy); margin-bottom:10px; }
.link-card-desc { font-size:14px; color:var(--text-light); line-height:1.65; flex-grow:1; margin-bottom:22px; }

.link-card-btn { display:inline-flex; align-items:center; justify-content:center; gap:8px; background:var(--green); color:#fff; padding:11px 20px; border-radius:8px; font-size:13px; font-weight:600; text-decoration:none; transition:background .2s, transform .15s; }
.link-card-btn:hover { background:#166f30; transform:translateY(-2px); color:#fff; }
.link-card-btn i { font-size:11px; }

.link-card-url { display:block; margin-top:14px; font-size:12px; color:#8a94a6; word-break:break-all; }

/* ===== Admin-only inline edit controls (Edit Mode only) ===== */
.lk-editbar{
  background:#0b2c4d;color:#fff;text-align:center;padding:10px 20px;
  font-family:"Poppins",sans-serif;font-size:13.5px;font-weight:600;
}
.lk-editbar a{color:#7ec8ff;margin-left:8px;text-decoration:none;}

.lk-add-btn{
  background:var(--green);border:1px solid var(--green);color:#fff;
  padding:10px 18px;border-radius:20px;font-size:13px;font-weight:600;
  cursor:pointer;display:inline-flex;align-items:center;gap:6px;
  margin-bottom:24px;
}
.lk-add-btn:hover{background:#166f30;}

.link-card{position:relative;}
.lk-card-actions{
  position:absolute;top:14px;right:14px;z-index:5;display:flex;gap:6px;
}
.lk-edit-btn,.lk-delete-btn{
  width:28px;height:28px;border-radius:6px;border:none;cursor:pointer;
  display:flex;align-items:center;justify-content:center;font-size:12px;
}
.lk-edit-btn{background:#eef2f7;color:#0b6dbf;}
.lk-edit-btn:hover{background:#0b6dbf;color:#fff;}
.lk-delete-btn{background:#eef2f7;color:#c0392b;}
.lk-delete-btn:hover{background:#c0392b;color:#fff;}
.lk-delete-btn:disabled{opacity:.5;cursor:default;}

.lk-modal-backdrop{
  display:none;position:fixed;inset:0;z-index:10000;
  background:rgba(8,20,40,.78);align-items:center;justify-content:center;
  backdrop-filter:blur(6px);padding:20px;
}
.lk-modal-backdrop.open{display:flex;}
.lk-modal{
  background:#fff;border-radius:18px;width:100%;max-width:520px;
  max-height:92vh;overflow-y:auto;box-shadow:0 28px 90px rgba(0,0,0,.28);
}
.lk-modal-header{
  padding:20px 26px;background:var(--primary);color:#fff;
  display:flex;align-items:center;justify-content:space-between;
  border-radius:18px 18px 0 0;
}
.lk-modal-header h3{font-family:var(--font-head);font-size:16px;font-weight:700;}
.lk-modal-close{
  background:rgba(255,255,255,.18);border:none;border-radius:50%;
  width:32px;height:32px;color:#fff;cursor:pointer;font-size:14px;
}
.lk-modal-body{padding:22px 26px 26px;}
.lk-field{margin-bottom:14px;}
.lk-field label{display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:#0b2c4d;margin-bottom:5px;}
.lk-field input[type=text]{
  width:100%;padding:9px 11px;border-radius:7px;border:1px solid #d7dde5;
  font-family:"Poppins",sans-serif;font-size:13px;
}
.lk-field textarea{
  width:100%;padding:9px 11px;border-radius:7px;border:1px solid #d7dde5;
  font-family:"Poppins",sans-serif;font-size:13px;resize:vertical;min-height:70px;
}
.lk-error{color:#c0392b;font-size:11.5px;margin-top:4px;display:none;}
.lk-modal-actions{display:flex;gap:10px;margin-top:6px;}
.lk-btn-primary,.lk-btn-secondary{
  flex:1;padding:11px 16px;border-radius:9px;font-family:"Poppins",sans-serif;
  font-size:13px;font-weight:600;cursor:pointer;border:none;
}
.lk-btn-primary{background:var(--green);color:#fff;}
.lk-btn-primary:hover{background:#166f30;}
.lk-btn-secondary{background:#f0f4f8;color:#0b2c4d;border:1.5px solid #dde2ea;}
.lk-btn-secondary:hover{background:#e4ecf4;}

#lkToast{
  position:fixed;top:20px;right:20px;z-index:20000;
  background:#1e8e3e;color:#fff;padding:14px 20px;border-radius:10px;
  box-shadow:0 10px 28px rgba(0,0,0,0.25);font-size:13.5px;font-weight:600;
  display:flex;align-items:center;gap:10px;opacity:0;transform:translateY(-12px);
  transition:opacity .25s, transform .25s;pointer-events:none;max-width:320px;
}
#lkToast.show{opacity:1;transform:translateY(0);}
#lkToast.error{background:#c0392b;}

@@media(max-width:900px){ .links-section { padding:40px 20px; } }
@@media(max-width:768px){ .links-grid { grid-template-columns:1fr; } }
</style>
<link rel="stylesheet" href="~/css/mobile-nav.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/public-modals.css" asp-append-version="true">
</head>
<body>

<div id="lkToast"></div>

@if (editMode)
{
    <div class="lk-editbar">
        <i class="fas fa-lock"></i> You are viewing this page in <strong>Admin Edit Mode</strong>.
        <a href="/links.html">Exit to normal view</a>
        <a href="/Admin"><i class="fas fa-user-shield"></i> Admin Panel</a>
    </div>
}

<partial name="_SiteHeader" />

<section class="hero">
  <div class="hero-bg-pattern"></div>
  <div class="hero-deco"></div>
  <div class="hero-content">
    <div class="hero-breadcrumb">
      <a href="/">Home</a>
      <i class="fas fa-chevron-right"></i>
      <span style="color:rgba(255,255,255,0.85)">Useful Links</span>
    </div>
    <div class="hero-eyebrow">Quick Access</div>
    <h1>Useful <em>Links</em></h1>
    <p>Handy shortcuts to the online systems and resources you use most &mdash; the Learning Management System, E-library, and more.</p>
  </div>
</section>

<section class="links-section">
  <div class="links-inner">
    @if (editMode)
    {
        <button type="button" class="lk-add-btn" onclick="openLinkModal()">
            <i class="fas fa-plus"></i> Add Link
        </button>
    }
    @if (Model == null || Model.Count == 0)
    {
        <div class="empty-state">
            <i class="fas fa-link" style="font-size:40px;opacity:0.3;display:block;margin-bottom:16px;"></i>
            <p>Abhi koi link add nahi kiya gaya.@(editMode ? " \"Add Link\" par click karke pehla link add karein." : "")</p>
        </div>
    }
    else
    {
        <div class="links-grid" id="lkGrid">
            @foreach (var link in Model)
            {
                <div class="link-card animate-up" data-link-id="@link.LinkId">
                    @if (editMode)
                    {
                        <div class="lk-card-actions">
                            <button type="button" class="lk-edit-btn" title="Edit"
                                    onclick='openLinkModal(@link.LinkId, @Html.Raw(Json.Serialize(link.Name)), @Html.Raw(Json.Serialize(link.Description)), @Html.Raw(Json.Serialize(link.Url)), @Html.Raw(Json.Serialize(link.Icon)))'>
                                <i class="fas fa-pen"></i>
                            </button>
                            <button type="button" class="lk-delete-btn" title="Delete" onclick="deleteLink(@link.LinkId, this)">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    }
                    <div class="link-card-icon"><i class="@link.Icon"></i></div>
                    <div class="link-card-title">@link.Name</div>
                    <div class="link-card-desc">@link.Description</div>
                    <a href="@link.Url" target="_blank" rel="noopener noreferrer" class="link-card-btn">
                        Visit Link <i class="fas fa-arrow-right"></i>
                    </a>
                    <span class="link-card-url">@link.Url</span>
                </div>
            }
        </div>
    }
  </div>
</section>

<partial name="_SiteFooter" />

@if (editMode)
{
    <div class="lk-modal-backdrop" id="lkModalBackdrop">
        <div class="lk-modal">
            <div class="lk-modal-header">
                <h3 id="lkModalTitle">Add Link</h3>
                <button type="button" class="lk-modal-close" onclick="closeLinkModal()"><i class="fas fa-times"></i></button>
            </div>
            <div class="lk-modal-body">
                <input type="hidden" id="lkLinkId" value="0">
                <div class="lk-field">
                    <label>Name</label>
                    <input type="text" id="lkName" placeholder="e.g. LMS">
                </div>
                <div class="lk-field">
                    <label>Description</label>
                    <textarea id="lkDescription" placeholder="Short description shown on the card"></textarea>
                </div>
                <div class="lk-field">
                    <label>URL</label>
                    <input type="text" id="lkUrl" placeholder="https://...">
                </div>
                <div class="lk-field">
                    <label>Icon (Font Awesome class, optional)</label>
                    <input type="text" id="lkIcon" placeholder="e.g. fas fa-link">
                </div>
                <div class="lk-error" id="lkError"></div>
                <div class="lk-modal-actions">
                    <button type="button" class="lk-btn-primary" id="lkSaveBtn" onclick="saveLink(this)"><i class="fas fa-save"></i> Save</button>
                    <button type="button" class="lk-btn-secondary" onclick="closeLinkModal()">Cancel</button>
                </div>
            </div>
        </div>
    </div>

    @Html.AntiForgeryToken()
}
<script>
// Tells the account-dropdown script whether someone is logged in, so the
// Account button can show the right state (same pattern as the Homepage).
window.NAU_AUTH = {
    isAuthenticated: @Html.Raw(User.Identity != null && User.Identity.IsAuthenticated ? "true" : "false"),
    isAdmin: @Html.Raw(isAdmin ? "true" : "false"),
    userName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)(ViewBag.CurrentUserName ?? "")))
};

/* ===== SEARCH ===== */
function toggleSearch() {
    const box = document.getElementById("searchBox");
    box.classList.toggle("open");
    if (box.classList.contains("open")) box.focus();
}
function closeSearch() {
    setTimeout(() => { document.getElementById("searchBox").classList.remove("open"); }, 150);
}

/* ===== ACCOUNT DROPDOWN (Log In / Sign Up, or user name + Log Out) =====
   Same dynamic behaviour as the Homepage: shows "Account" with Log In /
   Sign Up when logged out, and the real user's name with Log Out when
   logged in. */
(function setupAccountDropdown() {
    var enhancedButtons = new WeakSet();
    var auth = window.NAU_AUTH || { isAuthenticated: false, isAdmin: false, userName: '' };

    function enhance(btn) {
        if (enhancedButtons.has(btn)) return;
        var alreadyWrapped = !!btn.closest('.account-dropdown');
        var isPristineAccountBtn = btn.textContent.trim().toLowerCase() === 'account';
        if (!alreadyWrapped && !isPristineAccountBtn) return;
        enhancedButtons.add(btn);

        var wrap = btn.closest('.account-dropdown');
        if (!wrap) {
            wrap = document.createElement('div');
            wrap.className = 'account-dropdown';
            btn.parentNode.insertBefore(wrap, btn);
            wrap.appendChild(btn);
        }

        btn.removeAttribute('href');
        btn.setAttribute('role', 'button');

        if (auth.isAuthenticated) {
            btn.innerHTML = '<i class="fas fa-circle-user" style="margin-right:6px;"></i>' + (auth.userName || 'My Account');
        } else {
            btn.innerHTML = 'Account';
        }

        var menu = document.createElement('div');
        menu.className = 'account-dropdown-menu';
        if (auth.isAuthenticated) {
            menu.innerHTML =
                '<a href="#" id="navLogoutLink"><i class="fas fa-right-from-bracket" style="margin-right:8px;"></i>Log Out</a>';
        } else {
            menu.innerHTML =
                '<a href="/Account/Login"><i class="fas fa-right-to-bracket" style="margin-right:8px;"></i>Log In</a>';
        }
        menu.style.position = 'fixed';
        menu.style.display = 'none';
        menu.style.zIndex = '2147483647';
        menu.style.background = '#fff';
        menu.style.minWidth = '150px';
        menu.style.borderRadius = '8px';
        menu.style.boxShadow = '0 10px 28px rgba(0,0,0,0.2)';
        menu.style.overflow = 'hidden';
        document.body.appendChild(menu);

        if (auth.isAuthenticated) {
            var logoutLink = menu.querySelector('#navLogoutLink');
            logoutLink.addEventListener('click', function (e) {
                e.preventDefault();
                var form = document.createElement('form');
                form.method = 'post';
                form.action = '/Account/Logout';
                document.body.appendChild(form);
                form.submit();
            });
        }

        function positionMenu() {
            var r = btn.getBoundingClientRect();
            menu.style.top = (r.bottom + 8) + 'px';
            menu.style.left = 'auto';
            menu.style.right = (window.innerWidth - r.right) + 'px';
        }

        var closeTimer;
        function openMenu() {
            clearTimeout(closeTimer);
            positionMenu();
            menu.style.display = 'block';
            wrap.classList.add('open');
        }
        function closeMenu() {
            closeTimer = setTimeout(function () {
                menu.style.display = 'none';
                wrap.classList.remove('open');
            }, 150);
        }

        wrap.addEventListener('mouseenter', openMenu);
        wrap.addEventListener('mouseleave', closeMenu);
        menu.addEventListener('mouseenter', function () { clearTimeout(closeTimer); });
        menu.addEventListener('mouseleave', closeMenu);

        btn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            if (menu.style.display === 'block') {
                menu.style.display = 'none';
                wrap.classList.remove('open');
            } else {
                openMenu();
            }
        });

        document.addEventListener('click', function (e) {
            if (!wrap.contains(e.target) && !menu.contains(e.target)) {
                menu.style.display = 'none';
                wrap.classList.remove('open');
            }
        });

        window.addEventListener('scroll', function () {
            if (menu.style.display === 'block') positionMenu();
        }, true);
        window.addEventListener('resize', function () {
            if (menu.style.display === 'block') positionMenu();
        });
    }

    function run() {
        document.querySelectorAll('.apply-btn').forEach(enhance);
    }

    run();
    var observer = new MutationObserver(run);
    observer.observe(document.body, { childList: true, subtree: true });
})();

/* ===== Admin inline add/edit/delete (Edit Mode only) ===== */
function getAntiForgeryToken(){
    var el = document.querySelector('input[name="__RequestVerificationToken"]');
    return el ? el.value : '';
}

function showLkToast(message, isError){
    var toast = document.getElementById('lkToast');
    toast.textContent = message;
    toast.className = isError ? 'show error' : 'show';
    setTimeout(function(){ toast.className = ''; }, 3000);
}

function openLinkModal(linkId, name, description, url, icon){
    document.getElementById('lkError').style.display = 'none';
    document.getElementById('lkLinkId').value = linkId || 0;
    document.getElementById('lkName').value = name || '';
    document.getElementById('lkDescription').value = description || '';
    document.getElementById('lkUrl').value = url || '';
    document.getElementById('lkIcon').value = icon || '';
    var lkPrev = document.getElementById('lkIconPreview');
    if (lkPrev) lkPrev.innerHTML = '<i class="' + (icon || 'fas fa-link') + '"></i>';
    document.getElementById('lkModalTitle').textContent = linkId ? 'Edit Link' : 'Add Link';
    document.getElementById('lkModalBackdrop').classList.add('open');
}

function closeLinkModal(){
    document.getElementById('lkModalBackdrop').classList.remove('open');
}

function saveLink(btn){
    var linkId = parseInt(document.getElementById('lkLinkId').value, 10) || 0;
    var name = document.getElementById('lkName').value.trim();
    var description = document.getElementById('lkDescription').value.trim();
    var url = document.getElementById('lkUrl').value.trim();
    var icon = document.getElementById('lkIcon').value.trim();
    var errorEl = document.getElementById('lkError');

    if (!name || !url) {
        errorEl.textContent = 'Name aur URL dono zaroori hain.';
        errorEl.style.display = 'block';
        return;
    }

    var isEdit = linkId > 0;
    var payload = { name: name, description: description, url: url, icon: icon };
    if (isEdit) payload.linkId = linkId;

    btn.disabled = true;
    fetch(isEdit ? '/Links/QuickUpdate' : '/Links/QuickAdd', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
        body: JSON.stringify(payload)
    })
    .then(function(res){ return res.json().then(function(data){ return { ok: res.ok, data: data }; }); })
    .then(function(result){
        btn.disabled = false;
        if (!result.ok || !result.data.success) {
            errorEl.textContent = (result.data && result.data.message) || 'Something went wrong.';
            errorEl.style.display = 'block';
            return;
        }
        showLkToast(isEdit ? 'Link updated.' : 'Link added.', false);
        closeLinkModal();
        setTimeout(function(){ location.reload(); }, 400);
    })
    .catch(function(){
        btn.disabled = false;
        errorEl.textContent = 'Network error, please try again.';
        errorEl.style.display = 'block';
    });
}

function deleteLink(linkId, btn){
    if (!confirm('Is link ko delete karna hai?')) return;
    btn.disabled = true;
    fetch('/Links/QuickDelete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
        body: JSON.stringify({ linkId: linkId })
    })
    .then(function(res){ return res.json().then(function(data){ return { ok: res.ok, data: data }; }); })
    .then(function(result){
        if (!result.ok || !result.data.success) {
            btn.disabled = false;
            showLkToast((result.data && result.data.message) || 'Delete failed.', true);
            return;
        }
        var card = document.querySelector('.link-card[data-link-id="' + linkId + '"]');
        if (card) card.remove();
        showLkToast('Link deleted.', false);
    })
    .catch(function(){
        btn.disabled = false;
        showLkToast('Network error, please try again.', true);
    });
}
</script>

<script src="~/js/global-search.js" asp-append-version="true"></script>
<script src="~/js/mobile-nav.js" asp-append-version="true"></script>
<script src="~/js/schools-submenu.js" asp-append-version="true"></script>

<partial name="_PublicModals" />
<script src="~/js/public-modals.js" asp-append-version="true"></script>
<script src="~/js/cms-icon-picker.js" asp-append-version="true"></script>
</body>
</html>

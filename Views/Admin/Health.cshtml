@model NAU_Web.Models.HealthDashboardViewModel
@inject NAU_Web.Services.ISiteBrandingService BrandingService
@{
    ViewData["Title"] = "System Health & Uptime Monitor";
    Layout = null;
    var branding = await BrandingService.GetSettingAsync();
    var siteTitle = branding?.SiteTitle ?? "National Aviation University";
    var darkLogoUrl = !string.IsNullOrWhiteSpace(branding?.DarkModeLogoUrl) ? branding.DarkModeLogoUrl : (!string.IsNullOrWhiteSpace(branding?.LogoUrl) ? branding.LogoUrl : "/images/logo.png");
    var filterStyle = string.IsNullOrWhiteSpace(branding?.DarkModeLogoUrl) ? "filter: brightness(0) invert(1);" : "";

    var isOperational = Model.Status.Equals("Operational", StringComparison.OrdinalIgnoreCase);
    var isDegraded = Model.Status.Equals("Degraded", StringComparison.OrdinalIgnoreCase);
    var statusColor = isOperational ? "#16a34a" : (isDegraded ? "#d97706" : "#dc2626");
    var statusBg = isOperational ? "#dcfce7" : (isDegraded ? "#fef3c7" : "#fee2e2");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>System Health &amp; Downtime Monitor &ndash; @siteTitle</title>
    <partial name="_Favicon" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800;900&family=Poppins:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #0b2c4d;
            --primary-dark: #071f36;
            --green: #16a34a;
            --green-light: #dcfce7;
            --blue: #0284c7;
            --blue-light: #e0f2fe;
            --amber: #d97706;
            --amber-light: #fef3c7;
            --red: #dc2626;
            --red-light: #fee2e2;
            --purple: #7c3aed;
            --purple-light: #f3e8ff;
            --gray-bg: #f8fafc;
            --card-bg: #ffffff;
            --border: #e2e8f0;
            --text-dark: #0f172a;
            --text-muted: #64748b;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Poppins', sans-serif;
            background: var(--gray-bg);
            color: var(--text-dark);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Top Admin Navbar */
        .admin-nav {
            background: linear-gradient(135deg, #0b2c4d 0%, #071f36 100%);
            padding: 16px 36px;
            color: #fff;
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
            position: sticky;
            top: 0;
            z-index: 100;
        }
        .admin-nav-inner {
            max-width: 1400px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
        }
        .admin-brand {
            display: flex;
            align-items: center;
            gap: 14px;
            text-decoration: none;
            color: #fff;
        }
        .admin-brand img {
            height: 44px;
            width: auto;
            display: block;
            object-fit: contain;
        }
        .admin-brand-text h1 {
            font-family: 'Montserrat', sans-serif;
            font-size: 18px;
            font-weight: 800;
            color: #ffffff;
            margin: 0;
        }
        .admin-brand-text .admin-brand-tagline {
            font-size: 10.5px;
            color: rgba(255, 255, 255, 0.75);
            font-weight: 500;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }
        .admin-nav-actions {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .btn-nav {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: all .2s;
            font-family: 'Poppins', sans-serif;
        }
        .btn-nav-outline {
            background: rgba(255,255,255,0.12);
            color: #fff;
            border: 1px solid rgba(255,255,255,0.25);
        }
        .btn-nav-outline:hover {
            background: rgba(255,255,255,0.22);
            transform: translateY(-1px);
        }

        /* Pulse Dot */
        .live-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            display: inline-block;
            margin-right: 6px;
            animation: pulseDot 1.8s infinite;
        }
        @@keyframes pulseDot {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.7); }
            70% { transform: scale(1.05); box-shadow: 0 0 0 8px rgba(22, 163, 74, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(22, 163, 74, 0); }
        }

        /* Main Container */
        .admin-main {
            max-width: 1400px;
            margin: 0 auto;
            padding: 32px 24px 60px;
            width: 100%;
            flex: 1;
        }

        .page-header {
            margin-bottom: 26px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
        }
        .page-header-title h2 {
            font-family: 'Montserrat', sans-serif;
            font-size: 24px;
            font-weight: 800;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .page-header-title p {
            font-size: 13.5px;
            color: var(--text-muted);
            margin-top: 4px;
        }
        .header-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .btn-action {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 18px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: all .2s;
            font-family: 'Poppins', sans-serif;
        }
        .btn-primary {
            background: var(--primary);
            color: #fff;
        }
        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-1px);
        }
        .btn-success {
            background: var(--green);
            color: #fff;
        }
        .btn-success:hover {
            background: #15803d;
            transform: translateY(-1px);
        }
        .btn-outline {
            background: #fff;
            color: var(--text-dark);
            border: 1.5px solid var(--border);
        }
        .btn-outline:hover {
            background: #f1f5f9;
            border-color: #cbd5e1;
        }

        /* Metric Cards Grid */
        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 16px;
            margin-bottom: 28px;
        }
        .metric-card {
            background: #fff;
            border-radius: 14px;
            padding: 20px 22px;
            border: 1px solid var(--border);
            box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform .2s, box-shadow .2s;
        }
        .metric-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
        }
        .metric-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
        }
        .metric-title {
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-muted);
        }
        .metric-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }
        .metric-value {
            font-family: 'Montserrat', sans-serif;
            font-size: 23px;
            font-weight: 800;
            color: var(--text-dark);
            line-height: 1.2;
        }
        .metric-subtitle {
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 6px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        /* Two Column Layout */
        .dashboard-split {
            display: grid;
            grid-template-columns: 1.15fr 1fr;
            gap: 24px;
        }
        @@media (max-width: 1024px) {
            .dashboard-split { grid-template-columns: 1fr; }
        }

        .panel-card {
            background: #fff;
            border-radius: 16px;
            border: 1px solid var(--border);
            box-shadow: 0 4px 20px rgba(15, 23, 42, 0.05);
            overflow: hidden;
            margin-bottom: 24px;
        }
        .panel-header {
            padding: 18px 24px;
            border-bottom: 1px solid var(--border);
            background: #f8fafc;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .panel-header h3 {
            font-family: 'Montserrat', sans-serif;
            font-size: 15.5px;
            font-weight: 700;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .panel-body {
            padding: 24px;
        }

        /* Admin Recipient Pills Box */
        .auto-recipients-box {
            background: #f0fdf4;
            border: 1.5px solid #bbf7d0;
            border-radius: 12px;
            padding: 16px 20px;
            margin-bottom: 20px;
        }
        .auto-recipients-title {
            font-weight: 700;
            font-size: 13.5px;
            color: #166534;
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 8px;
        }
        .admin-pill-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 10px;
        }
        .admin-pill {
            background: #ffffff;
            border: 1px solid #86efac;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            color: #15803d;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            box-shadow: 0 2px 5px rgba(22,101,52,0.06);
        }
        .admin-pill i { font-size: 11px; }

        /* Form elements */
        .form-group {
            margin-bottom: 18px;
        }
        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 6px;
        }
        .form-input {
            width: 100%;
            padding: 10px 14px;
            border-radius: 8px;
            border: 1.5px solid var(--border);
            font-family: 'Poppins', sans-serif;
            font-size: 13.5px;
            outline: none;
            transition: border-color .2s;
        }
        .form-input:focus {
            border-color: var(--blue);
        }
        .form-hint {
            font-size: 11.5px;
            color: var(--text-muted);
            margin-top: 4px;
        }

        /* Toggle switch */
        .switch-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 16px;
            background: #f8fafc;
            border-radius: 10px;
            border: 1px solid var(--border);
            margin-bottom: 18px;
        }
        .switch {
            position: relative;
            display: inline-block;
            width: 48px;
            height: 26px;
        }
        .switch input { opacity: 0; width: 0; height: 0; }
        .slider {
            position: absolute;
            cursor: pointer;
            inset: 0;
            background-color: #cbd5e1;
            transition: .3s;
            border-radius: 26px;
        }
        .slider:before {
            position: absolute;
            content: "";
            height: 20px;
            width: 20px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: .3s;
            border-radius: 50%;
        }
        input:checked + .slider { background-color: var(--green); }
        input:checked + .slider:before { transform: translateX(22px); }

        /* Incident Table */
        .log-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12.5px;
        }
        .log-table th {
            text-align: left;
            padding: 10px 12px;
            background: #f8fafc;
            border-bottom: 1px solid var(--border);
            color: var(--text-muted);
            font-weight: 600;
            font-size: 11px;
            text-transform: uppercase;
        }
        .log-table td {
            padding: 12px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }
        .log-table tr:hover { background: #f8fafc; }
        .badge-status {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 700;
        }

        /* Integration Box */
        .api-box {
            background: #0f172a;
            color: #e2e8f0;
            border-radius: 10px;
            padding: 16px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            margin-top: 10px;
            overflow-x: auto;
        }

        /* Toast notifications */
        .toast-msg {
            position: fixed;
            bottom: 24px;
            right: 24px;
            background: #0b2c4d;
            color: #fff;
            padding: 14px 22px;
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.25);
            font-size: 13.5px;
            font-weight: 500;
            z-index: 100000;
            display: flex;
            align-items: center;
            gap: 10px;
            animation: slideUp .3s ease;
        }
        @@keyframes slideUp { from { transform: translateY(30px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    </style>
</head>
<body>

    <!-- Header Navbar -->
    <header class="admin-nav">
        <div class="admin-nav-inner">
            <a href="/Admin" class="admin-brand" title="Back to Admin Dashboard">
                <img src="@darkLogoUrl" alt="@siteTitle Logo" style="@filterStyle" onerror="this.src='/images/logo.png'">
                <div class="admin-brand-text">
                    <h1>@siteTitle</h1>
                    <span class="admin-brand-tagline">System Health &amp; Uptime Monitor</span>
                </div>
            </a>
            <div class="admin-nav-actions">
                <div style="background:rgba(255,255,255,0.12); padding:6px 14px; border-radius:20px; font-size:12px; font-weight:600; display:flex; align-items:center;">
                    <span class="live-dot" style="background:@statusColor;"></span>
                    <span id="navLiveStatus">@Model.Status</span>
                </div>
                <a href="/Admin/Users" class="btn-nav btn-nav-outline"><i class="fas fa-users-gear"></i> Users</a>
                <a href="/Admin" class="btn-nav btn-nav-outline"><i class="fas fa-arrow-left"></i> Dashboard</a>
                <a href="/" target="_blank" class="btn-nav btn-nav-outline"><i class="fas fa-globe"></i> View Site</a>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="admin-main">

        <!-- Module Tabs / Sub-Navbar -->
        <div style="display:flex; align-items:center; gap:10px; margin-bottom:24px; background:#ffffff; padding:8px 12px; border-radius:12px; border:1px solid #e2e8f0; box-shadow:0 2px 8px rgba(15,23,42,0.03); flex-wrap:wrap;">
            <a href="/Admin/Users" style="display:inline-flex; align-items:center; gap:8px; padding:9px 18px; border-radius:8px; font-size:13px; font-weight:600; text-decoration:none; color:#64748b; transition:all .2s;">
                <i class="fas fa-users-gear"></i> Registered Users &amp; Accounts
            </a>
            <a href="/Admin/Analytics" style="display:inline-flex; align-items:center; gap:8px; padding:9px 18px; border-radius:8px; font-size:13px; font-weight:600; text-decoration:none; color:#64748b; transition:all .2s;">
                <i class="fas fa-chart-line"></i> Real-Time Visitor Analytics
            </a>
            <a href="/Admin/Health" style="display:inline-flex; align-items:center; gap:8px; padding:9px 18px; border-radius:8px; font-size:13px; font-weight:600; text-decoration:none; background:#0b2c4d; color:#ffffff; box-shadow:0 4px 12px rgba(11,44,77,0.25);">
                <i class="fas fa-heart-pulse"></i> Uptime &amp; Health Monitor
            </a>
        </div>

        <!-- Page Header -->
        <div class="page-header">
            <div class="page-header-title">
                <h2><i class="fas fa-heart-pulse" style="color:@statusColor;"></i> Real-Time Website &amp; Server Health</h2>
                <p>Continuous automated health monitoring, database ping diagnostics, and 100% automatic outage alerts to all registered administrators.</p>
            </div>
            <div class="header-actions">
                <button type="button" class="btn-action btn-outline" id="btnDiagnose" onclick="triggerDiagnostics()">
                    <i class="fas fa-arrows-rotate" id="diagnoseSpinner"></i> Run Live Diagnostic
                </button>
                <button type="button" class="btn-action btn-success" id="btnTestAlert" onclick="sendAutoTestAlert()">
                    <i class="fas fa-paper-plane"></i> Send Test Alert to Admin(s)
                </button>
            </div>
        </div>

        <!-- Metric Cards -->
        <div class="metrics-grid">
            <!-- Website Status -->
            <div class="metric-card">
                <div class="metric-head">
                    <span class="metric-title">System Status</span>
                    <div class="metric-icon" style="background:@statusBg; color:@statusColor;">
                        <i class="fas fa-shield-halved"></i>
                    </div>
                </div>
                <div class="metric-value" style="color:@statusColor;" id="metricStatusVal">
                    @Model.Status
                </div>
                <div class="metric-subtitle">
                    <span class="live-dot" style="background:@statusColor;"></span>
                    <span id="metricStatusMsg">@Model.Setting.LastCheckMessage</span>
                </div>
            </div>

            <!-- Database Latency -->
            <div class="metric-card">
                <div class="metric-head">
                    <span class="metric-title">SQL Database</span>
                    <div class="metric-icon" style="background:#e0f2fe; color:#0284c7;">
                        <i class="fas fa-database"></i>
                    </div>
                </div>
                <div class="metric-value" id="metricDbLatency">
                    @(Model.DatabaseHealthy ? $"{Model.DatabaseLatencyMs} ms" : "Offline")
                </div>
                <div class="metric-subtitle">
                    <i class="fas @(Model.DatabaseHealthy ? "fa-circle-check" : "fa-circle-xmark")" style="color:@(Model.DatabaseHealthy ? "#16a34a" : "#dc2626");"></i>
                    <span>@Model.DatabaseName (@(Model.DatabaseHealthy ? "Connected" : "Disconnected"))</span>
                </div>
            </div>

            <!-- Server Uptime -->
            <div class="metric-card">
                <div class="metric-head">
                    <span class="metric-title">Server Uptime</span>
                    <div class="metric-icon" style="background:#f3e8ff; color:#7c3aed;">
                        <i class="fas fa-clock"></i>
                    </div>
                </div>
                <div class="metric-value" id="metricUptime">
                    @($"{Model.ServerUptime.Days}d {Model.ServerUptime.Hours}h {Model.ServerUptime.Minutes}m")
                </div>
                <div class="metric-subtitle">
                    <i class="fas fa-power-off" style="color:#7c3aed;"></i>
                    <span>Started @Model.ServerStartTime.ToString("dd MMM, hh:mm tt") UTC</span>
                </div>
            </div>

            <!-- Memory Allocation -->
            <div class="metric-card">
                <div class="metric-head">
                    <span class="metric-title">Process Memory</span>
                    <div class="metric-icon" style="background:#fef3c7; color:#d97706;">
                        <i class="fas fa-microchip"></i>
                    </div>
                </div>
                <div class="metric-value" id="metricMemory">
                    @Model.MemoryUsageMb MB
                </div>
                <div class="metric-subtitle">
                    <i class="fas fa-server" style="color:#d97706;"></i>
                    <span>@Model.DotNetVersion (@Model.EnvironmentName)</span>
                </div>
            </div>

            <!-- Free Storage -->
            <div class="metric-card">
                <div class="metric-head">
                    <span class="metric-title">Disk Storage</span>
                    <div class="metric-icon" style="background:#dcfce7; color:#16a34a;">
                        <i class="fas fa-hard-drive"></i>
                    </div>
                </div>
                <div class="metric-value" id="metricDisk">
                    @Model.DiskFreeGb GB Free
                </div>
                <div class="metric-subtitle">
                    <i class="fas fa-folder-open" style="color:#16a34a;"></i>
                    <span>Total Capacity: @Model.DiskTotalGb GB</span>
                </div>
            </div>
        </div>

        <!-- Two Column Content -->
        <div class="dashboard-split">

            <!-- Left Column: Notification & Alert Configuration -->
            <div>
                <div class="panel-card">
                    <div class="panel-header">
                        <h3><i class="fas fa-bell" style="color:#0284c7;"></i> Automated Outage Alert Configuration</h3>
                        <span style="font-size:11.5px; color:#16a34a; font-weight:600;"><i class="fas fa-circle-check"></i> Auto-Admin Mode</span>
                    </div>
                    <div class="panel-body">
                        
                        <form id="healthSettingsForm" onsubmit="saveHealthSettings(event)">
                            
                            <!-- Master Alert Toggle -->
                            <div class="switch-row" style="margin-bottom:24px;">
                                <div>
                                    <div style="font-weight:600; font-size:13.5px;">Enable Automated Outage Alert Emails</div>
                                    <div style="font-size:11.5px; color:var(--text-muted);">Automatically dispatch emergency emails when server/database downtime is detected.</div>
                                </div>
                                <label class="switch">
                                    <input type="checkbox" id="alertsEnabled" @(Model.Setting.AlertsEnabled ? "checked" : "")>
                                    <span class="slider"></span>
                                </label>
                            </div>

                            <!-- Add New Recipient Input Box -->
                            <div class="form-group" style="margin-bottom:20px;">
                                <label class="form-label" for="newAlertEmailInput"><i class="fas fa-user-plus" style="color:#0284c7;"></i> Add Alert Recipient Email</label>
                                <div style="display:flex; gap:10px;">
                                    <input type="email" id="newAlertEmailInput" class="form-input" placeholder="Enter recipient email (e.g. admin@nau.edu.pk or devops@agency.gov.pk)" style="flex:1;" onkeydown="if(event.key==='Enter'){event.preventDefault();addEmailToList();}">
                                    <button type="button" class="btn-action btn-primary" onclick="addEmailToList()" style="padding:8px 18px; white-space:nowrap; background:#0284c7; border-color:#0284c7;">
                                        <i class="fas fa-plus"></i> Add Email
                                    </button>
                                </div>
                                <div class="form-hint">Type any valid email address and click "Add Email" or press Enter.</div>
                            </div>

                            <!-- Active Managed Alert Recipients List -->
                            <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:12px; padding:18px 20px; margin-bottom:24px;">
                                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:12px;">
                                    <div style="font-size:14px; font-weight:700; color:#0b2c4d; display:flex; align-items:center; gap:8px;">
                                        <i class="fas fa-users-gear" style="color:#0284c7;"></i>
                                        <span>Configured Alert Recipients (<span id="recipientCountText">0</span>)</span>
                                    </div>
                                    <span style="font-size:11px; background:#e0f2fe; color:#0369a1; padding:2px 10px; border-radius:12px; font-weight:600;">Alert Recipient List</span>
                                </div>
                                <div style="font-size:12px; color:#64748b; margin-bottom:14px;">
                                    Only emails in this list will receive downtime &amp; recovery notifications. Click 🗑 Delete to remove any email address.
                                </div>

                                <div id="emailListContainer" style="display:flex; flex-direction:column; gap:8px;">
                                    <!-- Rendered by JS -->
                                </div>
                            </div>

                            <!-- Check Interval -->
                            <div class="form-group">
                                <label class="form-label" for="checkInterval"><i class="fas fa-stopwatch"></i> Monitoring Frequency</label>
                                <select id="checkInterval" class="form-input" style="cursor:pointer;">
                                    <option value="30" selected="@(Model.Setting.CheckIntervalSeconds == 30)">Every 30 Seconds (High Sensitivity)</option>
                                    <option value="60" selected="@(Model.Setting.CheckIntervalSeconds == 60)">Every 60 Seconds (Standard / Recommended)</option>
                                    <option value="120" selected="@(Model.Setting.CheckIntervalSeconds == 120)">Every 2 Minutes</option>
                                    <option value="300" selected="@(Model.Setting.CheckIntervalSeconds == 300)">Every 5 Minutes</option>
                                </select>
                                <div class="form-hint">Requires 2 consecutive failed cycles before dispatching an alert to prevent false alarms.</div>
                            </div>

                            <!-- Webhook URL -->
                            <div class="form-group">
                                <label class="form-label" for="webhookUrl"><i class="fas fa-satellite-dish"></i> Optional Webhook Notification URL (Slack / Discord / Teams)</label>
                                <input type="url" id="webhookUrl" class="form-input" value="@Model.Setting.WebhookUrl" placeholder="https://hooks.slack.com/services/...">
                                <div class="form-hint">Optional: Paste webhook endpoint to get outage notifications in your team chat.</div>
                            </div>

                            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-top:24px;">
                                <button type="button" class="btn-action btn-outline" id="btnTestAlert" onclick="sendAutoTestAlert()">
                                    <i class="fas fa-paper-plane" style="color:var(--green);"></i> Test Email to Recipients
                                </button>
                                <button type="submit" class="btn-action btn-primary" id="btnSaveSettings">
                                    <i class="fas fa-floppy-disk"></i> Save Settings
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- External Monitoring Integration Guide -->
                <div class="panel-card">
                    <div class="panel-header">
                        <h3><i class="fas fa-cloud-arrow-up" style="color:#7c3aed;"></i> Public Cloud Monitoring Endpoints</h3>
                    </div>
                    <div class="panel-body">
                        <p style="font-size:13px; color:var(--text-muted); line-height:1.5;">
                            When you host this website in production, free external tools (e.g. <strong>UptimeRobot</strong>, <strong>BetterUptime</strong>, <strong>Pingdom</strong>) can ping these public endpoints:
                        </p>
                        
                        <div class="api-box">
                            <div><strong style="color:#38bdf8;">GET</strong> /health</div>
                            <div style="color:#94a3b8; font-size:11px; margin-top:4px;">Returns HTTP 200 OK when operational, 503 when degraded.</div>
                            <div style="margin-top:10px;"><strong style="color:#38bdf8;">GET</strong> /health/json</div>
                            <div style="color:#94a3b8; font-size:11px; margin-top:4px;">Returns live JSON telemetry (Latency, Uptime, Memory).</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Incident History & System Telemetry -->
            <div>
                <div class="panel-card">
                    <div class="panel-header">
                        <h3><i class="fas fa-list-check" style="color:#16a34a;"></i> Recent Diagnostics &amp; Health Log</h3>
                        <span style="font-size:11.5px; color:var(--text-muted);">Real-Time Events</span>
                    </div>
                    <div class="panel-body" style="padding:0;">
                        <div style="max-height:480px; overflow-y:auto;">
                            <table class="log-table" id="incidentTable">
                                <thead>
                                    <tr>
                                        <th>Time (UTC)</th>
                                        <th>Status</th>
                                        <th>Event / Diagnostic</th>
                                        <th>Alert</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!Model.RecentIncidents.Any())
                                    {
                                        <tr>
                                            <td colspan="4" style="text-align:center; padding:32px; color:var(--text-muted);">
                                                <i class="fas fa-circle-check" style="color:#16a34a; font-size:24px; margin-bottom:8px; display:block;"></i>
                                                No downtime or critical incident events recorded.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var log in Model.RecentIncidents)
                                        {
                                            var isLogOk = log.Status.Equals("Operational", StringComparison.OrdinalIgnoreCase) || log.Status.Equals("Healthy", StringComparison.OrdinalIgnoreCase);
                                            var badgeBg = isLogOk ? "#dcfce7" : (log.Status.Equals("Degraded", StringComparison.OrdinalIgnoreCase) ? "#fef3c7" : "#fee2e2");
                                            var badgeColor = isLogOk ? "#16a34a" : (log.Status.Equals("Degraded", StringComparison.OrdinalIgnoreCase) ? "#d97706" : "#dc2626");

                                            <tr>
                                                <td style="white-space:nowrap; font-family:'JetBrains Mono', monospace; font-size:11.5px;">
                                                    @log.Timestamp.ToString("HH:mm:ss")
                                                </td>
                                                <td>
                                                    <span class="badge-status" style="background:@badgeBg; color:@badgeColor;">
                                                        @log.Status
                                                    </span>
                                                </td>
                                                <td>
                                                    <div style="font-weight:600; color:var(--text-dark);">@log.Title</div>
                                                    <div style="font-size:11.5px; color:var(--text-muted); margin-top:2px;">@log.Details</div>
                                                </td>
                                                <td style="white-space:nowrap;">
                                                    @if (log.IsAlertSent)
                                                    {
                                                        <span style="color:#0284c7; font-weight:600; font-size:11px;"><i class="fas fa-envelope-circle-check"></i> Sent</span>
                                                    }
                                                    else
                                                    {
                                                        <span style="color:#94a3b8; font-size:11px;">Internal</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Server Environment Specifications -->
                <div class="panel-card">
                    <div class="panel-header">
                        <h3><i class="fas fa-server" style="color:#d97706;"></i> Server &amp; Environment Specs</h3>
                    </div>
                    <div class="panel-body" style="font-size:13px;">
                        <table style="width:100%; border-collapse:collapse;">
                            <tr style="border-bottom:1px solid #f1f5f9;">
                                <td style="padding:8px 0; color:var(--text-muted); font-weight:500;">Host Machine Name:</td>
                                <td style="padding:8px 0; font-weight:600; text-align:right;">@Model.HostName</td>
                            </tr>
                            <tr style="border-bottom:1px solid #f1f5f9;">
                                <td style="padding:8px 0; color:var(--text-muted); font-weight:500;">Runtime Environment:</td>
                                <td style="padding:8px 0; font-weight:600; text-align:right;"><span style="background:#e0f2fe; color:#0369a1; padding:2px 8px; border-radius:4px; font-size:11.5px;">@Model.EnvironmentName</span></td>
                            </tr>
                            <tr style="border-bottom:1px solid #f1f5f9;">
                                <td style="padding:8px 0; color:var(--text-muted); font-weight:500;">Framework Version:</td>
                                <td style="padding:8px 0; font-weight:600; text-align:right;">@Model.DotNetVersion</td>
                            </tr>
                            <tr>
                                <td style="padding:8px 0; color:var(--text-muted); font-weight:500;">Last Alert Triggered:</td>
                                <td style="padding:8px 0; font-weight:600; text-align:right; color:#dc2626;">
                                    @(Model.Setting.LastAlertSentAt.HasValue ? Model.Setting.LastAlertSentAt.Value.ToString("dd MMM yyyy, hh:mm tt UTC") : "None (All Healthy)")
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>

        </div>

    </main>

    <script>
        function showToast(msg, isError = false) {
            const existing = document.querySelector('.toast-msg');
            if (existing) existing.remove();

            const toast = document.createElement('div');
            toast.className = 'toast-msg';
            toast.innerHTML = `<i class="fas ${isError ? 'fa-triangle-exclamation' : 'fa-circle-check'}" style="color:${isError ? '#f87171' : '#4ade80'}; font-size:16px;"></i> <span>${msg}</span>`;
            document.body.appendChild(toast);
            setTimeout(() => { toast.remove(); }, 4500);
        }

        let alertEmails = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Setting.ConfiguredAlertEmails ?? new List<string>()));
        if (!Array.isArray(alertEmails)) alertEmails = [];

        function renderEmailList() {
            const container = document.getElementById('emailListContainer');
            const countEl = document.getElementById('recipientCountText');
            if (countEl) countEl.innerText = alertEmails.length;

            if (!container) return;

            if (alertEmails.length === 0) {
                container.innerHTML = `
                    <div style="text-align:center; padding:20px; background:#fff; border:1px dashed #cbd5e1; border-radius:8px; color:#94a3b8; font-size:12.5px;">
                        <i class="fas fa-envelope-open" style="font-size:20px; margin-bottom:6px; display:block;"></i>
                        No recipient emails added. Add an email above so alerts can be sent.
                    </div>
                `;
                return;
            }

            container.innerHTML = alertEmails.map((email, idx) => `
                <div style="display:flex; align-items:center; justify-content:space-between; background:#ffffff; border:1px solid #e2e8f0; padding:10px 16px; border-radius:8px; transition:all 0.2s;">
                    <div style="display:flex; align-items:center; gap:10px;">
                        <div style="width:32px; height:32px; border-radius:50%; background:#e0f2fe; color:#0284c7; display:flex; align-items:center; justify-content:center; font-size:13px;">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <div>
                            <div style="font-weight:600; font-size:13px; color:#0f172a;">${email}</div>
                            <div style="font-size:11px; color:#16a34a; font-weight:500;"><i class="fas fa-check-circle" style="font-size:10px;"></i> Alert Notifications Active</div>
                        </div>
                    </div>
                    <button type="button" onclick="removeEmailFromList(${idx})" style="background:#fee2e2; color:#dc2626; border:1px solid #fca5a5; padding:6px 12px; border-radius:6px; font-size:12px; font-weight:600; cursor:pointer; display:flex; align-items:center; gap:5px; transition:all 0.2s;" onmouseover="this.style.background='#f87171';this.style.color='#fff';" onmouseout="this.style.background='#fee2e2';this.style.color='#dc2626';">
                        <i class="fas fa-trash-can"></i> Delete
                    </button>
                </div>
            `).join('');
        }

        function addEmailToList() {
            const input = document.getElementById('newAlertEmailInput');
            if (!input) return;
            const val = input.value.trim().toLowerCase();

            if (!val) {
                showToast('Please enter an email address.', true);
                return;
            }
            if (val.indexOf('@@') === -1) {
                showToast('Please enter a valid email address containing @@.', true);
                return;
            }
            if (alertEmails.map(e => e.toLowerCase()).includes(val)) {
                showToast('This email is already in the recipient list.', true);
                return;
            }

            alertEmails.push(val);
            input.value = '';
            renderEmailList();
            showToast(`Added ${val} to recipient list. Click "Save Settings" to save changes.`);
        }

        function removeEmailFromList(idx) {
            if (idx >= 0 && idx < alertEmails.length) {
                const removed = alertEmails[idx];
                alertEmails.splice(idx, 1);
                renderEmailList();
                showToast(`Removed ${removed} from recipient list. Click "Save Settings" to save changes.`);
            }
        }

        document.addEventListener('DOMContentLoaded', renderEmailList);

        async function saveHealthSettings(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSaveSettings');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';

            const payload = {
                configuredAlertEmails: alertEmails,
                alertsEnabled: document.getElementById('alertsEnabled').checked,
                checkIntervalSeconds: parseInt(document.getElementById('checkInterval').value, 10),
                webhookUrl: document.getElementById('webhookUrl').value.trim()
            };

            try {
                const res = await fetch('/Admin/UpdateHealthSettings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message);
                } else {
                    showToast(data.message || 'Error updating settings', true);
                }
            } catch (err) {
                showToast('Failed to connect to server.', true);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-floppy-disk"></i> Save Settings';
            }
        }

        async function sendAutoTestAlert() {
            const btn = document.getElementById('btnTestAlert');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending to Recipients...';

            try {
                const res = await fetch('/Admin/SendTestHealthAlert', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({})
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message);
                    setTimeout(() => { location.reload(); }, 2000);
                } else {
                    showToast(data.message || 'Failed to dispatch email.', true);
                }
            } catch (err) {
                showToast('Server error while sending test alert.', true);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-paper-plane"></i> Test Email to Recipients';
            }
        }

        async function triggerDiagnostics() {
            const btn = document.getElementById('btnDiagnose');
            const spinner = document.getElementById('diagnoseSpinner');
            btn.disabled = true;
            spinner.classList.add('fa-spin');

            try {
                const res = await fetch('/Admin/TriggerHealthDiagnostics', { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    showToast('Live diagnostics completed: Database Latency is ' + data.databaseLatencyMs + 'ms');
                    document.getElementById('metricDbLatency').innerText = data.databaseLatencyMs + ' ms';
                    document.getElementById('metricMemory').innerText = data.memoryUsageMb + ' MB';
                    document.getElementById('metricDisk').innerText = data.diskFreeGb + ' GB Free';
                    setTimeout(() => { location.reload(); }, 1200);
                } else {
                    showToast('Diagnostic failed.', true);
                }
            } catch (err) {
                showToast('Failed to execute diagnostic check.', true);
            } finally {
                btn.disabled = false;
                spinner.classList.remove('fa-spin');
            }
        }
    </script>
</body>
</html>

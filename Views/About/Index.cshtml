@if (editMode)
{
    <script src="~/js/cms-editor.js" asp-append-version="true"></script>
    <script src="~/js/about-cms-editor.js" asp-append-version="true"></script>
    <script>
        (function () {
            "use strict";

            var caaIds = {
                region: "cms-editable-region-caa",
                editBtn: "cmsEditBtn-caa",
                saveBtn: "cmsSaveBtn-caa",
                cancelBtn: "cmsCancelBtn-caa",
                status: "cmsStatus-caa",
                fileInput: "cmsImageInput-caa",
                videoInput: "cmsVideoInput-caa",
                antiForgeryForm: "cmsAntiForgeryForm"
            };
            var catiIds = {
                region: "cms-editable-region-cati",
                editBtn: "cmsEditBtn-cati",
                saveBtn: "cmsSaveBtn-cati",
                cancelBtn: "cmsCancelBtn-cati",
                status: "cmsStatus-cati",
                fileInput: "cmsImageInput-cati",
                videoInput: "cmsVideoInput-cati",
                antiForgeryForm: "cmsAntiForgeryForm"
            };
            var mgmtIds = {
                region: "cms-editable-region-mgmt",
                editBtn: "cmsEditBtn-mgmt",
                saveBtn: "cmsSaveBtn-mgmt",
                cancelBtn: "cmsCancelBtn-mgmt",
                status: "cmsStatus-mgmt",
                fileInput: "cmsImageInput-mgmt",
                videoInput: "cmsVideoInput-mgmt",
                antiForgeryForm: "cmsAntiForgeryForm"
            };

            // Each section still gets its own fully-wired editor instance
            // (own save endpoint, own image/video upload, own add/remove
            // milestone-and-card behaviour) -- only their toolbars are
            // hidden now. The page-level controls below drive all three at
            // once instead of the admin having to open/save each one
            // separately.
            var caaInstance  = initCmsEditor(caaIds);
            var catiInstance = initCmsEditor(catiIds);
            var mgmtInstance = initCmsEditor(mgmtIds);

            initAboutCmsEnhancer(caaIds);
            initAboutCmsEnhancer(catiIds);
            initAboutCmsEnhancer(mgmtIds);

            var instances = [caaInstance, catiInstance, mgmtInstance].filter(Boolean);

            var pageEditBtn   = document.getElementById("cmsEditBtn-page");
            var pageSaveBtn   = document.getElementById("cmsSaveBtn-page");
            var pageCancelBtn = document.getElementById("cmsCancelBtn-page");
            var pageStatus    = document.getElementById("cmsStatus-page");
            if (!pageEditBtn || !pageSaveBtn || !pageCancelBtn) return;

            function setPageStatus(text, isError) {
                if (!pageStatus) return;
                pageStatus.textContent = text || "";
                pageStatus.style.color = isError ? "#ff8a80" : "#fff";
            }

            pageEditBtn.addEventListener("click", function () {
                // "Click" each section's own (hidden) Edit button so both
                // cms-editor.js and about-cms-editor.js wire up exactly the
                // same way they already do per-section -- just triggered
                // for all three sections in one go.
                instances.forEach(function (inst) { inst.editBtn.click(); });
                pageEditBtn.style.display = "none";
                pageSaveBtn.style.display = "inline-flex";
                pageCancelBtn.style.display = "inline-flex";
                setPageStatus("Edit mode on: click any text to edit, hover an image/video to change it.");
            });

            // Automatically enter edit mode on load
            pageEditBtn.click();

            pageCancelBtn.addEventListener("click", function () {
                if (confirm("Discard unsaved changes on this page?")) {
                    location.reload();
                }
            });

            pageSaveBtn.addEventListener("click", function () {
                setPageStatus("Saving...");
                pageSaveBtn.disabled = true;
                Promise.all(instances.map(function (inst) { return inst.save(); }))
                    .then(function (results) {
                        var failed = results.filter(function (r) { return !r.success; });
                        if (failed.length === 0) {
                            setPageStatus("Saved! Reloading...");
                            setTimeout(function () { location.reload(); }, 600);
                        } else {
                            pageSaveBtn.disabled = false;
                            setPageStatus(
                                failed.length + " of " + results.length + " section(s) failed to save — try again.",
                                true
                            );
                        }
                    });
            });
        })();
    </script>
}

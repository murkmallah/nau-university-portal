@model NAU_Web.Models.Page
@{
    Layout = null;
    bool isAdmin  = User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin");
    bool editMode = ViewBag.EditMode == true;   // true only when reached via Admin Panel "Edit" link
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>About – National Aviation University</title>
<partial name="_Favicon" />

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Open+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">


    <link rel="stylesheet" href="~/css/public-site.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/courses-page.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/mobile-nav.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/public-modals.css" asp-append-version="true">

<script>
    window.NAU_AUTH = {
        isAuthenticated: @Html.Raw(User.Identity != null && User.Identity.IsAuthenticated ? "true" : "false"),
        isAdmin: @Html.Raw(isAdmin ? "true" : "false"),
        userName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)ViewBag.CurrentUserName ?? ""))
    };
</script>
@if (editMode)
{
    <link rel="stylesheet" href="~/css/cms-editor.css" asp-append-version="true">
}
    <style>
:root {
  --primary: #0b2c4d;
  --green:   #1e8e3e;
  --bg:      #f5f7fb;
  --white:   #fff;
  --shadow:  0 6px 20px rgba(0,0,0,0.08);
  --navy:    #0d2c54;
  --gold:    #f5a623;
  --text:    #333;
  --text-light: #666;
  --border:  #e0e0e0;
  --bg-light: #f7f9fc;
  --font-head: "Montserrat", sans-serif;
  --font-body: "Open Sans", sans-serif;
}

*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

body { background: var(--bg); font-family: "Poppins", sans-serif; color: var(--text); }

/* .announcement / .scroll / .account-dropdown / .apply-btn now come from
   the single shared file wwwroot/css/public-site.css (linked above), so
   this page always matches the rest of the site automatically. */
.navbar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 0 48px; background: white;
  box-shadow: 0 2px 12px rgba(0,0,0,0.07);
  position: sticky; top: 0; z-index: 1000; height: 68px;
}

.logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }

.logo img { height: 48px; width: auto; }

.menu { display: flex; align-items: stretch; height: 100%; gap: 0; }

.menu-item { position: static; display: flex; align-items: center; }

.menu-item > .nav-link {
  display: flex; align-items: center; gap: 5px;
  padding: 0 14px; height: 100%; text-decoration: none;
  color: #333; font-size: 13.5px; font-weight: 500;
  white-space: nowrap; position: relative; transition: color .2s;
  cursor: pointer; border: none; background: none; font-family: "Poppins", sans-serif;
}

.menu-item > .nav-link::after {
  content: ""; position: absolute; bottom: 0; left: 14px; right: 14px;
  height: 3px; background: var(--green);
  transform: scaleX(0); transition: transform .25s; border-radius: 2px 2px 0 0;
}

.menu-item:hover > .nav-link { color: var(--primary); }

.menu-item:hover > .nav-link::after { transform: scaleX(1); }

.nav-link .chevron { font-size: 10px; opacity: .6; transition: transform .25s; }

.menu-item:hover > .nav-link .chevron { transform: rotate(180deg); }

.menu-item.active > .nav-link { color: var(--primary); }

.menu-item.active > .nav-link::after { transform: scaleX(1); }

.dropdown {
  position: absolute; top: 68px; left: 0; right: 0;
  background: #fff; box-shadow: 0 8px 32px rgba(0,0,0,0.12);
  display: none; border-top: 3px solid var(--green); z-index: 999;
  animation: fadeSlide .2s ease;
}

@@keyframes fadeSlide {
  from{opacity:0;transform:translateY(-8px);}
  to{opacity:1;transform:translateY(0);}
}

.menu-item:hover .dropdown { display: block; }

.dd-inner {
  max-width: 1480px; margin: 0 auto; padding: 28px 24px 32px;
  display: flex; gap: 0;
}

.dd-col {
  flex: 1; padding: 0 24px; border-right: 1px solid #f0f2f5;
}

.dd-col:first-child { padding-left: 0; }

.dd-col:last-child { border-right: none; padding-right: 0; }

.dd-col-title {
  font-size: 12px; font-weight: 700; letter-spacing: 2px;
  text-transform: uppercase; color: var(--green);
  margin-bottom: 14px; padding-bottom: 8px; border-bottom: 1px solid #eef0f3;
}

.dd-link {
  display: flex; align-items: flex-start; gap: 10px;
  padding: 9px 10px; border-radius: 7px; text-decoration: none;
  color: #444; font-size: 13px; line-height: 1.35;
  transition: background .15s, color .15s; margin-bottom: 2px;
}

.dd-link:hover { background: #f5f7fb; color: var(--primary); }

.dd-link:hover .dd-icon { background: var(--primary); color: #fff; }

.dd-link .dd-icon {
  width: 32px; height: 32px; background: #eef2f8; border-radius: 7px;
  display: flex; align-items: center; justify-content: center;
  font-size: 13px; color: var(--primary); flex-shrink: 0;
  transition: background .15s, color .15s; margin-top: 1px;
}

.dd-link .dd-text strong { display: block; font-weight: 600; font-size: 13px; color: inherit; }

.dd-link .dd-text span { font-size: 11px; color: #999; line-height: 1.4; }

.dd-featured {
  background: linear-gradient(135deg, var(--primary) 0%, #1a5fa6 100%);
  border-radius: 10px; padding: 20px 18px; color: #fff;
  text-decoration: none; display: block; transition: opacity .2s;
}

.dd-featured:hover { opacity: .9; }

.dd-featured .feat-label { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; opacity: .7; margin-bottom: 6px; }

.dd-featured .feat-title { font-size: 15px; font-weight: 700; margin-bottom: 6px; line-height: 1.3; }

.dd-featured .feat-desc { font-size: 12px; opacity: .75; line-height: 1.5; margin-bottom: 12px; }

.dd-featured .feat-btn {
  display: inline-block; background: var(--green);
  color: #fff; padding: 6px 14px; border-radius: 5px; font-size: 12px; font-weight: 600;
}

.dd-view-all {
  display: inline-flex; align-items: center; gap: 6px; margin-top: 10px;
  padding: 7px 14px; background: var(--green); color: #fff; border-radius: 5px;
  font-size: 12px; font-weight: 600; text-decoration: none;
  font-family: "Poppins", sans-serif; transition: background .2s, transform .15s;
}

.dd-view-all:hover { background: #166f30; transform: translateY(-1px); }
/* ===== Academics dropdown: school course-preview submenu (hover flyout) ===== */
.dd-school-item{ position:relative; }
.dd-school-link{ padding-right:34px; position:relative; }
.dd-school-arrow{
  position:absolute; right:12px; top:50%; transform:translateY(-50%) rotate(0deg);
  font-size:11px; color:#9aa4b2; padding:8px; cursor:pointer; transition:transform .2s, color .2s;
}
.dd-school-item:hover .dd-school-arrow,
.dd-school-item.open .dd-school-arrow{ transform:translateY(-50%) rotate(90deg); color:#166f30; }
.dd-submenu{
  display:none;
  position:absolute;
  top:-8px;
  left:100%;
  margin-left:8px;
  min-width:240px;
  max-width:290px;
  background:#fff;
  border:1px solid #e2e8f0;
  border-radius:10px;
  box-shadow:0 14px 36px rgba(15,30,60,.18);
  padding:10px;
  z-index:9999;
}
.dd-submenu::before{
  content:'';
  position:absolute;
  top:-15px;
  bottom:-15px;
  left:-25px;
  width:30px;
  background:transparent;
  pointer-events:auto;
}
.dd-school-item:hover .dd-submenu,
.dd-school-item.open .dd-submenu{ display:block; }
.dd-submenu .dd-sub-link{ display:block; padding:7px 10px; border-radius:6px; font-size:12px; color:#475569; text-decoration:none; line-height:1.4; transition:background .15s, color .15s; }
.dd-submenu .dd-sub-link:hover{ background:#f1f5f9; color:#166f30; }
.dd-submenu .dd-sub-loading, .dd-submenu .dd-sub-error{ font-size:12px; color:#9aa4b2; padding:8px 10px; }
.dd-submenu .dd-sub-viewall{ display:flex; align-items:center; justify-content:center; gap:6px; margin-top:8px; padding:8px 14px; border-radius:20px; background:var(--green); color:#fff !important; font-size:12px; font-weight:600; text-decoration:none; transition:background .2s; }
.dd-submenu .dd-sub-viewall:hover{ background:#166f30; }


.search-wrap {
  display: flex; align-items: center; gap: 8px;
  padding: 0 0 0 14px; border-left: 1px solid #eee; margin-left: 6px;
}

.search-icon { cursor: pointer; color: #555; font-size: 15px; transition: color .2s; padding: 6px; border-radius: 50%; }

.search-icon:hover { color: var(--primary); }

.page-hero {
  background: linear-gradient(110deg, #0b1f3a 0%, #0d3a6e 60%, #1a5fa6 100%);
  padding: 80px 48px 64px;
  position: relative;
  overflow: hidden;
}

.page-hero::before {
  content: "";
  position: absolute; inset: 0;
  background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
}

.page-hero-inner { max-width: 1480px; margin: 0 auto; padding: 0 24px; position: relative; z-index: 1; }

.page-hero-eyebrow {
  font-size: 11px; font-weight: 700; letter-spacing: 4px;
  text-transform: uppercase; color: var(--gold); margin-bottom: 14px;
  display: flex; align-items: center; gap: 10px;
}

.page-hero-eyebrow::before {
  content: ""; display: inline-block; width: 32px; height: 2px; background: var(--gold);
}

.page-hero h1 {
  font-family: var(--font-head); font-size: 42px; font-weight: 800;
  color: #fff; margin-bottom: 16px; line-height: 1.15;
}

.page-hero h1 em { font-style: normal; color: #4ed47a; }

.page-hero p {
  font-size: 16px; color: rgba(255,255,255,0.8);
  max-width: 600px; line-height: 1.7;
}

.section-nav {
  background: #fff;
  border-bottom: 2px solid #eef0f3;
  position: sticky; top: 68px; z-index: 900;
  box-shadow: 0 2px 12px rgba(0,0,0,0.06);
}

.section-nav-inner {
  max-width: 1480px; margin: 0 auto;
  display: flex; gap: 0; padding: 0 24px;
}

.section-nav-link {
  display: flex; align-items: center; gap: 10px;
  padding: 18px 28px; text-decoration: none; color: #666;
  font-size: 13.5px; font-weight: 500; font-family: "Poppins", sans-serif;
  border-bottom: 3px solid transparent; margin-bottom: -2px;
  transition: color .2s, border-color .2s; white-space: nowrap;
}

.section-nav-link i { font-size: 15px; color: var(--green); opacity: .7; }

.section-nav-link:hover { color: var(--primary); border-bottom-color: var(--green); }

.section-nav-link.active { color: var(--primary); border-bottom-color: var(--green); font-weight: 700; }

.about-content { max-width: 1480px; margin: 0 auto; padding: 0 24px 80px; }

.about-section {
  padding: 72px 0 56px;
  border-bottom: 1px solid #e8ecf2;
}

.about-section:last-child { border-bottom: none; }

.about-section-header { margin-bottom: 40px; }

.section-label-tag {
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(30,142,62,0.08); color: var(--green);
  font-size: 11px; font-weight: 700; letter-spacing: 2.5px;
  text-transform: uppercase; padding: 6px 14px; border-radius: 20px;
  margin-bottom: 16px; border: 1px solid rgba(30,142,62,0.2);
}

.section-label-tag i { font-size: 12px; }

.about-section h2 {
  font-family: var(--font-head); font-size: 32px; font-weight: 800;
  color: var(--navy); margin-bottom: 12px; line-height: 1.2;
}

.about-section .underline-bar {
  width: 48px; height: 4px; background: var(--green); border-radius: 2px; margin-bottom: 0;
}

.about-two-col {
  display: grid; grid-template-columns: 1fr 340px; gap: 56px; align-items: start;
}

.about-two-col.reverse { grid-template-columns: 340px 1fr; }

.about-two-col.reverse .about-text { order: 2; }

.about-two-col.reverse .about-sidebar { order: 1; }

.about-text p {
  font-size: 15.5px; line-height: 1.85; color: #444;
  margin-bottom: 20px; font-family: var(--font-body);
}

.about-text p:last-child { margin-bottom: 0; }

.highlight-quote {
  background: linear-gradient(135deg, #0b2c4d 0%, #1a5fa6 100%);
  border-radius: 12px; padding: 28px 30px; color: #fff;
  margin: 32px 0; position: relative; overflow: hidden;
}

.highlight-quote::before {
  content: "“"; font-size: 120px; line-height: 1; color: rgba(255, 255, 255, 0.911);
  position: absolute; top: -10px; left: 12px; font-family: Georgia, serif;
}

.highlight-quote p {
  font-size: 15px; line-height: 1.7; font-style: italic;
  position: relative; z-index: 1; margin: 0; color: white;
}

.about-sidebar { display: flex; flex-direction: column; gap: 16px; }

.info-card {
  background: #fff; border-radius: 12px; padding: 24px;
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 12px rgba(11,44,77,0.05);
}

.info-card-icon {
  width: 44px; height: 44px; background: rgba(30,142,62,0.1);
  border-radius: 10px; display: flex; align-items: center; justify-content: center;
  font-size: 18px; color: var(--green); margin-bottom: 14px;
}

.info-card h4 {
  font-family: var(--font-head); font-size: 14px; font-weight: 700;
  color: var(--navy); margin-bottom: 10px;
}

.info-card p { font-size: 13px; color: #666; line-height: 1.6; margin: 0; }

.info-card .info-badge {
  display: inline-block; background: var(--green); color: #fff;
  font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: 20px;
  margin-top: 12px; letter-spacing: 0.5px;
}

.timeline-card { background: #fff; border-radius: 12px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 2px 12px rgba(11,44,77,0.05); }

.timeline-card-header {
  background: linear-gradient(135deg, var(--primary) 0%, #1a5fa6 100%);
  padding: 18px 22px; color: #fff;
}

.timeline-card-header h4 { font-family: var(--font-head); font-size: 14px; font-weight: 800; margin: 0; }

.timeline-list { padding: 8px 0; }

.timeline-item {
  display: flex; align-items: flex-start; gap: 14px;
  padding: 12px 22px; border-bottom: 1px solid #f0f3f8;
}

.timeline-item:last-child { border-bottom: none; }

.timeline-year {
  font-family: var(--font-head); font-size: 13px; font-weight: 800;
  color: var(--green); min-width: 42px; padding-top: 1px;
}

.timeline-desc { font-size: 12.5px; color: #555; line-height: 1.5; }

.org-overview {
  background: #fff; border-radius: 16px; padding: 36px 40px;
  border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(11,44,77,0.06);
  margin-bottom: 36px;
}

.org-overview p {
  font-size: 15.5px; line-height: 1.85; color: #444;
  font-family: var(--font-body); margin-bottom: 18px;
}

.org-overview p:last-child { margin-bottom: 0; }

.mgmt-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 32px; }

.mgmt-card {
  background: #fff; border-radius: 12px; padding: 24px 22px;
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 12px rgba(11,44,77,0.05);
  transition: box-shadow .2s, transform .2s;
}

.mgmt-card:hover { box-shadow: 0 8px 30px rgba(11,44,77,0.12); transform: translateY(-3px); }

.mgmt-card-icon {
  width: 48px; height: 48px; border-radius: 12px;
  display: flex; align-items: center; justify-content: center;
  font-size: 20px; margin-bottom: 16px;
}

.mgmt-card h4 {
  font-family: var(--font-head); font-size: 15px; font-weight: 700;
  color: var(--navy); margin-bottom: 8px;
}

.mgmt-card p { font-size: 13px; color: #666; line-height: 1.6; }

.core-functions {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 32px;
}

.core-fn {
  background: linear-gradient(135deg, var(--primary) 0%, #1a5fa6 100%);
  border-radius: 12px; padding: 28px 24px; color: #fff; text-align: center;
}

.core-fn i { font-size: 28px; margin-bottom: 14px; opacity: .9; display: block; color: #4ed47a; }

.core-fn h4 { font-family: var(--font-head); font-size: 15px; font-weight: 800; margin-bottom: 8px; }

.core-fn p { font-size: 12.5px; opacity: .75; line-height: 1.6; }

.achievement-banner {
  background: linear-gradient(110deg, #0b1f3a 0%, #0d3a6e 100%);
  border-radius: 16px; padding: 36px 40px; color: #fff;
  display: flex; gap: 48px; align-items: center;
}

.achievement-stat { text-align: center; flex: 1; }

.achievement-stat .stat-num {
  font-family: var(--font-head); font-size: 42px; font-weight: 900;
  color: #4ed47a; line-height: 1; margin-bottom: 8px;
}

.achievement-stat .stat-label { font-size: 12.5px; opacity: .7; letter-spacing: 0.5px; line-height: 1.4; }

.achievement-divider { width: 1px; background: rgba(255,255,255,0.12); align-self: stretch; }

.footer-simple {
  background: var(--primary); color: rgba(255,255,255,0.6);
  text-align: center; padding: 28px 48px; font-size: 13px;
  display: flex; align-items: center; justify-content: space-between;
}

.footer-simple a { color: rgba(255,255,255,0.8); text-decoration: none; }

.footer-simple a:hover { color: #fff; }

.reveal {
  opacity: 0; transform: translateY(24px);
  transition: opacity .6s ease, transform .6s ease;
}

.reveal.visible { opacity: 1; transform: translateY(0); }

@@media(max-width: 960px) {
  .about-two-col { grid-template-columns: 1fr; }
  .about-two-col.reverse .about-text { order: 1; }
  .about-two-col.reverse .about-sidebar { order: 2; }
  .mgmt-grid { grid-template-columns: 1fr 1fr; }
  .core-functions { grid-template-columns: 1fr; }
  .achievement-banner { flex-direction: column; gap: 24px; }
  .achievement-divider { display: none; }
}

@@media(max-width: 640px) {
  .about-content { padding: 0 20px 60px; }
  .page-hero { padding: 56px 20px 48px; }
  .page-hero h1 { font-size: 28px; }
  .navbar { padding: 0 20px; }
  .announcement { padding: 8px 20px; }
  .mgmt-grid { grid-template-columns: 1fr; }
  .section-nav-inner { overflow-x: auto; }
  .section-nav-link { padding: 16px 18px; font-size: 12.5px; }
}
    </style>
</head>
<body>

@if (editMode)
{
    <div class="cms-mode-banner">
        <i class="fas fa-lock"></i> You are viewing this page in <strong>Admin Edit Mode</strong> (History of CAA, History of CATI &amp; Management sections).
        <a href="/about.html">Exit to normal view</a>
        <a href="/Admin" style="margin-left:14px;"><i class="fas fa-user-shield"></i> Admin Panel</a>
    </div>
}

<partial name="_SiteHeader" />

<!-- ===== PAGE HERO ===== -->
<div class="page-hero">
  <div class="page-hero-inner">
    <div class="page-hero-eyebrow">About NAU</div>
    <h1>Our <em>Heritage</em> &amp; Mission</h1>
    <p>From the establishment of Pakistan's Civil Aviation Authority to becoming the nation's premier aviation university — discover the history, structure, and leadership that define us.</p>
  </div>
</div>

<!-- ===== STICKY SECTION NAV ===== -->
<nav class="section-nav" id="sectionNav">
  <div class="section-nav-inner">
    <a href="#history-caa" class="section-nav-link active" data-section="history-caa">
      <i class="fas fa-flag"></i> History of CAA in Pakistan
    </a>
    <a href="#history-cati" class="section-nav-link" data-section="history-cati">
      <i class="fas fa-landmark"></i> History of CATI
    </a>
    <a href="#management" class="section-nav-link" data-section="management">
      <i class="fas fa-sitemap"></i> Management
    </a>
  </div>
</nav>

<!-- ===== MAIN CONTENT ===== -->
<div class="about-content">

@if (editMode)
{
    <form id="cmsAntiForgeryForm">@Html.AntiForgeryToken()</form>
}

  <!-- ======================================================= -->
  <!-- SECTION 1: HISTORY OF CAA IN PAKISTAN -->
  <!-- ======================================================= -->
  <section class="about-section" id="history-caa">
    @* ===== Everything in this section lives in the database (Pages table, slug = "about-history-caa"). =====
       Admin-editable the same way as the "History of CATI" and
       "Management & Governance" sections below. ===== *@
    <div id="cms-editable-region-caa" data-save-url="/Cms/SaveAboutHistoryCaaContent">
      @Html.Raw(Model.ContentHtml)
    </div>

    @if (editMode)
    {
        <div id="cmsToolbar-caa" class="cms-toolbar" style="display:none;">
            <span class="cms-toolbar-label">History of CAA</span>
            <button id="cmsEditBtn-caa" type="button" class="cms-btn cms-btn-edit">
                <i class="fas fa-pen"></i> Edit Section
            </button>

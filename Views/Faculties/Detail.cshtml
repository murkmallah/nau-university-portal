@model NAU_Web.Models.Faculty
@{
    Layout = null;
    var programs = Model.Programs.OrderBy(p => p.ProgramId).ToList();
    var deptGroups = programs
        .GroupBy(p => string.IsNullOrWhiteSpace(p.Department) ? Model.Name : p.Department)
        .ToList();
    string color = string.IsNullOrWhiteSpace(Model.ColorHex) ? "#0b3a5c" : Model.ColorHex.Trim();
    string icon = string.IsNullOrWhiteSpace(Model.Icon) ? "fas fa-graduation-cap" : Model.Icon.Trim();
    bool isSuperAdmin = User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin");
    bool isAdmin = User.Identity != null && User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Staff"));
    bool canEdit = ViewBag.CanEdit == true;
    bool editMode = ViewBag.EditMode == true;   // true only when reached via Read More in Admin Edit Mode (?edit=true)

    string DarkenHex(string hex, double amount)
    {
        hex = hex.StartsWith("#") ? hex.Substring(1) : hex;
        if (hex.Length != 6) return "#0f7490";
        int r = Convert.ToInt32(hex.Substring(0, 2), 16);
        int g = Convert.ToInt32(hex.Substring(2, 2), 16);
        int b = Convert.ToInt32(hex.Substring(4, 2), 16);
        r = (int)(r * (1 - amount));
        g = (int)(g * (1 - amount));
        b = (int)(b * (1 - amount));
        return $"#{r:X2}{g:X2}{b:X2}";
    }
    string color2 = DarkenHex(color, 0.35);
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

          <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; border-bottom:1px solid #d8ede0; padding-bottom:10px;">
              <h3 style="font-family:'Montserrat',sans-serif; font-size:16px; font-weight:800; color:var(--primary); margin:0;">
                  <i class="fas fa-edit" style="color:var(--green); margin-right:6px;"></i> Edit "About the Faculty" Section
              </h3>
              <button type="button" onclick="document.getElementById('fdAboutEditForm').style.display='none';" style="background:none; border:none; font-size:16px; cursor:pointer; color:#667;">&times;</button>
          </div>

          <div style="margin-bottom:14px;">
              <label style="display:block; font-size:11.5px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; color:var(--primary); margin-bottom:6px;">
                  Faculty Overview / About Paragraph
              </label>
              <textarea id="fdAboutDescInput" rows="4" style="width:100%; border:1.5px solid var(--border); border-radius:8px; padding:10px 14px; font-size:14px; font-family:'Poppins',sans-serif; color:var(--text);">@Model.Description</textarea>
          </div>

          <div style="display:flex; gap:10px; align-items:center; margin-top:16px;">
              <button type="button" id="fdAboutSaveBtn" onclick="fdSaveAboutEdit()" style="background:var(--green); color:#fff; border:none; padding:10px 22px; border-radius:8px; font-weight:700; font-size:13.5px; cursor:pointer; font-family:'Poppins',sans-serif; display:inline-flex; align-items:center; gap:6px;">
                  <i class="fas fa-check"></i> Save About Section
              </button>
              <button type="button" onclick="document.getElementById('fdAboutEditForm').style.display='none';" style="background:var(--bg-light); color:var(--primary); border:1px solid var(--border); padding:10px 18px; border-radius:8px; font-weight:700; font-size:13.5px; cursor:pointer; font-family:'Poppins',sans-serif;">
                  Cancel
              </button>
              <span id="fdAboutError" style="display:none; color:#c0392b; font-size:13px; margin-left:8px; font-weight:600;"></span>
          </div>
      </div>
  }

  <div class="fd-section-title-wrap">
    <div class="fd-section-title-heading">
      <h2>Departments &amp; Programs</h2>
      <div class="fd-title-line"></div>
    </div>
    @if (editMode)
    {
        <button type="button" class="fd-admin-btn fd-admin-btn-add" onclick="fdOpenAddProgram(null, @Model.FacultyId)">
            <i class="fas fa-plus"></i> Add Department
        </button>
    }
  </div>

  <div class="fd-dept-grid" id="fdDeptGrid">
    @foreach (var grp in deptGroups)
    {
        string deptDesc = "Focuses on academic instruction, research, and technical training in specialized fields of aviation and aerospace.";
        if (grp.Key.Contains("Engineering", StringComparison.OrdinalIgnoreCase) || grp.Key.Contains("ANS", StringComparison.OrdinalIgnoreCase) || grp.Key.Contains("System", StringComparison.OrdinalIgnoreCase))
        {
            deptDesc = "Focuses on avionics systems, navigation systems, and advanced aviation engineering. Students gain hands-on experience with real-world aviation systems and cutting-edge simulation environments.";
        }
        else if (grp.Key.Contains("Management", StringComparison.OrdinalIgnoreCase))
        {
            deptDesc = "Focuses on the business, economics, and management dimensions of the aviation industry. Combines aviation-specific knowledge with modern management principles to develop well-rounded leaders.";
        }
        else if (grp.Key.Contains("Operation", StringComparison.OrdinalIgnoreCase) || grp.Key.Contains("Traffic", StringComparison.OrdinalIgnoreCase) || grp.Key.Contains("ATM", StringComparison.OrdinalIgnoreCase))
        {
            deptDesc = "Focuses on flight operations, air traffic control procedures, aerodrome management, and aviation safety protocols to ensure seamless airspace operations.";
        }
        else if (grp.Key.Contains("Cyber", StringComparison.OrdinalIgnoreCase) || grp.Key.Contains("IT", StringComparison.OrdinalIgnoreCase) || grp.Key.Contains("Technology", StringComparison.OrdinalIgnoreCase) || grp.Key.Contains("Computer", StringComparison.OrdinalIgnoreCase))
        {
            deptDesc = "Equips students with cutting-edge skills in aviation cyber security, software development, cloud systems, and digital infrastructure for modern airspace networks.";
        }

        <div class="fd-dept-card" data-department="@grp.Key">
          <div class="fd-dept-header" style="background:@color">
            <div class="fd-dept-icon"><i class="@(grp.FirstOrDefault()?.Icon ?? icon)"></i></div>
            <div style="flex:1;min-width:0;">
              <div class="fd-dept-label">Department</div>
              <div class="fd-dept-name" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@grp.Key</div>
            </div>
            @if (editMode)
            {
                <button type="button" class="fd-dept-delete-btn" title="Delete this department" onclick="event.stopPropagation(); fdDeleteDepartment(@System.Text.Json.JsonSerializer.Serialize(grp.Key), @Model.FacultyId);">
                    <i class="fas fa-trash"></i>
                </button>
            }
          </div>
          <div class="fd-dept-body">
            <p class="fd-dept-desc">@deptDesc</p>
            <div class="fd-programs-title">Degree Programs</div>
            @foreach (var p in grp)
            {
                <div class="fd-prog-item" data-program-id="@p.ProgramId" onclick="openProgramModal(@p.ProgramId)">
                  <div class="fd-prog-icon"><i class="@(string.IsNullOrWhiteSpace(p.Icon) ? "fas fa-graduation-cap" : p.Icon)"></i></div>
                  <div>
                    <div class="fd-prog-name">@p.Name</div>
                    <div class="fd-prog-meta">
                      @if (!string.IsNullOrWhiteSpace(p.UndergradYears)) { <span><i class="fas fa-clock"></i> @p.UndergradYears UG</span> }
                      @if (!string.IsNullOrWhiteSpace(p.Adpyears)) { <span><i class="fas fa-award"></i> @p.Adpyears ADP</span> }
                      @if (!string.IsNullOrWhiteSpace(p.GradYears)) { <span><i class="fas fa-graduation-cap"></i> @p.GradYears Grad</span> }
                    </div>
                  </div>
                  @if (editMode)
                  {
                      <button type="button" class="fd-prog-icon-btn" title="Edit program" onclick="event.stopPropagation(); fdOpenEditProgram(@p.ProgramId);"><i class="fas fa-pen"></i></button>
                      <button type="button" class="fd-prog-icon-btn fd-prog-icon-btn-danger" title="Delete program" onclick="event.stopPropagation(); fdDeleteProgram(@p.ProgramId, this);"><i class="fas fa-trash"></i></button>
                  }
                  <i class="fas fa-chevron-right fd-prog-arrow"></i>
                </div>
            }
            @if (!grp.Any())
            {
                <div class="fd-no-programs">No programs listed yet.</div>
            }
            @if (editMode)
            {
                <button type="button" class="fd-admin-btn fd-admin-btn-add" style="margin-top:12px;width:100%;justify-content:center;" onclick="fdOpenAddProgram(@System.Text.Json.JsonSerializer.Serialize(grp.Key), @Model.FacultyId)">
                    <i class="fas fa-plus"></i> Add Program
                </button>
            }
          </div>
        </div>
    }
  </div>
</div>


<partial name="_SiteFooter" />

<script>
  function toggleSearch() {
    const box = document.getElementById("searchBox");
    box.classList.toggle("open");
    if (box.classList.contains("open")) box.focus();
  }
  function closeSearch() {
    setTimeout(() => { document.getElementById("searchBox").classList.remove("open"); }, 150);
  }

  var fdEditMode = @Html.Raw(editMode ? "true" : "false");
  var fdFacultyId = @Model.FacultyId;
  window.fdCurrentProgramId = null;

  var programData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
      programs.ToDictionary(p => p.ProgramId.ToString(), p => new
      {
          name = p.Name,
          department = p.Department ?? "",
          dept = string.IsNullOrWhiteSpace(p.Department) ? Model.Name : p.Department,
          icon = p.Icon ?? "fas fa-graduation-cap",
          overview = p.Overview ?? "",
          ug = p.UndergradYears ?? "",
          adp = p.Adpyears ?? "",
          grad = p.GradYears ?? "",
          careers = p.ProgramCareers.OrderBy(c => c.DisplayOrder).Select(c => new { id = c.ProgramCareerId, title = c.CareerTitle }),
          highlights = p.ProgramHighlights.OrderBy(h => h.DisplayOrder).Select(h => new { id = h.ProgramHighlightId, text = h.HighlightText })
      })
  ).Replace("</", "<\\/"));

  function fdAntiForgeryToken(){
    var el = document.querySelector('#fdAntiForgeryForm input[name="__RequestVerificationToken"]');
    return el ? el.value : '';
  }

  async function fdPost(url, body){
    var res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': fdAntiForgeryToken() },
      body: JSON.stringify(body)
    });
    var data = null;
    try { data = await res.json(); } catch (e) {}
    return { ok: res.ok, data: data };
  }

  var fdFeaturesList = @Html.Raw(ViewBag.FacultyFeaturesJson ?? "[]");

  function renderFacultyFeatures(){
    var container = document.getElementById('fdIntroFeatsContainer');
    if (!container) return;
    var html = '';
    if (!fdFeaturesList || fdFeaturesList.length === 0){
      html = '<div style="color:#999;font-size:13px;padding:10px;">No feature highlights added yet.</div>';
    } else {
      html = fdFeaturesList.map(function(f, idx){
        var adminBtns = '';
        if (fdEditMode){
          adminBtns = '<div class="fd-feat-actions">' +
            '<button type="button" class="fd-feat-act-btn" title="Edit Feature" onclick="fdOpenEditFeature(' + idx + ')"><i class="fas fa-pen"></i></button>' +
            '<button type="button" class="fd-feat-act-btn fd-feat-act-btn-danger" title="Delete Feature" onclick="fdDeleteFeature(' + idx + ')"><i class="fas fa-trash"></i></button>' +
            '</div>';
        }
        var iconClass = f.icon || 'fas fa-check-circle';
        return '<div class="fd-feat-item"><i class="' + iconClass + ' fd-feat-icon"></i><span class="fd-feat-text">' + f.text + '</span>' + adminBtns + '</div>';
      }).join('');
    }

    if (fdEditMode){
      html += '<button type="button" class="fd-admin-btn fd-admin-btn-secondary" style="margin-top:10px;width:100%;justify-content:center;" onclick="fdOpenAddFeature()"><i class="fas fa-plus"></i> Add Feature Card</button>';
    }
    container.innerHTML = html;
  }

  function fdOpenAddFeature(){
    document.getElementById('fdFeatModalTitle').textContent = 'Add Feature Card';
    document.getElementById('fdFeatIndex').value = '';
    document.getElementById('fdFeatIconInput').value = 'fas fa-award';
    document.getElementById('fdFeatTextInput').value = '';
    document.getElementById('fdFeatFormError').style.display = 'none';
    document.getElementById('fdFeatFormModal').classList.add('open');
  }

  function fdOpenEditFeature(idx){
    var item = fdFeaturesList[idx];
    if (!item) return;
    document.getElementById('fdFeatModalTitle').textContent = 'Edit Feature Card';
    document.getElementById('fdFeatIndex').value = idx;
    document.getElementById('fdFeatIconInput').value = item.icon || 'fas fa-check-circle';
    document.getElementById('fdFeatTextInput').value = item.text || '';
    document.getElementById('fdFeatFormError').style.display = 'none';
    document.getElementById('fdFeatFormModal').classList.add('open');
  }

  function fdCloseFeatModal(){
    var m = document.getElementById('fdFeatFormModal');
    if (m) m.classList.remove('open');
  }

  async function fdSaveFeatureForm(){
    var idx = document.getElementById('fdFeatIndex').value;
    var icon = document.getElementById('fdFeatIconInput').value.trim();
    var text = document.getElementById('fdFeatTextInput').value.trim();
    var errorBox = document.getElementById('fdFeatFormError');
    errorBox.style.display = 'none';

    if (!text){
      errorBox.textContent = 'Feature text is required.';
      errorBox.style.display = 'block';
      return;
    }
    if (!icon) icon = 'fas fa-check-circle';

    var newList = Array.from(fdFeaturesList);
    if (idx !== '' && idx !== null && idx !== undefined){
      newList[parseInt(idx, 10)] = { icon: icon, text: text };
    } else {
      newList.push({ icon: icon, text: text });
    }

    var btn = document.getElementById('fdFeatSaveBtn');
    btn.disabled = true;
    btn.textContent = 'Saving...';

    var r = await fdPost('@Url.Action("QuickSaveFacultyFeatures", "Faculties")', {
      FacultyId: fdFacultyId,
      FeaturesJson: JSON.stringify(newList)
    });

    btn.disabled = false;
    btn.textContent = 'Save Feature';

    if (!r.ok || !r.data || !r.data.success){
      errorBox.textContent = (r.data && r.data.message) || 'Failed to save feature.';
      errorBox.style.display = 'block';
      return;
    }

    fdFeaturesList = newList;
    renderFacultyFeatures();
    fdCloseFeatModal();
    if (window.fdShowToast) window.fdShowToast('Feature card saved!');
  }

  async function fdDeleteFeature(idx){
    if (!confirm('Are you sure you want to delete this feature card?')) return;
    var newList = fdFeaturesList.filter(function(_, i){ return i !== idx; });

    var r = await fdPost('@Url.Action("QuickSaveFacultyFeatures", "Faculties")', {
      FacultyId: fdFacultyId,
      FeaturesJson: JSON.stringify(newList)
    });

    if (!r.ok || !r.data || !r.data.success){
      alert((r.data && r.data.message) || 'Could not delete feature card.');
      return;
    }

    fdFeaturesList = newList;
    renderFacultyFeatures();
    if (window.fdShowToast) window.fdShowToast('Feature card deleted!');
  }

  document.addEventListener('DOMContentLoaded', function(){
    renderFacultyFeatures();
  });

  function renderModalCareers(programId, careers){
    var box = document.getElementById('fdModalCareers');
    if (!careers || careers.length === 0){
      box.innerHTML = '<span style="color:#999;font-size:12.5px;">No careers listed yet.</span>';
      return;
    }
    box.innerHTML = careers.map(function(c){
      var delBtn = fdEditMode ? ('<button type="button" class="fd-chip-x" title="Remove" onclick="fdDeleteCareer(' + c.id + ')"><i class="fas fa-times"></i></button>') : '';
      return '<span class="fd-career-pill">' + c.title + delBtn + '</span>';
    }).join('');
  }

  function renderModalHighlights(programId, highlights){
    var box = document.getElementById('fdModalHighlights');
    if (!highlights || highlights.length === 0){
      box.innerHTML = '<li style="color:#999;">No highlights listed yet.</li>';
      return;
    }
    box.innerHTML = highlights.map(function(h){
      var delBtn = fdEditMode ? ('<button type="button" class="fd-chip-x" title="Remove" onclick="fdDeleteHighlight(' + h.id + ')"><i class="fas fa-trash"></i></button>') : '';
      return '<li><span class="fd-hl-text"><i class="fas fa-check-circle"></i> ' + h.text + '</span>' + delBtn + '</li>';
    }).join('');
  }

  function openProgramModal(programId){
    var data = programData[programId];
    if (!data) return;
    window.fdCurrentProgramId = programId;
    document.getElementById('fdModalDept').textContent = data.dept;
    document.getElementById('fdModalTitle').textContent = data.name;
    document.getElementById('fdModalDesc').textContent = data.overview;
    document.getElementById('fdUG').textContent = data.ug || '-';
    document.getElementById('fdADP').textContent = data.adp || '-';
    document.getElementById('fdGrad').textContent = data.grad || '-';
    renderModalCareers(programId, data.careers);
    renderModalHighlights(programId, data.highlights);
    var newCareerInput = document.getElementById('fdNewCareerInput');
    var newHighlightInput = document.getElementById('fdNewHighlightInput');
    if (newCareerInput) newCareerInput.value = '';
    if (newHighlightInput) newHighlightInput.value = '';
    document.getElementById('fdModal').classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeProgramModal(){
    document.getElementById('fdModal').classList.remove('open');
    document.body.style.overflow = '';
  }
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape'){ closeProgramModal(); fdCloseFormModal(); } });

  // ===== Career chips: add / delete =====
  async function fdAddCareer(){
    var input = document.getElementById('fdNewCareerInput');
    var title = input.value.trim();
    if (!title || !window.fdCurrentProgramId) return;
    var r = await fdPost('@Url.Action("QuickAddProgramCareer", "Faculties")', { ProgramId: window.fdCurrentProgramId, CareerTitle: title });
    if (!r.ok || !r.data || !r.data.success){ alert((r.data && r.data.message) || 'Could not add career.'); return; }
    programData[window.fdCurrentProgramId].careers.push({ id: r.data.careerId, title: r.data.careerTitle });
    renderModalCareers(window.fdCurrentProgramId, programData[window.fdCurrentProgramId].careers);
    input.value = '';
  }
  async function fdDeleteCareer(careerId){
    if (!confirm('Remove this career?')) return;
    var r = await fdPost('@Url.Action("QuickDeleteProgramCareer", "Faculties")', { CareerId: careerId });
    if (!r.ok || !r.data || !r.data.success){ alert((r.data && r.data.message) || 'Could not remove career.'); return; }
    var pid = window.fdCurrentProgramId;
    programData[pid].careers = programData[pid].careers.filter(function(c){ return c.id !== careerId; });
    renderModalCareers(pid, programData[pid].careers);
  }

  // ===== Highlights: add / delete =====
  async function fdAddHighlight(){
    var input = document.getElementById('fdNewHighlightInput');
    var text = input.value.trim();
    if (!text || !window.fdCurrentProgramId) return;
    var r = await fdPost('@Url.Action("QuickAddProgramHighlight", "Faculties")', { ProgramId: window.fdCurrentProgramId, HighlightText: text });
    if (!r.ok || !r.data || !r.data.success){ alert((r.data && r.data.message) || 'Could not add highlight.'); return; }
    programData[window.fdCurrentProgramId].highlights.push({ id: r.data.highlightId, text: r.data.highlightText });
    renderModalHighlights(window.fdCurrentProgramId, programData[window.fdCurrentProgramId].highlights);
    input.value = '';
  }
  async function fdDeleteHighlight(highlightId){
    if (!confirm('Remove this highlight?')) return;
    var r = await fdPost('@Url.Action("QuickDeleteProgramHighlight", "Faculties")', { HighlightId: highlightId });
    if (!r.ok || !r.data || !r.data.success){ alert((r.data && r.data.message) || 'Could not remove highlight.'); return; }
    var pid = window.fdCurrentProgramId;
    programData[pid].highlights = programData[pid].highlights.filter(function(h){ return h.id !== highlightId; });
    renderModalHighlights(pid, programData[pid].highlights);
  }

  // ===== Add / Edit Program form modal =====
  function fdOpenAddProgram(department, facultyId){
    document.getElementById('fdFormModalTitle').textContent = 'Add Program';
    document.getElementById('fdFormProgramId').value = '';
    document.getElementById('fdFormFacultyId').value = facultyId;
    document.getElementById('fdFormName').value = '';
    document.getElementById('fdFormDepartment').value = department || '';
    document.getElementById('fdFormIcon').value = 'fas fa-graduation-cap';
    document.getElementById('fdFormOverview').value = '';
    document.getElementById('fdFormUG').value = '4 Years';
    document.getElementById('fdFormADP').value = '2 Years';
    document.getElementById('fdFormGrad').value = '2 Years';
    var cInput = document.getElementById('fdFormCareers');
    var hInput = document.getElementById('fdFormHighlights');
    if (cInput) cInput.value = '';
    if (hInput) hInput.value = '';
    document.getElementById('fdFormError').style.display = 'none';
    document.getElementById('fdFormModal').classList.add('open');
  }
  function fdOpenEditProgram(programId){
    var data = programData[programId];
    if (!data) return;
    document.getElementById('fdFormModalTitle').textContent = 'Edit Program';
    document.getElementById('fdFormProgramId').value = programId;
    document.getElementById('fdFormFacultyId').value = fdFacultyId;
    document.getElementById('fdFormName').value = data.name || '';
    document.getElementById('fdFormDepartment').value = data.department || '';
    document.getElementById('fdFormIcon').value = data.icon || 'fas fa-graduation-cap';
    document.getElementById('fdFormOverview').value = data.overview || '';
    document.getElementById('fdFormUG').value = data.ug || '';
    document.getElementById('fdFormADP').value = data.adp || '';
    document.getElementById('fdFormGrad').value = data.grad || '';
    var cInput = document.getElementById('fdFormCareers');
    var hInput = document.getElementById('fdFormHighlights');
    if (cInput) cInput.value = (data.careers || []).map(function(c){ return c.title; }).join(', ');
    if (hInput) hInput.value = (data.highlights || []).map(function(h){ return h.text; }).join('\n');
    document.getElementById('fdFormError').style.display = 'none';
    closeProgramModal();
    document.getElementById('fdFormModal').classList.add('open');
  }
  function fdCloseFormModal(){
    var m = document.getElementById('fdFormModal');
    if (m) m.classList.remove('open');
  }
  async function fdSaveProgramForm(){
    var programId = document.getElementById('fdFormProgramId').value;
    var facultyId = document.getElementById('fdFormFacultyId').value;
    var name = document.getElementById('fdFormName').value.trim();
    var department = document.getElementById('fdFormDepartment').value.trim();
    var icon = document.getElementById('fdFormIcon').value.trim();
    var overview = document.getElementById('fdFormOverview').value.trim();
    var ug = document.getElementById('fdFormUG').value.trim();
    var adp = document.getElementById('fdFormADP').value.trim();
    var grad = document.getElementById('fdFormGrad').value.trim();
    var cInput = document.getElementById('fdFormCareers');
    var hInput = document.getElementById('fdFormHighlights');
    var careers = cInput ? cInput.value.trim() : '';
    var highlights = hInput ? hInput.value.trim() : '';
    var errorBox = document.getElementById('fdFormError');
    errorBox.style.display = 'none';

    if (!name){
      errorBox.textContent = 'Program name is required.';
      errorBox.style.display = 'block';
      return;
    }

    var btn = document.getElementById('fdFormSaveBtn');
    btn.disabled = true;
    btn.textContent = 'Saving...';

    var url, body;
    if (programId){
      url = '@Url.Action("QuickUpdateProgram", "Faculties")';
      body = { ProgramId: parseInt(programId, 10), Name: name, Department: department, Icon: icon, Overview: overview, UndergradYears: ug, Adpyears: adp, GradYears: grad, Careers: careers, Highlights: highlights };
    } else {
      url = '@Url.Action("QuickAddProgram", "Faculties")';
      body = { FacultyId: parseInt(facultyId, 10), Name: name, Department: department, Icon: icon, Overview: overview, UndergradYears: ug, Adpyears: adp, GradYears: grad, Careers: careers, Highlights: highlights };
    }

    var r = await fdPost(url, body);
    if (!r.ok || !r.data || !r.data.success){
      errorBox.textContent = (r.data && r.data.message) || 'Could not save program.';
      errorBox.style.display = 'block';
      btn.disabled = false;
      btn.textContent = 'Save';
      return;
    }
    // Departments/programs are grouped server-side on render, so the
    // simplest reliable way to reflect an add/rename/move is a reload --
    // same pattern used for the hero edit above.
    location.reload();
  }

  // ===== Delete program (from the list row, or from inside the modal) =====
  async function fdDeleteProgram(programId, rowEl, fromModal){
    if (!programId) return;
    if (!confirm('Delete this program? This also removes its careers and highlights.')) return;
    var r = await fdPost('@Url.Action("QuickDeleteProgram", "Faculties")', { ProgramId: programId });
    if (!r.ok || !r.data || !r.data.success){ alert((r.data && r.data.message) || 'Could not delete program.'); return; }
    if (fromModal) { closeProgramModal(); }
    location.reload();
  }

  // ===== Delete entire department (and all its programs) =====
  async function fdDeleteDepartment(department, facultyId){
    if (!department || !facultyId) return;
    if (!confirm('Are you sure you want to delete the entire department "' + department + '" and all programs inside it? This will remove all associated programs, careers, and highlights from the database.')) return;
    var r = await fdPost('@Url.Action("QuickDeleteDepartment", "Faculties")', {
      FacultyId: facultyId,
      Department: department
    });
    if (!r.ok || !r.data || !r.data.success){
      alert((r.data && r.data.message) || 'Could not delete department.');
      return;
    }
    location.reload();
  }
</script>

<!-- ===== ACCOUNT DROPDOWN (Log In / Sign Up, or user name + Log Out) =====
     Same canonical implementation as home-scripts.js (the Homepage).
     IMPORTANT: the menu is appended directly to document.body with position:fixed,
     computed from the button's on-screen location -- NOT left nested inside
     .announcement. .announcement has overflow:hidden (see courses-page.css /
     faculties-page.css), so a menu nested inside it gets silently clipped
     and never becomes visible on hover, even though the JS logic runs fine.
     That was the bug on this page. Keep this "append to body" pattern on
     any future account-dropdown so this issue can't come back. ===== -->
<script>
window.NAU_AUTH = {
    isAuthenticated: @Html.Raw(User.Identity != null && User.Identity.IsAuthenticated ? "true" : "false"),
    isAdmin: @Html.Raw(isAdmin ? "true" : "false"),
    userName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)(ViewBag.CurrentUserName ?? "")))
};

(function setupAccountDropdown() {
    var enhancedButtons = new WeakSet();
    var auth = window.NAU_AUTH || { isAuthenticated: false, isAdmin: false, userName: '' };

    function enhance(btn) {
        if (enhancedButtons.has(btn)) return;

        var alreadyWrapped = !!btn.closest('.account-dropdown');
        var isPristineAccountBtn = btn.textContent.trim().toLowerCase() === 'account';
        var looksAlreadyEnhanced = btn.innerHTML.indexOf('fa-circle-user') !== -1;
        if (!alreadyWrapped && !isPristineAccountBtn && !looksAlreadyEnhanced) return;

        enhancedButtons.add(btn);

        var wrap = btn.closest('.account-dropdown');
        if (!wrap) {
            wrap = document.createElement('div');
            wrap.className = 'account-dropdown';
            btn.parentNode.insertBefore(wrap, btn);
            wrap.appendChild(btn);
        }

        btn.removeAttribute('href');
        btn.setAttribute('role', 'button');

        if (auth.isAuthenticated) {
            btn.innerHTML = '<i class="fas fa-circle-user" style="margin-right:6px;"></i>' + (auth.userName || 'My Account');
        } else {
            btn.innerHTML = 'Account';
        }

        // Appended to document.body, not to `wrap` -- see note above.
        var menu = document.createElement('div');
        menu.className = 'account-dropdown-menu';
        if (auth.isAuthenticated) {
            menu.innerHTML =
                '<a href="#" id="navLogoutLink"><i class="fas fa-right-from-bracket" style="margin-right:8px;"></i>Log Out</a>';
        } else {
            menu.innerHTML =
                '<a href="/Account/Login"><i class="fas fa-right-to-bracket" style="margin-right:8px;"></i>Log In</a>';
        }
        menu.style.position = 'fixed';
        menu.style.display = 'none';
        menu.style.zIndex = '2147483647';
        menu.style.background = '#fff';
        menu.style.minWidth = '150px';
        menu.style.borderRadius = '8px';
        menu.style.boxShadow = '0 10px 28px rgba(0,0,0,0.2)';
        menu.style.overflow = 'hidden';
        document.body.appendChild(menu);

        if (auth.isAuthenticated) {
            var logoutLink = menu.querySelector('#navLogoutLink');
            logoutLink.addEventListener('click', function (e) {
                e.preventDefault();
                var form = document.createElement('form');
                form.method = 'post';
                form.action = '/Account/Logout';
                document.body.appendChild(form);
                form.submit();
            });
        }

        function positionMenu() {
            var r = btn.getBoundingClientRect();
            menu.style.top = (r.bottom + 8) + 'px';
            menu.style.left = 'auto';
            menu.style.right = (window.innerWidth - r.right) + 'px';
        }

        var closeTimer;
        function openMenu() {
            clearTimeout(closeTimer);
            positionMenu();
            menu.style.display = 'block';
            wrap.classList.add('open');
        }
        function closeMenu() {
            closeTimer = setTimeout(function () {
                menu.style.display = 'none';
                wrap.classList.remove('open');
            }, 150);
        }

        // Hover for mouse users.
        wrap.addEventListener('mouseenter', openMenu);
        wrap.addEventListener('mouseleave', closeMenu);
        menu.addEventListener('mouseenter', function () { clearTimeout(closeTimer); });
        menu.addEventListener('mouseleave', closeMenu);

        // Click/tap for touch users (also acts as a toggle).
        btn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            if (menu.style.display === 'block') {
                menu.style.display = 'none';
                wrap.classList.remove('open');
            } else {
                openMenu();
            }
        });

        document.addEventListener('click', function (e) {
            if (!wrap.contains(e.target) && !menu.contains(e.target)) {
                menu.style.display = 'none';
                wrap.classList.remove('open');
            }
        });

        window.addEventListener('scroll', function () {
            if (menu.style.display === 'block') positionMenu();
        }, true);
        window.addEventListener('resize', function () {
            if (menu.style.display === 'block') positionMenu();
        });
    }

    function run() {
        document.querySelectorAll('.apply-btn').forEach(enhance);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', run);
    } else {
        run();
    }

    // Re-run if admin content edits change the DOM later. Without this, the
    // dropdown and its listeners can disappear after an edit is saved.
    var observer = new MutationObserver(run);
    observer.observe(document.body, { childList: true, subtree: true });
})();
</script>




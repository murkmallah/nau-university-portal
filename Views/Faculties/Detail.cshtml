<style>
  .account-dropdown{ position:relative; display:inline-block; }
  .account-dropdown > .apply-btn::after{
    content:"\f078"; font-family:"Font Awesome 6 Free"; font-weight:900;
    font-size:10px; margin-left:8px; opacity:.85; display:inline-block; transition:transform .2s;
  }
  .account-dropdown.open > .apply-btn::after,
  .account-dropdown:hover > .apply-btn::after{ transform:rotate(180deg); }
  .account-dropdown-menu a{ display:block; padding:11px 16px; color:#0b2c4d; text-decoration:none; font-size:13.5px; font-weight:600; border-bottom:1px solid #f0f2f5; }
  .account-dropdown-menu a:last-child{ border-bottom:none; }
  .account-dropdown-menu a:hover{ background:#f5f7fb; color:#1e8e3e; }

  /* ===== This faculty's own page (self-contained styles) ===== */
  .fd-hero{
    background:linear-gradient(135deg, @color 0%, @color2 100%);
    padding:64px 48px 56px; position:relative; overflow:hidden;
  }
  .fd-hero-inner{ max-width:1480px; margin:0 auto; display:flex; gap:28px; align-items:flex-start; padding:0 24px; }
  .fd-hero-icon{ width:78px; height:78px; border-radius:18px; background:rgba(255,255,255,0.12); display:flex; align-items:center; justify-content:center; font-size:34px; color:#fff; flex:none; }
  .fd-hero-crumb{ color:rgba(255,255,255,0.7); font-size:13px; margin-bottom:10px; display:flex; align-items:center; gap:6px; font-family:'Poppins',sans-serif; }
  .fd-hero-crumb a{ color:rgba(255,255,255,0.75); text-decoration:none; font-weight:500; }
  .fd-hero-crumb a:hover{ color:#fff; text-decoration:underline; }
  .fd-hero-crumb i{ font-size:10px; opacity:0.6; color:#fff; }
  .fd-hero-crumb span{ color:#ffffff; font-weight:700; }

  .fd-hero-label{ display:block; color:rgba(255,255,255,0.65); font-size:11px; font-weight:700; letter-spacing:3px; text-transform:uppercase; margin-bottom:6px; font-family:'Montserrat',sans-serif; }
  .fd-hero h1{ color:#fff; font-family:'Montserrat',sans-serif; font-weight:800; font-size:34px; margin:4px 0 12px; }
  .fd-hero p{ color:rgba(255,255,255,0.85); font-size:15px; max-width:680px; line-height:1.7; margin:0 0 20px; }
  .fd-hero-stats{ display:flex; gap:34px; flex-wrap:wrap; }
  .fd-stat strong{ display:block; color:#fff; font-size:22px; font-family:'Montserrat',sans-serif; font-weight:800; }
  .fd-stat span{ color:rgba(255,255,255,0.7); font-size:12.5px; }

  .fd-main{ max-width:1480px; margin:0 auto; padding:48px 24px 70px; }
  .fd-intro{ display:flex; gap:40px; flex-wrap:wrap; margin-bottom:44px; }
  .fd-intro-text{ flex:1 1 480px; }
  .fd-intro-text h2{ font-family:'Montserrat',sans-serif; font-weight:800; color:var(--primary); font-size:24px; margin-bottom:14px; }
  .fd-intro-text p{ color:var(--text-light); line-height:1.8; font-size:14.5px; }
  .fd-intro-feats{ flex:1 1 320px; display:grid; gap:12px; align-content:start; }
  .fd-feat{ display:flex; align-items:center; gap:10px; background:var(--bg-light); border:1px solid var(--border); border-radius:10px; padding:12px 14px; font-size:13.5px; color:var(--text); }
  .fd-feat i{ color:@color; font-size:16px; width:20px; text-align:center; }
  .fd-section-title-wrap { display:flex; align-items:center; justify-content:space-between; margin:40px 0 24px; }
  .fd-section-title-heading { display:flex; align-items:center; flex:1; }
  .fd-section-title-heading h2 { font-family:'Montserrat',sans-serif; font-weight:800; color:#0b2c4d; font-size:22px; margin:0; white-space:nowrap; }
  .fd-section-title-heading .fd-title-line { flex:1; height:1.5px; background:#cbd5e1; margin-left:20px; margin-right:20px; }

  .fd-dept-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(420px, 1fr)); gap:28px; }
  .fd-dept-card { background:#ffffff; border:1px solid #e2e8f0; border-radius:16px; overflow:hidden; box-shadow:0 10px 30px rgba(11,44,77,0.06); display:flex; flex-direction:column; transition:transform 0.2s ease, box-shadow 0.2s ease; }
  .fd-dept-card:hover { box-shadow:0 14px 38px rgba(11,44,77,0.1); }
  .fd-dept-header { background:#1e3a5f; color:#ffffff; padding:22px 24px; display:flex; align-items:center; gap:16px; border-radius:16px 16px 0 0; }
  .fd-dept-icon { width:44px; height:44px; border-radius:10px; background:rgba(255,255,255,0.16); display:flex; align-items:center; justify-content:center; font-size:18px; color:#ffffff; flex:none; }
  .fd-dept-label { font-size:10px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:rgba(255,255,255,0.7); margin-bottom:3px; font-family:'Montserrat',sans-serif; }
  .fd-dept-name { font-family:'Montserrat',sans-serif; font-weight:800; font-size:15.5px; color:#ffffff; margin:0; line-height:1.3; }
  .fd-dept-body { padding:24px 26px; display:flex; flex-direction:column; flex:1; }
  .fd-dept-desc { font-size:13.5px; color:#64748b; line-height:1.68; margin:0 0 22px; font-family:'Open Sans',sans-serif; }
  .fd-programs-title { font-size:10.5px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:#94a3b8; margin-bottom:14px; font-family:'Montserrat',sans-serif; }
  .fd-prog-item { display:flex; align-items:center; gap:14px; background:#f8fafc; border:1px solid #f1f5f9; border-radius:12px; padding:13px 16px; margin-bottom:11px; text-decoration:none; color:inherit; transition:all .2s ease; cursor:pointer; }
  .fd-prog-item:hover { background:#f1f5f9; border-color:#cbd5e1; transform:translateY(-2px); box-shadow:0 4px 14px rgba(11,44,77,0.06); }
  .fd-prog-icon { width:36px; height:36px; border-radius:8px; background:#e2e8f0; display:flex; align-items:center; justify-content:center; color:#1e3a5f; font-size:15px; flex:none; }
  .fd-prog-name { font-family:'Poppins',sans-serif; font-weight:700; font-size:13.5px; color:#0b2c4d; margin-bottom:3px; }
  .fd-prog-meta { display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
  .fd-prog-meta span { font-size:11px; color:#64748b; display:inline-flex; align-items:center; gap:5px; font-weight:500; }
  .fd-prog-meta span i { font-size:10px; color:#94a3b8; }
  .fd-prog-arrow { margin-left:auto; color:#cbd5e1; font-size:12px; transition:transform .2s ease; }
  .fd-prog-item:hover .fd-prog-arrow { color:#0b2c4d; transform:translateX(3px); }
  .fd-no-programs { color:var(--text-light); font-size:13.5px; font-style:italic; }

  /* ===== Admin edit controls: dept/program add/edit/delete ===== */
  .fd-admin-btn{ display:inline-flex; align-items:center; gap:6px; background:var(--primary); color:#fff; border:none; border-radius:8px; padding:8px 14px; font-size:12.5px; font-weight:700; cursor:pointer; font-family:'Poppins',sans-serif; white-space:nowrap; }
  .fd-admin-btn:hover{ opacity:.9; }
  .fd-admin-btn-danger{ background:#c0392b; }
  .fd-admin-btn-secondary{ background:var(--bg-light); color:var(--primary); border:1px solid var(--border); }
  .fd-prog-item{ position:relative; padding-right:14px; }
  .fd-prog-icon-btn{ flex:none; width:30px; height:30px; border-radius:50%; border:1px solid var(--border); background:#fff; color:var(--primary); cursor:pointer; font-size:12px; margin-left:4px; }
  .fd-prog-icon-btn:first-of-type{ margin-left:auto; }
  .fd-prog-icon-btn:hover{ background:var(--bg-light); }
  .fd-prog-icon-btn-danger{ color:#c0392b; }
  .fd-dept-delete-btn{
    margin-left:auto;
    width:32px; height:32px;
    border-radius:50%;
    border:1px solid rgba(255,255,255,0.3);
    background:rgba(255,255,255,0.18);
    color:#fff;
    cursor:pointer;
    font-size:13px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    transition:background .2s, transform .15s;
    flex:none;
  }
  .fd-dept-delete-btn:hover{
    background:#c0392b;
    border-color:#c0392b;
    color:#fff;
    transform:scale(1.08);
  }
  .fd-feat-item{ position:relative; display:flex; align-items:center; gap:10px; background:var(--bg-light); border:1px solid var(--border); border-radius:10px; padding:12px 14px; font-size:13.5px; color:var(--text); }
  .fd-feat-item i.fd-feat-icon{ color:@color; font-size:16px; width:20px; text-align:center; flex:none; }
  .fd-feat-item .fd-feat-text{ flex:1; line-height:1.4; }
  .fd-feat-actions{ display:flex; gap:4px; align-items:center; flex:none; margin-left:auto; }
  .fd-feat-act-btn{ width:26px; height:26px; border-radius:50%; border:1px solid var(--border); background:#fff; color:var(--primary); cursor:pointer; font-size:11px; display:inline-flex; align-items:center; justify-content:center; }
  .fd-feat-act-btn:hover{ background:var(--bg-light); }
  .fd-feat-act-btn-danger{ color:#c0392b; }
  .fd-feat-act-btn-danger:hover{ background:#fdecea; }

  /* Add/Edit Program modal (separate from the read-only Program modal) */
  .fd-form-modal-backdrop{ display:none; position:fixed; inset:0; background:rgba(11,44,77,0.55); z-index:2100; align-items:center; justify-content:center; padding:20px; overflow-y:auto; }
  .fd-form-modal-backdrop.open{ display:flex; }
  .fd-form-modal{ background:#fff; border-radius:14px; max-width:520px; width:100%; max-height:90vh; overflow-y:auto; font-family:'Poppins',sans-serif; }
  .fd-form-modal-header{ display:flex; align-items:center; justify-content:space-between; padding:18px 22px; border-bottom:1px solid #eef1f6; }
  .fd-form-modal-header h3{ font-family:'Montserrat',sans-serif; font-size:16px; font-weight:800; color:var(--primary); }
  .fd-form-modal-close{ background:none; border:none; font-size:15px; cursor:pointer; color:#667; }
  .fd-form-modal-body{ padding:20px 22px; }
  .fd-form-row{ margin-bottom:13px; }
  .fd-form-row label{ display:block; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.4px; color:var(--primary); margin-bottom:5px; }
  .fd-form-row input, .fd-form-row textarea{ width:100%; border:1.5px solid var(--border); border-radius:7px; padding:9px 12px; font-size:13.5px; font-family:'Poppins',sans-serif; color:var(--text); }
  .fd-form-row textarea{ min-height:70px; resize:vertical; }
  .fd-form-grid3{ display:grid; grid-template-columns:1fr 1fr 1fr; gap:10px; }
  .fd-form-error{ color:#c0392b; font-size:12px; margin-top:2px; display:none; }
  .fd-form-actions{ display:flex; gap:10px; margin-top:8px; }
  .fd-form-actions button{ flex:1; padding:11px; border-radius:8px; border:none; font-weight:700; font-size:13.5px; cursor:pointer; font-family:'Poppins',sans-serif; }
  .fd-form-btn-primary{ background:var(--green); color:#fff; }
  .fd-form-btn-secondary{ background:var(--bg-light); color:var(--primary); border:1px solid var(--border); }

  /* Career/Highlight chip edit controls inside the read-only program modal */
  .fd-career-pill{ position:relative; padding-right:26px; }
  .fd-career-pill .fd-chip-x{ position:absolute; right:6px; top:50%; transform:translateY(-50%); background:none; border:none; color:#c0392b; cursor:pointer; font-size:11px; padding:2px; }
  .fd-highlights li{ align-items:flex-start; justify-content:space-between; }
  .fd-highlights li .fd-hl-text{ flex:1; display:flex; gap:10px; }
  .fd-highlights li .fd-chip-x{ background:none; border:none; color:#c0392b; cursor:pointer; font-size:12px; padding:2px 6px; flex:none; }
  .fd-inline-add-row{ display:flex; gap:8px; margin-top:8px; margin-bottom:18px; }
  .fd-inline-add-row input{ flex:1; border:1.5px solid var(--border); border-radius:7px; padding:8px 10px; font-size:13px; font-family:'Poppins',sans-serif; }
  .fd-inline-add-row button{ background:var(--primary); color:#fff; border:none; border-radius:7px; padding:8px 14px; font-size:12.5px; font-weight:700; cursor:pointer; white-space:nowrap; }
  .fd-modal-edit-btn{ position:absolute; top:16px; right:56px; background:rgba(255,255,255,0.2); border:none; color:#fff; width:32px; height:32px; border-radius:50%; cursor:pointer; font-size:13px; }
  .fd-modal-delete-btn{ position:absolute; top:16px; right:96px; background:rgba(255,255,255,0.2); border:none; color:#fff; width:32px; height:32px; border-radius:50%; cursor:pointer; font-size:13px; }

  /* ===== Program modal ===== */
  .fd-modal-backdrop{ display:none; position:fixed; inset:0; background:rgba(11,44,77,0.55); z-index:2000; align-items:flex-start; justify-content:center; padding:40px 16px; overflow-y:auto; }
  .fd-modal-backdrop.open{ display:flex; }
  .fd-modal{ background:#fff; border-radius:16px; max-width:620px; width:100%; overflow:hidden; }
  .fd-modal-hero{ padding:26px 28px; position:relative; }
  .fd-modal-close{ position:absolute; top:16px; right:16px; background:rgba(255,255,255,0.2); border:none; color:#fff; width:32px; height:32px; border-radius:50%; cursor:pointer; font-size:14px; }
  .fd-modal-dept{ color:rgba(255,255,255,0.75); font-size:12px; font-weight:700; letter-spacing:0.5px; margin-bottom:6px; }
  .fd-modal-title{ color:#fff; font-family:'Montserrat',sans-serif; font-weight:800; font-size:23px; }
  .fd-modal-body{ padding:24px 28px 28px; }
  .fd-modal-desc{ color:var(--text-light); font-size:14px; line-height:1.75; margin-bottom:20px; }
  .fd-dur-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-bottom:22px; }
  .fd-dur-item{ background:var(--bg-light); border-radius:10px; padding:12px; text-align:center; }
  .fd-dur-item label{ display:block; font-size:10.5px; font-weight:700; letter-spacing:0.5px; text-transform:uppercase; color:#9aa4b2; margin-bottom:4px; }
  .fd-dur-item span{ font-weight:700; color:var(--primary); font-size:14px; }
  .fd-section-label{ font-size:12px; font-weight:700; letter-spacing:0.5px; text-transform:uppercase; color:var(--primary); margin:0 0 10px; }
  .fd-careers{ display:flex; flex-wrap:wrap; gap:8px; margin-bottom:22px; }
  .fd-career-pill{ background:var(--bg-light); border:1px solid var(--border); border-radius:20px; padding:6px 14px; font-size:12.5px; color:var(--text); }
  .fd-highlights{ list-style:none; padding:0; margin:0 0 24px; display:grid; gap:9px; }
  .fd-highlights li{ display:flex; gap:10px; font-size:13.5px; color:var(--text); line-height:1.6; }
  .fd-highlights li i{ color:var(--green); margin-top:3px; }
  .fd-modal-actions{ display:flex; gap:12px; flex-wrap:wrap; }
  .fd-action-btn{ flex:1; text-align:center; padding:12px 16px; border-radius:10px; font-weight:700; font-size:13.5px; text-decoration:none; }
  .fd-action-btn.enroll{ background:var(--green); color:#fff; }
  .fd-action-btn.catalog{ background:var(--bg-light); color:var(--primary); border:1px solid var(--border); }

  .fd-page-footer{ text-align:center; padding:24px; color:var(--text-light); font-size:13px; background:var(--bg-light); }
</style>
</head>
<body>

@if (editMode)
{
    <div style="background:#0b2c4d;color:#fff;text-align:center;padding:12px 20px;font-family:'Poppins',sans-serif;font-size:13.5px;font-weight:600;display:flex;align-items:center;justify-content:center;gap:14px;position:sticky;top:0;z-index:9999;box-shadow:0 4px 15px rgba(0,0,0,0.2);">
        <span><i class="fas fa-shield-halved" style="color:#38bdf8;"></i> You are viewing <strong>@Model.Name</strong> in <strong>Admin Edit Mode</strong>.</span>
        <a href="/Faculties/Detail/@Model.Slug" style="background:rgba(255,255,255,0.15);color:#fff;text-decoration:none;padding:5px 12px;border-radius:6px;font-size:12.5px;"><i class="fas fa-eye"></i> View Live</a>
        <a href="/Admin" style="background:#0284c7;color:#fff;text-decoration:none;padding:5px 12px;border-radius:6px;font-size:12.5px;"><i class="fas fa-arrow-left"></i> Staff Control Panel</a>
    </div>
}

<partial name="_SiteHeader" />

<!-- HERO -->
<div class="fd-hero">
  @if (editMode)
  {
      <button type="button" id="fdEditHeroBtn" title="Edit this faculty" onclick="fdOpenHeroEdit()"
              style="position:absolute; top:20px; right:24px; z-index:5; width:38px; height:38px; border-radius:50%; border:none; background:rgba(255,255,255,0.18); color:#fff; cursor:pointer; font-size:15px;">
          <i class="fas fa-pen"></i>
      </button>
  }
  <div class="fd-hero-inner">
    <div class="fd-hero-icon"><i class="@icon" id="fdHeroIcon"></i></div>
    <div>
      <div class="fd-hero-crumb"><a href="/">Home</a> <i class="fas fa-chevron-right"></i> <a href="/Faculties/Public@(editMode ? "?edit=true" : "")">Faculties</a> <i class="fas fa-chevron-right"></i> <span>@Model.Name</span></div>
      <div class="fd-hero-label">FACULTY OVERVIEW</div>
      <h1 id="fdHeroName">@Model.Name</h1>
      <p id="fdHeroDesc">@Model.Description</p>
      <div class="fd-hero-stats">
        <div class="fd-stat"><strong>@deptGroups.Count</strong><span>Department@(deptGroups.Count == 1 ? "" : "s")</span></div>
        <div class="fd-stat"><strong>@programs.Count</strong><span>Degree Program@(programs.Count == 1 ? "" : "s")</span></div>
        <div class="fd-stat"><strong>3</strong><span>Study Levels</span></div>
        <div class="fd-stat"><strong>2026</strong><span>Est.</span></div>
      </div>

      @if (editMode)
      {
          <div id="fdHeroEditForm" style="display:none; margin-top:20px; max-width:640px; background:rgba(255,255,255,0.12); border:1px dashed rgba(255,255,255,0.5); border-radius:10px; padding:16px 18px;">
              <label style="display:block;font-size:11.5px;font-weight:700;color:#fff;opacity:.85;margin-bottom:4px;">FACULTY NAME</label>
              <input id="fdEditName" type="text" value="@Model.Name" style="width:100%;padding:8px 10px;border-radius:6px;border:1px solid #cfe8d8;font-family:'Poppins',sans-serif;font-size:14px;margin-bottom:10px;">
              <label style="display:block;font-size:11.5px;font-weight:700;color:#fff;opacity:.85;margin-bottom:4px;">ICON (Font Awesome class)</label>
              <input id="fdEditIcon" type="text" value="@icon" style="width:100%;padding:8px 10px;border-radius:6px;border:1px solid #cfe8d8;font-family:'Poppins',sans-serif;font-size:14px;margin-bottom:10px;">
              <label style="display:block;font-size:11.5px;font-weight:700;color:#fff;opacity:.85;margin-bottom:4px;">COLOR (hex)</label>
              <input id="fdEditColor" type="text" value="@color" style="width:100%;padding:8px 10px;border-radius:6px;border:1px solid #cfe8d8;font-family:'Poppins',sans-serif;font-size:14px;margin-bottom:10px;">
              <label style="display:block;font-size:11.5px;font-weight:700;color:#fff;opacity:.85;margin-bottom:4px;">DESCRIPTION</label>
              <textarea id="fdEditDesc" rows="3" style="width:100%;padding:8px 10px;border-radius:6px;border:1px solid #cfe8d8;font-family:'Poppins',sans-serif;font-size:14px;margin-bottom:10px;">@Model.Description</textarea>
              <div style="display:flex; gap:10px; align-items:center;">
                  <button type="button" onclick="fdSaveHeroEdit(this)" style="background:#1e8e3e;color:#fff;border:none;padding:9px 18px;border-radius:6px;font-weight:700;cursor:pointer;">Save</button>
                  <button type="button" onclick="document.getElementById('fdHeroEditForm').style.display='none';" style="background:rgba(255,255,255,0.15);color:#fff;border:1px solid rgba(255,255,255,0.4);padding:9px 18px;border-radius:6px;font-weight:700;cursor:pointer;">Cancel</button>
                  <span id="fdEditError" style="display:none;color:#ffd2d2;font-size:12.5px;"></span>
              </div>
          </div>
      }
    </div>
  </div>
</div>

@if (editMode)
{
    <form id="fdAntiForgeryForm">@Html.AntiForgeryToken()</form>
    <script>
      function fdOpenHeroEdit(){
        document.getElementById('fdHeroEditForm').style.display = 'block';
      }
      async function fdSaveHeroEdit(btn){
        var name = document.getElementById('fdEditName').value.trim();
        var icon = document.getElementById('fdEditIcon').value.trim();
        var color = document.getElementById('fdEditColor').value.trim();
        var desc = document.getElementById('fdEditDesc').value.trim();
        var errorBox = document.getElementById('fdEditError');
        errorBox.style.display = 'none';

        if (!name){
          errorBox.textContent = 'Faculty name is required.';
          errorBox.style.display = 'inline';
          return;
        }

        btn.disabled = true;
        btn.textContent = 'Saving...';

        try {
          var token = document.querySelector('#fdAntiForgeryForm input[name="__RequestVerificationToken"]').value;
          var res = await fetch('@Url.Action("QuickUpdateFaculty", "Faculties")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({ FacultyId: @Model.FacultyId, Name: name, Icon: icon, ColorHex: color, Description: desc })
          });
          var data = await res.json();
          if (!res.ok || !data.success){
            errorBox.textContent = data.message || 'Could not save changes.';
            errorBox.style.display = 'inline';
            btn.disabled = false;
            btn.textContent = 'Save';
            return;
          }
          location.reload();
        } catch (err) {
          errorBox.textContent = 'Network error, please try again.';
          errorBox.style.display = 'inline';
          btn.disabled = false;
          btn.textContent = 'Save';
        }
      }

      function fdOpenAboutEdit(){
        var form = document.getElementById('fdAboutEditForm');
        if (form) {
          form.style.display = form.style.display === 'none' ? 'block' : 'none';
          if (form.style.display === 'block') {
            form.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        }
      }

      async function fdSaveAboutEdit(){
        var desc = document.getElementById('fdAboutDescInput').value.trim();
        var errorBox = document.getElementById('fdAboutError');
        var btn = document.getElementById('fdAboutSaveBtn');
        if (errorBox) errorBox.style.display = 'none';

        if (!desc) {
          if (errorBox) { errorBox.textContent = 'Description cannot be empty.'; errorBox.style.display = 'inline'; }
          return;
        }

        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';

        try {
          var r = await fdPost('@Url.Action("QuickUpdateFaculty", "Faculties")', {
            FacultyId: fdFacultyId,
            Name: '@Model.Name',
            Icon: '@icon',
            ColorHex: '@color',
            Description: desc
          });

          if (!r.ok || !r.data || !r.data.success) {
            if (errorBox) { errorBox.textContent = (r.data && r.data.message) || 'Failed to update About section.'; errorBox.style.display = 'inline'; }
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-check"></i> Save About Section';
            return;
          }

          var pText = document.getElementById('fdAboutDescText');
          if (pText) {
            pText.textContent = desc + " Our faculty is committed to academic excellence, cutting-edge research, and producing graduates who are industry-ready from day one.";
          }
          var heroDesc = document.getElementById('fdHeroDesc');
          if (heroDesc) {
            heroDesc.textContent = desc;
          }

          document.getElementById('fdAboutEditForm').style.display = 'none';
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-check"></i> Save About Section';
          if (window.fdShowToast) window.fdShowToast('About section updated successfully!');
        } catch (err) {
          if (errorBox) { errorBox.textContent = 'Network error, please try again.'; errorBox.style.display = 'inline'; }
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-check"></i> Save About Section';
        }
      }
    </script>
}

<!-- MAIN -->
<div class="fd-main">

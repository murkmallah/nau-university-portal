@model NAU_Web.Models.Facility
@{
    Layout = null;
    bool isAdmin = User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin");
    var color1 = string.IsNullOrEmpty(Model.ColorHex) ? "#0b2c4d" : Model.ColorHex;
    var color2 = string.IsNullOrEmpty(Model.GradientColorHex2) ? color1 : Model.GradientColorHex2;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>@Model.Name - National Aviation University</title>
<partial name="_Favicon" />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Open+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link rel="stylesheet" href="~/css/public-site.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/mobile-nav.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/public-modals.css" asp-append-version="true">
<style>
  .facility-hero{ background:linear-gradient(135deg, @color1, @color2); color:#fff; padding:56px 48px; text-align:center; }
  .facility-hero i.hero-icon{ font-size:40px; margin-bottom:12px; display:inline-block; }
  .facility-hero h1{ font-size:34px; margin-bottom:10px; }
  .facility-hero p{ max-width:640px; margin:0 auto; opacity:.9; }

  .content-wrap{ max-width:1000px; margin:0 auto; padding:40px 24px 64px; }

  .stats-row{ display:grid; grid-template-columns:repeat(auto-fit, minmax(140px, 1fr)); gap:20px; margin-bottom:40px; }
  .stat-box{ background:var(--white, #fff); border-radius:12px; box-shadow:0 6px 20px rgba(0,0,0,0.08); padding:24px 16px; text-align:center; }
  .stat-box .num{ font-size:28px; font-weight:700; color:var(--primary, #0b2c4d); }
  .stat-box .label{ font-size:13px; color:#666; margin-top:4px; }

  .section-title{ font-size:22px; color:var(--primary, #0b2c4d); margin-bottom:18px; }

  .services-grid{ display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:20px; margin-bottom:40px; }
  .service-card{ background:var(--white, #fff); border-radius:12px; box-shadow:0 6px 20px rgba(0,0,0,0.08); padding:20px; }
  .service-card i{ color:var(--green, #1e8e3e); font-size:20px; margin-bottom:8px; }
  .service-card h4{ margin-bottom:6px; color:var(--primary, #0b2c4d); }
  .service-card p{ font-size:14px; color:#555; }

  .hours-table{ background:var(--white, #fff); border-radius:12px; box-shadow:0 6px 20px rgba(0,0,0,0.08); overflow:hidden; margin-bottom:40px; }
  .hours-row{ display:flex; justify-content:space-between; padding:14px 22px; border-bottom:1px solid #eee; }
  .hours-row:last-child{ border-bottom:none; }
  .hours-row.highlighted{ background:#fff8e1; font-weight:600; }

  .back-link{ display:inline-block; margin-top:8px; color:var(--green, #1e8e3e); font-weight:600; text-decoration:none; }
</style>
</head>
<body>

<partial name="_SiteHeader" />

<div class="facility-hero">
  <i class="hero-icon @(string.IsNullOrEmpty(Model.CardIcon) ? "fas fa-building" : Model.CardIcon)"></i>
  <h1>@Model.Name</h1>
  @if (!string.IsNullOrEmpty(Model.IntroText))
  {
      <p>@Model.IntroText</p>
  }
</div>

<div class="content-wrap">

@if (Model.FacilityStats != null && Model.FacilityStats.Any())
{
    <div class="stats-row">
    @foreach (var stat in Model.FacilityStats)
    {
        <div class="stat-box">
            <div class="num">@stat.StatNumber</div>
            <div class="label">@stat.StatLabel</div>
        </div>
    }
    </div>
}

@if (Model.FacilityServices != null && Model.FacilityServices.Any())
{
    <h2 class="section-title">What's Available</h2>
    <div class="services-grid">
    @foreach (var svc in Model.FacilityServices)
    {
        <div class="service-card">
            <i class="@(string.IsNullOrEmpty(svc.Icon) ? "fas fa-check-circle" : svc.Icon)"></i>
            <h4>@svc.Title</h4>
            @if (!string.IsNullOrEmpty(svc.Description))
            {
                <p>@svc.Description</p>
            }
        </div>
    }
    </div>
}

@if (Model.FacilityHours != null && Model.FacilityHours.Any())
{
    <h2 class="section-title">Hours</h2>
    <div class="hours-table">
    @foreach (var hr in Model.FacilityHours)
    {
        <div class="hours-row @(hr.IsHighlighted ? "highlighted" : "")">
            <span>@hr.DayOrLabel</span>
            <span>@hr.TimeValue</span>
        </div>
    }
    </div>
}

<a class="back-link" href="@Url.Action("Public", "Facilities")"><i class="fas fa-arrow-left"></i> Back to all facilities</a>

</div>

<script>
// Tells the account-dropdown script whether someone is logged in, so the
// Account button can show the right state (same pattern as the Homepage).
window.NAU_AUTH = {
    isAuthenticated: @Html.Raw(User.Identity != null && User.Identity.IsAuthenticated ? "true" : "false"),
    isAdmin: @Html.Raw(isAdmin ? "true" : "false"),
    userName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)(ViewBag.CurrentUserName ?? "")))
};

/* ===== SEARCH ===== */
function toggleSearch() {
    const box = document.getElementById("searchBox");
    box.classList.toggle("open");
    if (box.classList.contains("open")) box.focus();
}
function closeSearch() {
    setTimeout(() => { document.getElementById("searchBox").classList.remove("open"); }, 150);
}

/* ===== ACCOUNT DROPDOWN (Log In / Sign Up, or user name + Log Out) =====
   Same dynamic behaviour as the Homepage. */
(function setupAccountDropdown() {
    var enhancedButtons = new WeakSet();
    var auth = window.NAU_AUTH || { isAuthenticated: false, isAdmin: false, userName: '' };

    function enhance(btn) {
        if (enhancedButtons.has(btn)) return;
        var alreadyWrapped = !!btn.closest('.account-dropdown');
        var isPristineAccountBtn = btn.textContent.trim().toLowerCase() === 'account';
        if (!alreadyWrapped && !isPristineAccountBtn) return;
        enhancedButtons.add(btn);

        var wrap = btn.closest('.account-dropdown');
        if (!wrap) {
            wrap = document.createElement('div');
            wrap.className = 'account-dropdown';
            btn.parentNode.insertBefore(wrap, btn);
            wrap.appendChild(btn);
        }

        btn.removeAttribute('href');
        btn.setAttribute('role', 'button');

        if (auth.isAuthenticated) {
            btn.innerHTML = '<i class="fas fa-circle-user" style="margin-right:6px;"></i>' + (auth.userName || 'My Account');
        } else {
            btn.innerHTML = 'Account';
        }

        var menu = document.createElement('div');
        menu.className = 'account-dropdown-menu';
        if (auth.isAuthenticated) {
            menu.innerHTML =
                '<a href="#" id="navLogoutLink"><i class="fas fa-right-from-bracket" style="margin-right:8px;"></i>Log Out</a>';
        } else {
            menu.innerHTML =
                '<a href="/Account/Login"><i class="fas fa-right-to-bracket" style="margin-right:8px;"></i>Log In</a>';
        }
        menu.style.position = 'fixed';
        menu.style.display = 'none';
        menu.style.zIndex = '2147483647';
        menu.style.background = '#fff';
        menu.style.minWidth = '150px';
        menu.style.borderRadius = '8px';
        menu.style.boxShadow = '0 10px 28px rgba(0,0,0,0.2)';
        menu.style.overflow = 'hidden';
        document.body.appendChild(menu);

        if (auth.isAuthenticated) {
            var logoutLink = menu.querySelector('#navLogoutLink');
            logoutLink.addEventListener('click', function (e) {
                e.preventDefault();
                var form = document.createElement('form');
                form.method = 'post';
                form.action = '/Account/Logout';
                document.body.appendChild(form);
                form.submit();
            });
        }

        function positionMenu() {
            var r = btn.getBoundingClientRect();
            menu.style.top = (r.bottom + 8) + 'px';
            menu.style.left = 'auto';
            menu.style.right = (window.innerWidth - r.right) + 'px';
        }

        var closeTimer;
        function openMenu() {
            clearTimeout(closeTimer);
            positionMenu();
            menu.style.display = 'block';
            wrap.classList.add('open');
        }
        function closeMenu() {
            closeTimer = setTimeout(function () {
                menu.style.display = 'none';
                wrap.classList.remove('open');
            }, 150);
        }

        wrap.addEventListener('mouseenter', openMenu);
        wrap.addEventListener('mouseleave', closeMenu);
        menu.addEventListener('mouseenter', function () { clearTimeout(closeTimer); });
        menu.addEventListener('mouseleave', closeMenu);

        btn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            if (menu.style.display === 'block') {
                menu.style.display = 'none';
                wrap.classList.remove('open');
            } else {
                openMenu();
            }
        });

        document.addEventListener('click', function (e) {
            if (!wrap.contains(e.target) && !menu.contains(e.target)) {
                menu.style.display = 'none';
                wrap.classList.remove('open');
            }
        });

        window.addEventListener('scroll', function () {
            if (menu.style.display === 'block') positionMenu();
        }, true);
        window.addEventListener('resize', function () {
            if (menu.style.display === 'block') positionMenu();
        });
    }

    function run() {
        document.querySelectorAll('.apply-btn').forEach(enhance);
    }

    run();
    var observer = new MutationObserver(run);
    observer.observe(document.body, { childList: true, subtree: true });
})();
</script>



<script src="~/js/global-search.js" asp-append-version="true"></script>
<script src="~/js/mobile-nav.js" asp-append-version="true"></script>
<script src="~/js/schools-submenu.js" asp-append-version="true"></script>

<partial name="_PublicModals" />
<script src="~/js/public-modals.js" asp-append-version="true"></script>
</body>
</html>

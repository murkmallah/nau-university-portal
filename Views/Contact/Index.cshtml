@model NAU_Web.Models.ContactSettings
@{
    Layout = null;
    ViewData["Title"] = "Contact Us";
    bool isAdmin = ViewBag.IsAdmin ?? false;
    bool editMode = ViewBag.EditMode ?? false;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Contact Us &ndash; National Aviation University</title>
<partial name="_Favicon" />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Open+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link rel="stylesheet" href="~/css/public-site.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/mobile-nav.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/public-modals.css" asp-append-version="true">
<style>
:root {
  --primary: #0b2c4d;
  --green: #1e8e3e;
  --bg: #f5f7fb;
  --white: #fff;
  --shadow: 0 6px 20px rgba(0,0,0,0.08);
  --navy: #0d2c54;
  --gold: #f5a623;
  --text: #333;
  --text-light: #666;
  --border: #e0e0e0;
  --bg-light: #f7f9fc;
  --font-head: "Montserrat", sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box;font-family:"Poppins",sans-serif;}
body{background:var(--bg);}

/* .announcement / .scroll / .account-dropdown / .apply-btn now come from
   the single shared file wwwroot/css/public-site.css (linked above), so
   this page always matches the rest of the site automatically. */

.logo{display:flex;align-items:center;gap:10px;text-decoration:none;}
.logo img{width:60px;height:auto;}
.logo span{font-size:30px;font-weight:700;color:var(--primary);white-space:nowrap;}
.logo-tagline{font-size:10px;font-weight:600;color:#0073ff;letter-spacing:3px;text-transform:uppercase;margin-top:1px;white-space:nowrap;}

.menu{display:flex;align-items:stretch;height:100%;gap:0;}
.menu-item{position:static;display:flex;align-items:center;}
.menu-item > .nav-link{
  display:flex;align-items:center;gap:5px;padding:0 14px;height:100%;text-decoration:none;
  color:#333;font-size:13.5px;font-weight:500;white-space:nowrap;position:relative;
  transition:color .2s;cursor:pointer;border:none;background:none;font-family:"Poppins",sans-serif;
}
.menu-item > .nav-link::after{
  content:"";position:absolute;bottom:0;left:14px;right:14px;height:3px;background:var(--green);
  transform:scaleX(0);transition:transform .25s;border-radius:2px 2px 0 0;
}
.menu-item:hover > .nav-link,
.menu-item > .nav-link:hover{color:var(--primary);}
.menu-item:hover > .nav-link::after{transform:scaleX(1);}
.menu-item.current > .nav-link{color:var(--primary);}
.menu-item.current > .nav-link::after{transform:scaleX(1);}
.nav-link .chevron{font-size:10px;opacity:.6;transition:transform .25s;}
.menu-item:hover > .nav-link .chevron{transform:rotate(180deg);}

.dropdown{
  position:absolute;top:68px;left:0;right:0;background:#fff;box-shadow:0 8px 32px rgba(0,0,0,0.12);
  display:none;border-top:3px solid var(--green);z-index:999;animation:fadeSlide .2s ease;
}
@@keyframes fadeSlide{from{opacity:0;transform:translateY(-8px);}to{opacity:1;transform:translateY(0);}}
.menu-item:hover .dropdown{display:block;}
.dd-inner{max-width:1480px;margin:0 auto;padding:28px 24px 32px;display:flex;gap:0;}
.dd-col{flex:1;padding:0 24px;border-right:1px solid #f0f2f5;}
.dd-col:first-child{padding-left:0;}
.dd-col:last-child{border-right:none;padding-right:0;}
.dd-col-title{font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--green);margin-bottom:14px;padding-bottom:8px;border-bottom:1px solid #eef0f3;}
.dd-link{display:flex;align-items:flex-start;gap:10px;padding:9px 10px;border-radius:7px;text-decoration:none;color:#444;font-size:13px;line-height:1.35;transition:background .15s, color .15s;margin-bottom:2px;}
.dd-link:hover{background:#f5f7fb;color:var(--primary);}
.dd-link:hover .dd-icon{background:var(--primary);color:#fff;}
.dd-link .dd-icon{width:32px;height:32px;background:#eef2f8;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:13px;color:var(--primary);flex-shrink:0;transition:background .15s, color .15s;margin-top:1px;}
.dd-link .dd-text strong{display:block;font-weight:600;font-size:13px;color:inherit;}
.dd-link .dd-text span{font-size:11px;color:#999;line-height:1.4;}
.dd-link:hover .dd-text span{color:#aaa;}
.dd-view-all{display:inline-flex;align-items:center;gap:6px;margin-top:10px;padding:7px 14px;background:var(--green);color:#fff;border-radius:5px;font-size:12px;font-weight:600;text-decoration:none;font-family:"Poppins",sans-serif;transition:background .2s, transform .15s;}
.dd-view-all:hover{background:#166f30;transform:translateY(-1px);}
.dd-view-all i{font-size:10px;}
/* ===== Academics dropdown: school course-preview submenu (hover flyout) ===== */
.dd-school-item{ position:relative; }
.dd-school-link{ padding-right:34px; position:relative; }
.dd-school-arrow{
  position:absolute; right:12px; top:50%; transform:translateY(-50%) rotate(0deg);
  font-size:11px; color:#9aa4b2; padding:8px; cursor:pointer; transition:transform .2s, color .2s;
}
.dd-school-item:hover .dd-school-arrow,
.dd-school-item.open .dd-school-arrow{ transform:translateY(-50%) rotate(90deg); color:#166f30; }
.dd-submenu{
  display:none;
  position:absolute;
  top:-8px;
  left:100%;
  margin-left:8px;
  min-width:240px;
  max-width:290px;
  background:#fff;
  border:1px solid #e2e8f0;
  border-radius:10px;
  box-shadow:0 14px 36px rgba(15,30,60,.18);
  padding:10px;
  z-index:9999;
}
.dd-submenu::before{
  content:'';
  position:absolute;
  top:-15px;
  bottom:-15px;
  left:-25px;
  width:30px;
  background:transparent;
  pointer-events:auto;
}
.dd-school-item:hover .dd-submenu,
.dd-school-item.open .dd-submenu{ display:block; }
.dd-submenu .dd-sub-link{ display:block; padding:7px 10px; border-radius:6px; font-size:12px; color:#475569; text-decoration:none; line-height:1.4; transition:background .15s, color .15s; }
.dd-submenu .dd-sub-link:hover{ background:#f1f5f9; color:#166f30; }
.dd-submenu .dd-sub-loading, .dd-submenu .dd-sub-error{ font-size:12px; color:#9aa4b2; padding:8px 10px; }
.dd-submenu .dd-sub-viewall{ display:flex; align-items:center; justify-content:center; gap:6px; margin-top:8px; padding:8px 14px; border-radius:20px; background:var(--green); color:#fff !important; font-size:12px; font-weight:600; text-decoration:none; transition:background .2s; }
.dd-submenu .dd-sub-viewall:hover{ background:#166f30; }

.dd-featured{background:linear-gradient(135deg,var(--primary) 0%,#1a5fa6 100%);border-radius:10px;padding:20px 18px;color:#fff;text-decoration:none;display:block;transition:opacity .2s;}
.dd-featured:hover{opacity:.9;}
.dd-featured .feat-label{font-size:10px;letter-spacing:2px;text-transform:uppercase;opacity:.7;margin-bottom:6px;}
.dd-featured .feat-title{font-size:15px;font-weight:700;margin-bottom:6px;line-height:1.3;}
.dd-featured .feat-desc{font-size:12px;opacity:.75;line-height:1.5;margin-bottom:12px;}
.dd-featured .feat-btn{display:inline-block;background:var(--green);color:#fff;padding:6px 14px;border-radius:5px;font-size:12px;font-weight:600;}

.search-wrap{display:flex;align-items:center;gap:8px;padding:0 0 0 14px;border-left:1px solid #eee;margin-left:6px;}
.search-icon{cursor:pointer;color:#555;font-size:15px;transition:color .2s;padding:6px;border-radius:50%;}
.search-icon:hover{color:var(--primary);}
.search-box{display:none;padding:6px 12px;border:1.5px solid #ddd;border-radius:20px;font-size:13px;font-family:"Poppins",sans-serif;outline:none;width:180px;transition:border-color .2s;}
.search-box:focus{border-color:var(--green);}
.search-box.open{display:block;}

.hero { position:relative; padding:80px 48px; background:linear-gradient(135deg, #0b2c4d 0%, #0d3a6e 50%, #1a5fa6 100%); text-align:center; overflow:hidden; }
.hero-bg-pattern { position:absolute; inset:0; opacity:0.05; background-image: radial-gradient(circle at 20% 30%, #fff 1px, transparent 1px), radial-gradient(circle at 80% 70%, #fff 1px, transparent 1px); background-size:60px 60px, 80px 80px; }
.hero-deco { position:absolute; left:50%; top:-120px; transform:translateX(-50%); width:600px; height:600px; border-radius:50%; border:1px solid rgba(255,255,255,0.05); }
.hero-content { position:relative; z-index:2; max-width:680px; margin:0 auto; }
.hero-breadcrumb { display:flex; align-items:center; justify-content:center; gap:8px; font-size:12px; color:rgba(255,255,255,0.55); margin-bottom:20px; flex-wrap:wrap; }
.hero-breadcrumb a{ color:rgba(255,255,255,0.55); text-decoration:none; }
.hero-eyebrow { font-size:11px; font-weight:700; letter-spacing:4px; text-transform:uppercase; color:var(--gold); margin-bottom:16px; display:flex; align-items:center; justify-content:center; gap:10px; }
.hero-eyebrow::before, .hero-eyebrow::after { content:""; display:inline-block; width:28px; height:2px; background:var(--gold); }
.hero h1 { font-family:var(--font-head); font-size:44px; font-weight:800; color:#fff; line-height:1.15; margin-bottom:16px; }
.hero h1 em { font-style:normal; color:#4ed47a; }
.hero p { font-size:16px; color:rgba(255,255,255,0.75); line-height:1.75; max-width:560px; margin:0 auto; }

/* ===== Contact section ===== */
.contact-section{ padding:60px 24px; }
.contact-inner{ max-width:1480px; margin:0 auto; display:grid; grid-template-columns:1fr 1.15fr; gap:32px; align-items:start; background:#fff; border-radius:18px; overflow:hidden; box-shadow:var(--shadow); border:1px solid #eef0f4; }

.contact-info{ background:#fff; }
.contact-panel-head{ background:var(--primary); color:#fff; font-family:var(--font-head); font-weight:800; font-size:19px; text-align:center; padding:20px 24px; }
.contact-info-grid{ display:grid; grid-template-columns:1fr 1fr; }
.contact-info-item{ padding:30px 26px; text-align:center; border-bottom:1px solid #eef0f4; }
.contact-info-item:nth-child(odd){ border-right:1px solid #eef0f4; }
.contact-info-item i{ font-size:26px; color:var(--primary); margin-bottom:14px; display:inline-block; }
.contact-info-item h4{ font-family:var(--font-head); font-size:16px; font-weight:800; color:var(--navy); margin-bottom:10px; }
.contact-info-item p, .contact-info-item a{ font-size:13px; color:var(--text-light); line-height:1.7; text-decoration:none; }
.contact-info-item a:hover{ color:var(--primary); }

.contact-form-wrap{ background:var(--bg-light); }
.contact-form{ padding:32px 36px 40px; }
.form-row{ display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px; }
.form-field{ position:relative; }
.form-field i{ position:absolute; left:16px; top:50%; transform:translateY(-50%); color:#9aa4b2; font-size:14px; }
.form-field input, .form-field textarea{
  width:100%; padding:13px 16px 13px 40px; border:1.5px solid var(--border); border-radius:8px;
  font-size:13.5px; font-family:"Poppins",sans-serif; color:var(--text); background:#fff;
  transition:border-color .2s; outline:none;
}
.form-field textarea{ padding-left:16px; resize:vertical; min-height:120px; }
.form-field input:focus, .form-field textarea:focus{ border-color:var(--primary); }
.form-field .req{ color:#e0453c; }
.field-label{ font-size:12.5px; font-weight:600; color:var(--navy); margin-bottom:6px; display:block; }
.form-full{ margin-bottom:16px; }
.hp-field{ position:absolute; left:-9999px; top:-9999px; opacity:0; height:0; width:0; }

.contact-submit-btn{
  display:inline-flex; align-items:center; gap:10px; background:var(--green); color:#fff; border:none;
  padding:13px 28px; border-radius:8px; font-size:14px; font-weight:700; cursor:pointer;
  font-family:"Poppins",sans-serif; transition:background .2s, transform .15s;
}
.contact-submit-btn:hover{ background:#166f30; transform:translateY(-1px); }
.contact-submit-btn:disabled{ opacity:.65; cursor:not-allowed; transform:none; }

.form-status{ margin-top:16px; font-size:13.5px; padding:12px 16px; border-radius:8px; display:none; }
.form-status.show{ display:block; }
.form-status.success{ background:#e8f7ee; color:#166f30; border:1px solid #bfe8cf; }
.form-status.error{ background:#fdecea; color:#b3261e; border:1px solid #f6c6c2; }

.map-wrap{ max-width:1480px; margin:0 auto 60px; padding:0 24px; }
.map-frame{ border-radius:16px; overflow:hidden; box-shadow:var(--shadow); border:1px solid #eef0f4; height:340px; }
.map-frame iframe{ width:100%; height:100%; border:0; }

@@media(max-width:900px){
  .contact-section{ padding:40px 20px; }
  .contact-inner{ grid-template-columns:1fr; }
  .contact-info-grid{ grid-template-columns:1fr 1fr; }
  .map-wrap{ padding:0 20px; }
}
@@media(max-width:768px){
  .announcement{ padding:8px 20px; }
  .navbar{ padding:14px 20px; }
  .hero{ padding:60px 20px; }
  .hero h1{ font-size:30px; }
  .form-row{ grid-template-columns:1fr; }
  .contact-info-grid{ grid-template-columns:1fr; }
  .contact-info-item:nth-child(odd){ border-right:none; }
}

/* ===== Footer (matches home.css so this page's footer looks identical
   to the homepage / other public pages) ===== */
footer { background:var(--navy); color:rgba(255,255,255,0.85); padding:50px 20px 20px; }
.footer-inner { max-width:1480px; margin:0 auto; display:grid; grid-template-columns:1.4fr 1fr 1fr 1.2fr; gap:40px; }
.footer-brand p { font-size:13px; color:rgba(255,255,255,0.65); margin:14px 0 18px; line-height:1.7; }
.footer-col h4 { font-family:var(--font-head); font-size:13px; font-weight:700; color:#fff; text-transform:uppercase; letter-spacing:1px; margin-bottom:16px; }
.footer-col ul { list-style:none; }
.footer-col ul li { margin-bottom:9px; }
.footer-col ul li a { color:rgba(255,255,255,0.65); text-decoration:none; font-size:13px; transition:color .2s; }
.footer-col ul li a:hover { color:#fff; }
.contact-item { display:flex; gap:10px; margin-bottom:10px; font-size:13px; color:rgba(255,255,255,0.65); }
.contact-item i { color:var(--gold); margin-top:2px; flex-shrink:0; width:14px; }
.footer-bottom { max-width:1480px; margin:30px auto 0; border-top:1px solid rgba(255,255,255,0.1); padding-top:18px; display:flex; justify-content:space-between; align-items:center; font-size:12px; color:rgba(255,255,255,0.5); flex-wrap:wrap; gap:10px; }
.footer-bottom-links { display:flex; gap:16px; }
.footer-bottom-links a { color:rgba(255,255,255,0.5); text-decoration:none; }
.footer-bottom-links a:hover { color:#fff; }
@@media(max-width:900px){ .footer-inner{ grid-template-columns:1fr 1fr; } }
@@media(max-width:600px){ .footer-inner{ grid-template-columns:1fr; } .footer-bottom{ flex-direction:column; text-align:center; } }

@@keyframes fadeInUp { from{opacity:0;transform:translateY(30px);} to{opacity:1;transform:translateY(0);} }
.animate-up { animation:fadeInUp .55s ease both; }

/* ---- Admin inline-edit additions (pencil buttons + modal), same visual
   language/class names as the SimulationLabs edit UI ---- */
.cs-edit-btn{
  width:30px; height:30px; border-radius:50%; border:1.5px solid #d5dce6; cursor:pointer;
  background:rgba(255,255,255,0.92); color:#0b6dbf; display:inline-flex; align-items:center;
  justify-content:center; font-size:12px; box-shadow:0 3px 10px rgba(0,0,0,.1); flex-shrink:0;
}
.cs-edit-btn:hover{ background:#0b6dbf; color:#fff; }
.cs-hero-edit-btn{ position:absolute; top:0; right:0; }
.hero-content{ position:relative; }
.contact-panel-head-row{ display:flex; align-items:center; justify-content:space-between; gap:10px; }

.sl-modal-backdrop{
  display:none; position:fixed; inset:0; background:rgba(11,44,77,.55);
  z-index:100000; align-items:center; justify-content:center; padding:20px;
}
.sl-modal-backdrop.open{ display:flex; }
.sl-modal{
  background:#fff; border-radius:12px; width:100%; max-width:480px;
  max-height:90vh; overflow-y:auto; box-shadow:0 20px 60px rgba(0,0,0,.3);
  font-family:"Poppins",sans-serif;
}
.sl-modal-header{
  display:flex; align-items:center; justify-content:space-between;
  padding:18px 22px; border-bottom:1px solid #eef1f6;
}
.sl-modal-header h3{ font-family:"Montserrat",sans-serif; font-size:16px; font-weight:700; color:#0b2c4d; }
.sl-modal-close{ background:none; border:none; font-size:16px; cursor:pointer; color:#667; }
.sl-modal-body{ padding:22px; }
.sl-field{ margin-bottom:14px; }
.sl-field label{ display:block; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.5px; color:#0b2c4d; margin-bottom:5px; }
.sl-field input[type=text], .sl-field textarea{
  width:100%; border:1px solid #d5dce6; border-radius:6px; padding:9px 12px; font-size:13px;
  font-family:"Poppins",sans-serif;
}
.sl-field textarea{ min-height:70px; resize:vertical; }
.sl-error{ color:#c0392b; font-size:11.5px; margin-top:4px; display:none; }
.sl-modal-actions{ display:flex; gap:10px; margin-top:6px; }
.sl-btn-primary, .sl-btn-secondary{
  flex:1; padding:10px; border-radius:6px; border:none; font-weight:700; font-size:13px; cursor:pointer;
}
.sl-btn-primary{ background:#0b6dbf; color:#fff; }
.sl-btn-primary:hover{ background:#0a58ca; }
.sl-btn-secondary{ background:#f0f4f8; color:#0b2c4d; border:1.5px solid #dde2ea; }
.sl-btn-secondary:hover{ background:#e4ecf4; }
</style>
</head>
<body>

<partial name="_SiteHeader" />


<section class="hero">
  <div class="hero-bg-pattern"></div>
  <div class="hero-deco"></div>
  <div class="hero-content">
    <div class="hero-breadcrumb">
      <a href="/">Home</a>
      <i class="fas fa-chevron-right"></i>
      <span style="color:rgba(255,255,255,0.85)">Contact</span>
    </div>
    <div class="hero-eyebrow">Get In Touch</div>
    <h1>@Model.Heading</h1>
    <p>@Model.Subtext</p>
    @if (editMode)
    {
        <button type="button" class="cs-edit-btn cs-hero-edit-btn" title="Edit Contact Info" onclick="openContactSettingsModal()"><i class="fas fa-pen"></i></button>
    }
  </div>
</section>

<section class="contact-section">
  <div class="contact-inner animate-up">

    <div class="contact-info">
      <div class="contact-panel-head-row">
        <div class="contact-panel-head">Get In Touch With Us Now!</div>
        @if (editMode)
        {
            <button type="button" class="cs-edit-btn" title="Edit Contact Info" onclick="openContactSettingsModal()"><i class="fas fa-pen"></i></button>
        }
      </div>
      <div class="contact-info-grid">
        <div class="contact-info-item">
          <i class="fas fa-phone"></i>
          <h4>Phone Number</h4>
          <p><a href="tel:@Model.Phone">@Model.Phone</a></p>
        </div>
        <div class="contact-info-item">
          <i class="fas fa-envelope"></i>
          <h4>Email</h4>
          <p><a href="mailto:@Model.Email">@Model.Email</a></p>
        </div>
        <div class="contact-info-item">
          <i class="fas fa-location-dot"></i>
          <h4>Location</h4>
          <p>@Model.Address</p>
        </div>
        <div class="contact-info-item">
          <i class="fas fa-clock"></i>
          <h4>Working Hours</h4>
          <p>@Html.Raw((Model.OfficeHours ?? "").Replace(", ", "<br>"))</p>
        </div>
      </div>
    </div>


    <div class="contact-form-wrap">
      <div class="contact-panel-head">Contact Us</div>
      <form class="contact-form" id="contactForm" novalidate>

        <div class="form-row">
          <div class="form-field">
            <span class="field-label">First Name <span class="req">*</span></span>
            <i class="fas fa-user"></i>
            <input type="text" id="cfFirstName" name="firstName" required maxlength="100">
          </div>
          <div class="form-field">
            <span class="field-label">Last Name</span>
            <i class="fas fa-user"></i>
            <input type="text" id="cfLastName" name="lastName" maxlength="100">
          </div>
        </div>

        <div class="form-row">
          <div class="form-field">
            <span class="field-label">Mobile No <span class="req">*</span></span>
            <i class="fas fa-phone"></i>
            <input type="tel" id="cfMobile" name="mobileNo" required maxlength="30">
          </div>
          <div class="form-field">
            <span class="field-label">Email ID <span class="req">*</span></span>
            <i class="fas fa-envelope"></i>
            <input type="email" id="cfEmail" name="email" required maxlength="150">
          </div>
        </div>

        <div class="form-full form-field">
          <span class="field-label">Message</span>
          <textarea id="cfMessage" name="message" maxlength="2000" placeholder="Write your message..."></textarea>
        </div>

        <!-- Honeypot: hidden from real visitors, catches spam bots -->
        <div class="hp-field" aria-hidden="true">
          <label for="cfWebsite">Leave this field empty</label>
          <input type="text" id="cfWebsite" name="website" tabindex="-1" autocomplete="off">
        </div>

        <button type="submit" class="contact-submit-btn" id="cfSubmitBtn">
          <span id="cfSubmitLabel">Submit</span> <i class="fas fa-paper-plane"></i>
        </button>

        <div class="form-status" id="cfStatus"></div>
      </form>
    </div>

  </div>
</section>

<div class="map-wrap">
  <div class="map-frame">
    <iframe src="https://www.google.com/maps?q=@Uri.EscapeDataString(Model.Address ?? "")&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
  </div>
</div>

<partial name="_SiteFooter" />

<form id="contactAntiForgeryForm">@Html.AntiForgeryToken()</form>

@if (editMode)
{
    <div class="sl-modal-backdrop" id="contactSettingsModal">
        <div class="sl-modal">
            <div class="sl-modal-header">
                <h3>Edit Contact Info & Email Routing</h3>
                <button type="button" class="sl-modal-close" onclick="closeContactSettingsModal()"><i class="fas fa-times"></i></button>
            </div>
            <div class="sl-modal-body">
                <div class="sl-field"><label>Heading</label><input type="text" id="csHeading" placeholder="e.g. Contact Us"></div>
                <div class="sl-field"><label>Subtext</label><textarea id="csSubtext" placeholder="Short intro shown under the heading"></textarea></div>
                <div class="sl-field"><label>Phone</label><input type="text" id="csPhone" placeholder="e.g. +92 22 9260310-19"></div>
                <div class="sl-field"><label style="color:#1e8e3e;">📩 Target Email (Receives all Contact Us messages)</label><input type="text" id="csEmail" placeholder="e.g. oicit.cati@gmail.com or AdID.Academics@paa.gov.pk"></div>
                <div class="sl-field"><label>Address</label><input type="text" id="csAddress" placeholder="e.g. Airport Road, Hyderabad, Sindh, Pakistan"></div>
                <div class="sl-field"><label>Office Hours</label><input type="text" id="csOfficeHours" placeholder="e.g. Monday to Saturday, 09:00 AM to 06:00 PM"></div>
                <div style="background:#f0f7ff; border:1px solid #cce3ff; border-radius:8px; padding:12px; margin:14px 0 10px;">
                    <div style="font-size:12px; font-weight:700; color:#0b2c4d; margin-bottom:4px;"><i class="fas fa-paper-plane" style="color:#0b6dbf;"></i> Direct Sender SMTP Settings (Optional / Recommended)</div>
                    <div style="font-size:11px; color:#556; line-height:1.5; margin-bottom:8px;">To send emails directly to <em>any</em> address without test-mode restrictions, enter a Gmail address and its <strong>16-digit App Password</strong> (generated from Google Account &gt; Security &gt; 2-Step Verification &gt; App Passwords).</div>
                    <div class="sl-field" style="margin-bottom:8px;"><label style="font-size:10px;">Sender Gmail Address</label><input type="text" id="csSmtpUsername" placeholder="e.g. your-gmail@gmail.com"></div>
                    <div class="sl-field" style="margin-bottom:4px;"><label style="font-size:10px;">Google App Password (16 characters)</label><input type="password" id="csSmtpPassword" placeholder="e.g. abcd efgh ijkl mnop" autocomplete="new-password"></div>
                </div>
                <div class="sl-error" id="contactSettingsError"></div>
                <div class="sl-modal-actions" style="display:flex; flex-direction:column; gap:8px;">
                    <div style="display:flex; gap:10px;">
                        <button type="button" class="sl-btn-primary" id="contactSettingsSaveBtn" onclick="saveContactSettings(this)"><i class="fas fa-save"></i> Save Settings</button>
                        <button type="button" class="sl-btn-secondary" onclick="closeContactSettingsModal()">Cancel</button>
                    </div>
                    <button type="button" class="sl-btn-secondary" id="contactTestEmailBtn" onclick="sendTestEmail(this)" style="background:#eef6ee; color:#1e8e3e; border-color:#bce5bc; font-size:12px; padding:8px;"><i class="fas fa-paper-plane"></i> Send Test Email to Target Address</button>
                </div>
            </div>
        </div>
    </div>
}



<script>
window.NAU_AUTH = {
    isAuthenticated: @Html.Raw(User.Identity != null && User.Identity.IsAuthenticated ? "true" : "false"),
    isAdmin: @Html.Raw(isAdmin ? "true" : "false"),
    userName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)(ViewBag.CurrentUserName ?? "")))
};

function toggleSearch() {
    const box = document.getElementById("searchBox");
    box.classList.toggle("open");
    if (box.classList.contains("open")) box.focus();
}
function closeSearch() {
    setTimeout(() => { document.getElementById("searchBox").classList.remove("open"); }, 150);
}

function getAntiForgeryToken(){
  var el = document.querySelector('#contactAntiForgeryForm input[name="__RequestVerificationToken"]');
  return el ? el.value : '';
}

/* ===== Contact Settings (heading, subtext, phone, email, address, hours) ===== */
function openContactSettingsModal(){
  var f = function(id){ return document.getElementById(id); };
  f('csHeading').value = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Heading ?? ""));
  f('csSubtext').value = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Subtext ?? ""));
  f('csPhone').value = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Phone ?? ""));
  f('csEmail').value = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Email ?? ""));
  f('csAddress').value = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Address ?? ""));
  f('csOfficeHours').value = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OfficeHours ?? ""));
  f('csSmtpUsername').value = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SmtpUsername ?? ""));
  f('csSmtpPassword').value = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SmtpPassword ?? ""));
  f('contactSettingsError').style.display = 'none';
  document.getElementById('contactSettingsModal').classList.add('open');
  document.body.style.overflow = 'hidden';
  f('csHeading').focus();
}
function closeContactSettingsModal(){
  var m = document.getElementById('contactSettingsModal');
  if (m) m.classList.remove('open');
  document.body.style.overflow = '';
}
async function saveContactSettings(btn){
  var f = function(id){ return document.getElementById(id); };
  var heading = f('csHeading').value.trim();
  var email = f('csEmail').value.trim();
  var err = f('contactSettingsError');
  err.style.display = 'none';
  if (!heading){ err.textContent = 'Heading is required.'; err.style.display = 'block'; return; }
  if (!email){ err.textContent = 'Email is required.'; err.style.display = 'block'; return; }

  var payload = {
    Heading: heading,
    Subtext: f('csSubtext').value.trim(),
    Phone: f('csPhone').value.trim(),
    Email: email,
    Address: f('csAddress').value.trim(),
    OfficeHours: f('csOfficeHours').value.trim(),
    SmtpUsername: f('csSmtpUsername').value.trim(),
    SmtpPassword: f('csSmtpPassword').value.trim()
  };

  btn.disabled = true;
  var originalText = btn.innerHTML;
  btn.innerHTML = 'Saving...';

  try {
    var res = await fetch('@Url.Action("QuickSaveContactSettings", "Contact")', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
      body: JSON.stringify(payload)
    });
    var data = await res.json();
    if (!res.ok || !data.success){
      err.textContent = data.message || 'Could not save.';
      err.style.display = 'block';
      btn.disabled = false; btn.innerHTML = originalText;
      return;
    }
    setTimeout(function(){ window.location.reload(); }, 300);
  } catch (e){
    err.textContent = 'Network error, please try again.';
    err.style.display = 'block';
    btn.disabled = false; btn.innerHTML = originalText;
  }
}

async function sendTestEmail(btn) {
  var err = document.getElementById('contactSettingsError');
  err.style.display = 'none';
  btn.disabled = true;
  var originalText = btn.innerHTML;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending Test Email...';

  try {
    var res = await fetch('/Contact/SendTestEmail', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'RequestVerificationToken': getAntiForgeryToken()
      }
    });
    var data = await res.json();
    if (data.success) {
      alert(data.message);
    } else {
      err.textContent = data.message || 'Failed to send test email.';
      err.style.display = 'block';
    }
  } catch (e) {
    err.textContent = 'Network error while sending test email.';
    err.style.display = 'block';
  } finally {
    btn.disabled = false;
    btn.innerHTML = originalText;
  }
}

/* ===== ACCOUNT DROPDOWN (Log In / Sign Up, or user name + Log Out) ===== */
(function setupAccountDropdown() {
    var enhancedButtons = new WeakSet();
    var auth = window.NAU_AUTH || { isAuthenticated: false, isAdmin: false, userName: '' };

    function enhance(btn) {
        if (enhancedButtons.has(btn)) return;
        var alreadyWrapped = !!btn.closest('.account-dropdown');
        var isPristineAccountBtn = btn.textContent.trim().toLowerCase() === 'account';
        if (!alreadyWrapped && !isPristineAccountBtn) return;
        enhancedButtons.add(btn);

        var wrap = btn.closest('.account-dropdown');
        if (!wrap) {
            wrap = document.createElement('div');
            wrap.className = 'account-dropdown';
            btn.parentNode.insertBefore(wrap, btn);
            wrap.appendChild(btn);
        }

        btn.removeAttribute('href');
        btn.setAttribute('role', 'button');

        if (auth.isAuthenticated) {
            btn.innerHTML = '<i class="fas fa-circle-user" style="margin-right:6px;"></i>' + (auth.userName || 'My Account');
        } else {
            btn.innerHTML = 'Account';
        }

        var menu = document.createElement('div');
        menu.className = 'account-dropdown-menu';
        if (auth.isAuthenticated) {
            menu.innerHTML =
                '<a href="#" id="navLogoutLink"><i class="fas fa-right-from-bracket" style="margin-right:8px;"></i>Log Out</a>';
        } else {
            menu.innerHTML =
                '<a href="/Account/Login"><i class="fas fa-right-to-bracket" style="margin-right:8px;"></i>Log In</a>';
        }
        menu.style.position = 'fixed';
        menu.style.display = 'none';
        menu.style.zIndex = '2147483647';
        menu.style.background = '#fff';
        menu.style.minWidth = '150px';
        menu.style.borderRadius = '8px';
        menu.style.boxShadow = '0 10px 28px rgba(0,0,0,0.2)';
        menu.style.overflow = 'hidden';
        document.body.appendChild(menu);

        if (auth.isAuthenticated) {
            var logoutLink = menu.querySelector('#navLogoutLink');
            logoutLink.addEventListener('click', function (e) {
                e.preventDefault();
                var form = document.createElement('form');
                form.method = 'post';
                form.action = '/Account/Logout';
                document.body.appendChild(form);
                form.submit();
            });
        }

        function positionMenu() {
            var r = btn.getBoundingClientRect();
            menu.style.top = (r.bottom + 8) + 'px';
            menu.style.left = 'auto';
            menu.style.right = (window.innerWidth - r.right) + 'px';
        }

        var closeTimer;
        function openMenu() {
            clearTimeout(closeTimer);
            positionMenu();
            menu.style.display = 'block';
            wrap.classList.add('open');
        }
        function closeMenu() {
            closeTimer = setTimeout(function () {
                menu.style.display = 'none';
                wrap.classList.remove('open');
            }, 150);
        }

        wrap.addEventListener('mouseenter', openMenu);
        wrap.addEventListener('mouseleave', closeMenu);
        menu.addEventListener('mouseenter', function () { clearTimeout(closeTimer); });
        menu.addEventListener('mouseleave', closeMenu);

        btn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            if (menu.style.display === 'block') {
                menu.style.display = 'none';
                wrap.classList.remove('open');
            } else {
                openMenu();
            }
        });

        document.addEventListener('click', function (e) {
            if (!wrap.contains(e.target) && !menu.contains(e.target)) {
                menu.style.display = 'none';
                wrap.classList.remove('open');
            }
        });

        window.addEventListener('scroll', function () {
            if (menu.style.display === 'block') positionMenu();
        }, true);
        window.addEventListener('resize', function () {
            if (menu.style.display === 'block') positionMenu();
        });
    }

    function run() {
        document.querySelectorAll('.apply-btn').forEach(enhance);
    }

    run();
    var observer = new MutationObserver(run);
    observer.observe(document.body, { childList: true, subtree: true });
})();

/* ===== CONTACT FORM SUBMIT ===== */
document.getElementById('contactForm').addEventListener('submit', function (e) {
    e.preventDefault();

    var statusBox = document.getElementById('cfStatus');
    var btn = document.getElementById('cfSubmitBtn');
    var label = document.getElementById('cfSubmitLabel');

    statusBox.className = 'form-status';
    statusBox.textContent = '';

    var payload = {
        firstName: document.getElementById('cfFirstName').value.trim(),
        lastName: document.getElementById('cfLastName').value.trim(),
        mobileNo: document.getElementById('cfMobile').value.trim(),
        email: document.getElementById('cfEmail').value.trim(),
        message: document.getElementById('cfMessage').value.trim(),
        website: document.getElementById('cfWebsite').value.trim() // honeypot
    };

    if (!payload.firstName || !payload.mobileNo || !payload.email) {
        statusBox.textContent = 'Please fill in First Name, Mobile No and Email.';
        statusBox.className = 'form-status show error';
        return;
    }

    btn.disabled = true;
    label.textContent = 'Sending...';

    fetch('/Contact/Send', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': getAntiForgeryToken()
        },
        body: JSON.stringify(payload)
    })
    .then(function (res) { return res.json(); })
    .then(function (data) {
        if (data.success) {
            statusBox.textContent = data.message || 'Thank you! Your message has been sent.';
            statusBox.className = 'form-status show success';
            document.getElementById('contactForm').reset();
        } else {
            statusBox.textContent = data.message || 'Something went wrong. Please try again.';
            statusBox.className = 'form-status show error';
        }
    })
    .catch(function () {
        statusBox.textContent = 'Network error. Please check your connection and try again.';
        statusBox.className = 'form-status show error';
    })
    .finally(function () {
        btn.disabled = false;
        label.textContent = 'Submit';
    });
});
</script>

